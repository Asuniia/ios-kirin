+		.src_w = 64, .src_h = 64, .src_pitch = 256,
+		.dst_w = 128, .dst_h = 128, .dst_pitch = 512,
+		.x0 = 16, .y0 = 16, .w = 64, .h = 64,
+		.m = {0x3f800000u, 0, 0, 0x3f800000u, 0xc1800000u, 0xc1800000u},
+		.opacity = 0x3f800000u,
