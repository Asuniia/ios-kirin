+		q->m[0], q->m[1], q->m[2], q->m[3],
+		q->m[4], q->m[5], q->opacity, 0x3f800000u,
+		0x437f0000u, 0x3f000000u, q->w - 1, q->dst_pitch / 4,
+		q->x0, q->y0, 0, 0,
+	};
+	uint32_t tex[24], samp[8];
+	tex_rgba8(tex, q->src_va, q->src_w, q->src_h, q->src_pitch);
+	tex_rgba8(tex + 12, q->dst_va, q->dst_w, q->dst_h, q->dst_pitch);
+	samp_unnorm(samp, !(q->flags & SWEET_GPU_QUAD_NEAREST));
+	samp_unnorm(samp + 4, false);
+	struct cs_extra x = {consts, 4, tex, samp, 2, q->h};
+	uint64_t bufs[1] = {q->dst_va};
+	uint32_t sizes[1] = {(uint32_t)dlen};
+	uint32_t seq = ++g_seq;
+	volatile uint32_t *fv = (volatile uint32_t *)(g_scratch_va + 64);
+	bool read = compute_run(g_gpu, &k_sample, g_ksample, bufs, sizes, (q->w + 63) / 64, g_scratch + 64, seq, &x);
+	bool done = false;
+	for (unsigned us = 0; read && us < 500000 && !(done = (*fv == seq)); us += 20) {
+		delay(20);
+		flush_dcache64((addr64_t)g_scratch + 64, 4, TRUE);
 	}
+	vm_cache((uint32_t)df, q->dst_va, dlen);
+	lck_mtx_unlock(&sweet_gpu_vm_lock);
