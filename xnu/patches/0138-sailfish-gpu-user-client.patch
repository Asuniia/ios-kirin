+	int r = sweet_gpu_quad(&q);
+	uint64_t t1 = mach_absolute_time();
+	uint32_t bad = 0;
+	for (uint32_t i = 0; i < 128 * 128; i++) {
+		uint32_t px = i % 128, py = i / 128;
+		uint32_t dd = 0xff000000u | ((i * 7) & 0xff) << 16 | ((i * 13) & 0xff) << 8 | (i & 0xff);
