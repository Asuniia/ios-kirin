+/* VM lock held: the first chunk of the one mapping holding [va, va + len), or -1. */
+static int
+vm_range(uint64_t va, uint64_t len)
+{
+	if (len == 0 || va < GVA_BASE || va - GVA_BASE >= ((uint64_t)GVA_CHUNKS << 21)) {
+		return -1;
+	}
+	uint32_t c = (uint32_t)((va - GVA_BASE) >> 21);
