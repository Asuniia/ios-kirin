@@ -54,6 +54,19 @@ sweet_early_string(const char *s)
 	}
 }
 
+/* "SWEET EARLY   label 0x0123456789abcdef", for bring-up debugging */
+void
+sweet_early_hex(const char *label, uint64_t v)
+{
+	sweet_early_string("SWEET EARLY   ");
+	sweet_early_string(label);
+	sweet_early_string(" 0x");
+	for (int sh = 60; sh >= 0; sh -= 4) {
+		sweet_early_putc("0123456789abcdef"[(v >> sh) & 0xf]);
+	}
+	sweet_early_putc('\n');
+}
