+/*
+ * GPU SMMU (ARM SMMUv2, 2 context banks, 4 KB pages, CBs from 0x8000):
+ * firmware ignores sCR0.CLIENTPD (bypass) and the stream starts as FAULT
+ * (0120a: S2CR0 0x000200ff, the first CP fetch reset the phone). Like
+ * mainline (which translates through a context bank on MSM8996), but with
+ * an identity map: context bank 0, stage 1 AArch64, 4 KB granule, 36-bit
+ * VA = PA, 1 GB blocks for 0x80000000-0x1ffffffff (DRAM), normal
+ * non-cacheable; SMR0 matches every stream ID. Returns false (and the GPU
+ * must not touch memory) unless every write reads back.
+ */
+static bool
+smmu_identity(vm_offset_t smmu)
+{
+	vm_offset_t pt_va;
+	uint64_t pt = gpu_page(&pt_va);
+	if (pt == 0) {
+		return false;
+	}
+	uint64_t *l1 = (uint64_t *)pt_va;
+	for (uint64_t gb = 2; gb < 8; gb++) {
+		/* block | AttrIndx 0 | AP[1] (EL0 too) | SH outer | AF */
+		l1[gb] = (gb << 30) | 1u | (1u << 6) | (2u << 8) | (1u << 10);
+	}
+	flush_dcache64((addr64_t)pt, PAGE_SIZE, TRUE);
+	vm_offset_t gr1 = smmu + 0x1000, cb = smmu + 0x8000;
+	wr(cb, 0x0, 0);                         /* SCTLR off while configuring */
+	wr(gr1, 0x0, 1u << 16);                 /* CBAR0: S1 translate, S2 bypass */
+	wr(gr1, 0x800, 1u);                     /* CBA2R0: VA64 */
+	wr(cb, 0x10, (7u << 15) | 1u);          /* TCR2: SEP upstream, PASIZE 36 bit */
+	wr(cb, 0x30, 28u | (1u << 23));         /* TCR: T0SZ 28, TG0 4K, walks NC, EPD1 */
+	wr(cb, 0x38, 0x44u);                    /* MAIR0: attr0 normal non-cacheable */
+	wr(cb, 0x20, (uint32_t)pt);             /* TTBR0, ASID 0 */
+	wr(cb, 0x24, (uint32_t)(pt >> 32));
+	wr(cb, 0x58, 0xffffffffu);              /* FSR: clear */
+	wr(cb, 0x0, (1u << 5) | (1u << 2) | (1u << 1) | 1u);    /* CFRE AFE TRE M */
+	wr(smmu, 0x800, (1u << 31) | (0x7fffu << 16));          /* SMR0: any stream */
+	wr(smmu, 0xc00, 0);                     /* S2CR0: translate, context bank 0 */
+	wr(smmu, 0x68, 0);                      /* TLBIALLNSNH */
+	wr(smmu, 0x70, 0);                      /* sTLBGSYNC */
+	bool synced = poll(smmu, 0x74, 1u, 0, 10);
+	uint32_t smr = rd(smmu, 0x800), s2cr = rd(smmu, 0xc00), cbar = rd(gr1, 0x0);
+	uint32_t sctlr = rd(cb, 0x0), tcr = rd(cb, 0x30), ttbr = rd(cb, 0x20);
+	bool ok = synced && smr == ((1u << 31) | (0x7fffu << 16)) && (s2cr & 0x300ff) == 0 &&
+	    (cbar & (3u << 16)) == (1u << 16) && (sctlr & 0x27) == 0x27 && tcr == (28u | (1u << 23)) &&
+	    ttbr == (uint32_t)pt;
+	printf("SWEET GPU: SMMU identity %s: pt %llx SMR0 %08x S2CR0 %08x CBAR0 %08x SCTLR %08x TCR %08x TTBR0 %08x tlbsync %d\n",
+	    ok ? "ok" : "REJECTED", pt, smr, s2cr, cbar, sctlr, tcr, ttbr, synced);
+	return ok;
+}
+
+static void
+smmu_faults(vm_offset_t smmu, const char *when)
+{
+	vm_offset_t cb = smmu + 0x8000;
+	printf("SWEET GPU: %s SMMU sGFSR %08x CB0 FSR %08x FAR %08x%08x FSYNR0 %08x\n", when,
+	    rd(smmu, 0x48), rd(cb, 0x58), rd(cb, 0x64), rd(cb, 0x60), rd(cb, 0x68));
+}
