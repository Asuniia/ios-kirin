+/* num / den as IEEE single bits (truncated); |num| < 2^20, den > 0. */
+static uint32_t
+fbits(int64_t num, uint32_t den)
+{
+	if (num == 0) {
+		return 0;
+	}
+	uint32_t sign = num < 0 ? 0x80000000u : 0;
+	uint64_t q = ((uint64_t)(num < 0 ? -num : num) << 40) / den;
+	int t = 63 - __builtin_clzll(q);
+	uint64_t mant = t >= 23 ? q >> (t - 23) : q << (23 - t);
+	return sign | ((uint32_t)(t - 40 + 127) << 23) | ((uint32_t)mant & 0x7fffffu);
