+/*
+ * Panel buffers for the GPU present: 1080x1920 B,G,R,X, rows padded to 64
+ * bytes, in the lower RAM bank next to the bootloader's splash (0xc0001000;
+ * XNU only owns the upper bank, Linux has this as free RAM). The MDP fetches
+ * physical addresses below 4 GB, the GPU through its SMMU (identity there).
+ * Not mapped for the CPU (the kernel io map is 8 MB: a whole buffer
+ * panicked kmem_alloc, 0164a); the GPU clears each before its first use.
+ * From the first GPU frame on VIG0 is switched to 32 bpp (sweet_fbcon_flip):
+ * the kernel text console (24 bpp in the old buffer) no longer shows.
+ * Boot-arg sweetfb_gpu=0 keeps the CPU copy.
+ */
+#define SWEET_FB_GPU_PA0        0xc0800000ull
+#define SWEET_FB_GPU_PA1        0xc1000000ull
+#define SWEET_FB_GPU_SLOT       0x00800000ull
+
+bool
+AppleCLCD::gpuStart(void)
+{
+	int on = 1;
+	PE_parse_boot_argn("sweetfb_gpu", &on, sizeof(on));
+	fGpuStride = (fPanelW * 4 + 63) & ~63u;
+	uint64_t bytes = round_page((uint64_t)fGpuStride * fPanelH);
+	fGpuTest = on == 2;
+	if (!on || bytes > SWEET_FB_GPU_SLOT) {
+		return false;
+	}
+	uint32_t npages = (uint32_t)(bytes / PAGE_SIZE);
+	uint64_t *pa = (uint64_t *)IOMallocData(npages * sizeof(uint64_t));
+	if (pa == NULL) {
+		return false;
+	}
+	for (int b = 0; b < 2; b++) {
+		fGpuPa[b] = b ? SWEET_FB_GPU_PA1 : SWEET_FB_GPU_PA0;
+		for (uint32_t p = 0; p < npages; p++) {
+			pa[p] = fGpuPa[b] + (uint64_t)p * PAGE_SIZE;
+		}
+		fGpuVa[b] = sweet_gpu_vm_map(pa, npages, false);
+	}
+	IOFreeData(pa, npages * sizeof(uint64_t));
+	bool ok = fGpuVa[0] != 0 && fGpuVa[1] != 0;
+	IOLog("SWEET FB: GPU present %s (panel buffers 0x%llx 0x%llx, stride %u)\n",
+	    ok ? "on" : "FAILED", fGpuPa[0], fGpuPa[1], fGpuStride);
+	return ok;
+}
+
+/* GPU VA of a swap surface; up to 4 stay mapped (and retained), oldest out. */
+uint64_t
+AppleCLCD::gpuMap(SweetSurface *s)
+{
+	for (uint32_t i = 0; i < 4; i++) {
+		if (fGmap[i].s == s) {
+			return fGmap[i].va;
+		}
+	}
+	IOMemoryDescriptor *md = s->memory;
+	uint64_t size = md != NULL ? md->getLength() : 0;
+	if (size == 0 || (size & PAGE_MASK) || md->prepare() != kIOReturnSuccess) {
+		return 0;
+	}
+	uint32_t npages = (uint32_t)(size / PAGE_SIZE);
+	uint64_t *pa = (uint64_t *)IOMallocData(npages * sizeof(uint64_t));
+	bool ok = pa != NULL;
+	for (uint32_t p = 0; ok && p < npages; p++) {
+		IOByteCount seg = 0;
+		pa[p] = md->getPhysicalSegment((IOByteCount)p * PAGE_SIZE, &seg, kIOMemoryMapperNone);
+		ok = pa[p] != 0 && (pa[p] & PAGE_MASK) == 0 && seg >= PAGE_SIZE;
+	}
+	uint64_t va = ok ? sweet_gpu_vm_map(pa, npages, true) : 0;
+	if (pa != NULL) {
+		IOFreeData(pa, npages * sizeof(uint64_t));
+	}
+	if (va == 0) {
+		md->complete();
+		return 0;
+	}
+	uint32_t i = fGmapNext++ % 4;
+	if (fGmap[i].s != NULL) {
+		sweet_gpu_vm_unmap(fGmap[i].va);
+		fGmap[i].s->memory->complete();
+		fGmap[i].s->release();
+	}
+	s->retain();
+	fGmap[i].s = s;
+	fGmap[i].va = va;
+	return va;
+}
+
+/*
+ * Logical rect (dx,dy,w,h) of a BGRA source at (sx,sy) -> the panel pixels
+ * it covers in the back buffer, bilinear (the CPU path is nearest).
+ */
+bool
+AppleCLCD::gpuLayer(SweetSurface *s, int32_t sx, int32_t sy, int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	uint32_t lw = fWidth, lh = fHeight;
+	uint32_t x0 = ((uint32_t)dx * fPanelW + lw - 1) / lw;
+	uint32_t x1 = MIN(((uint32_t)(dx + w) * fPanelW + lw - 1) / lw, fPanelW);
+	uint32_t y0 = ((uint32_t)dy * fPanelH + lh - 1) / lh;
+	uint32_t y1 = MIN(((uint32_t)(dy + h) * fPanelH + lh - 1) / lh, fPanelH);
+	if (x0 >= x1 || y0 >= y1) {
+		return true;
+	}
+	if ((s->offset & 63) || (s->bytesPerRow & 63)) {
+		return false;
+	}
+	uint64_t va = gpuMap(s);
+	if (va == 0) {
+		return false;
+	}
+	struct sweet_gpu_quad q = {
+		.src_va = va + s->offset, .dst_va = fGpuVa[fGpuBack],
+		.src_w = s->width, .src_h = s->height, .src_pitch = s->bytesPerRow,
+		.dst_w = fPanelW, .dst_h = fPanelH, .dst_pitch = fGpuStride,
+		.x0 = x0, .y0 = y0, .w = x1 - x0, .h = y1 - y0,
+		/* u = (X + .5) lw / pw + sx - dx, v likewise */
+		.m = {fbits(lw, fPanelW), 0, 0, fbits(lh, fPanelH), fbits(sx - dx, 1), fbits(sy - dy, 1)},
+		.flags = SWEET_GPU_QUAD_COPY,
+		.color = {0x3f800000u, 0x3f800000u, 0x3f800000u, 0x3f800000u},
+		.src_fmt = SWEET_GPU_FMT_RGBA8,
+		.src_swiz = 0x688,      /* xyzw: bytes B, G, R, A as they are */
+	};
+	if (!fGpuClean[fGpuBack]) {
+		struct sweet_gpu_quad c = q;    /* the whole panel, colour 0 */
+		c.x0 = c.y0 = 0;
+		c.w = fPanelW;
+		c.h = fPanelH;
+		memset(c.color, 0, sizeof(c.color));
+		IOLog("SWEET FB: GPU clear of panel buffer %u (gva 0x%llx, src gva 0x%llx)\n", fGpuBack, c.dst_va, c.src_va);
+		IOSleep(100);           /* the line reaches pstore before a hard hang */
+		int rc = sweet_gpu_quad(&c);
+		IOLog("SWEET FB: GPU clear -> %d\n", rc);
+		if (rc != 0) {
+			return false;
+		}
+		fGpuClean[fGpuBack] = true;
+	}
+	return sweet_gpu_quad(&q) == 0;
+}
