+/* A kernel's binary in its own page; returns the PA (0 on failure). */
+static uint64_t
+kernel_page(const struct sweet_kernel *k)
+{
+	vm_offset_t va;
+	uint64_t pa = gpu_page(&va);
+	if (pa != 0 && k->size <= PAGE_SIZE) {
+		memcpy((void *)va, k->bin, k->size);
+		flush_dcache64((addr64_t)pa, PAGE_SIZE, TRUE);
+	}
+	return k->size <= PAGE_SIZE ? pa : 0;
+}
+
+/* CPU reference of blend.asm: premultiplied source-over, same rounding. */
+static uint32_t
+blend_ref(uint32_t src, uint32_t dst)
+{
+	uint32_t ia = 255 - (src >> 24), out = 0;
+	for (int sh = 0; sh < 32; sh += 8) {
+		uint32_t t = ((dst >> sh) & 0xff) * ia;
+		out |= (((t + 128 + (t >> 8)) >> 8) & 0xff) << sh;
+	}
+	return src + out;
+}
