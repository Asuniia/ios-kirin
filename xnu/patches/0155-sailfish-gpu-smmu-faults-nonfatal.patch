+/* VM lock held: log (rate-limited) and clear a recorded SMMU fault, with the mapping below it. */
+static void
+smmu_report(void)
+{
+	static uint32_t logged;
+	vm_offset_t cb = g_smmu + 0x8000;
+	uint32_t fsr = rd(cb, 0x58);
+	if (fsr == 0) {
+		return;
+	}
+	uint64_t far = ((uint64_t)rd(cb, 0x64) << 32) | rd(cb, 0x60);
+	if (logged < 32) {
+		logged++;
+		int64_t below = -1;
+		if (far >= GVA_BASE && far - GVA_BASE < (uint64_t)GVA_PAGES * PAGE_SIZE && g_owner != NULL) {
+			for (int64_t p = (int64_t)((far - GVA_BASE) / PAGE_SIZE); p >= 0 && below < 0; p--) {
+				uint32_t m = g_owner[p];
+				if (m != 0 && m != VM_GUARD) {
+					below = m;
+				}
+			}
+		}
+		printf("SWEET GPU: SMMU fault (non-fatal) FSR %08x FAR %llx FSYNR0 %08x; mapping below: %llx + %llx\n",
+		    fsr, far, rd(cb, 0x68), below >= 0 ? g_maps[below].va : 0,
+		    below >= 0 ? (uint64_t)g_maps[below].npages * PAGE_SIZE : 0);
+	}
+	wr(cb, 0x58, fsr);      /* write-1-to-clear */
+}
