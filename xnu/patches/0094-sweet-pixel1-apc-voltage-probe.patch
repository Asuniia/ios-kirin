+
+/*
+ * Read-only PMIC register access for other drivers (after sweet_keys_init),
+ * ppid = SID << 8 | peripheral. ponytail: maps the observer page on every
+ * call (io map space is small); fine for a few reads at boot, cache the
+ * mapping before polling.
+ */
+bool
+sweet_pmic_read(uint16_t ppid, uint8_t addr, uint8_t *out)
+{
+	static vm_offset_t obs;
+	static uint16_t obs_ppid = KEYS_NO_APID;
+	if (keys_core == 0 || keys_cnfg == 0) {
+		return false;
+	}
+	if (obs == 0 || obs_ppid != ppid) {
+		uint16_t apid = keys_find_apid(ppid);
+		if (apid == KEYS_NO_APID) {
+			return false;
+		}
+		obs = ml_io_map(KEYS_OBS_PA + 0x8000u * apid, 0x1000);
+		obs_ppid = ppid;
+	}
+	return obs != 0 && keys_obs_read(obs, addr, out);
+}
