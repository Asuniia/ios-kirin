+/* Row bytes for an explicit value (0: none) as above. */
+static uint32_t
+sweet_rows(uint32_t asked, uint32_t width, uint32_t ew, uint32_t bpe)
+{
+	char name[32];
+	if (asked == 0) {
+		return sweet_row_bytes(width, ew, bpe);
+	}
+	proc_selfname(name, sizeof(name));
+	return strcmp(name, "backboardd") == 0 ? sweet_row_align(asked) : asked;
+}
