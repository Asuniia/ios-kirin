+/*
+ * Profiler: boot-arg sweetprof=NAME (default backboardd, "-" = off).
+ * osfmk/arm64/sleh.c records the user pc of NAME at every interrupt that
+ * lands on one of its threads; every 20 s this prints the sample counts
+ * ("PROF ... samples N kernel K of all A", A = interrupts on any non-idle
+ * thread) and the 160 most frequent pcs, 8 per line ("PROF pc:count ...").
+ * Symbolicate with the slide from an SMP/UBT/CRASH line of the same boot.
+ */
+#define SWEET_PROF_MAX 65536
+extern int sweet_prof_pid;
+extern uint64_t sweet_prof_pc[SWEET_PROF_MAX];
+extern uint32_t sweet_prof_n, sweet_prof_kernel, sweet_prof_all;
+static char sweet_prof_name[32];
+static int sweet_prof_found;
+
+static int
+sweet_prof_find(proc_t p, __unused void *arg)
+{
+	char name[32];
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (strcmp(name, sweet_prof_name) == 0) {
+		sweet_prof_found = proc_pid(p);
+	}
+	return PROC_RETURNED;
+}
+
+static int
+sweet_prof_cmp(const void *a, const void *b)
+{
+	uint64_t x = *(const uint64_t *)a, y = *(const uint64_t *)b;
+	return x < y ? -1 : x > y;
+}
+
+static void
+sweet_prof_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	static uint64_t pcs[SWEET_PROF_MAX];
+	enum { TOP = 160 };
+	static uint64_t top_pc[TOP];
+	static uint32_t top_n[TOP];
+
+	if (!PE_parse_boot_argn("sweetprof", sweet_prof_name, sizeof(sweet_prof_name))) {
+		strlcpy(sweet_prof_name, "backboardd", sizeof(sweet_prof_name));
+	}
+	if (sweet_prof_name[0] == '-') {
+		return;
+	}
+	for (int round = 0;; round++) {
+		sweet_prof_found = 0;
+		proc_iterate(PROC_ALLPROCLIST, sweet_prof_find, NULL, NULL, NULL);
+		sweet_prof_pid = sweet_prof_found;
+		(void)tsleep(&chan, PZERO, "sweetprf", 20 * hz);
+		sweet_prof_pid = 0;
+		uint32_t n = MIN(sweet_prof_n, SWEET_PROF_MAX), k = sweet_prof_kernel, all = sweet_prof_all;
+		memcpy(pcs, sweet_prof_pc, n * sizeof(pcs[0]));
+		sweet_prof_n = sweet_prof_kernel = sweet_prof_all = 0;
+		if (sweet_prof_found == 0 || n == 0) {
+			continue;
+		}
+		qsort(pcs, n, sizeof(pcs[0]), sweet_prof_cmp);
+		int t = 0;
+		for (uint32_t i = 0; i < n;) {
+			uint32_t j = i;
+			while (j < n && pcs[j] == pcs[i]) {
+				j++;
+			}
+			uint32_t c = j - i;
+			int pos = t < TOP ? t++ : TOP;
+			while (pos > 0 && top_n[pos - 1] < c) {
+				if (pos < TOP) {
+					top_pc[pos] = top_pc[pos - 1];
+					top_n[pos] = top_n[pos - 1];
+				}
+				pos--;
+			}
+			if (pos < TOP) {
+				top_pc[pos] = pcs[i];
+				top_n[pos] = c;
+			}
+			i = j;
+		}
+		printf("PROF %s[%d] round %d samples %u kernel %u of all %u\n", sweet_prof_name,
+		    sweet_prof_found, round, n, k, all);
+		for (int i = 0; i < t; i += 8) {
+			char line[256];
+			int m = snprintf(line, sizeof(line), "PROF");
+			for (int j = i; j < i + 8 && j < t; j++) {
+				m += snprintf(line + m, sizeof(line) - m, " %llx:%u", top_pc[j], top_n[j]);
+			}
+			printf("%s\n", line);
+		}
+	}
+}
+
 void
 sweet_sample_start(void)
 {
 	thread_t thread;
+	if (kernel_thread_start(sweet_prof_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
 	if (kernel_thread_start(sweet_sample_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
