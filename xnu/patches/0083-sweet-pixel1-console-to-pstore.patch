-void
-sweet_early_putc(char c)
+/*
+ * Ring like Linux persistent_ram: start = next write position, size grows
+ * to the buffer size; Android unrolls it as data[start..size) + data[0..start).
+ */
+static void
+sweet_log_raw(char c)
 {
-	if (early_disabled) {
-		return;
-	}
 	if (PRZ_W(0) != PRZ_SIG) {      /* no shim record: start one */
 		PRZ_W(4) = 0;
 		PRZ_W(8) = 0;
 		PRZ_W(0) = PRZ_SIG;
 	}
-	uint32_t n = PRZ_W(8);
-	if (n >= PRZ_DATA_MAX) {
-		return;
+	uint32_t start = PRZ_W(4), size = PRZ_W(8);
+	if (start >= PRZ_DATA_MAX || size > PRZ_DATA_MAX) {     /* not ours: restart */
+		start = size = 0;
+	}
+	early_base[PRZ_OFF + 12 + start] = (uint8_t)c;
+	start = (start + 1) % PRZ_DATA_MAX;
+	if (size < PRZ_DATA_MAX) {
+		size++;
+	}
+	PRZ_W(4) = start;
+	PRZ_W(8) = size;
+}
+
+static unsigned int log_line_start = 1;
+
+/*
+ * Each line starts with "[sec.ms] " from the 19.2 MHz CNTVCT (since power-on).
+ * One instruction per asm statement: ';' starts a comment in Apple's assembler.
+ */
+void
+sweet_log_putc(char c)
+{
+	if (log_line_start && c != '\n') {
+		uint64_t t;
+		__asm__ volatile ("isb");
+		__asm__ volatile ("mrs %0, CNTVCT_EL0" : "=r"(t));
+		uint64_t ms = t / 19200, sec = ms / 1000;
+		char digits[20];
+		int nd = 0;
+		do {
+			digits[nd++] = (char)('0' + sec % 10);
+			sec /= 10;
+		} while (sec != 0 && nd < 20);
+		sweet_log_raw('[');
+		while (nd > 0) {
+			sweet_log_raw(digits[--nd]);
+		}
+		sweet_log_raw('.');
+		sweet_log_raw((char)('0' + ms % 1000 / 100));
+		sweet_log_raw((char)('0' + ms % 100 / 10));
+		sweet_log_raw((char)('0' + ms % 10));
+		sweet_log_raw(']');
+		sweet_log_raw(' ');
+	}
+	log_line_start = (c == '\n');
+	sweet_log_raw(c);
+}
+
+void
+sweet_early_putc(char c)
+{
+	if (!early_disabled) {
+		sweet_log_putc(c);
 	}
-	early_base[PRZ_OFF + 12 + n] = (uint8_t)c;
-	PRZ_W(4) = n + 1;
-	PRZ_W(8) = n + 1;
 }
 
