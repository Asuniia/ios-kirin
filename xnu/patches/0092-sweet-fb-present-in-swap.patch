 /* Copy each enabled layer's surface into the panel memory (no scaling). */
 /*
- * A swap only records the frame: copying 10 MB into the panel on every
- * swap (backboardd presents at 60 Hz) took the whole CPU. The vsync timer
- * shows the latest frame every fFlushTicks ticks (boot-arg sweetfb_hz,
- * default 10 Hz).
+ * Copy the frame into the panel inside the swap call, at most sweetfb_hz
+ * (default 30) times a second; the vsync timer shows a frame held back by
+ * that limit once the swaps pause. backboardd draws the next frame into its
+ * other buffer as soon as this call returns, so a copy made later from the
+ * timer while it keeps swapping tore the image (seen on the power-off blur).
+ * fPresentLock also makes the next swap wait for a timer copy in progress.
  */
 void
 AppleCLCD::swap(const uint8_t *rec)
 {
+	IOLockLock(fPresentLock);
 	IOLockLock(fLock);
 	memcpy(fPending, rec, SWEET_FB_SWAP_REC_SIZE);
 	fDirty = true;
 	sweet_fb_stat_swaps++;
 	IOLockUnlock(fLock);
+	if (mach_absolute_time() - fLastPresent >= fMinAbs) {
+		presentPending();
+	}
+	IOLockUnlock(fPresentLock);
 	if ((++sweet_fb_swap_count % 1000) == 0) {
 		IOLog("SWEET FB: %llu swaps\n", sweet_fb_swap_count);
 	}
 }
 
+/* fPresentLock held. */
 void
+AppleCLCD::presentPending(void)
+{
+	uint8_t rec[SWEET_FB_SWAP_REC_SIZE];
+	IOLockLock(fLock);
+	memcpy(rec, fPending, sizeof(rec));
+	fDirty = false;
+	IOLockUnlock(fLock);
+	uint64_t t0 = mach_absolute_time();
+	present(rec);
+	fLastPresent = mach_absolute_time();
+	sweet_fb_stat_present_abs += fLastPresent - t0;
+	sweet_fb_stat_presents++;
+}
