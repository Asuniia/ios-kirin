+/* Masked write; secure registers (0xf0+) get the SEC_ACCESS unlock first. */
+bool
+SweetBattery::secWrite(uint16_t address, uint8_t mask, uint8_t value)
+{
+	uint16_t ppid = (uint16_t)(0x200 | (address >> 8));
+	uint8_t old;
+	if (!reg(address, &old)) {
+		return false;
+	}
+	if ((address & 0xff) >= 0xf0 && !sweet_pmic_write(ppid, 0xd0, 0xa5)) {
+		return false;
+	}
+	return sweet_pmic_write(ppid, (uint8_t)address, (uint8_t)((old & ~mask) | (value & mask)));
+}
