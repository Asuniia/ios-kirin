+/*
+ * One-byte PMIC write (Linux pmic_arb v2 EXT_WRITEL on the APID's channel
+ * page: WDATA0 +0x10, CMD +0x00, STATUS +0x08). Only for peripherals owned
+ * by EE 0 (apps). Callers must never use it on RPM-owned regulators.
+ */
+bool
+sweet_pmic_write(uint16_t ppid, uint8_t addr, uint8_t val)
+{
+	static vm_offset_t ch[8];
+	static uint16_t ch_ppid[8];
+	static unsigned ch_n;
+	bool ok = false;
+	if (keys_core == 0 || keys_cnfg == 0) {
+		return false;
+	}
+	lck_mtx_lock(&sweet_pmic_lock);
+	unsigned i;
+	for (i = 0; i < ch_n && ch_ppid[i] != ppid; i++) {
+	}
+	if (i == ch_n && i < 8) {
+		uint16_t apid = keys_find_apid(ppid);
+		ch[i] = apid == KEYS_NO_APID || (keys_rd(keys_cnfg, 0x700u + 4u * apid) & 7u) != 0 ? 0 :
+		    ml_io_map(KEYS_CHNLS_PA + 0x8000u * apid, 0x1000);
+		if (ch[i] != 0) {
+			ch_ppid[i] = ppid;
+			ch_n++;
+		}
+	}
+	if (i < ch_n) {
+		vm_offset_t c = ch[i];
+		*(volatile uint32_t *)(c + 0x10) = val;
+		__asm__ volatile("dmb oshst" ::: "memory");
+		*(volatile uint32_t *)c = (uint32_t)addr << 4;	/* EXT_WRITEL, one byte */
+		__asm__ volatile("dsb osh" ::: "memory");
+		for (unsigned t = 0; t < 1000; ++t) {
+			uint32_t st = keys_rd(c, 0x08u);
+			if (st & 1u) {
+				ok = (st & 0x0eu) == 0;
+				break;
+			}
+			delay(1);
+		}
+	}
+	lck_mtx_unlock(&sweet_pmic_lock);
+	if (!ok) {
+		printf("SWEET PMIC: write ppid 0x%03x addr 0x%02x = 0x%02x failed\n", ppid, addr, val);
+	}
+	return ok;
+}
