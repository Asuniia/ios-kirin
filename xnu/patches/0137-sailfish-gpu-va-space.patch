+/*
+ * GPU VA window 8-16 GB: L1[8..15] -> L2 (512 x 2 MB) -> L3 (512 x 4 KB).
+ * L2/L3 tables are 4 KB, carved from 16 KB pages; L3 tables are allocated
+ * on first use of a 2 MB chunk and kept. A mapping takes whole chunks.
+ */
+#define GVA_BASE        0x200000000ull
+#define GVA_CHUNKS      4096u                   /* 8 GB / 2 MB */
+#define PTE_ATTRS       ((1u << 6) | (2u << 8) | (1u << 10))    /* AP[1], SH outer, AF; AttrIndx 0 */
+static LCK_GRP_DECLARE(sweet_gpu_grp, "sweet_gpu");
+static LCK_MTX_DECLARE(sweet_gpu_vm_lock, &sweet_gpu_grp);
+static vm_offset_t g_smmu;
+static uint64_t *g_l2[8];
+static uint64_t *g_l3[GVA_CHUNKS];
+static uint16_t g_chunk_len[GVA_CHUNKS];        /* run length at a mapping's first chunk */
+static uint8_t g_chunk_used[GVA_CHUNKS];
+
+/* A 4 KB table from the current 16 KB pool page; *pa gets its PA. */
+static uint64_t *
+pt4k(uint64_t *pa)
+{
+	static vm_offset_t pool_va;
+	static uint64_t pool_pa;
+	static unsigned pool_left;
+	if (pool_left == 0) {
+		pool_pa = gpu_page(&pool_va);
+		if (pool_pa == 0) {
+			return NULL;
+		}
+		pool_left = PAGE_SIZE / 4096;
+	}
+	unsigned i = PAGE_SIZE / 4096 - pool_left--;
+	*pa = pool_pa + i * 4096;
+	return (uint64_t *)(pool_va + i * 4096);
+}
+
+static void
+smmu_tlb_flush(void)
+{
+	wr(g_smmu, 0x68, 0);    /* TLBIALLNSNH */
+	wr(g_smmu, 0x70, 0);    /* sTLBGSYNC */
+	(void)poll(g_smmu, 0x74, 1u, 0, 10);
+}
+
+static bool
+vm_init(vm_offset_t smmu)
+{
+	g_smmu = smmu;
+	for (unsigned gb = 0; gb < 8; gb++) {
+		uint64_t pa;
+		g_l2[gb] = pt4k(&pa);
+		if (g_l2[gb] == NULL) {
+			return false;
+		}
+		g_l1[8 + gb] = pa | 3u;                 /* table */
+	}
+	flush_dcache64((addr64_t)g_l1_pa, 4096, TRUE);
+	smmu_tlb_flush();
+	return true;
+}
+
+/*
+ * Map npages kernel pages (16 KB each, physical addresses in pa[]) at a new
+ * GPU VA; returns it, or 0 if out of VA or table memory.
+ */
+uint64_t sweet_gpu_vm_map(const uint64_t *pa, uint32_t npages);
+uint64_t
+sweet_gpu_vm_map(const uint64_t *pa, uint32_t npages)
+{
+	uint64_t bytes = (uint64_t)npages * PAGE_SIZE;
+	uint32_t n = (uint32_t)((bytes + (2u << 20) - 1) >> 21), first = 0, run = 0;
+	if (g_l1 == NULL || n == 0 || n > GVA_CHUNKS) {
+		return 0;
+	}
+	lck_mtx_lock(&sweet_gpu_vm_lock);
+	for (uint32_t c = 0; c < GVA_CHUNKS && run < n; c++) {
+		run = g_chunk_used[c] ? 0 : run + 1;
+		first = c + 1 - run;
+	}
+	if (run < n) {
+		lck_mtx_unlock(&sweet_gpu_vm_lock);
+		return 0;
+	}
+	for (uint32_t c = first; c < first + n; c++) {
+		if (g_l3[c] == NULL) {
+			uint64_t l3pa;
+			g_l3[c] = pt4k(&l3pa);
+			if (g_l3[c] == NULL) {
+				lck_mtx_unlock(&sweet_gpu_vm_lock);
+				return 0;
+			}
+			uint64_t *l2 = g_l2[c / 512];
+			l2[c % 512] = l3pa | 3u;
+			flush_dcache64((addr64_t)&l2[c % 512], 8, FALSE);
 		}
+		g_chunk_used[c] = 1;
+	}
+	g_chunk_len[first] = (uint16_t)n;
+	uint32_t sub = PAGE_SIZE / 4096;
+	for (uint64_t i = 0; i < (uint64_t)npages * sub; i++) {
+		uint32_t c = first + (uint32_t)(i / 512);
+		g_l3[c][i % 512] = (pa[i / sub] + (i % sub) * 4096) | 3u | PTE_ATTRS;
+	}
+	for (uint32_t c = first; c < first + n; c++) {
+		flush_dcache64((addr64_t)g_l3[c], 4096, FALSE);
+	}
+	smmu_tlb_flush();
+	lck_mtx_unlock(&sweet_gpu_vm_lock);
+	return GVA_BASE + ((uint64_t)first << 21);
+}
+
+void sweet_gpu_vm_unmap(uint64_t va);
+void
+sweet_gpu_vm_unmap(uint64_t va)
+{
+	if (va < GVA_BASE || va >= GVA_BASE + ((uint64_t)GVA_CHUNKS << 21) || (va & ((2u << 20) - 1))) {
+		return;
+	}
+	uint32_t first = (uint32_t)((va - GVA_BASE) >> 21);
+	lck_mtx_lock(&sweet_gpu_vm_lock);
+	uint32_t n = g_chunk_used[first] ? g_chunk_len[first] : 0;
+	for (uint32_t c = first; c < first + n; c++) {
+		bzero(g_l3[c], 4096);
+		flush_dcache64((addr64_t)g_l3[c], 4096, FALSE);
+		g_chunk_used[c] = 0;
 	}
+	g_chunk_len[first] = 0;
+	if (n) {
+		smmu_tlb_flush();
+	}
+	lck_mtx_unlock(&sweet_gpu_vm_lock);
 }
 
