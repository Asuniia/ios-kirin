  */
+/* Kernel memory from kernel_memory_allocate (pages not contiguous), mapped at a GPU VA. */
+static uint64_t
+vm_buffer(vm_offset_t *va, uint32_t bytes)
+{
+	uint64_t pa[16];
+	uint32_t npages = (bytes + PAGE_SIZE - 1) / PAGE_SIZE;
+	if (npages > 16 || kmem_alloc(kernel_map, va, npages * PAGE_SIZE, KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return 0;
+	}
+	bool contiguous = true;
+	for (uint32_t i = 0; i < npages; i++) {
+		pa[i] = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)(*va + i * PAGE_SIZE)));
+		contiguous = contiguous && (i == 0 || pa[i] == pa[i - 1] + PAGE_SIZE);
+	}
+	uint64_t gva = sweet_gpu_vm_map(pa, npages);
+	printf("SWEET GPU: vm buffer %u pages (%s) pa[0] %llx pa[1] %llx -> GPU VA %llx\n", npages,
+	    contiguous ? "contiguous" : "scattered", pa[0], npages > 1 ? pa[1] : 0, gva);
+	return gva;
+}
