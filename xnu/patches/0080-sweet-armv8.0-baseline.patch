diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 69b13f9..43572d0 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -61,7 +61,9 @@ MACHINE_FLAGS_ARM64_T8103 = -DARM64_BOARD_CONFIG_T8103                  -mcpu=ap
 MACHINE_FLAGS_ARM64_T6000 = -DARM64_BOARD_CONFIG_T6000 		-mcpu=apple-a14
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a
 MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
-MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=armv8.2-a+crypto
+# Pixel 1 Kryo is ARMv8.0: no LSE atomics (ID_AA64ISAR0 Atomic=0), no PAN.
+# -mcpu, not -march: with -arch arm64 Apple clang keeps its Apple CPU features (LSE).
+MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -mcpu=kryo
 
 
 #
diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index b99c2f4..9eea047 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -33,7 +33,7 @@
 #define __ARM_DEBUG__             7
 #define __ARM_ENABLE_SWAP__       1
 #define __ARM_V8_CRYPTO_EXTENSIONS__ 1
-#define __ARM_PAN_AVAILABLE__     1
+/* no __ARM_PAN_AVAILABLE__: PAN is ARMv8.1, the Pixel 1 Kryo is v8.0 */
 #define __ARM_16K_PG__            1
 
 #define HAS_GIC_V3                1
diff --git a/osfmk/arm/commpage/commpage_asm.s b/osfmk/arm/commpage/commpage_asm.s
index da0bbba..f8a1f80 100644
--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -272,8 +272,12 @@ _pfz_trylock_and_enqueue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
-	// Try to grab the lock
-	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
+	// Try to grab the lock: LL/SC, the Pixel 1 Kryo (ARMv8.0) has no casa
+1:	ldaxr	w10, [x3]		 // acquire, like casa
+	cbnz	w10, 2f			 // held: fail
+	stxr	w12, w11, [x3]
+	cbnz	w12, 1b			 // lost the reservation: retry
+2:	clrex
 	cbz		w10, Ltrylock_enqueue_success
 
 	mov		x0, #-1			// Failed
@@ -323,7 +327,12 @@ _pfz_trylock_and_dequeue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
-	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
+	// LL/SC, the Pixel 1 Kryo (ARMv8.0) has no casa
+1:	ldaxr	w10, [x2]		 // acquire, like casa
+	cbnz	w10, 2f			 // held: fail
+	stxr	w12, w11, [x2]
+	cbnz	w12, 1b			 // lost the reservation: retry
+2:	clrex
 	cbz		w10, Ltrylock_dequeue_success
 
 	mov		x0, #-1			// Failed
