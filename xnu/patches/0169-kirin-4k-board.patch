  * without editing launchd.plist on the phone). Several NAME:... entries
  * are separated by ';'.
  */
+/*
+ * Boot-arg sweetnoexec=NAME,NAME,...: exec of an executable whose file name
+ * is in the list fails with EPERM (launchd then backs off). For daemons that
+ * spin on hardware this port does not have (health, widgets, accessory
+ * updates, ...) and keep the CPU busy. Each name is logged once.
+ */
+static int
+sweet_exec_denied(struct image_params *imgp)
+{
+	static char list[512];
+	static int state;       /* 0 not parsed, 1 none, 2 set */
+	static char logged[512];
+	if (state == 0) {
+		state = PE_parse_boot_argn("sweetnoexec", list, sizeof(list)) && list[0] ? 2 : 1;
+	}
+	if (state != 2) {
+		return 0;
+	}
+	const char *path = imgp->ip_strings + strlen("executable_path="), *base = path;
+	for (const char *c = path; *c; c++) {
+		if (*c == '/') {
+			base = c + 1;
+		}
+	}
+	size_t bl = strlen(base);
+	for (const char *e = list; *e;) {
+		size_t n = 0;
+		while (e[n] && e[n] != ',') {
+			n++;
+		}
+		if (n == bl && strncmp(e, base, n) == 0) {
+			size_t ll = strlen(logged);
+			if (ll + n + 2 < sizeof(logged) && strnstr(logged, base, sizeof(logged)) == NULL) {
+				strlcat(logged, base, sizeof(logged));
+				strlcat(logged, ",", sizeof(logged));
+				printf("SWEET NOEXEC: %s denied (sweetnoexec)\n", base);
+			}
+			return EPERM;
+		}
+		e += n;
+		if (*e == ',') {
+			e++;
+		}
+	}
+	return 0;
+}
+
