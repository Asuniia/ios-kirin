diff --git a/bsd/dev/sweet_adsp.c b/bsd/dev/sweet_adsp.c
new file mode 100644
index 0000000..68330e9
--- /dev/null
+++ b/bsd/dev/sweet_adsp.c
@@ -0,0 +1,189 @@
+/*
+ * kirin, boot-arg sweetadsp=1: the audio DSP (ADSP, the LPASS Hexagon) is
+ * loaded and started through TrustZone, as Linux's pil-tz-generic does it
+ * for DT qcom,lpass@15700000 (qcom,pas-id 1, firmware "adsp",
+ * memory-region adsp_fw_region@92a00000, 30 MB): the step before sound,
+ * microphone and sensors, which all live on it.
+ *
+ * The firmware comes in the boot payload as one blob, ADSP-FW
+ * (tools/mkadspfw.py): 'SADF', u32 segment count, u32 offset and length of
+ * the .mdt, then per program header u32 offset and length of its .bNN file
+ * (0 when there is none), then the files. As mainline qcom_mdt_load and
+ * qcom_scm_pas_*:
+ *   PAS_INIT_IMAGE    (SCM svc 2 cmd 1) pas id, the .mdt (ELF header,
+ *                     program headers, hash segment) in physically
+ *                     contiguous memory: TrustZone checks the signature
+ *   PAS_MEM_SETUP     (svc 2 cmd 2) pas id, region base, size
+ *   segments          every PT_LOAD that is not the hash segment, at its
+ *                     own physical address (this firmware is not
+ *                     relocatable: its segments span the region exactly),
+ *                     the part past filesz zeroed
+ *   PAS_AUTH_AND_RESET (svc 2 cmd 5) pas id: TrustZone authenticates the
+ *                     loaded image and releases the DSP from reset
+ * The region is outside the kernel's RAM: it is mapped whole, once,
+ * write-combined (ml_io_map_wcomb).
+ * Linux also votes the LPASS CX rail and XO through the RPM for the time of
+ * the boot (qcom,proxy-*); there is no RPM driver here yet: if the DSP needs
+ * them and the bootloader left them off, auth_and_reset will say so.
+ */
+#if defined(SWEET_KIRIN)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <arm/caches_internal.h>
+
+extern vm_map_address_t phystokv(uint64_t pa);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size);
+void sweet_adsp_init(void);
+
+#define ADSP_PAS_ID     1u
+#define ADSP_REGION     0x92a00000ull
+#define ADSP_REGION_SZ  0x01e00000ull
+
+/* Qualcomm SCM call, ARM SMCCC (as sweet_gpu.c's scm_call). */
+static int64_t
+adsp_scm(uint32_t svc, uint32_t cmd, uint32_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *r1)
+{
+	uint64_t fn = (1ull << 30) | (2ull << 24) | ((uint64_t)svc << 8) | cmd;
+	for (int busy = 0;; busy++) {
+		uint64_t a0 = fn, a6 = 0;
+		register uint64_t x0 __asm__("x0"), x1 __asm__("x1"), x2 __asm__("x2"), x3 __asm__("x3");
+		register uint64_t x4 __asm__("x4"), x5 __asm__("x5"), x6 __asm__("x6"), x7 __asm__("x7");
+		do {
+			x0 = a0; x1 = arginfo; x2 = a; x3 = b; x4 = c; x5 = 0; x6 = a6; x7 = 0;
+			__asm__ volatile("smc #0"
+			    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+			    :
+			    : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+			a0 = 1;
+			a6 = x6;
+		} while (x0 == 1);
+		if ((int64_t)x0 != -12 || busy >= 20) {
+			if (r1) {
+				*r1 = x1;
+			}
+			return (int64_t)x0;
+		}
+		delay(30000);
+	}
+}
+
+struct elf_phdr32 {
+	uint32_t type, offset, vaddr, paddr, filesz, memsz, flags, align;
+};
+
+
+static void
+adsp_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	DTEntry mm;
+	uint64_t const *v;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &mm) != kSuccess ||
+	    SecureDTGetProperty(mm, "ADSP-FW", (void const **)&v, &size) != kSuccess || size != 16) {
+		printf("SWEET ADSP: no ADSP-FW in the payload\n");
+		return;
+	}
+	/* the GLINK descriptor and our fifo are in SMEM before the DSP starts */
+	extern void sweet_glink_init(void);
+	sweet_glink_init();
+	extern void sweet_modem_init(void);
+	sweet_modem_init();
+	extern void kirin_bt_init(void);
+	kirin_bt_init();
+	const uint8_t *fw = (const uint8_t *)phystokv(v[0]);
+	uint64_t fwlen = v[1];
+	uint32_t nseg, mdt_off, mdt_len;
+	if (fwlen < 16 || memcmp(fw, "SADF", 4) != 0) {
+		printf("SWEET ADSP: ADSP-FW is not a SADF container\n");
+		return;
+	}
+	memcpy(&nseg, fw + 4, 4);
+	memcpy(&mdt_off, fw + 8, 4);
+	memcpy(&mdt_len, fw + 12, 4);
+	if (nseg > 64 || 16 + 8ull * nseg > fwlen || (uint64_t)mdt_off + mdt_len > fwlen || mdt_len < 0x34) {
+		printf("SWEET ADSP: ADSP-FW header out of range\n");
+		return;
+	}
+	const uint8_t *mdt = fw + mdt_off;
+	uint32_t phoff = *(const uint32_t *)(mdt + 0x1c);
+	uint16_t phnum = *(const uint16_t *)(mdt + 0x2c);
+	if (phnum != nseg || phoff + 32ull * phnum > mdt_len) {
+		printf("SWEET ADSP: %u program headers, %u segments in the container\n", phnum, nseg);
+		return;
+	}
+
+	/* the metadata, physically contiguous */
+	vm_offset_t meta_va = 0;
+	vm_size_t meta_sz = round_page(mdt_len);
+	if (kmem_alloc_contig(kernel_map, &meta_va, meta_sz, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET ADSP: no page for the %u-byte metadata\n", mdt_len);
+		return;
+	}
+	memcpy((void *)meta_va, mdt, mdt_len);
+	uint64_t meta = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)meta_va));
+	flush_dcache64((addr64_t)meta, (unsigned)meta_sz, TRUE);
+
+	uint64_t r1 = 0;
+	int64_t r = adsp_scm(2, 1, 2u | (2u << 6), ADSP_PAS_ID, meta, 0, &r1);
+	printf("SWEET ADSP: init_image (metadata %u bytes at %#llx) -> %lld/%#llx\n", mdt_len, meta, r, r1);
+	if (r != 0 || r1 != 0) {
+		return;
+	}
+	r = adsp_scm(2, 2, 3, ADSP_PAS_ID, ADSP_REGION, ADSP_REGION_SZ, &r1);
+	printf("SWEET ADSP: mem_setup %#llx + %#llx -> %lld/%#llx\n", ADSP_REGION, ADSP_REGION_SZ, r, r1);
+	if (r != 0 || r1 != 0) {
+		return;
+	}
+
+	uint8_t *region = (uint8_t *)ml_io_map_wcomb(ADSP_REGION, ADSP_REGION_SZ);
+	if (!region) {
+		printf("SWEET ADSP: the region cannot be mapped\n");
+		return;
+	}
+	unsigned loaded = 0;
+	for (uint32_t i = 0; i < phnum; i++) {
+		const struct elf_phdr32 *ph = (const struct elf_phdr32 *)(mdt + phoff + 32 * i);
+		if (ph->type != 1 || ((ph->flags >> 24) & 7) == 2 || ph->memsz == 0) {
+			continue;
+		}
+		uint32_t off, len;
+		memcpy(&off, fw + 16 + 8 * i, 4);
+		memcpy(&len, fw + 20 + 8 * i, 4);
+		if (ph->paddr < ADSP_REGION || ph->paddr + (uint64_t)ph->memsz > ADSP_REGION + ADSP_REGION_SZ ||
+		    ph->filesz > ph->memsz || len < ph->filesz || (uint64_t)off + len > fwlen) {
+			printf("SWEET ADSP: segment %u (%#x + %#x, file %u) does not fit, stop\n", i, ph->paddr, ph->memsz, len);
+			return;
+		}
+		memcpy(region + (ph->paddr - ADSP_REGION), fw + off, ph->filesz);
+		bzero(region + (ph->paddr - ADSP_REGION) + ph->filesz, ph->memsz - ph->filesz);
+		loaded++;
+	}
+	__builtin_arm_dsb(0xf);
+	printf("SWEET ADSP: %u segments loaded into %#llx\n", loaded, ADSP_REGION);
+	r = adsp_scm(2, 5, 1, ADSP_PAS_ID, 0, 0, &r1);
+	printf("SWEET ADSP: auth_and_reset -> %lld/%#llx%s\n", r, r1,
+	    r == 0 && r1 == 0 ? ": THE ADSP IS RUNNING" : "");
+}
+
+void
+sweet_adsp_init(void)
+{
+	int on = 0;
+	thread_t t;
+	if (!PE_parse_boot_argn("sweetadsp", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	if (kernel_thread_start(adsp_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
+#endif /* SWEET_KIRIN */
diff --git a/bsd/dev/sweet_audio.c b/bsd/dev/sweet_audio.c
new file mode 100644
index 0000000..4d95d46
--- /dev/null
+++ b/bsd/dev/sweet_audio.c
@@ -0,0 +1,225 @@
+/*
+ * kirin: the devices iOS's audio plug-in writes to (tools/sweetaudio, after
+ * HackiOS's RedwoodAudio.driver, APSL 2.0): mediaserverd gets from it the
+ * iPhone X's "Speaker" and "Actuator" (Taptic Engine) devices.
+ *
+ *   /dev/sweet-audio   stereo 16-bit 48 kHz frames of what iOS plays, handed
+ *                      to the ADSP (bsd/dev/sweet_q6audio.c; dropped until it
+ *                      plays). ioctl SWEET_AUDIO_SET_VOLUME accepted.
+ *   /dev/sweet-haptic  the Taptic Engine's waveform (one channel, 16-bit,
+ *                      48 kHz). There is no waveform playback on this phone's
+ *                      motor (PM660 haptics, ERM, direct mode): while a write
+ *                      is louder than HAPTIC_ON (peak sample) the motor runs,
+ *                      and it stops HAPTIC_TAIL_MS after the last loud write,
+ *                      or after HAPTIC_MAX_MS of running, then rests for as
+ *                      long as it ran.
+ * Writes never block (the audio server's real-time thread): the motor's PMIC
+ * writes are done by a kernel thread the writes wake.
+ */
+#if defined(SWEET_KIRIN)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/uio.h>
+#include <sys/errno.h>
+#include <sys/ioccom.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <mach/mach_time.h>
+#include <pexpert/pexpert.h>
+
+extern bool sweet_haptic_set(bool on);
+void sweet_audio_init(void);
+
+struct sweet_audio_volume {
+	uint32_t below;
+	uint32_t muted;
+};
+#define SWEET_AUDIO_SET_VOLUME  _IOW('r', 1, struct sweet_audio_volume)
+
+#define HAPTIC_ON               2000    /* peak sample that runs the motor */
+#define HAPTIC_TAIL_MS          30
+#define HAPTIC_MAX_MS           1500
+
+static volatile uint64_t haptic_last_loud;     /* mach_absolute_time of the last loud write */
+static int haptic_chan;
+
+static int
+sa_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+sa_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+audio_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	static uint64_t frames;
+	extern void sweet_q6audio_play(const uint8_t *pcm, uint32_t len);
+	uint8_t buf[1024];
+	int error = 0;
+	if (frames == 0) {
+		printf("SWEET AUDIO: first sound from iOS\n");
+	}
+	frames += (uint64_t)uio_resid(uio) / 4;
+	while (uio_resid(uio) > 0) {
+		int n = (int)MIN(uio_resid(uio), (user_ssize_t)sizeof(buf));
+		if ((error = uiomove((caddr_t)buf, n, uio)) != 0) {
+			break;
+		}
+		sweet_q6audio_play(buf, (uint32_t)n);
+	}
+	return error;
+}
+
+/*
+ * /dev/sweet-mic: the phone's microphone, read by iOS's audio plug-in while its
+ * input runs (sweetaudio codec_read). Opening it starts the ADSP capture
+ * (sweet_q6audio.c), closing it stops it. A read never blocks: it gives the
+ * captured mono 16-bit 48 kHz samples that have come, and no more.
+ */
+static int
+mic_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	extern void sweet_q6audio_capture_start(void);
+	sweet_q6audio_capture_start();
+	return 0;
+}
+
+static int
+mic_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	extern void sweet_q6audio_capture_stop(void);
+	sweet_q6audio_capture_stop();
+	return 0;
+}
+
+static int
+mic_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	extern uint32_t sweet_q6audio_capture_read(uint8_t *out, uint32_t len);
+	uint8_t buf[2048];
+	int error = 0;
+	while (uio_resid(uio) > 0) {
+		uint32_t want = (uint32_t)MIN(uio_resid(uio), (user_ssize_t)sizeof(buf));
+		uint32_t got = sweet_q6audio_capture_read(buf, want);
+		if (got == 0) {
+			break;          /* non-blocking: nothing more is buffered */
+		}
+		if ((error = uiomove((caddr_t)buf, (int)got, uio)) != 0) {
+			break;
+		}
+	}
+	return error;
+}
+
+static int
+audio_ioctl(__unused dev_t dev, u_long command, caddr_t data, __unused int flags, __unused struct proc *p)
+{
+	if (command != SWEET_AUDIO_SET_VOLUME) {
+		return ENOTTY;
+	}
+	const struct sweet_audio_volume *v = (const struct sweet_audio_volume *)data;
+	printf("SWEET AUDIO: volume %s%u.%03u dB under the loudest\n", v->muted ? "muted, " : "",
+	    v->below / 8, v->below % 8 * 125);
+	return 0;
+}
+
+static int
+haptic_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int16_t buf[256];
+	int peak = 0, error = 0;
+	while (uio_resid(uio) >= 2) {
+		user_ssize_t n = MIN(uio_resid(uio), (user_ssize_t)sizeof(buf));
+		n -= n % 2;
+		if ((error = uiomove((caddr_t)buf, (int)n, uio)) != 0) {
+			break;
+		}
+		for (int i = 0; i < n / 2; i++) {
+			int a = buf[i] < 0 ? -buf[i] : buf[i];
+			peak = a > peak ? a : peak;
+		}
+	}
+	if (peak >= HAPTIC_ON) {
+		haptic_last_loud = mach_absolute_time();
+		thread_wakeup(&haptic_chan);
+	}
+	return error;
+}
+
+static uint64_t
+ms_abs(unsigned ms)
+{
+	uint64_t abs;
+	nanoseconds_to_absolutetime((uint64_t)ms * NSEC_PER_MSEC, &abs);
+	return abs;
+}
+
+static void
+haptic_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	bool on = false;
+	uint64_t since = 0, rest_until = 0;
+	unsigned plays = 0;
+	for (;;) {
+		uint64_t deadline;
+		clock_interval_to_deadline(on ? 5 : 1000, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&haptic_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+		uint64_t now = mach_absolute_time(), loud = haptic_last_loud;
+		bool active = loud != 0 && now - loud < ms_abs(HAPTIC_TAIL_MS);
+		if (!on && active && now >= rest_until) {
+			on = sweet_haptic_set(true);
+			since = now;
+			if (plays++ < 10) {
+				printf("SWEET HAPTIC: motor on (%s)\n", on ? "ok" : "FAILED");
+			}
+		} else if (on && (!active || now - since > ms_abs(HAPTIC_MAX_MS))) {
+			(void)sweet_haptic_set(false);
+			on = false;
+			rest_until = now + (now - since > ms_abs(HAPTIC_MAX_MS) ? now - since : 0);
+		}
+	}
+}
+
+static const struct cdevsw audio_cdevsw = {
+	.d_open = sa_open, .d_close = sa_close, .d_read = eno_rdwrt, .d_write = audio_write,
+	.d_ioctl = audio_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+static const struct cdevsw haptic_cdevsw = {
+	.d_open = sa_open, .d_close = sa_close, .d_read = eno_rdwrt, .d_write = haptic_write,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+static const struct cdevsw mic_cdevsw = {
+	.d_open = mic_open, .d_close = mic_close, .d_read = mic_read, .d_write = eno_rdwrt,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+void
+sweet_audio_init(void)
+{
+	int a = cdevsw_add(-1, &audio_cdevsw), h = cdevsw_add(-1, &haptic_cdevsw), m = cdevsw_add(-1, &mic_cdevsw);
+	bool ok = a >= 0 && h >= 0 && m >= 0 &&
+	    devfs_make_node(makedev(a, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "sweet-audio") != NULL &&
+	    devfs_make_node(makedev(h, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "sweet-haptic") != NULL &&
+	    devfs_make_node(makedev(m, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "sweet-mic") != NULL;
+	thread_t t;
+	if (ok && kernel_thread_start(haptic_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+	printf("SWEET AUDIO: /dev/sweet-audio, /dev/sweet-haptic and /dev/sweet-mic %s\n", ok ? "ready" : "NOT created");
+}
+#endif /* SWEET_KIRIN */
diff --git a/bsd/dev/sweet_bt_hci.c b/bsd/dev/sweet_bt_hci.c
new file mode 100644
index 0000000..17ee0ff
--- /dev/null
+++ b/bsd/dev/sweet_bt_hci.c
@@ -0,0 +1,760 @@
+/*
+ * Poco F1 (beryllium) Bluetooth HCI transport for iOS userland.
+ *
+ * What bluetoothd (BT_HCI_TRANSPORT=H4BC:POSIX:com.apple.uart.bluetooth,3000000) and BlueTool
+ * open on A11: a PF_SYSTEM / SYSPROTO_CONTROL SOCK_STREAM socket on the kernel control
+ * "com.apple.uart.bluetooth", read and written as a plain H4 byte stream, termios through
+ * get/setsockopt(SYSPROTO_CONTROL, TIOCGETA = 0x40487413 / TIOCSETA = 0x80487414, struct termios).
+ * docs/BT_IOS_TRANSPORT.md has the evidence.
+ *
+ * The chip side lives in bsd/dev/beryllium_wlan.c (power, firmware, UART, in-band sleep). It hands
+ * this file complete, IBS-free H4 packets (bt_hci_rx_packet) and takes complete H4 packets to
+ * transmit (struct bt_hci_ops.tx); this file owns the 64 KiB RX ring, the kctl and the termios
+ * answers. Off by default: only registered by the BT stage when boot-arg sweetbt=1 and the
+ * controller came up (sweetwlan=2).
+ *
+ * Lock order: the UART lock (beryllium_wlan.c) is taken before bt.lock; nothing here calls into
+ * the socket layer with either held (ctl_enqueuedata is called with neither).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/kern_control.h>
+#include <sys/kpi_mbuf.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <libkern/libkern.h>
+#include <machine/atomic.h>
+#include <pexpert/pexpert.h>
+
+struct bt_hci_ops {
+	bool (*tx)(const uint8_t *pkt, unsigned len);   /* one complete H4 packet to the UART (wakes the controller) */
+	unsigned (*baud)(unsigned requested);           /* termios speed request: returns the speed in effect */
+};
+
+void bt_hci_register(const struct bt_hci_ops *ops, unsigned sk_alias, unsigned log_budget);
+void bt_hci_rx_packet(const uint8_t *pkt, unsigned len);
+void bt_hci_rx_service(void);
+void bt_hci_stats_periodic(bool force);
+bool bt_hci_connected(void);
+
+#define BT_CTL_NAME     "com.apple.uart.bluetooth"
+#define BT_CTL_NAME_SK  "com.apple.uart.sk.bluetooth"
+#define BT_RING_SIZE    65536u          /* RX ring: 218 ms of a saturated 3 Mbaud line */
+#define BT_RING_MASK    (BT_RING_SIZE - 1)
+#define BT_STAGE_SIZE   4096u           /* bytes per ctl_enqueuedata */
+#define BT_PKT_MAX      4100u           /* 1 + 4 + 4095: enough for ACL (1021 classic / 251 LE) and events */
+#define BT_CTL_RECV     (128u * 1024)
+#define BT_CTL_SEND     (64u * 1024)
+
+#define BT_TIOCGETA     0x40487413u     /* _IOR('t', 19, struct termios), what bluetoothd/BlueTool pass as the option name */
+#define BT_TIOCSETA     0x80487414u     /* _IOW('t', 20, ...) */
+#define BT_TIOCSETAW    0x80487415u
+#define BT_TIOCSETAF    0x80487416u
+#define BT_CRTSCTS      0x30000ul       /* CCTS_OFLOW | CRTS_IFLOW */
+
+/* Darwin LP64 struct termios (72 bytes): tcflag_t / speed_t are unsigned long */
+struct bt_termios {
+	unsigned long c_iflag, c_oflag, c_cflag, c_lflag;
+	unsigned char c_cc[20];
+	unsigned long c_ispeed, c_ospeed;
+};
+_Static_assert(sizeof(struct bt_termios) == 72, "struct termios size");
+
+static LCK_GRP_DECLARE(bt_grp, "sweet_bt_hci");
+static LCK_MTX_DECLARE(bt_lock, &bt_grp);
+
+static struct {
+	const struct bt_hci_ops *ops;
+	kern_ctl_ref ref[2];
+	unsigned nref;
+	bool up;                        /* ctl registered */
+	bool connected;
+	kern_ctl_ref conn_ref;
+	uint32_t conn_unit;
+	unsigned epoch;                 /* bumped on connect: a flush that raced a reset must not advance rd */
+	uint32_t rd, wr;                /* free-running ring counters */
+	unsigned log_budget;
+	/* TX framer (userland writes are a byte stream; the UART gets whole packets) */
+	uint8_t txb[BT_PKT_MAX];
+	unsigned txn, txtotal;
+	struct bt_termios tio;
+	/* statistics */
+	unsigned ring_peak, rx_pkts, rx_drop_pkts, rx_drop_nc, enq_fail, enq_ok;
+	uint64_t rx_bytes, tx_bytes;
+	unsigned tx_pkts, tx_fail, tx_garbage, tios_get, tios_set, baud_req_ignored;
+	unsigned connects;
+	unsigned last_rx_pkts, last_tx_pkts;
+	unsigned compat, compat_fixed, compat_local, err_budget;       /* sweetbtcompat; rewritten / kernel-answered commands */
+} bt;
+
+static uint8_t bt_ring[BT_RING_SIZE];
+static uint8_t bt_stage[BT_STAGE_SIZE];         /* only the single consumer (RX thread) uses it */
+
+/* ------------------------------------------------------------ logging */
+
+static const char *
+bt_h4_name(uint8_t t)
+{
+	switch (t) {
+	case 1:  return "cmd";
+	case 2:  return "acl";
+	case 3:  return "sco";
+	case 4:  return "evt";
+	case 5:  return "iso";
+	default: return "???";
+	}
+}
+
+static void
+bt_log_pkt(const char *dir, const uint8_t *p, unsigned n)
+{
+	char hex[3 * 16 + 1];
+	unsigned o = 0, i;
+
+	if (bt.log_budget == 0) {
+		return;
+	}
+	bt.log_budget--;
+	for (i = 0; i < n && i < 16; i++) {
+		o += (unsigned)snprintf(hex + o, sizeof(hex) - o, "%02x ", p[i]);
+	}
+	if (p[0] == 1 && n >= 4) {
+		printf("SWEET BT: %s cmd opcode %#06x plen %u (%u bytes): %s\n", dir, p[1] | (p[2] << 8), p[3], n, hex);
+	} else if (p[0] == 4 && n >= 3) {
+		printf("SWEET BT: %s evt %#04x plen %u (%u bytes): %s\n", dir, p[1], p[2], n, hex);
+	} else {
+		printf("SWEET BT: %s %s (%u bytes): %s\n", dir, bt_h4_name(p[0]), n, hex);
+	}
+}
+
+/* ------------------------------------------------------------ RX: UART -> ring -> socket */
+
+bool
+bt_hci_connected(void)
+{
+	return os_atomic_load(&bt.connected, relaxed);
+}
+
+/*
+ * bluetoothd's HCI init (OI stack) treats any failed command as fatal ("HCI initialization
+ * failed"; with 0238+0239 v2 a SIGABRT in Stack_Init). The WCN3990 answers Command Complete with
+ * status 0x01 (Unknown HCI Command) to commands Apple's Broadcom controllers know: the Broadcom
+ * vendor commands of bluetoothd's bcm_vsc.c (0xfce2, 0xfce9, 0xfd47, 0xfd48 on boot
+ * combo2-0240b-bt0239v2). sweetbtcompat=1 turns such an answer into success for standard
+ * commands (OGF != 0x3f), =2 (default) also for vendor commands: the reply then has no return
+ * parameters, which bcm_vsc.c's sub-opcode checker accepts (it returns true on an empty reply);
+ * a read that needs its parameters still fails in bluetoothd and shows up in the log. Every rewrite and every other non-zero status is logged (own budget), so the
+ * next missing command shows up even after the packet trace budget is spent.
+ */
+#define BT_COMPAT_PAD   16u             /* parameter bytes in a rewritten Command Complete */
+
+/* First parameter byte of the last few commands sent, by opcode (for rewritten replies). */
+static struct { uint16_t op; uint8_t p0; } bt_last_cmd[8];
+static unsigned bt_last_cmd_next;
+
+static void
+bt_cmd_note(const uint8_t *cmd, unsigned len)
+{
+	const unsigned n = sizeof(bt_last_cmd) / sizeof(bt_last_cmd[0]);
+	unsigned op, i;
+
+	if (len < 4 || cmd[0] != 1) {
+		return;
+	}
+	op = cmd[1] | (cmd[2] << 8);
+	for (i = 0; i < n && bt_last_cmd[i].op != op; i++) {
+	}
+	if (i == n) {                   /* one slot per opcode: the newest command wins */
+		i = bt_last_cmd_next++ % n;
+	}
+	bt_last_cmd[i].op = (uint16_t)op;
+	bt_last_cmd[i].p0 = cmd[3] != 0 && len >= 5 ? cmd[4] : 0;
+}
+
+static unsigned
+bt_cmd_param0(unsigned op)
+{
+	for (unsigned i = 0; i < sizeof(bt_last_cmd) / sizeof(bt_last_cmd[0]); i++) {
+		if (bt_last_cmd[i].op == op) {
+			return bt_last_cmd[i].p0;
+		}
+	}
+	return 0;
+}
+
+/*
+ * Command watchdog. Boot combo6-0244-bt0239v4: the WCN3990 never answered 0xfce9 sub-opcode 1
+ * (Broadcom LE Meta Enable Features, while it answers the other 0xfce9 sub-opcodes with 0x01), and
+ * bluetoothd gave up: "BD_VSC_LE_META_ENA_FEATURES timedout waiting for controller", "Notifying BT
+ * Firmware Crashed", restart reason 3602. A command sent to the controller that gets neither Command
+ * Complete nor Command Status within BT_CMD_WATCHDOG_MS is answered here like a rewritten one
+ * (success, first parameter byte + zeros). Only one command is tracked (bluetoothd keeps one in
+ * flight: Num_HCI_Command_Packets 1); a late real answer just arrives as an extra event.
+ */
+#define BT_CMD_WATCHDOG_MS      800u
+
+static struct {
+	uint16_t op;
+	uint8_t p0;
+	bool on;
+	uint64_t t;             /* mach_absolute_time of the transmit */
+} bt_pend;
+static unsigned bt_watchdog_fired;
+
+static void
+bt_pend_set(const uint8_t *cmd, unsigned len)
+{
+	if (len >= 4 && cmd[0] == 1) {
+		bt_pend.op = (uint16_t)(cmd[1] | (cmd[2] << 8));
+		bt_pend.p0 = cmd[3] != 0 && len >= 5 ? cmd[4] : 0;
+		bt_pend.t = mach_absolute_time();
+		os_atomic_store(&bt_pend.on, true, release);
+	}
+}
+
+static void
+bt_pend_answered(const uint8_t *p, unsigned len)
+{
+	unsigned op;
+
+	if (len < 7 || p[0] != 4 || !os_atomic_load(&bt_pend.on, acquire)) {
+		return;
+	}
+	if (p[1] == 0x0e) {
+		op = p[4] | (p[5] << 8);
+	} else if (p[1] == 0x0f) {
+		op = p[5] | (p[6] << 8);
+	} else {
+		return;
+	}
+	if (op == bt_pend.op) {
+		os_atomic_store(&bt_pend.on, false, relaxed);
+	}
+}
+
+static void
+bt_pend_check(void)
+{
+	uint64_t ns;
+	uint8_t ev[7 + 16];
+	unsigned i;
+
+	if (!bt.compat || !os_atomic_load(&bt_pend.on, acquire)) {
+		return;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - bt_pend.t, &ns);
+	if (ns < (uint64_t)BT_CMD_WATCHDOG_MS * 1000000ull) {
+		return;
+	}
+	os_atomic_store(&bt_pend.on, false, relaxed);
+	ev[0] = 4;
+	ev[1] = 0x0e;
+	ev[2] = 4 + 16;
+	ev[3] = 1;
+	ev[4] = (uint8_t)bt_pend.op;
+	ev[5] = (uint8_t)(bt_pend.op >> 8);
+	ev[6] = 0;
+	ev[7] = bt_pend.p0;
+	for (i = 8; i < sizeof(ev); i++) {
+		ev[i] = 0;
+	}
+	bt_watchdog_fired++;
+	printf("SWEET BT: compat: opcode %#06x (OGF %#x OCF %#05x, first parameter %#04x) not answered by the controller "
+	    "within %u ms, answered as success by the kernel (%u so far)\n", bt_pend.op, bt_pend.op >> 10,
+	    bt_pend.op & 0x3ff, bt_pend.p0, BT_CMD_WATCHDOG_MS, bt_watchdog_fired);
+	bt_hci_rx_packet(ev, sizeof(ev));
+}
+
+/*
+ * Commands bluetoothd's init sends unconditionally and fails on when the controller does not list
+ * them (Read Local Supported Commands): { opcode, octet, bit } of the supported-commands mask. They
+ * are answered here with success and never reach the WCN3990. Boot 2026-10-24 combo-0240b-bt0239:
+ * mask octet 18 = 0x83, so bit 3 (Write Default Erroneous Data Reporting) was clear and the OI stack
+ * failed locally: "OI_HCICMD_WriteDefaultErroneousDataReporting (status=628)", "HCI initialization
+ * failed", restart reason 108, without sending the command.
+ */
+static const struct { uint16_t op; uint8_t octet, bit; } bt_local_cmds[] = {
+	{ 0x0c5b, 18, 3 },      /* Write Default Erroneous Data Reporting */
+};
+
+static bool
+bt_hci_local_answer(const uint8_t *cmd, unsigned len)
+{
+	unsigned op, i;
+	uint8_t ev[7];
+
+	if (!bt.compat || len < 4 || cmd[0] != 1) {
+		return false;
+	}
+	op = cmd[1] | (cmd[2] << 8);
+	for (i = 0; i < sizeof(bt_local_cmds) / sizeof(bt_local_cmds[0]); i++) {
+		if (bt_local_cmds[i].op == op) {
+			break;
+		}
+	}
+	if (i == sizeof(bt_local_cmds) / sizeof(bt_local_cmds[0])) {
+		return false;
+	}
+	ev[0] = 4;
+	ev[1] = 0x0e;                   /* Command Complete */
+	ev[2] = 4;
+	ev[3] = 1;                      /* Num_HCI_Command_Packets */
+	ev[4] = cmd[1];
+	ev[5] = cmd[2];
+	ev[6] = 0;                      /* success */
+	bt.compat_local++;
+	printf("SWEET BT: compat: opcode %#06x answered by the kernel (not sent to the controller, %u so far)\n",
+	    op, bt.compat_local);
+	bt_hci_rx_packet(ev, sizeof(ev));
+	return true;
+}
+
+static unsigned
+bt_hci_compat(uint8_t *p, unsigned len)
+{
+	unsigned op, st;
+
+	if (len < 7 || p[0] != 4) {
+		return len;
+	}
+	if (p[1] == 0x0e) {                     /* Command Complete: 04 0e plen ncmd op op status */
+		op = p[4] | (p[5] << 8);
+		st = p[6];
+	} else if (p[1] == 0x0f) {              /* Command Status: 04 0f plen status ncmd op op */
+		op = p[5] | (p[6] << 8);
+		st = p[3];
+	} else {
+		return len;
+	}
+	if (st == 0) {
+		if (bt.compat && p[1] == 0x0e && op == 0x1002 && len >= 7 + 64) {
+			/* Read Local Supported Commands: list the commands answered by bt_hci_local_answer */
+			for (unsigned i = 0; i < sizeof(bt_local_cmds) / sizeof(bt_local_cmds[0]); i++) {
+				uint8_t *b = &p[7 + bt_local_cmds[i].octet];
+				uint8_t was = *b;
+
+				*b |= (uint8_t)(1u << bt_local_cmds[i].bit);
+				printf("SWEET BT: compat: supported commands octet %u %#04x -> %#04x (opcode %#06x)\n",
+				    bt_local_cmds[i].octet, was, *b, bt_local_cmds[i].op);
+			}
+		}
+		return len;
+	}
+	if (bt.compat && p[1] == 0x0e && st == 0x0c &&
+	    (op == 0x2006 || op == 0x2007 || op == 0x200a || op == 0x200b || op == 0x200c)) {
+		/*
+		 * Command Disallowed for an LE command that changes or reads state the controller is busy
+		 * with: Set Advertising Parameters / Read Advertising Channel Tx Power / Set Advertising
+		 * Enable / Set Scan Parameters / Set Scan Enable while advertising or scanning. Apple's
+		 * Broadcom firmware accepts these; the WCN3990 follows the spec. Boot combo8: bluetoothd
+		 * sets new scan parameters while its first passive scan runs, gets 0x0c, logs "Could not
+		 * start LE scan (leScanParamsLPCoreCb): STATUS 712" and restarts (reason 712). Answered as
+		 * success, return parameters (if any) kept as they are: the running scan or advertising
+		 * simply keeps its previous parameters.
+		 */
+		p[6] = 0;
+		bt.compat_fixed++;
+		printf("SWEET BT: compat: LE opcode %#06x Command Disallowed by the controller, answered as success (%u so far)\n",
+		    op, bt.compat_fixed);
+		return len;
+	}
+	if (bt.compat && p[1] == 0x0e && len == 7 && op != 0 &&
+	    st == 0x01 && ((op >> 10) != 0x3f || bt.compat >= 2)) {
+		/*
+		 * Success instead of Unknown HCI Command (0x01), or Command Disallowed (0x0c) for LE Read
+		 * Advertising Physical Channel Tx Power. bluetoothd's reply parsers read return
+		 * parameters on success: bcm_vsc.c's sub-opcode checker compares the first byte with the
+		 * command's sub-opcode (its first parameter), _BCM_CreateMultiAdvInstParser (0xfd48) reads a
+		 * 1-byte instance, LE 0x2007 a 1-byte Tx power; the generic status-only parser ignores the
+		 * rest. So the reply carries the command's first parameter byte followed by zeros
+		 * (BT_COMPAT_PAD bytes in all). Boot combo5-0243-bt0239v3: an empty success for 0xfd48
+		 * tripped "ByteStream_NumReadBytesAvail(*pBs) >= 1" (abort in bcm_vsc.c:827).
+		 */
+		/*
+		 * The sub-opcode byte must be the one of the command this answers: bcm_vsc.c matches
+		 * 0xfce9/0xfd23 replies to their pending command by it. Combo7: an older 0xfce9 entry gave
+		 * 0x32 instead of 0x01 for LE Meta Enable Features, its completion never ran and
+		 * bluetoothd restarted after 15 s ("timedout waiting for controller", reason 3602).
+		 */
+		unsigned i, p0 = op == bt_pend.op ? bt_pend.p0 : bt_cmd_param0(op);
+
+		p[2] = 4 + BT_COMPAT_PAD;
+		p[6] = 0;
+		p[7] = (uint8_t)p0;
+		for (i = 1; i < BT_COMPAT_PAD; i++) {
+			p[7 + i] = 0;
+		}
+		bt.compat_fixed++;
+		printf("SWEET BT: compat: opcode %#06x (OGF %#x OCF %#05x) status %#04x from the controller, answered as success "
+		    "with %u parameter bytes (first %#04x) (%u so far)\n", op, op >> 10, op & 0x3ff, st, BT_COMPAT_PAD, p0,
+		    bt.compat_fixed);
+		return 7 + BT_COMPAT_PAD;
+	}
+	if (bt.err_budget) {
+		bt.err_budget--;
+		printf("SWEET BT: %s for opcode %#06x (OGF %#x OCF %#05x): status %#04x\n",
+		    p[1] == 0x0e ? "Command Complete" : "Command Status", op, op >> 10, op & 0x3ff, st);
+	}
+	return len;
+}
+
+/* Called by the UART RX path (under the UART lock) with one complete, IBS-free H4 packet. */
+void
+bt_hci_rx_packet(const uint8_t *pkt, unsigned len)
+{
+	uint8_t ev[3 + 255];
+	unsigned used, i;
+
+	if (!os_atomic_load(&bt.connected, relaxed)) {
+		bt.rx_drop_nc++;
+		return;
+	}
+	if (pkt[0] == 4 && len >= 7 && len <= 3 + 255 && (pkt[1] == 0x0e || pkt[1] == 0x0f)) {
+		bt_pend_answered(pkt, len);
+		/* Command Complete / Status: bt_hci_compat may rewrite it (and make it longer) */
+		for (i = 0; i < len; i++) {
+			ev[i] = pkt[i];
+		}
+		len = bt_hci_compat(ev, len);
+		pkt = ev;
+	}
+	lck_mtx_lock(&bt_lock);
+	used = bt.wr - bt.rd;
+	if (BT_RING_SIZE - used < len) {
+		bt.rx_drop_pkts++;              /* whole packets only: the H4 framing must survive */
+		lck_mtx_unlock(&bt_lock);
+		return;
+	}
+	for (i = 0; i < len; i++) {
+		bt_ring[(bt.wr + i) & BT_RING_MASK] = pkt[i];
+	}
+	bt.wr += len;
+	if (used + len > bt.ring_peak) {
+		bt.ring_peak = used + len;
+	}
+	bt.rx_pkts++;
+	bt.rx_bytes += len;
+	bt_log_pkt("RX", pkt, len);
+	lck_mtx_unlock(&bt_lock);
+}
+
+/*
+ * Called by the RX thread every iteration, without the UART lock. Moves ring bytes into the
+ * socket. A full socket buffer (userland slow) is plain flow control: the bytes stay in the
+ * ring and the next call retries; if the ring itself fills, whole packets are dropped above.
+ */
+void
+bt_hci_rx_service(void)
+{
+	bt_pend_check();
+	for (unsigned loops = 0; loops < 16; loops++) {
+		kern_ctl_ref ref;
+		uint32_t unit, rd;
+		unsigned n, ep, i;
+		errno_t err;
+
+		lck_mtx_lock(&bt_lock);
+		if (!bt.connected) {
+			lck_mtx_unlock(&bt_lock);
+			return;
+		}
+		ref = bt.conn_ref;
+		unit = bt.conn_unit;
+		ep = bt.epoch;
+		rd = bt.rd;
+		n = bt.wr - rd;
+		if (n > BT_STAGE_SIZE) {
+			n = BT_STAGE_SIZE;
+		}
+		for (i = 0; i < n; i++) {
+			bt_stage[i] = bt_ring[(rd + i) & BT_RING_MASK];
+		}
+		lck_mtx_unlock(&bt_lock);
+		if (n == 0) {
+			return;
+		}
+		err = ctl_enqueuedata(ref, unit, bt_stage, n, 0);
+		if (err != 0) {
+			bt.enq_fail++;          /* ENOBUFS: socket buffer full, retry next round */
+			return;
+		}
+		bt.enq_ok++;
+		lck_mtx_lock(&bt_lock);
+		if (bt.epoch == ep) {
+			bt.rd = rd + n;
+		}
+		lck_mtx_unlock(&bt_lock);
+	}
+}
+
+/* ------------------------------------------------------------ TX: socket -> H4 framer -> UART */
+
+static unsigned
+bt_tx_hdrlen(uint8_t type)
+{
+	switch (type) {
+	case 1:  return 3;      /* opcode, plen */
+	case 2:  return 4;      /* handle, dlen16 */
+	case 3:  return 3;      /* handle, dlen8 */
+	case 5:  return 4;      /* handle, dlen14 */
+	default: return 0;
+	}
+}
+
+static unsigned
+bt_tx_paylen(const uint8_t *p)
+{
+	switch (p[0]) {
+	case 1:  return p[3];
+	case 2:  return p[3] | (p[4] << 8);
+	case 3:  return p[3];
+	default: return (p[3] | (p[4] << 8)) & 0x3fff;
+	}
+}
+
+static void
+bt_tx_feed(const uint8_t *p, size_t n)
+{
+	for (size_t i = 0; i < n; i++) {
+		uint8_t b = p[i];
+
+		if (bt.txn == 0) {
+			if (bt_tx_hdrlen(b) == 0) {
+				if (bt.tx_garbage++ < 8) {
+					printf("SWEET BT: TX: byte %#04x is not an H4 packet type, dropped\n", b);
+				}
+				continue;
+			}
+			bt.txtotal = 0;
+		}
+		bt.txb[bt.txn++] = b;
+		if (bt.txtotal == 0 && bt.txn == 1 + bt_tx_hdrlen(bt.txb[0])) {
+			bt.txtotal = bt.txn + bt_tx_paylen(bt.txb);
+			if (bt.txtotal > sizeof(bt.txb)) {
+				printf("SWEET BT: TX: %s packet of %u bytes does not fit, dropped\n", bt_h4_name(bt.txb[0]),
+				    bt.txtotal);
+				bt.txn = bt.txtotal = 0;
+				continue;
+			}
+		}
+		if (bt.txtotal != 0 && bt.txn == bt.txtotal) {
+			bt_log_pkt("TX", bt.txb, bt.txn);
+			bt_cmd_note(bt.txb, bt.txn);
+			if (bt_hci_local_answer(bt.txb, bt.txn)) {
+				bt.tx_pkts++;
+			} else if ((bt_pend_set(bt.txb, bt.txn), bt.ops->tx(bt.txb, bt.txn))) {
+				bt.tx_pkts++;
+				bt.tx_bytes += bt.txn;
+			} else {
+				bt.tx_fail++;
+				printf("SWEET BT: TX: UART transmit of a %s packet (%u bytes) failed\n",
+				    bt_h4_name(bt.txb[0]), bt.txn);
+			}
+			bt.txn = bt.txtotal = 0;
+		}
+	}
+}
+
+static errno_t
+bt_ctl_send(kern_ctl_ref ref, u_int32_t unit, void *unitinfo, mbuf_t m, int flags)
+{
+#pragma unused(ref, unit, unitinfo, flags)
+	mbuf_t seg;
+
+	for (seg = m; seg != NULL; seg = mbuf_next(seg)) {
+		size_t len = mbuf_len(seg);
+		if (len != 0) {
+			bt_tx_feed((const uint8_t *)mbuf_data(seg), len);
+		}
+	}
+	mbuf_freem(m);
+	return 0;
+}
+
+/* ------------------------------------------------------------ connect / disconnect / termios */
+
+static errno_t
+bt_ctl_connect(kern_ctl_ref ref, struct sockaddr_ctl *sac, void **unitinfo)
+{
+	lck_mtx_lock(&bt_lock);
+	if (bt.connected) {
+		lck_mtx_unlock(&bt_lock);
+		printf("SWEET BT: connect refused: already connected (unit %u)\n", bt.conn_unit);
+		return EBUSY;
+	}
+	bt.connected = true;
+	bt.conn_ref = ref;
+	bt.conn_unit = sac->sc_unit;
+	bt.rd = bt.wr = 0;
+	bt.epoch++;
+	bt.txn = bt.txtotal = 0;
+	bt.connects++;
+	lck_mtx_unlock(&bt_lock);
+	*unitinfo = &bt;
+	printf("SWEET BT: client connected (ctl id %u unit %u)\n", sac->sc_id, sac->sc_unit);
+	return 0;
+}
+
+static errno_t
+bt_ctl_disconnect(kern_ctl_ref ref, u_int32_t unit, void *unitinfo)
+{
+#pragma unused(ref, unitinfo)
+	lck_mtx_lock(&bt_lock);
+	if (bt.connected && bt.conn_unit == unit) {
+		bt.connected = false;
+		bt.rd = bt.wr = 0;
+		bt.epoch++;
+		bt.txn = bt.txtotal = 0;
+	}
+	lck_mtx_unlock(&bt_lock);
+	printf("SWEET BT: client disconnected (unit %u)\n", unit);
+	bt_hci_stats_periodic(true);
+	return 0;
+}
+
+static errno_t
+bt_ctl_setopt(kern_ctl_ref ref, u_int32_t unit, void *unitinfo, int opt, void *data, size_t len)
+{
+#pragma unused(ref, unit, unitinfo)
+	switch ((unsigned)opt) {
+	case BT_TIOCSETA:
+	case BT_TIOCSETAW:
+	case BT_TIOCSETAF: {
+		struct bt_termios t;
+		unsigned actual;
+
+		if (data == NULL || len != sizeof(t)) {
+			return EINVAL;
+		}
+		memcpy(&t, data, sizeof(t));
+		bt.tios_set++;
+		/*
+		 * The controller's speed was fixed by the vendor baud command during the firmware
+		 * step (3 Mbaud, HW flow control). Accept whatever userland asks for, keep the line as
+		 * it is and answer with the speed really in effect (the get returns it too).
+		 */
+		actual = bt.ops->baud((unsigned)t.c_ospeed);
+		if (t.c_ospeed != actual && bt.baud_req_ignored++ < 8) {
+			printf("SWEET BT: termios set: requested %lu baud, line stays at %u\n", t.c_ospeed, actual);
+		}
+		if (!(t.c_cflag & BT_CRTSCTS) && bt.baud_req_ignored < 8) {
+			printf("SWEET BT: termios set: hardware flow control off requested, kept on\n");
+		}
+		if (bt.tios_set <= 4) {
+			printf("SWEET BT: termios set (opt %#x): iflag %#lx oflag %#lx cflag %#lx lflag %#lx speed %lu/%lu\n",
+			    (unsigned)opt, t.c_iflag, t.c_oflag, t.c_cflag, t.c_lflag, t.c_ispeed, t.c_ospeed);
+		}
+		t.c_ispeed = t.c_ospeed = actual;
+		t.c_cflag |= BT_CRTSCTS;
+		bt.tio = t;
+		return 0;
+	}
+	default:
+		return ENOTSUP;
+	}
+}
+
+static errno_t
+bt_ctl_getopt(kern_ctl_ref ref, u_int32_t unit, void *unitinfo, int opt, void *data, size_t *len)
+{
+#pragma unused(ref, unit, unitinfo)
+	if ((unsigned)opt != BT_TIOCGETA) {
+		return ENOTSUP;
+	}
+	if (data == NULL) {
+		*len = sizeof(bt.tio);
+		return 0;
+	}
+	if (*len < sizeof(bt.tio)) {
+		return EINVAL;
+	}
+	bt.tio.c_ispeed = bt.tio.c_ospeed = bt.ops->baud(0);
+	bt.tio.c_cflag |= BT_CRTSCTS;
+	memcpy(data, &bt.tio, sizeof(bt.tio));
+	*len = sizeof(bt.tio);
+	if (bt.tios_get++ < 4) {
+		printf("SWEET BT: termios get: speed %lu cflag %#lx\n", bt.tio.c_ospeed, bt.tio.c_cflag);
+	}
+	return 0;
+}
+
+/* ------------------------------------------------------------ statistics */
+
+void
+bt_hci_stats_periodic(bool force)
+{
+	if (!bt.up) {
+		return;
+	}
+	if (!force && bt.last_rx_pkts == bt.rx_pkts && bt.last_tx_pkts == bt.tx_pkts) {
+		return;
+	}
+	bt.last_rx_pkts = bt.rx_pkts;
+	bt.last_tx_pkts = bt.tx_pkts;
+	printf("SWEET BT: HCI: rx %u pkts / %llu B (ring peak %u of %u B, dropped %u pkts full + %u not connected, "
+	    "socket full %u of %u enqueues), tx %u pkts / %llu B (%u failed, %u garbage), connects %u\n",
+	    bt.rx_pkts, bt.rx_bytes, bt.ring_peak, BT_RING_SIZE, bt.rx_drop_pkts, bt.rx_drop_nc, bt.enq_fail,
+	    bt.enq_fail + bt.enq_ok, bt.tx_pkts, bt.tx_bytes, bt.tx_fail, bt.tx_garbage, bt.connects);
+}
+
+/* ------------------------------------------------------------ registration */
+
+static errno_t
+bt_reg_one(const char *name, kern_ctl_ref *out)
+{
+	struct kern_ctl_reg r;
+
+	bzero(&r, sizeof(r));
+	strlcpy(r.ctl_name, name, sizeof(r.ctl_name));
+	r.ctl_flags = CTL_FLAG_REG_SOCK_STREAM;         /* not privileged: bluetoothd and BlueTool run as mobile */
+	r.ctl_sendsize = BT_CTL_SEND;
+	r.ctl_recvsize = BT_CTL_RECV;
+	r.ctl_connect = bt_ctl_connect;
+	r.ctl_disconnect = bt_ctl_disconnect;
+	r.ctl_send = bt_ctl_send;
+	r.ctl_setopt = bt_ctl_setopt;
+	r.ctl_getopt = bt_ctl_getopt;
+	return ctl_register(&r, out);
+}
+
+void
+bt_hci_register(const struct bt_hci_ops *ops, unsigned sk_alias, unsigned log_budget)
+{
+	errno_t err;
+
+	if (bt.up) {
+		return;
+	}
+	bt.ops = ops;
+	bt.log_budget = log_budget;
+	bt.compat = 2;
+	bt.err_budget = 64;
+	(void)PE_parse_boot_argn("sweetbtcompat", &bt.compat, sizeof(bt.compat));
+	printf("SWEET BT: compat %u (unknown commands answered as success: %s)\n", bt.compat,
+	    bt.compat >= 2 ? "standard and Broadcom vendor" : bt.compat ? "standard only" : "off");
+	/* raw mode as bluetoothd would set it (cfmakeraw, 8N1, hw flow control); the speed is filled in on get */
+	bt.tio.c_cflag = 0x38B00ul;
+	bt.tio.c_ispeed = bt.tio.c_ospeed = ops->baud(0);
+	err = bt_reg_one(BT_CTL_NAME, &bt.ref[0]);
+	printf("SWEET BT: kernel control %s registered: %d\n", BT_CTL_NAME, (int)err);
+	if (err != 0) {
+		return;
+	}
+	bt.nref = 1;
+	bt.up = true;
+	if (sk_alias) {
+		/*
+		 * Same stream under the Skywalk name. bluetoothd would still need the IOAOSSKY* socket
+		 * options for it (not implemented), so this is only useful for plain-socket clients.
+		 */
+		err = bt_reg_one(BT_CTL_NAME_SK, &bt.ref[1]);
+		printf("SWEET BT: kernel control %s registered: %d\n", BT_CTL_NAME_SK, (int)err);
+		if (err == 0) {
+			bt.nref = 2;
+		}
+	}
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_glink.c b/bsd/dev/sweet_glink.c
new file mode 100644
index 0000000..41d1987
--- /dev/null
+++ b/bsd/dev/sweet_glink.c
@@ -0,0 +1,948 @@
+/*
+ * kirin: talking to the ADSP once it runs (bsd/dev/sweet_adsp.c), as
+ * Linux 4.19's qcom_smem + qcom_glink_smem + qcom_glink_native do it for DT
+ * /soc/qcom,glink/adsp (remote pid 2, mailbox APCS 0x17911000 bit 9):
+ *
+ *   SMEM      0x86000000 (2 MB, reserved smem-mem): partition table "$TOC" in
+ *             its last 4 KB, the APPS<->ADSP partition "$PRT" (hosts 0, 2);
+ *             items are allocated under TCSR mutex 3 (0x1f40000 + 3 * 0x1000)
+ *   GLINK     item 478: 32-byte descriptor (tx tail, tx head, rx tail, rx
+ *             head), 479: our 16 KB tx fifo, 480: the ADSP's (it allocates
+ *             it); 8-byte aligned commands (VERSION, OPEN, OPEN_ACK, INTENT,
+ *             TX_DATA, RX_DONE...), a kick through the APCS IPC register
+ *             after each write. There is no interrupt here: a thread polls
+ *             the rx fifo (1 ms while busy, 4 ms idle).
+ *   channels  apr_audio_svc: APR, the audio services (CORE, AFE, ASM, ADM);
+ *             IPCRTR: QRTR, the QMI services (sensors among them).
+ *
+ * This file only brings the link up and says what is on the other side:
+ * the ADSP's audio core state (AVCS_CMD_ADSP_EVENT_GET_STATE) and every QMI
+ * service the ADSP announces (QRTR NEW_SERVER: service, instance, node,
+ * port). sweet_glink_apr_send/sweet_glink_apr_handler and
+ * sweet_glink_qrtr_send are for the audio and sensor clients.
+ */
+#if defined(SWEET_KIRIN)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+#include <kern/kalloc.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size);
+void sweet_glink_init(void);
+int sweet_glink_apr_send(const void *pkt, uint32_t len);
+void (*sweet_glink_apr_handler)(const uint8_t *pkt, uint32_t len);
+int sweet_glink_qrtr_send(const void *pkt, uint32_t len);
+void (*sweet_glink_qrtr_handler)(const uint8_t *pkt, uint32_t len);
+bool sweet_glink_up(void);
+
+#define SMEM_PA         0x86000000ull
+#define SMEM_SZ         0x00200000u
+#define TCSR_MUTEX_PA   (0x01f40000ull + 3 * 0x1000)
+#define APCS_IPC_PA     0x17911000ull
+#define APCS_IPC_OFF    0x8
+#define ADSP_IPC_BIT    (1u << 9)
+#define ADSP_PID        2
+#define ITEM_DESC       478
+#define ITEM_TX_FIFO    479
+#define ITEM_RX_FIFO    480
+#define TX_FIFO_SZ      16384u
+
+#define CMD_VERSION             0
+#define CMD_VERSION_ACK         1
+#define CMD_OPEN                2
+#define CMD_CLOSE               3
+#define CMD_OPEN_ACK            4
+#define CMD_INTENT              5
+#define CMD_RX_DONE             6
+#define CMD_RX_INTENT_REQ       7
+#define CMD_RX_INTENT_REQ_ACK   8
+#define CMD_TX_DATA             9
+#define CMD_CLOSE_ACK           11
+#define CMD_TX_DATA_CONT        12
+#define CMD_READ_NOTIF          13
+#define CMD_RX_DONE_W_REUSE     14
+#define CMD_SIGNALS             15
+
+struct ptable_entry {
+	uint32_t offset, size, flags;
+	uint16_t host0, host1;
+	uint32_t cacheline, reserved[7];
+} __attribute__((packed));
+
+struct part_header {
+	uint8_t magic[4];
+	uint16_t host0, host1;
+	uint32_t size, offset_free_uncached, offset_free_cached, reserved[3];
+} __attribute__((packed));
+
+struct private_entry {
+	uint16_t canary, item;
+	uint32_t size;
+	uint16_t padding_data, padding_hdr;
+	uint32_t reserved;
+} __attribute__((packed));
+
+/* our receive buffers (intents) and the ADSP's, per channel */
+#define NLOCAL  24
+#define NREMOTE 32
+struct gchan {
+	const char *name;
+	uint16_t lcid, rcid;
+	bool open_sent, open_acked, remote_open, intents_sent;
+	struct { uint32_t id, size; uint8_t *buf; uint32_t off; } local[NLOCAL];
+	uint32_t nlocal;
+	struct { uint32_t id, size; bool used; } remote[NREMOTE];
+	void (**handler)(const uint8_t *, uint32_t);
+	uint32_t isize[NLOCAL];
+};
+
+static struct {
+	volatile uint8_t *smem, *mutex, *apcs;
+	volatile uint8_t *part;
+	uint32_t part_size;
+	volatile uint32_t *desc;        /* tx tail, tx head, rx tail, rx head */
+	volatile uint8_t *txf, *rxf;
+	uint32_t txlen, rxlen;
+	bool version_done, up;
+	uint32_t next_liid;
+	struct gchan ch[2];
+	lck_mtx_t *tx_lock;
+	int sleep_chan;
+} g;
+
+static LCK_GRP_DECLARE(sweet_glink_grp, "sweet_glink");
+static LCK_MTX_DECLARE(sweet_glink_tx_lock, &sweet_glink_grp);
+
+static void
+g_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&g.sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* ---- SMEM ---- */
+
+static bool
+hwlock(void)
+{
+	for (int i = 0; i < 1000; i++) {
+		*(volatile uint32_t *)g.mutex = 1;      /* QCOM_MUTEX_APPS_PROC_ID */
+		__builtin_arm_dsb(0xf);
+		if (*(volatile uint32_t *)g.mutex == 1) {
+			return true;
+		}
+		delay(10);
+	}
+	return false;
+}
+
+static void
+hwunlock(void)
+{
+	__builtin_arm_dsb(0xf);
+	*(volatile uint32_t *)g.mutex = 0;
+	__builtin_arm_dsb(0xf);
+}
+
+static bool
+smem_find_partition(void)
+{
+	volatile uint8_t *pt = g.smem + SMEM_SZ - 4096;
+	if (memcmp((const void *)pt, "$TOC", 4) != 0) {
+		printf("SWEET GLINK: no SMEM partition table (%02x %02x %02x %02x)\n", pt[0], pt[1], pt[2], pt[3]);
+		return false;
+	}
+	uint32_t n = *(volatile uint32_t *)(pt + 8);
+	for (uint32_t i = 0; i < n && i < 32; i++) {
+		volatile struct ptable_entry *e = (volatile struct ptable_entry *)(pt + 32 + i * sizeof(struct ptable_entry));
+		if (((e->host0 == 0 && e->host1 == ADSP_PID) || (e->host0 == ADSP_PID && e->host1 == 0)) &&
+		    e->offset && e->size && e->offset + (uint64_t)e->size <= SMEM_SZ) {
+			g.part = g.smem + e->offset;
+			g.part_size = e->size;
+			if (memcmp((const void *)g.part, "$PRT", 4) != 0) {
+				printf("SWEET GLINK: APPS/ADSP partition without its magic\n");
+				return false;
+			}
+			printf("SWEET GLINK: SMEM partition APPS/ADSP at +%#x, %u KB\n", e->offset, e->size >> 10);
+			return true;
+		}
+	}
+	printf("SWEET GLINK: no APPS/ADSP partition among %u\n", n);
+	return false;
+}
+
+static volatile uint8_t *smem_get_in(volatile uint8_t *part, uint32_t part_size, uint16_t item, uint32_t *size);
+
+static volatile uint8_t *
+smem_get(uint16_t item, uint32_t *size)
+{
+	return smem_get_in(g.part, g.part_size, item, size);
+}
+
+/*
+ * A global item: in the legacy table of the SMEM header (toc at +0xd0: allocated, offset,
+ * size, aux_base) or in the global partition (hosts 0xfffe), as Linux's qcom_smem_get.
+ * Its text (up to len - 1 bytes) for the audio side's diagnostics: item 423 is the
+ * reason the LPASS (the ADSP) gives when it goes down.
+ */
+bool sweet_glink_smem_string(uint16_t item, char *out, uint32_t len);
+
+bool
+sweet_glink_smem_string(uint16_t item, char *out, uint32_t len)
+{
+	volatile uint8_t *p = NULL;
+	uint32_t size = 0;
+	if (g.smem == NULL || len == 0) {
+		return false;
+	}
+	volatile uint32_t *toc = (volatile uint32_t *)(g.smem + 0xd0 + 16 * (uint32_t)item);
+	if (item < 512 && toc[0] == 1 && toc[1] + (uint64_t)toc[2] <= SMEM_SZ && toc[2] > 0) {
+		p = g.smem + toc[1];
+		size = toc[2];
+	} else {
+		volatile uint8_t *pt = g.smem + SMEM_SZ - 4096;
+		uint32_t n = memcmp((const void *)pt, "$TOC", 4) == 0 ? *(volatile uint32_t *)(pt + 8) : 0;
+		for (uint32_t i = 0; i < n && i < 32 && p == NULL; i++) {
+			volatile struct ptable_entry *e = (volatile struct ptable_entry *)(pt + 32 + i * sizeof(struct ptable_entry));
+			if (e->host0 == 0xfffe && e->host1 == 0xfffe && e->offset && e->offset + (uint64_t)e->size <= SMEM_SZ) {
+				p = smem_get_in(g.smem + e->offset, e->size, item, &size);
+			}
+		}
+	}
+	if (p == NULL) {
+		return false;
+	}
+	uint32_t k = 0;
+	for (; k + 1 < len && k < size && p[k] != 0; k++) {
+		out[k] = (char)p[k];
+	}
+	out[k] = 0;
+	return true;
+}
+
+static volatile uint8_t *
+smem_get_in(volatile uint8_t *part, uint32_t part_size, uint16_t item, uint32_t *size)
+{
+	volatile struct part_header *ph = (volatile struct part_header *)part;
+	if (part == NULL) {
+		return NULL;
+	}
+	uint32_t end = ph->offset_free_uncached;
+	uint32_t off = sizeof(struct part_header);
+	if (end > part_size) {
+		return NULL;
+	}
+	while (off + sizeof(struct private_entry) <= end) {
+		volatile struct private_entry *e = (volatile struct private_entry *)(part + off);
+		if (e->canary != 0xa5a5) {
+			printf("SWEET GLINK: SMEM bad canary at +%#x\n", off);
+			return NULL;
+		}
+		uint32_t next = off + sizeof(struct private_entry) + e->padding_hdr + e->size;
+		if (e->item == item) {
+			if (size) {
+				*size = e->size - e->padding_data;
+			}
+			return part + off + sizeof(struct private_entry) + e->padding_hdr;
+		}
+		if (next <= off) {
+			return NULL;
+		}
+		off = next;
+	}
+	return NULL;
+}
+
+static volatile uint8_t *
+smem_alloc(uint16_t item, uint32_t size, uint32_t *got)
+{
+	volatile uint8_t *p = smem_get(item, got);
+	if (p) {
+		return p;
+	}
+	if (!hwlock()) {
+		printf("SWEET GLINK: TCSR mutex 3 stays taken\n");
+		return NULL;
+	}
+	volatile struct part_header *ph = (volatile struct part_header *)g.part;
+	uint32_t off = ph->offset_free_uncached;
+	uint32_t asz = (uint32_t)sizeof(struct private_entry) + ((size + 7) & ~7u);
+	if (off + asz > ph->offset_free_cached) {
+		hwunlock();
+		printf("SWEET GLINK: SMEM partition full for item %u\n", item);
+		return NULL;
+	}
+	volatile struct private_entry *e = (volatile struct private_entry *)(g.part + off);
+	e->canary = 0xa5a5;
+	e->item = item;
+	e->size = (size + 7) & ~7u;
+	e->padding_data = (uint16_t)(e->size - size);
+	e->padding_hdr = 0;
+	e->reserved = 0;
+	__builtin_arm_dsb(0xf);
+	ph->offset_free_uncached = off + asz;
+	hwunlock();
+	return smem_get(item, got);
+}
+
+/* ---- fifos ---- */
+
+static uint32_t
+rx_avail(void)
+{
+	if (!g.rxf) {
+		uint32_t len = 0;
+		volatile uint8_t *f = smem_get(ITEM_RX_FIFO, &len);
+		if (!f) {
+			return 0;
+		}
+		g.rxf = f;
+		g.rxlen = len;
+		printf("SWEET GLINK: the ADSP's fifo is there (%u bytes)\n", len);
+	}
+	uint32_t head = g.desc[3], tail = g.desc[2];
+	uint32_t n = head >= tail ? head - tail : g.rxlen - tail + head;
+	return n > g.rxlen ? 0 : n;
+}
+
+static void
+rx_peek(void *out, uint32_t off, uint32_t n)
+{
+	uint32_t t = g.desc[2] + off;
+	if (t >= g.rxlen) {
+		t -= g.rxlen;
+	}
+	uint32_t a = MIN(n, g.rxlen - t);
+	for (uint32_t i = 0; i < a; i++) {
+		((uint8_t *)out)[i] = g.rxf[t + i];
+	}
+	for (uint32_t i = 0; i < n - a; i++) {
+		((uint8_t *)out)[a + i] = g.rxf[i];
+	}
+}
+
+static void
+rx_advance(uint32_t n)
+{
+	uint32_t t = g.desc[2] + ((n + 7) & ~7u);
+	if (t >= g.rxlen) {
+		t %= g.rxlen;
+	}
+	__builtin_arm_dmb(0xf);
+	g.desc[2] = t;
+}
+
+static uint32_t
+tx_avail(void)
+{
+	uint32_t head = g.desc[1], tail = g.desc[0];
+	uint32_t a = tail <= head ? g.txlen - head + tail : tail - head;
+	return a < 16 ? 0 : a - 16;
+}
+
+static uint32_t
+tx_write_one(uint32_t head, const void *d, uint32_t n)
+{
+	uint32_t a = MIN(n, g.txlen - head);
+	for (uint32_t i = 0; i < a; i++) {
+		g.txf[head + i] = ((const uint8_t *)d)[i];
+	}
+	for (uint32_t i = 0; i < n - a; i++) {
+		g.txf[i] = ((const uint8_t *)d)[a + i];
+	}
+	head += n;
+	return head >= g.txlen ? head - g.txlen : head;
+}
+
+static void
+kick(void)
+{
+	__builtin_arm_dsb(0xf);
+	*(volatile uint32_t *)(g.apcs + APCS_IPC_OFF) = ADSP_IPC_BIT;
+}
+
+/* one command (+ data), 8-byte aligned in the fifo */
+static int
+g_tx(const void *hdr, uint32_t hlen, const void *data, uint32_t dlen)
+{
+	uint32_t tlen = (hlen + dlen + 7) & ~7u;
+	if (tlen >= g.txlen) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_glink_tx_lock);
+	for (int i = 0; tx_avail() < tlen; i++) {
+		if (i > 2000) {
+			lck_mtx_unlock(&sweet_glink_tx_lock);
+			printf("SWEET GLINK: tx fifo stays full\n");
+			return EBUSY;
+		}
+		kick();
+		g_sleep_ms(1);
+	}
+	uint32_t head = g.desc[1];
+	head = tx_write_one(head, hdr, hlen);
+	if (dlen) {
+		head = tx_write_one(head, data, dlen);
+	}
+	head = (head + 7) & ~7u;
+	if (head >= g.txlen) {
+		head -= g.txlen;
+	}
+	__builtin_arm_dsb(0xf);
+	g.desc[1] = head;
+	kick();
+	lck_mtx_unlock(&sweet_glink_tx_lock);
+	return 0;
+}
+
+static int
+g_cmd(uint16_t cmd, uint16_t p1, uint32_t p2)
+{
+	struct { uint16_t cmd, p1; uint32_t p2; } m = { cmd, p1, p2 };
+	return g_tx(&m, sizeof(m), NULL, 0);
+}
+
+/* ---- channels ---- */
+
+static struct gchan *
+ch_by_rcid(uint16_t rcid)
+{
+	for (int i = 0; i < 2; i++) {
+		if (g.ch[i].remote_open && g.ch[i].rcid == rcid) {
+			return &g.ch[i];
+		}
+	}
+	return NULL;
+}
+
+static struct gchan *
+ch_by_lcid(uint16_t lcid)
+{
+	for (int i = 0; i < 2; i++) {
+		if (g.ch[i].lcid == lcid) {
+			return &g.ch[i];
+		}
+	}
+	return NULL;
+}
+
+static void
+ch_open(struct gchan *c)
+{
+	struct { uint16_t cmd, lcid; uint32_t namelen; char name[32]; } req;
+	bzero(&req, sizeof(req));
+	uint32_t nl = (uint32_t)strlen(c->name) + 1;
+	req.cmd = CMD_OPEN;
+	req.lcid = c->lcid;
+	req.namelen = nl;
+	strlcpy(req.name, c->name, sizeof(req.name));
+	c->open_sent = true;
+	(void)g_tx(&req, (8 + nl + 7) & ~7u, NULL, 0);
+}
+
+static void
+ch_advertise(struct gchan *c, uint32_t i)
+{
+	struct { uint16_t cmd, lcid; uint32_t count, size, liid; } m;
+	c->local[i].id = ++g.next_liid;
+	c->local[i].off = 0;
+	m.cmd = CMD_INTENT;
+	m.lcid = c->lcid;
+	m.count = 1;
+	m.size = c->local[i].size;
+	m.liid = c->local[i].id;
+	(void)g_tx(&m, sizeof(m), NULL, 0);
+}
+
+static void
+ch_ready(struct gchan *c)
+{
+	if (!c->open_acked || !c->remote_open || c->intents_sent) {
+		return;
+	}
+	c->intents_sent = true;
+	for (uint32_t i = 0; i < c->nlocal; i++) {
+		c->local[i].size = c->isize[i];
+		if (!c->local[i].buf) {
+			c->local[i].buf = kalloc_data(c->local[i].size, Z_WAITOK | Z_ZERO);
+		}
+		ch_advertise(c, i);
+	}
+	printf("SWEET GLINK: channel %s open (local %u, remote %u)\n", c->name, c->lcid, c->rcid);
+}
+
+static int
+ch_send(struct gchan *c, const void *d, uint32_t len)
+{
+	if (!c->intents_sent) {
+		return ENOTCONN;
+	}
+	for (int tries = 0; tries < 500; tries++) {
+		lck_mtx_lock(&sweet_glink_tx_lock);
+		int best = -1;
+		for (int i = 0; i < NREMOTE; i++) {
+			if (c->remote[i].size >= len && !c->remote[i].used &&
+			    (best < 0 || c->remote[i].size < c->remote[best].size)) {
+				best = i;
+			}
+		}
+		if (best >= 0) {
+			c->remote[best].used = true;
+		}
+		lck_mtx_unlock(&sweet_glink_tx_lock);
+		if (best >= 0) {
+			struct { uint16_t cmd, lcid; uint32_t iid, chunk, left; } h;
+			h.cmd = CMD_TX_DATA;
+			h.lcid = c->lcid;
+			h.iid = c->remote[best].id;
+			h.chunk = len;
+			h.left = 0;
+			return g_tx(&h, sizeof(h), d, len);
+		}
+		if (tries == 0) {
+			(void)g_cmd(CMD_RX_INTENT_REQ, c->lcid, len);
+		}
+		g_sleep_ms(2);
+	}
+	printf("SWEET GLINK: %s: no ADSP buffer for %u bytes\n", c->name, len);
+	return EBUSY;
+}
+
+/* returns false when the command is not all in the fifo yet */
+static bool
+rx_one(void)
+{
+	uint32_t avail = rx_avail();
+	struct { uint16_t cmd, p1; uint32_t p2; } m;
+	if (avail < 8) {
+		return false;
+	}
+	rx_peek(&m, 0, 8);
+	struct gchan *c;
+	switch (m.cmd) {
+	case CMD_VERSION:
+		rx_advance(8);
+		printf("SWEET GLINK: ADSP speaks GLINK version %u, features %#x\n", m.p1, m.p2);
+		(void)g_cmd(CMD_VERSION_ACK, 1, 0);
+		g.version_done = true;
+		break;
+	case CMD_VERSION_ACK:
+		rx_advance(8);
+		g.version_done = true;
+		break;
+	case CMD_OPEN: {
+		uint32_t nl = m.p2 & 0xffff;
+		char name[33] = { 0 };
+		if (avail < 8 + nl) {
+			return false;
+		}
+		rx_peek(name, 8, MIN(nl, 32u));
+		rx_advance(8 + nl);
+		c = NULL;
+		for (int i = 0; i < 2; i++) {
+			if (strcmp(g.ch[i].name, name) == 0) {
+				c = &g.ch[i];
+			}
+		}
+		if (!c) {
+			printf("SWEET GLINK: the ADSP opens %s (not handled)\n", name);
+			struct { uint16_t cmd, p1; uint32_t p2; } ack = { CMD_OPEN_ACK, m.p1, 0 };
+			(void)g_tx(&ack, 8, NULL, 0);
+			break;
+		}
+		c->rcid = m.p1;
+		c->remote_open = true;
+		(void)g_cmd(CMD_OPEN_ACK, c->rcid, 0);
+		if (!c->open_sent) {
+			ch_open(c);
+		}
+		ch_ready(c);
+		break;
+	}
+	case CMD_OPEN_ACK:
+		rx_advance(8);
+		if ((c = ch_by_lcid(m.p1)) != NULL) {
+			c->open_acked = true;
+			ch_ready(c);
+		}
+		break;
+	case CMD_CLOSE:
+		rx_advance(8);
+		(void)g_cmd(CMD_CLOSE_ACK, m.p1, 0);
+		if ((c = ch_by_rcid(m.p1)) != NULL) {
+			printf("SWEET GLINK: the ADSP closes %s\n", c->name);
+			c->remote_open = false;
+		}
+		break;
+	case CMD_CLOSE_ACK:
+		rx_advance(8);
+		break;
+	case CMD_INTENT: {
+		uint32_t n = m.p2, len = 8 + 8 * n;
+		if (avail < len) {
+			return false;
+		}
+		c = ch_by_rcid(m.p1);
+		for (uint32_t k = 0; k < n; k++) {
+			uint32_t pair[2];
+			rx_peek(pair, 8 + 8 * k, 8);
+			if (!c) {
+				continue;
+			}
+			lck_mtx_lock(&sweet_glink_tx_lock);
+			for (int i = 0; i < NREMOTE; i++) {
+				if (c->remote[i].size == 0) {
+					c->remote[i].size = pair[0];
+					c->remote[i].id = pair[1];
+					c->remote[i].used = false;
+					break;
+				}
+			}
+			lck_mtx_unlock(&sweet_glink_tx_lock);
+		}
+		rx_advance(len);
+		break;
+	}
+	case CMD_RX_DONE:
+	case CMD_RX_DONE_W_REUSE:
+		rx_advance(8);
+		if ((c = ch_by_rcid(m.p1)) != NULL) {
+			lck_mtx_lock(&sweet_glink_tx_lock);
+			for (int i = 0; i < NREMOTE; i++) {
+				if (c->remote[i].size && c->remote[i].id == m.p2) {
+					if (m.cmd == CMD_RX_DONE) {
+						c->remote[i].size = 0;
+					}
+					c->remote[i].used = false;
+				}
+			}
+			lck_mtx_unlock(&sweet_glink_tx_lock);
+		}
+		break;
+	case CMD_RX_INTENT_REQ:
+		rx_advance(8);
+		printf("SWEET GLINK: the ADSP asks for a %u-byte buffer on channel %u\n", m.p2, m.p1);
+		if ((c = ch_by_rcid(m.p1)) != NULL) {
+			/* one more buffer of that size (ours in use stay as they are) */
+			if (c->nlocal >= NLOCAL) {
+				(void)g_cmd(CMD_RX_INTENT_REQ_ACK, c->lcid, 0);
+				break;
+			}
+			uint32_t s = c->nlocal++;
+			c->local[s].size = MAX(m.p2, 512u);
+			c->local[s].buf = kalloc_data(c->local[s].size, Z_WAITOK | Z_ZERO);
+			(void)g_cmd(CMD_RX_INTENT_REQ_ACK, c->lcid, 1);
+			ch_advertise(c, s);
+		}
+		break;
+	case CMD_TX_DATA:
+	case CMD_TX_DATA_CONT: {
+		struct { uint16_t cmd, p1; uint32_t liid, chunk, left; } h;
+		if (avail < 16) {
+			return false;
+		}
+		rx_peek(&h, 0, 16);
+		if (avail < 16 + h.chunk) {
+			return false;
+		}
+		c = ch_by_rcid(h.p1);
+		int li = -1;
+		if (c) {
+			for (uint32_t i = 0; i < c->nlocal; i++) {
+				if (c->local[i].id == h.liid) {
+					li = (int)i;
+				}
+			}
+		}
+		if (li < 0 || c->local[li].size - c->local[li].off < h.chunk) {
+			printf("SWEET GLINK: data for unknown buffer %u on channel %u, dropped\n", h.liid, h.p1);
+			rx_advance(16 + h.chunk);
+			break;
+		}
+		rx_peek(c->local[li].buf + c->local[li].off, 16, h.chunk);
+		c->local[li].off += h.chunk;
+		rx_advance(16 + h.chunk);
+		if (h.left == 0) {
+			if (*c->handler) {
+				(*c->handler)(c->local[li].buf, c->local[li].off);
+			}
+			(void)g_cmd(CMD_RX_DONE, c->lcid, c->local[li].id);
+			ch_advertise(c, (uint32_t)li);
+		}
+		break;
+	}
+	case CMD_READ_NOTIF:
+		rx_advance(8);
+		kick();
+		break;
+	case CMD_RX_INTENT_REQ_ACK:
+	case CMD_SIGNALS:
+		rx_advance(8);
+		break;
+	default:
+		printf("SWEET GLINK: unknown command %u (%u, %#x), fifo reset\n", m.cmd, m.p1, m.p2);
+		g.desc[2] = g.desc[3];
+		break;
+	}
+	return true;
+}
+
+/* ---- APR (audio) ---- */
+
+struct apr_hdr {
+	uint16_t hdr_field, pkt_size;
+	uint8_t src_svc, src_domain;
+	uint16_t src_port;
+	uint8_t dest_svc, dest_domain;
+	uint16_t dest_port;
+	uint32_t token, opcode;
+} __attribute__((packed));
+
+static volatile uint32_t apr_core_state = ~0u;
+
+static void apr_rx(const uint8_t *pkt, uint32_t len);
+void (*sweet_glink_apr_client)(const uint8_t *, uint32_t);
+
+static void
+apr_rx(const uint8_t *pkt, uint32_t len)
+{
+	const struct apr_hdr *h = (const struct apr_hdr *)pkt;
+	if (len < sizeof(*h)) {
+		return;
+	}
+	const uint32_t *pl = (const uint32_t *)(pkt + ((h->hdr_field >> 4) & 0xf) * 4);
+	if (h->opcode == 0x0001290D && len >= sizeof(*h) + 4) {   /* AVCS_CMDRSP_ADSP_EVENT_GET_STATE */
+		apr_core_state = pl[0];
+		return;
+	}
+	if (sweet_glink_apr_client) {
+		sweet_glink_apr_client(pkt, len);
+		return;
+	}
+	printf("SWEET APR: svc %u port %u opcode %#x token %u (%u bytes)%s%#x %#x\n", h->src_svc, h->src_port,
+	    h->opcode, h->token, len, len >= sizeof(*h) + 8 ? ": " : "", len >= sizeof(*h) + 8 ? pl[0] : 0,
+	    len >= sizeof(*h) + 8 ? pl[1] : 0);
+}
+
+int
+sweet_glink_apr_send(const void *pkt, uint32_t len)
+{
+	return ch_send(&g.ch[0], pkt, len);
+}
+
+/* ---- QRTR (QMI services) ---- */
+
+struct qrtr_hdr_v1 {
+	uint32_t version, type, src_node, src_port, confirm_rx, size, dst_node, dst_port;
+};
+#define QRTR_PORT_CTRL  0xfffffffeu
+#define QRTR_NODE_BCAST 0xffffffffu
+#define QRTR_LOCAL_NODE 1u
+static uint32_t qrtr_adsp_node = ~0u;
+static void (*qrtr_client)(const uint8_t *, uint32_t);
+
+static void
+qrtr_ctrl(uint32_t type, uint32_t dst_node, uint32_t dst_port, const uint32_t *args, uint32_t nargs)
+{
+	struct { struct qrtr_hdr_v1 h; uint32_t cmd, a[4]; } p;
+	bzero(&p, sizeof(p));
+	p.h.version = 1;
+	p.h.type = type;
+	p.h.src_node = QRTR_LOCAL_NODE;
+	p.h.src_port = QRTR_PORT_CTRL;
+	p.h.size = 20;
+	p.h.dst_node = dst_node;
+	p.h.dst_port = dst_port;
+	p.cmd = type;
+	for (uint32_t i = 0; i < nargs && i < 4; i++) {
+		p.a[i] = args[i];
+	}
+	(void)ch_send(&g.ch[1], &p, sizeof(p));
+}
+
+static void
+qrtr_rx(const uint8_t *pkt, uint32_t len)
+{
+	const struct qrtr_hdr_v1 *h = (const struct qrtr_hdr_v1 *)pkt;
+	if (len < sizeof(*h) || h->version != 1) {
+		printf("SWEET QRTR: %u bytes, version %u: not a v1 packet\n", len, len >= 4 ? h->version : 0);
+		return;
+	}
+	const uint32_t *c = (const uint32_t *)(pkt + sizeof(*h));
+	switch (h->type) {
+	case 2: /* HELLO */
+		qrtr_adsp_node = h->src_node;
+		printf("SWEET QRTR: hello from the ADSP (node %u)\n", h->src_node);
+		qrtr_ctrl(2, h->src_node, QRTR_PORT_CTRL, NULL, 0);
+		break;
+	case 4: /* NEW_SERVER */
+		if (h->size >= 20) {
+			printf("SWEET QRTR: ADSP service %u (%#x) version %u instance %u at node %u port %u\n",
+			    c[1], c[1], c[2] & 0xff, c[2] >> 8, c[3], c[4]);
+		}
+		break;
+	case 5: /* DEL_SERVER */
+		if (h->size >= 20) {
+			printf("SWEET QRTR: ADSP service %u gone\n", c[1]);
+		}
+		break;
+	case 1: /* DATA */
+		if (h->confirm_rx) {
+			uint32_t a[2] = { QRTR_LOCAL_NODE, h->dst_port };
+			struct { struct qrtr_hdr_v1 h; uint32_t cmd, node, port; } r;
+			bzero(&r, sizeof(r));
+			r.h.version = 1;
+			r.h.type = 7;   /* RESUME_TX */
+			r.h.src_node = QRTR_LOCAL_NODE;
+			r.h.src_port = h->dst_port;
+			r.h.size = 12;
+			r.h.dst_node = h->src_node;
+			r.h.dst_port = h->src_port;
+			r.cmd = 7;
+			r.node = a[0];
+			r.port = a[1];
+			(void)ch_send(&g.ch[1], &r, sizeof(r));
+		}
+		if (qrtr_client) {
+			qrtr_client(pkt, len);
+		} else {
+			printf("SWEET QRTR: data %u bytes from %u:%u to port %u\n", h->size, h->src_node, h->src_port, h->dst_port);
+		}
+		break;
+	case 7: /* RESUME_TX */
+	case 9: /* PING */
+		break;
+	default:
+		printf("SWEET QRTR: control %u from %u:%u\n", h->type, h->src_node, h->src_port);
+		break;
+	}
+}
+
+int
+sweet_glink_qrtr_send(const void *pkt, uint32_t len)
+{
+	return ch_send(&g.ch[1], pkt, len);
+}
+
+bool
+sweet_glink_up(void)
+{
+	return g.up;
+}
+
+/* ---- bring-up ---- */
+
+static void
+glink_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	g.smem = (volatile uint8_t *)ml_io_map_wcomb(SMEM_PA, SMEM_SZ);
+	g.mutex = (volatile uint8_t *)ml_io_map(TCSR_MUTEX_PA, 0x1000);
+	g.apcs = (volatile uint8_t *)ml_io_map(APCS_IPC_PA, 0x1000);
+	if (!g.smem || !g.mutex || !g.apcs || !smem_find_partition()) {
+		return;
+	}
+	uint32_t dsz = 0;
+	g.desc = (volatile uint32_t *)smem_alloc(ITEM_DESC, 32, &dsz);
+	g.txf = smem_alloc(ITEM_TX_FIFO, TX_FIFO_SZ, &g.txlen);
+	if (!g.desc || dsz != 32 || !g.txf) {
+		printf("SWEET GLINK: descriptor (%u bytes) or tx fifo missing\n", dsz);
+		return;
+	}
+	g.desc[2] = 0;  /* rx tail */
+	g.desc[1] = 0;  /* tx head */
+	printf("SWEET GLINK: descriptor and %u-byte tx fifo in SMEM, waiting for the ADSP\n", g.txlen);
+
+	/* APR: 20 buffers of 512 bytes; IPCRTR: 5 x 2 KB, 3 x 8 KB, 2 x 17 KB (DT intents) */
+	g.ch[0].name = "apr_audio_svc";
+	g.ch[0].lcid = 1;
+	g.ch[0].handler = &sweet_glink_apr_handler;
+	g.ch[0].nlocal = 12;
+	for (int i = 0; i < 12; i++) {
+		g.ch[0].isize[i] = 4096;
+	}
+	g.ch[1].name = "IPCRTR";
+	g.ch[1].lcid = 2;
+	g.ch[1].handler = &sweet_glink_qrtr_handler;
+	g.ch[1].nlocal = 10;
+	for (int i = 0; i < 10; i++) {
+		g.ch[1].isize[i] = i < 5 ? 0x800 : i < 8 ? 0x2000 : 0x4400;
+	}
+	sweet_glink_apr_handler = apr_rx;
+	sweet_glink_qrtr_handler = qrtr_rx;
+
+	struct { uint16_t cmd, p1; uint32_t p2; } ver = { CMD_VERSION, 1, 1 /* INTENT_REUSE */ };
+	(void)g_tx(&ver, 8, NULL, 0);
+
+	uint64_t start = mach_absolute_time(), last_ver = start, now;
+	bool opened = false, hello = false, said_up = false;
+	uint32_t idle = 0, core_asks = 0;
+	uint64_t ns;
+	for (;;) {
+		bool any = false;
+		while (rx_one()) {
+			any = true;
+		}
+		now = mach_absolute_time();
+		absolutetime_to_nanoseconds(now - start, &ns);
+		if (!g.version_done) {
+			uint64_t d;
+			absolutetime_to_nanoseconds(now - last_ver, &d);
+			if (d > 2000000000ull) {   /* the ADSP may come up after our first VERSION */
+				(void)g_tx(&ver, 8, NULL, 0);
+				last_ver = now;
+				if (ns > 30000000000ull && ns < 32100000000ull) {
+					printf("SWEET GLINK: no answer from the ADSP after 30 s (tx %u/%u rx %u/%u)\n",
+					    g.desc[0], g.desc[1], g.desc[2], g.desc[3]);
+				}
+			}
+		} else if (!opened) {
+			opened = true;
+			ch_open(&g.ch[0]);
+			ch_open(&g.ch[1]);
+		}
+		if (g.ch[1].intents_sent && !hello) {
+			hello = true;
+			qrtr_ctrl(2, QRTR_NODE_BCAST, QRTR_PORT_CTRL, NULL, 0);
+		}
+		if (g.ch[0].intents_sent && apr_core_state != 1 && core_asks < 100 && (core_asks == 0 || (ns / 100000000ull) > core_asks)) {
+			struct apr_hdr h;
+			bzero(&h, sizeof(h));
+			h.hdr_field = (2 << 8) | (5 << 4);       /* SEQ_CMD, 20-byte header */
+			h.pkt_size = sizeof(h);
+			h.src_svc = 3;
+			h.src_domain = 5;
+			h.dest_svc = 3;                         /* APR_SVC_ADSP_CORE */
+			h.dest_domain = 4;
+			h.opcode = 0x0001290C;                  /* AVCS_CMD_ADSP_EVENT_GET_STATE */
+			(void)sweet_glink_apr_send(&h, sizeof(h));
+			core_asks = (uint32_t)(ns / 100000000ull) + 1;
+		}
+		if (!said_up && apr_core_state == 1) {
+			said_up = true;
+			g.up = true;
+			printf("SWEET APR: the ADSP's audio core is ready (%llu ms after the link)\n", ns / 1000000ull);
+		}
+		idle = any ? 0 : idle + 1;
+		g_sleep_ms(idle > 8 ? 4 : 1);
+	}
+}
+
+void
+sweet_glink_init(void)
+{
+	thread_t t;
+	extern void sweet_q6audio_init(void);
+	sweet_q6audio_init();
+	if (kernel_thread_start(glink_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
