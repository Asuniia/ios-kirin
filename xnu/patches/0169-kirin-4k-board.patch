+#if defined(SWEET_KIRIN)
+/*
+ * SDM630 / Adreno 508, step 1: read-only probe of what the bootloader left
+ * (Linux gpucc-sdm660.c, gcc-sdm660.c, DT kgsl-3d0@5000000):
+ *   GCC        gpu_cfg_ahb 0x171004, gpu_bimc_gfx 0x171010, bimc_gfx
+ *              0x17106c, gpu_gpll0 / gpu_gpll0_div = 0x15200c bits 4 / 3
+ *              (vote register)
+ *   GPU CC     0x5065000: PLL0 +0x0 (mode, L +0x4), PLL1 +0x40, GDSC gpu_cx
+ *              +0x1004, gpu_gx +0x1094, cxo +0x1020, gfx3d RCG +0x1070 /
+ *              branch +0x1098, rbcpr +0x1054, rbbmtimer +0x10d0
+ *   GFX LDO    0x506e000 (msm_gfx_ldo, BHS or LDO mode), first 13 words
+ *   GPU        0x5000000, only when gpu_cx is on and the AHB and gfx3d
+ *              clocks run (a gated block hangs the bus): RBBM_STATUS 0x4f5,
+ *              VBIF_VERSION 0x3000 (a5xx.xml dwords)
+ * GPU CC and the LDO only when gpu_cfg_ahb runs. Nothing is written.
+ */
+/*
+ * Step 2 (sweetgpu=2): power-up, in Linux's order, at a low clock.
+ *   GFX LDO    the bootloader leaves it in BHS mode (power source BHS, BHS
+ *              under GDSC control): the GPU runs from the CX rail, which the
+ *              RPM keeps up. As msm_gfx_ldo probe: clear CLAMP_IO (bit 31),
+ *              set EN_LDOAP_CTRL_CPR (bit 29) of PWRSWITCH_CTRL 0x1c.
+ *   gpu_cx     GDSCR SW_COLLAPSE (bit 0) off, wait PWR_ON (bit 31)
+ *   clocks     GCC: GPLL0 for the GPU (vote bits 4, 3) and bimc_gfx;
+ *              gfx3d RCG = GPLL0 (source 5) / 4 = 150 MHz (cfg hid 7),
+ *              root forced on (CMD bit 1) as the GX GDSC needs its root clock
+ *   gpu_gx     as Linux gdsc_enable with DT sw-reset, domain-addr,
+ *              qcom,reset-aon-logic: pulse BLK_ARES of GPU_GX_BCR 0x5066090,
+ *              pulse GMEM_RESET (bit 4) of GPU_GX_DOMAIN_MISC 0x5065130 and
+ *              clear its GMEM_CLAMP_IO (bit 0), then SW_COLLAPSE off and
+ *              wait PWR_ON (without the clamp/resets PWR_ON never came)
+ *   branches   gfx3d, rbbmtimer (XO); then RBBM and VBIF are read.
+ * Any step that does not complete stops here, before the GPU is touched.
+ */
+static bool
+kirin_wait_bit(vm_offset_t b, uint32_t off, uint32_t bit, bool set)
+{
+	for (int i = 0; i < 1000; i++) {
+		if (!!(*(volatile uint32_t *)(b + off) & bit) == set) {
+			return true;
+		}
+		delay(10);
+	}
+	return false;
+}
+
+static vm_offset_t
+kirin_gpu_power_up(vm_offset_t g71, vm_offset_t g52, vm_offset_t cc, vm_offset_t ldo)
+{
+#define RD(b, o) (*(volatile uint32_t *)((b) + (o)))
+#define WR(b, o, v) do { *(volatile uint32_t *)((b) + (o)) = (v); __builtin_arm_dsb(0xf); } while (0)
+	WR(ldo, 0x1c, (RD(ldo, 0x1c) & ~(1u << 31)) | (1u << 29));
+	printf("SWEET GPU: ldo ctl %#x status %#x %#x\n", RD(ldo, 0x1c), RD(ldo, 0x24), RD(ldo, 0x28));
+
+	WR(cc, 0x1004, RD(cc, 0x1004) & ~1u);
+	if (!kirin_wait_bit(cc, 0x1004, 1u << 31, true)) {
+		printf("SWEET GPU: gpu_cx GDSC did not power on (%#x)\n", RD(cc, 0x1004));
+		return 0;
+	}
+	printf("SWEET GPU: gpu_cx on (%#x)\n", RD(cc, 0x1004));
+
+	WR(g52, 0x00c, RD(g52, 0x00c) | 0x18);
+	WR(g71, 0x06c, RD(g71, 0x06c) | 1u);
+	(void)kirin_wait_bit(g71, 0x06c, 1u << 31, false);
+	WR(cc, 0x1074, (5u << 8) | 7u);
+	WR(cc, 0x1070, RD(cc, 0x1070) | 2u | 1u);
+	if (!kirin_wait_bit(cc, 0x1070, 1u, false)) {
+		printf("SWEET GPU: gfx3d RCG update stuck (cmd %#x cfg %#x)\n", RD(cc, 0x1070), RD(cc, 0x1074));
+		return 0;
+	}
+	printf("SWEET GPU: gfx3d RCG cmd %#x cfg %#x, gpll0 vote %#x bimc_gfx %#x\n",
+	    RD(cc, 0x1070), RD(cc, 0x1074), RD(g52, 0x00c), RD(g71, 0x06c));
+
+	printf("SWEET GPU: gx bcr %#x domain misc %#x\n", RD(cc, 0x1090), RD(cc, 0x0130));
+	WR(cc, 0x1090, RD(cc, 0x1090) | 1u);
+	delay(1);
+	WR(cc, 0x1090, RD(cc, 0x1090) & ~1u);
+	WR(cc, 0x0130, RD(cc, 0x0130) | 0x10u);
+	delay(1);
+	WR(cc, 0x0130, RD(cc, 0x0130) & ~0x10u);
+	WR(cc, 0x0130, RD(cc, 0x0130) & ~1u);
+	WR(cc, 0x1094, RD(cc, 0x1094) & ~1u);
+	delay(1);
+	if (!kirin_wait_bit(cc, 0x1094, 1u << 31, true)) {
+		printf("SWEET GPU: gpu_gx GDSC did not power on (%#x), ldo %#x %#x\n",
+		    RD(cc, 0x1094), RD(ldo, 0x24), RD(ldo, 0x28));
+		return 0;
+	}
+	printf("SWEET GPU: gpu_gx on (%#x), ldo status %#x %#x\n", RD(cc, 0x1094), RD(ldo, 0x24), RD(ldo, 0x28));
+
+	WR(cc, 0x1098, RD(cc, 0x1098) | 1u);
+	WR(cc, 0x10d0, RD(cc, 0x10d0) | 1u);
+	bool gfx = kirin_wait_bit(cc, 0x1098, 1u << 31, false);
+	bool tmr = kirin_wait_bit(cc, 0x10d0, 1u << 31, false);
+	printf("SWEET GPU: gfx3d branch %#x (%s) rbbmtimer %#x (%s)\n", RD(cc, 0x1098), gfx ? "on" : "OFF",
+	    RD(cc, 0x10d0), tmr ? "on" : "OFF");
+	if (!gfx) {
+		return 0;
+	}
+	vm_offset_t gpu = ml_io_map(0x05000000u, 0x40000);
+	if (gpu != 0) {
+		printf("SWEET GPU: powered: RBBM_STATUS %#x VBIF_VERSION %#x RBBM_INT_0_STATUS %#x\n",
+		    RD(gpu, 0x4f5 * 4), RD(gpu, 0x3000 * 4), RD(gpu, 0x4e1 * 4));
+	}
+	return gpu;
+#undef WR
+#undef RD
+}
+
+static void
+kirin_gpu_probe(void *arg, wait_result_t wr)
+{
+	int level = (int)(uintptr_t)arg;
+	(void)wr;
+	g_level = level;        /* service mode skips the MSM8996 log-flush pauses (gpu_wait) */
+	vm_offset_t g71 = ml_io_map(0x00171000u, 0x1000), g52 = ml_io_map(0x00152000u, 0x1000);
+	vm_offset_t cc = ml_io_map(0x05065000u, 0x2000), ldo = ml_io_map(0x0506e000u, 0x1000);
+	if (!g71 || !g52 || !cc || !ldo) {
+		printf("SWEET GPU: map failed\n");
+		return;
+	}
+#define RD(b, o) (*(volatile uint32_t *)((b) + (o)))
+	uint32_t ahb = RD(g71, 0x004), gbimc = RD(g71, 0x010), bimc = RD(g71, 0x06c), vote = RD(g52, 0x00c);
+	printf("SWEET GPU: gcc gpu_cfg_ahb %#x gpu_bimc_gfx %#x bimc_gfx %#x gpll0 vote %#x (gpu %d div %d)\n",
+	    ahb, gbimc, bimc, vote, !!(vote & 0x10), !!(vote & 0x08));
+	if (ahb & (1u << 31)) {
+		/* GPU CC and the GFX LDO sit behind this clock: reading them would hang. */
+		printf("SWEET GPU: gpu_cfg_ahb clock off; GPU CC not read\n");
+		return;
+	}
+	uint32_t cx = RD(cc, 0x1004), gx = RD(cc, 0x1094), gfx = RD(cc, 0x1098);
+	printf("SWEET GPU: gpucc pll0 mode %#x L %#x pll1 mode %#x L %#x gdsc cx %#x gx %#x\n",
+	    RD(cc, 0x0), RD(cc, 0x4), RD(cc, 0x40), RD(cc, 0x44), cx, gx);
+	printf("SWEET GPU: gpucc cxo %#x gfx3d rcg %#x/%#x cbcr %#x rbcpr %#x rbbmtimer %#x\n",
+	    RD(cc, 0x1020), RD(cc, 0x1070), RD(cc, 0x1074), gfx, RD(cc, 0x1054), RD(cc, 0x10d0));
+	printf("SWEET GPU: gfx ldo %#x %#x %#x %#x %#x %#x %#x %#x %#x %#x %#x %#x %#x\n",
+	    RD(ldo, 0x00), RD(ldo, 0x04), RD(ldo, 0x08), RD(ldo, 0x0c), RD(ldo, 0x10), RD(ldo, 0x14),
+	    RD(ldo, 0x18), RD(ldo, 0x1c), RD(ldo, 0x20), RD(ldo, 0x24), RD(ldo, 0x28), RD(ldo, 0x2c),
+	    RD(ldo, 0x30));
+	bool on = (cx & (1u << 31)) && !(ahb & (1u << 31)) && !(gfx & (1u << 31));
+	if (!on) {
+		printf("SWEET GPU: GPU core off or unclocked; not read\n");
+		if (level >= 2) {
+			kirin_gpucc = cc;
+			vm_offset_t gpu = kirin_gpu_power_up(g71, g52, cc, ldo);
+			/* Step 3+ (sweetgpu=3..): the MSM8996 CP / zap / blit path with A508 values */
+			if (gpu != 0 && level >= 3) {
+				cp_test(gpu, level);
+			}
+		}
+		return;
+	}
+	vm_offset_t gpu = ml_io_map(0x05000000u, 0x10000);
+	if (gpu != 0) {
+		printf("SWEET GPU: RBBM_STATUS %#x VBIF_VERSION %#x\n", RD(gpu, 0x4f5 * 4), RD(gpu, 0x3000 * 4));
+	}
+#undef RD
+}
+#endif
