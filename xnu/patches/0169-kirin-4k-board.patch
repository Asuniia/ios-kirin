+// ------------------------------------------------------------------ AppleBaseband
+// Sweet: after a soft reset ABM waits for the AppleBaseband service to say so: libBasebandManager's IOGeneralInterest handler
+// takes 0xe3ff8000 as "baseband reset detected" and 0xe3ff8001 as "baseband alive detected" (Apple's driver sends them from the
+// modem's reset-detect line; libTelephonyBaseband handles 0xe3ff8007 wake and 0xe3ff800d coredump itself and passes the rest on).
+// Without them a reset (the carrier-bundle push resets once per SIM) ends in "Soft reset failed; timeout waiting for reset detection"
+// and the radio stays down. The modem here never resets: say it did, then that it is alive again for the next SendImage.
+#define BB_MSG_RESET_DETECTED 0xe3ff8000u
+#define BB_MSG_ALIVE 0xe3ff8001u
+static IOService *bb_baseband_service;
+static thread_call_t bb_reset_call, bb_alive_call;
+static uint32_t bb_reset_messages;
+static void bb_after_ms(thread_call_t call, uint32_t ms)
+{
+  uint64_t deadline;
+  clock_interval_to_deadline(ms, kMillisecondScale, &deadline);
+  if (call) thread_call_enter_delayed(call, deadline);
+}
+static void bb_alive(thread_call_param_t, thread_call_param_t)
+{
+  if (!bb_baseband_service) return;
+  const IOReturn r = bb_baseband_service->messageClients(BB_MSG_ALIVE);
+  if (bb_reset_messages <= 8) printf("SWEET BB: alive message sent (0x%x)\n", r);
+}
+static void bb_reset_fire(thread_call_param_t, thread_call_param_t)
+{
+  if (!bb_baseband_service) return;
+  const IOReturn r = bb_baseband_service->messageClients(BB_MSG_RESET_DETECTED);
+  if (++bb_reset_messages <= 8) printf("SWEET BB: reset detected message sent (0x%x), alive in 100 ms\n", r);
+  bb_after_ms(bb_alive_call, 100);
+}
+// After the caller has returned and started waiting (ABM logs "waiting for reset detection" after issuing the reset): 50 ms later.
+static void bb_reset_detected(IOService *service)
+{
+  if (service) bb_baseband_service = service;
+  if (!bb_baseband_service) return;
+  if (!bb_reset_call) bb_reset_call = thread_call_allocate(bb_reset_fire, nullptr);
+  if (!bb_alive_call) bb_alive_call = thread_call_allocate(bb_alive, nullptr);
+  bb_after_ms(bb_reset_call, 50);
+}
+// bb_lock held (from bb_to_modem): back to before SendImage, as a reset or power-on through AppleBaseband.
+static void bb_qmi_soft_reset(void)
+{
+  bb_boot_image_sent = false;
+  bb_flush(CBH_SAHARA);
+  bb_reset_detected(nullptr);
+}
+
+class AppleBasebandUserClient : public IOUserClient {
+  OSDeclareDefaultStructors(AppleBasebandUserClient)
+public:
+  IOReturn clientClose() override
+  {
+    terminate();
+    return kIOReturnSuccess;
+  }
+  IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args, IOExternalMethodDispatch *, OSObject *, void *) override
+  {
+    if (!args) return kIOReturnBadArgument;
+    uint64_t out[4] = { 0 };
+    uint32_t nout = args->scalarOutputCount < 4 ? args->scalarOutputCount : 4;
+    IOLockLock(bb_lock);
+    const int result = cbc_call(&bb_control, selector, args->scalarInput, args->scalarInputCount, out, &nout);
+    // A reset or power-on goes back to before SendImage: nothing greets until the next one.
+    const bool reset = !result && (selector == CBC_RESET_MODEM || selector == CBC_POWERCYCLE ||
+                                   (selector == CBC_POWER && args->scalarInputCount && args->scalarInput[0]));
+    if (reset) {
+      bb_boot_image_sent = false;
+      bb_flush(CBH_SAHARA);
+    }
+    IOLockUnlock(bb_lock);
+    // No reset-detected message here: during ABM's hard-reset fallback one arriving later reads as "baseband crash detected"
+    // and starts the next reset (a reset storm with the first 0188). Only the bridge-answered DMS reset plays one back.
+    if (result == CBC_UNSUPPORTED) printf("SWEET BB: AppleBaseband selector %u unsupported\n", selector);
+    for (uint32_t i = 0; i < nout; i++) args->scalarOutput[i] = out[i];
+    args->scalarOutputCount = nout;
+    return result;
+  }
+};
+OSDefineMetaClassAndStructors(AppleBasebandUserClient, IOUserClient)
+
