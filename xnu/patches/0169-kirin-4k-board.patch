+ * calendar clock is set from it only if it reads a date after 2024-01-01:
+ * under Android the RTC may count from another origin (Android keeps an
+ * offset of its own), and then it is only logged.
+ */
+extern void clock_set_calendar_microtime(clock_sec_t secs, clock_usec_t microsecs);
+
+static void
+sweet_rtc_init(void)
+{
+	uint8_t ctl = 0, b[4] = {0}, c[4] = {0};
+	bool ok = sweet_pmic_read(0x060, 0x46, &ctl);
+	for (int tries = 0; ok && tries < 3; tries++) {
+		for (int i = 0; ok && i < 4; i++) {
+			ok = sweet_pmic_read(0x060, (uint8_t)(0x48 + i), &b[i]);
+		}
+		for (int i = 0; ok && i < 4; i++) {
+			ok = sweet_pmic_read(0x060, (uint8_t)(0x48 + i), &c[i]);
+		}
+		if (ok && memcmp(b, c, 4) == 0) {
+			break;
+		}
+	}
+	uint32_t secs = (uint32_t)c[0] | (uint32_t)c[1] << 8 | (uint32_t)c[2] << 16 | (uint32_t)c[3] << 24;
+	bool plausible = ok && (ctl & 0x80) && secs > 1704067200u;
+	printf("SWEET RTC: ctl %#x seconds %u%s -> %s\n", ctl, secs, ok ? "" : " (read failed)",
+	    plausible ? "calendar clock set" : "not a recent date, clock left alone");
+	if (plausible) {
+		clock_set_calendar_microtime((clock_sec_t)secs, 0);
+	}
+}
+
+/*
+ * PS_HOLD reset type of both PMICs before PS_HOLD drops (Linux
+ * qpnp_pon_reset_config / qpnp_pon_system_pwr_off): PON base 0x800,
+ * PS_HOLD_RST_CTL2 0x5b bit 7 off, 500 us, PS_HOLD_RST_CTL 0x5a [3:0] =
+ * type, bit 7 on again. Types: 4 shutdown, 7 hard reset. PM660L (SID 2)
+ * turns hard reset into shutdown (DT qcom,hard-reset-poweroff-type = 4).
+ * Thread context only (the PMIC lock).
+ */
+bool
+sweet_pmic_pshold_config(bool shutdown)
+{
+	static const struct { uint16_t ppid; uint8_t type[2]; } pon[] = {
+		{0x008, {7, 4}}, {0x208, {4, 4}},
+	};
+	bool ok = true;
+	for (unsigned i = 0; i < sizeof(pon) / sizeof(pon[0]); i++) {
+		uint8_t ctl = 0, ctl2 = 0;
+		bool r = sweet_pmic_read(pon[i].ppid, 0x5b, &ctl2) &&
+		    sweet_pmic_write(pon[i].ppid, 0x5b, (uint8_t)(ctl2 & ~0x80u));
+		delay(500);
+		r = r && sweet_pmic_read(pon[i].ppid, 0x5a, &ctl) &&
+		    sweet_pmic_write(pon[i].ppid, 0x5a, (uint8_t)((ctl & ~0x0fu) | pon[i].type[shutdown])) &&
+		    sweet_pmic_write(pon[i].ppid, 0x5b, (uint8_t)(ctl2 | 0x80u));
+		ok = ok && r;
+	}
+	return ok;
+}
