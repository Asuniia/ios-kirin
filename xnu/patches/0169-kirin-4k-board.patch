+	    __builtin_arm_rsr64("ICC_SRE_EL1"), __builtin_arm_rsr64("ICC_IGRPEN1_EL1"),
+	    __builtin_arm_rsr64("ICC_PMR_EL1"), __builtin_arm_rsr64("ICC_RPR_EL1"),
+	    __builtin_arm_rsr64("ICC_HPPIR1_EL1"), __builtin_arm_rsr64("DAIF"));
+	printf("SWEET TMR %s: CNTV_CTL %#llx CVAL %#llx VCT %#llx PCT %#llx FRQ %llu intid %u\n", when,
+	    __builtin_arm_rsr64("CNTV_CTL_EL0"), __builtin_arm_rsr64("CNTV_CVAL_EL0"),
+	    __builtin_arm_rsr64("CNTVCT_EL0"), __builtin_arm_rsr64("CNTPCT_EL0"),
+	    __builtin_arm_rsr64("CNTFRQ_EL0"), sweet_vtimer_intid);
