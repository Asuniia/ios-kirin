+++ b/bsd/dev/kirin_bt.c
@@ -0,0 +1,737 @@
+/*
+ * kirin (Xperia 10, SDM630), boot-arg sweetbt=1: the WCN3990's Bluetooth core
+ * over BLSP2 UART1 (0xc1af000, UARTDM v1.4 in single-character PIO), HCI in
+ * the kernel, then the H4 stream for iOS's bluetoothd/BlueTool through the
+ * kernel control com.apple.uart.bluetooth (bsd/dev/sweet_bt_hci.c, from
+ * ios-sweet 0154).
+ *
+ * The chip (live DT /bt_wcn3990, qca,wcn3990) and its bring-up, as Linux
+ * hci_qca + btqca:
+ *   rails      RPM LDOs (pm660): vdd-core l9 1.8 V, vdd-pa l6 1.304 V,
+ *              vdd-ldo l19 3.312 V, chip-pwd pm660l bob pin1; clock rf_clk1.
+ *              All votable over the GLINK RPM link (sweet_rpm_vote_kvs).
+ *   UART       the only HS UART the live DT enables is /soc/uart@c1af000
+ *              (qcom,msm-hsuart-v14, status ok; 0xc16f000 is disabled):
+ *              pins gpio16 TX, 17 RX, 18 CTS, 19 RFR (TLMM CENTER tile
+ *              0x3500000, function 1 = blsp_uart5), clocks GCC blsp2_ahb
+ *              (vote 0x52004 bit 15) and blsp2_uart1_apps (RCG 0x2700c +
+ *              branch 0x27004); UARTDM baud = RCG rate / CSR divider
+ *              (3.6864 MHz with CSR 0x55 = 2400 for the power pulse,
+ *              51.2 MHz with CSR 0xff = 3.2 M to operate).
+ *   power      qca_regulator_init as ios-sweet replays it: a power-off pulse
+ *              byte (0xc0) at 2400 baud, then the power-on pulse (0xfc) at
+ *              115200, and the controller talks at 115200 from there (the
+ *              baud-change vendor command to 3.2 M is not sent yet; the
+ *              first attempt at 3.2 M straight after the pulse got no
+ *              answer, 11/11).
+ *   firmware   rampatch crbtfw21.tlv + NVM crnv21.bin, streamed in 243-byte
+ *              EDL TLV segments (opcode 0xfc00, command 0x1e); read at boot
+ *              from the phone's own bluetooth firmware partition on the eMMC
+ *              (sweet_fat_read_file, the modem's FAT reader).
+ *   sleep      in-band sleep bytes between H4 packets: 0xfe sleep, 0xfd
+ *              wake, 0xfc wake-ack.
+ *
+ * First bring-up: everything is polled and logged; expect to iterate on the
+ * phone (which partition holds the firmware, whether the rails were already
+ * on, RX at 3.2 M under the auto-RFR flow control).
+ */
+#if defined(SWEET_KIRIN)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+#include <kern/kalloc.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern int sweet_rpm_vote_kvs(const char *what, uint32_t resource, uint32_t resource_id, const uint32_t *kv, unsigned nkvp);
+extern int64_t sweet_fat_read_file_in(const char *part, const char name83[11], uint8_t *dest, uint32_t maxlen);
+
+void kirin_bt_init(void);
+
+struct bt_hci_ops {
+	bool (*tx)(const uint8_t *pkt, unsigned len);
+	unsigned (*baud)(unsigned requested);
+};
+extern void bt_hci_register(const struct bt_hci_ops *ops, unsigned sk_alias, unsigned log_budget);
+extern void bt_hci_rx_packet(const uint8_t *pkt, unsigned len);
+extern void bt_hci_rx_service(void);
+extern bool bt_hci_connected(void);
+
+#ifndef MIN
+#define MIN(a, b) ((a) < (b) ? (a) : (b))
+#endif
+
+/* ---- addresses ---- */
+#define GCC_PA          0x00100000ull
+#define TLMM_CENTER_PA  0x03500000ull   /* tile of gpio16-19 (pinctrl-sdm660.c CENTER); ctl at 0x1000 * gpio */
+#define BT_GPIO_FIRST   16u
+#define BT_GPIO_FUNC    1u              /* blsp_uart5 is function 1 on gpio16-19 */
+#define UART_PA         0x0c1af000ull   /* BLSP2 UART1 core_mem */
+
+#define GCC_BLSP2_AHB_VOTE      0x52004 /* bit 15 */
+#define GCC_UART_BRANCH         0x27004 /* gcc_blsp2_uart1_apps_clk, bit 0 */
+#define GCC_UART_RCG_CMD        0x2700c /* blsp2_uart1_apps_clk_src */
+#define GCC_UART_RCG_CFG        0x27010
+#define GCC_UART_RCG_M          0x27014
+#define GCC_UART_RCG_N          0x27018
+#define GCC_UART_RCG_D          0x2701c
+
+/* UARTDM v1.4 */
+#define UART_MR1        0x00
+#define UART_MR2        0x04
+#define UART_IPR        0x18
+#define UART_TFWR       0x1c
+#define UART_RFWR       0x20
+#define UART_DMEN       0x3c
+#define UART_DMRX       0x34
+#define UART_RXFS       0x50
+#define UART_CSR        0xa0
+#define UART_SR         0xa4
+#define UART_CR         0xa8
+#define UART_IMR        0xb0
+#define UART_ISR        0xb4
+#define UART_TF         0x100
+#define UART_RF         0x140
+
+#define MR1_RX_RDY_CTL  (1u << 7)       /* hardware RFR from the RX watermark */
+#define MR1_CTS_CTL     (1u << 6)       /* transmitter obeys CTS */
+#define MR2_8N1         ((1u << 2) | (3u << 4))
+#define SR_RXRDY        (1u << 0)
+#define SR_TXRDY        (1u << 2)
+#define SR_TXEMT        (1u << 3)
+#define SR_OVERRUN      (1u << 4)
+#define CR_RX_EN        (1u << 0)
+#define CR_TX_EN        (1u << 2)
+#define CR_RESET_RX     (1u << 4)
+#define CR_RESET_TX     (2u << 4)
+#define CR_RESET_ERR    (3u << 4)
+#define CR_RESET_CTS    (7u << 4)
+#define CR_RESET_STALE  (8u << 4)
+#define CR_SET_RFR      (13u << 4)
+#define CR_RESET_RFR    (14u << 4)
+#define DMEN_TX_SC      (1u << 4)
+#define DMEN_RX_SC      (1u << 5)
+
+/* qca (btqca.h) */
+#define QCA_PULSE_ON    0xfcu
+#define QCA_PULSE_OFF   0xc0u
+#define EDL_OPCODE      0xfc00u
+#define EDL_VER_REQ     0x19u
+#define EDL_TLV_REQ     0x1eu
+#define EDL_SEGMENT     243u
+#define IBS_SLEEP_IND   0xfeu
+#define IBS_WAKE_IND    0xfdu
+#define IBS_WAKE_ACK    0xfcu
+
+static volatile uint32_t *bt_gcc, *bt_tlmm, *bt_uart;
+static struct {
+	unsigned baud;
+	bool ibs_asleep, ibs_ack_pending, xport;
+	unsigned ibs_logged, raw_budget, overruns;
+	uint8_t rxq[2048];
+	unsigned rxn;
+	uint8_t pkt[4 + 4096];          /* the H4 packet being assembled for iOS */
+	unsigned pn, pneed;
+	bool hdr_done;
+	int sleep_chan;
+} kb;
+
+static void
+kb_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&kb.sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static uint32_t
+rd(volatile uint32_t *base, uint32_t off)
+{
+	return base[off / 4];
+}
+
+static void
+wr(volatile uint32_t *base, uint32_t off, uint32_t v)
+{
+	base[off / 4] = v;
+	__builtin_arm_dsb(0xf);
+}
+
+/* ---- rails and clocks ---- */
+
+static void
+kb_rails(void)
+{
+	/* "swen" 1 + "uv" microvolts for the LDOs; "swen" alone for the rest */
+	static const struct { const char *what; uint32_t res, id, uv; } ldos[] = {
+		{ "bt vdd-core (l9)", 0x616f646cu, 9, 1800000 },
+		{ "bt vdd-pa (l6)", 0x616f646cu, 6, 1304000 },
+		{ "bt vdd-ldo (l19)", 0x616f646cu, 19, 3312000 },
+	};
+	for (unsigned i = 0; i < sizeof(ldos) / sizeof(ldos[0]); i++) {
+		uint32_t kv[4] = { 0x6e657773u /* swen */, 1, 0x00007675u /* uv */, ldos[i].uv };
+		(void)sweet_rpm_vote_kvs(ldos[i].what, ldos[i].res, ldos[i].id, kv, 2);
+	}
+	{
+		uint32_t kv[2] = { 0x6e657773u, 1 };
+		(void)sweet_rpm_vote_kvs("bt chip-pwd (bob pin1)", 0x62626f62u /* bobb */, 1, kv, 1);
+		(void)sweet_rpm_vote_kvs("bt rf_clk1", 0x616b6c63u /* clka */, 4, kv, 1);
+	}
+}
+
+static void
+kb_pins(void)
+{
+	/* gpio16-19 to blsp_uart5 (function 1), no pull, 2 mA: the DT's blsp2_uart1_*_active */
+	for (unsigned g = 0; g < 4; g++) {
+		wr(bt_tlmm, 0x1000 * (BT_GPIO_FIRST + g), BT_GPIO_FUNC << 2);
+	}
+}
+
+/* RCG rows (gcc-sdm660.c ftbl): src 1 = GPLL0 600 MHz, MND 16 bits, dual edge */
+static void
+kb_rcg(uint32_t m, uint32_t n, uint32_t src, uint32_t prediv)
+{
+	wr(bt_gcc, GCC_UART_RCG_M, m);
+	wr(bt_gcc, GCC_UART_RCG_N, (~(n - m)) & 0xffff);
+	wr(bt_gcc, GCC_UART_RCG_D, (~n) & 0xffff);
+	wr(bt_gcc, GCC_UART_RCG_CFG, (src << 8) | prediv | (m ? (2u << 12) : 0));
+	wr(bt_gcc, GCC_UART_RCG_CMD, rd(bt_gcc, GCC_UART_RCG_CMD) | 3u);        /* ROOT_EN | UPDATE */
+	for (int i = 0; i < 1000 && (rd(bt_gcc, GCC_UART_RCG_CMD) & 1u); i++) {
+		delay(1);
+	}
+}
+
+static void
+kb_clocks(void)
+{
+	wr(bt_gcc, GCC_BLSP2_AHB_VOTE, rd(bt_gcc, GCC_BLSP2_AHB_VOTE) | (1u << 15));
+	kb_rcg(96, 15625, 1, 1);        /* 3.6864 MHz */
+	wr(bt_gcc, GCC_UART_BRANCH, rd(bt_gcc, GCC_UART_BRANCH) | 1u);
+	delay(100);
+}
+
+/* ---- the UART ---- */
+
+static void
+kb_uart_setup(unsigned flow)
+{
+	wr(bt_uart, UART_CR, 0);
+	wr(bt_uart, UART_CR, CR_RESET_RX);
+	wr(bt_uart, UART_CR, CR_RESET_TX);
+	wr(bt_uart, UART_CR, CR_RESET_ERR);
+	wr(bt_uart, UART_CR, CR_RESET_CTS);
+	wr(bt_uart, UART_CR, CR_RESET_STALE);
+	wr(bt_uart, UART_MR1, flow ? (MR1_RX_RDY_CTL | MR1_CTS_CTL | 46u) : 0);
+	wr(bt_uart, UART_MR2, MR2_8N1);
+	wr(bt_uart, UART_IPR, 0);
+	wr(bt_uart, UART_TFWR, 0);
+	wr(bt_uart, UART_RFWR, 46);
+	wr(bt_uart, UART_IMR, 0);
+	wr(bt_uart, UART_DMEN, DMEN_TX_SC | DMEN_RX_SC);
+	wr(bt_uart, UART_CR, CR_RX_EN | CR_TX_EN);
+	if (!flow) {
+		wr(bt_uart, UART_CR, CR_RX_EN | CR_TX_EN | CR_SET_RFR);
+	}
+}
+
+/* baud: RCG row + CSR divider */
+static void
+kb_baud(unsigned baud)
+{
+	if (baud == 2400) {
+		kb_rcg(96, 15625, 1, 1);                /* 3.6864 MHz / 1536 */
+		wr(bt_uart, UART_CSR, 0x55);
+	} else if (baud == 115200) {
+		kb_rcg(96, 15625, 1, 1);                /* 3.6864 MHz / 32 */
+		wr(bt_uart, UART_CSR, 0xee);
+	} else {
+		baud = 3200000;
+		kb_rcg(32, 375, 1, 1);                  /* 51.2 MHz / 16 */
+		wr(bt_uart, UART_CSR, 0xff);
+	}
+	wr(bt_uart, UART_CR, CR_RESET_RX);
+	wr(bt_uart, UART_CR, CR_RESET_TX);
+	wr(bt_uart, UART_CR, CR_RX_EN | CR_TX_EN);
+	kb.baud = baud;
+	kb.rxn = 0;
+	printf("SWEET KBT: UART at %u baud\n", baud);
+}
+
+static bool
+kb_tx_bytes(const uint8_t *b, unsigned n)
+{
+	for (unsigned i = 0; i < n; i++) {
+		unsigned t;
+		for (t = 0; t < 200000 && !(rd(bt_uart, UART_SR) & SR_TXRDY); t++) {
+			delay(5);
+		}
+		if (t == 200000) {
+			printf("SWEET KBT: TX stuck (SR %#x ISR %#x)\n", rd(bt_uart, UART_SR), rd(bt_uart, UART_ISR));
+			return false;
+		}
+		wr(bt_uart, UART_TF, b[i]);
+	}
+	for (unsigned t = 0; t < 200000 && !(rd(bt_uart, UART_SR) & SR_TXEMT); t++) {
+		delay(5);
+	}
+	return true;
+}
+
+static void kb_rx_feed(uint8_t b);
+
+static void
+kb_rx_poll(void)
+{
+	uint32_t sr;
+	unsigned got = 0;
+	while ((sr = rd(bt_uart, UART_SR)) & SR_RXRDY) {
+		if (++got > 8192) {
+			printf("SWEET KBT: RX never drains (SR %#x), giving the thread back\n", sr);
+			break;
+		}
+		uint8_t b = (uint8_t)rd(bt_uart, UART_RF);
+		if (kb.raw_budget) {
+			kb.raw_budget--;
+			printf("SWEET KBT: RX %02x (SR %#x)\n", b, sr);
+		}
+		kb_rx_feed(b);
+	}
+	if (sr & SR_OVERRUN) {
+		wr(bt_uart, UART_CR, CR_RESET_ERR);
+		if (kb.overruns++ < 8) {
+			printf("SWEET KBT: RX overrun (%u)\n", kb.overruns);
+		}
+	}
+}
+
+/* ---- H4 + IBS RX ---- */
+
+static void
+kb_rx_feed(uint8_t b)
+{
+	if (kb.pn == 0 && b >= IBS_WAKE_ACK && b <= IBS_SLEEP_IND) {
+		if (b == IBS_SLEEP_IND) {
+			kb.ibs_asleep = true;
+		} else {
+			kb.ibs_asleep = false;
+			if (b == IBS_WAKE_IND) {
+				kb.ibs_ack_pending = true;
+			}
+		}
+		if (kb.ibs_logged < 16) {
+			kb.ibs_logged++;
+			printf("SWEET KBT: IBS RX %02x\n", b);
+		}
+		return;
+	}
+	if (kb.pn == 0 && (b < 2 || b > 4)) {
+		return;         /* not a packet start: resync */
+	}
+	kb.pkt[kb.pn++] = b;
+	if (kb.pn == 1) {
+		kb.pneed = b == 2 ? 5 : b == 3 ? 4 : 3;         /* header bytes incl. type */
+		kb.hdr_done = false;
+		return;
+	}
+	if (!kb.hdr_done && kb.pn == kb.pneed) {
+		unsigned plen = kb.pkt[0] == 2 ? (kb.pkt[3] | (kb.pkt[4] << 8)) : kb.pkt[kb.pneed - 1];
+		if (kb.pneed + plen > sizeof(kb.pkt)) {
+			kb.pn = 0;
+			return;
+		}
+		kb.pneed += plen;
+		kb.hdr_done = true;
+	}
+	if (kb.hdr_done && kb.pn == kb.pneed) {
+		if (kb.xport) {
+			bt_hci_rx_packet(kb.pkt, kb.pn);
+		} else if (kb.rxn + kb.pn <= sizeof(kb.rxq)) {
+			memcpy(kb.rxq + kb.rxn, kb.pkt, kb.pn);
+			kb.rxn += kb.pn;
+		}
+		kb.pn = 0;
+		kb.pneed = 0;
+		kb.hdr_done = false;
+	}
+}
+
+static void
+kb_ibs_service(void)
+{
+	if (kb.ibs_ack_pending) {
+		uint8_t b = IBS_WAKE_ACK;
+		kb.ibs_ack_pending = false;
+		(void)kb_tx_bytes(&b, 1);
+	}
+}
+
+static void
+kb_ibs_wake(void)
+{
+	if (!kb.ibs_asleep) {
+		return;
+	}
+	for (unsigned attempt = 0; attempt < 3 && kb.ibs_asleep; attempt++) {
+		uint8_t b = IBS_WAKE_IND;
+		(void)kb_tx_bytes(&b, 1);
+		for (unsigned t = 0; t < 100 && kb.ibs_asleep; t++) {
+			kb_rx_poll();
+			if (kb.ibs_asleep) {
+				delay(1000);
+			}
+		}
+	}
+	kb.ibs_asleep = false;          /* send anyway */
+	kb_ibs_service();
+}
+
+/* ---- HCI commands (bring-up mode: answers land in kb.rxq) ---- */
+
+static bool
+kb_hci_send(uint16_t opcode, const uint8_t *params, unsigned plen)
+{
+	uint8_t cmd[4 + 255];
+	if (plen > 255) {
+		return false;
+	}
+	kb_ibs_service();
+	kb_ibs_wake();
+	cmd[0] = 0x01;
+	cmd[1] = (uint8_t)opcode;
+	cmd[2] = (uint8_t)(opcode >> 8);
+	cmd[3] = (uint8_t)plen;
+	if (plen) {
+		memcpy(cmd + 4, params, plen);
+	}
+	return kb_tx_bytes(cmd, 4 + plen);
+}
+
+/* wait for a Command Complete/Status for opcode, or any vendor event */
+static int
+kb_hci_wait(uint16_t opcode, uint8_t *evt_out, unsigned timeout_ms)
+{
+	for (unsigned t = 0; t < timeout_ms; t++) {
+		kb_rx_poll();
+		kb_ibs_service();
+		unsigned pos = 0;
+		while (pos + 3 <= kb.rxn) {
+			if (kb.rxq[pos] != 0x04) {
+				pos++;
+				continue;
+			}
+			unsigned elen = kb.rxq[pos + 2];
+			if (pos + 3 + elen > kb.rxn) {
+				break;
+			}
+			uint8_t ev = kb.rxq[pos + 1];
+			const uint8_t *d = &kb.rxq[pos + 3];
+			bool match = ev == 0xff ||
+			    (ev == 0x0e && elen >= 3 && (d[1] | (d[2] << 8)) == opcode) ||
+			    (ev == 0x0f && elen >= 4 && (d[2] | (d[3] << 8)) == opcode);
+			if (match) {
+				if (evt_out) {
+					evt_out[0] = ev;
+					evt_out[1] = (uint8_t)elen;
+					memcpy(evt_out + 2, d, MIN(elen, 46u));
+				}
+				unsigned rest = kb.rxn - (pos + 3 + elen);
+				memmove(kb.rxq, kb.rxq + pos + 3 + elen, rest);
+				kb.rxn = rest;
+				return 0;
+			}
+			pos += 3 + elen;
+		}
+		delay(1000);
+	}
+	return ETIMEDOUT;
+}
+
+static int
+kb_hci_cmd(uint16_t opcode, const uint8_t *params, unsigned plen, uint8_t *evt_out, unsigned timeout_ms)
+{
+	kb.rxn = 0;
+	if (!kb_hci_send(opcode, params, plen)) {
+		return EIO;
+	}
+	return kb_hci_wait(opcode, evt_out, timeout_ms);
+}
+
+/* ---- firmware ---- */
+
+static uint8_t kb_fw[512 * 1024];
+
+static uint16_t
+le16b(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | (p[1] << 8));
+}
+
+static uint32_t
+le32b(const uint8_t *p)
+{
+	return le16b(p) | ((uint32_t)le16b(p + 2) << 16);
+}
+
+/*
+ * The rampatch TLV header (btqca.h tlv_type_patch): download_mode is byte 14 of
+ * the file. 0 and 2: a vendor event per segment; 1: a command complete per
+ * segment; 3 (what WCN399x patches carry): nothing per segment, only the last
+ * one is acknowledged. The first attempt waited 2 s for each segment and gave
+ * up after four (11/11).
+ */
+static unsigned
+kb_patch_mode(const uint8_t *fw, unsigned len)
+{
+	if (len < 28 || (le32b(fw) & 0xff) != 1) {
+		printf("SWEET KBT: rampatch does not start with a TLV patch header\n");
+		return 0;
+	}
+	printf("SWEET KBT: rampatch TLV: total %u, format %u, download_mode %u, product %#x, rom %#x, patch %#x\n",
+	    le32b(fw + 4), fw[12], fw[14], le16b(fw + 16), le16b(fw + 18), le16b(fw + 20));
+	return fw[14] <= 3 ? fw[14] : 0;
+}
+
+/*
+ * The NVM is a list of tags {id u16, len u16, pad u32, data[len]} after the TLV
+ * header (some images carry one more header word). Tag 17 (HCI transport):
+ * data[0] bit 7 = software in-band sleep, data[2] = the UART baud code the
+ * controller switches to once the NVM is in (WCN3990; btqca.h qca_baudrate,
+ * 115200 = 0). Tag 27: deep sleep bit 0. As ios-sweet: both sleep bits off
+ * (the controller never sleeps, no 0xfd/0xfe protocol to get right first)
+ * and the baud pinned so the controller stays where we talk to it.
+ */
+static void
+kb_nvm_edit(uint8_t *fw, unsigned len, uint8_t baud_code)
+{
+	if (len < 16) {
+		return;
+	}
+	unsigned limit = MIN(len, 4 + (le32b(fw) >> 8));
+	unsigned best_start = 0, best_n = 0;
+	for (unsigned start = 4; start <= 8; start += 4) {
+		unsigned idx = start, prev = 0, n = 0;
+		while (idx + 12 <= limit) {
+			unsigned id = le16b(fw + idx), l = le16b(fw + idx + 2);
+			if (id == 0 || id > 0x400 || id <= prev || idx + 12 + l > limit) {
+				break;
+			}
+			n++;
+			prev = id;
+			idx += 12 + l;
+		}
+		if (n > best_n) {
+			best_n = n;
+			best_start = start;
+		}
+	}
+	if (best_n < 3) {
+		printf("SWEET KBT: NVM tag layout not recognised, sent unmodified\n");
+		return;
+	}
+	unsigned idx = best_start, prev = 0;
+	while (idx + 12 <= limit) {
+		unsigned id = le16b(fw + idx), l = le16b(fw + idx + 2);
+		if (id == 0 || id > 0x400 || id <= prev || idx + 12 + l > limit) {
+			break;
+		}
+		uint8_t *t = fw + idx + 12;
+		if (id == 17 && l >= 3) {
+			printf("SWEET KBT: NVM HCI tag: data %02x %02x %02x; IBS off, baud code %u\n", t[0], t[1], t[2], baud_code);
+			t[0] &= (uint8_t)~0x80;
+			t[2] = baud_code;
+		} else if (id == 27 && l >= 1) {
+			t[0] &= (uint8_t)~0x01;
+		}
+		prev = id;
+		idx += 12 + l;
+	}
+	printf("SWEET KBT: NVM: %u tags from offset %u\n", best_n, best_start);
+}
+
+static int
+kb_download(const char *part, const char name83[11], const char *what, bool is_patch)
+{
+	int64_t len = sweet_fat_read_file_in(part, name83, kb_fw, sizeof(kb_fw));
+	if (len <= 0) {
+		printf("SWEET KBT: %s (%.11s) not found in %s\n", what, name83, part);
+		return ENOENT;
+	}
+	unsigned mode = 0;
+	if (is_patch) {
+		mode = kb_patch_mode(kb_fw, (unsigned)len);
+	} else {
+		kb_nvm_edit(kb_fw, (unsigned)len, 0);
+	}
+	printf("SWEET KBT: sending %s (%lld bytes) in %u-byte segments, download_mode %u\n",
+	    what, (long long)len, EDL_SEGMENT, mode);
+	uint8_t seg[2 + EDL_SEGMENT], evt[48];
+	unsigned sent = 0, acked = 0;
+	bool cc_wait = mode == 1;
+	while (sent < (unsigned)len) {
+		unsigned n = MIN((unsigned)len - sent, EDL_SEGMENT);
+		bool last = sent + n >= (unsigned)len || n < EDL_SEGMENT;
+		unsigned m = last ? 0 : mode;          /* the last segment is always acknowledged */
+		seg[0] = EDL_TLV_REQ;
+		seg[1] = (uint8_t)n;
+		memcpy(seg + 2, kb_fw + sent, n);
+		if (m == 0 || m == 2) {
+			int err = kb_hci_cmd(EDL_OPCODE, seg, 2 + n, evt, last ? 10000 : 2000);
+			if (err) {
+				printf("SWEET KBT: %s: no answer at byte %u (%d)\n", what, sent, err);
+				return err;
+			}
+			/* vendor event {cresp 0, rtype 4 (TLV download), status} */
+			if (evt[0] == 0xff && evt[1] >= 3 && (evt[2] != 0 || evt[3] != 4 || evt[4] != 0)) {
+				printf("SWEET KBT: %s: segment at byte %u refused (%02x %02x %02x)\n", what, sent, evt[2], evt[3], evt[4]);
+				return EIO;
+			}
+			acked++;
+			if ((unsigned)len <= 32 * EDL_SEGMENT) {
+				printf("SWEET KBT: %s: segment at byte %u acknowledged (event %02x len %u: %02x %02x %02x)\n",
+				    what, sent, evt[0], evt[1], evt[2], evt[3], evt[4]);
+			}
+		} else {
+			kb.rxn = 0;
+			if (!kb_hci_send(EDL_OPCODE, seg, 2 + n)) {
+				return EIO;
+			}
+			if (cc_wait && kb_hci_wait(EDL_OPCODE, evt, 100) != 0) {
+				printf("SWEET KBT: %s: no command complete per segment, not waiting for them\n", what);
+				cc_wait = false;
+			}
+			kb_rx_poll();
+			kb_ibs_service();
+		}
+		sent += n;
+	}
+	printf("SWEET KBT: %s sent, %u segments acknowledged\n", what, acked);
+	return 0;
+}
+
+/* ---- the iOS transport ---- */
+
+static bool
+kbt_ops_tx(const uint8_t *pkt, unsigned len)
+{
+	kb_ibs_service();
+	kb_ibs_wake();
+	return kb_tx_bytes(pkt, len);
+}
+
+static unsigned
+kbt_ops_baud(unsigned requested)
+{
+	(void)requested;        /* the controller is already at its operating rate */
+	return kb.baud ? kb.baud : 3200000;
+}
+
+static const struct bt_hci_ops kbt_ops = { kbt_ops_tx, kbt_ops_baud };
+
+/* ---- bring-up thread ---- */
+
+static void
+kirin_bt_thread(__unused void *arg, __unused wait_result_t wr_)
+{
+	unsigned oper = 0;
+	(void)PE_parse_boot_argn("sweetbtbaud", &oper, sizeof(oper));
+	extern void sweet_wait_for_cpus(const char *who);
+	sweet_wait_for_cpus("KBT");
+
+	bt_gcc = (volatile uint32_t *)ml_io_map(GCC_PA, 0x100000);
+	bt_tlmm = (volatile uint32_t *)ml_io_map(TLMM_CENTER_PA, 0x1000 * (BT_GPIO_FIRST + 4));
+	bt_uart = (volatile uint32_t *)ml_io_map(UART_PA, 0x1000);
+	if (!bt_gcc || !bt_tlmm || !bt_uart) {
+		printf("SWEET KBT: a register region could not be mapped\n");
+		return;
+	}
+
+	kb_rails();
+	kb_clocks();
+	kb_pins();
+	kb.raw_budget = 64;
+
+	/* power-off pulse at 2400 baud, then power-on pulse at 115200, no flow control */
+	kb_uart_setup(0);
+	kb_baud(2400);
+	uint8_t pulse = QCA_PULSE_OFF;
+	(void)kb_tx_bytes(&pulse, 1);
+	kb_sleep(10);
+	kb_baud(115200);
+	pulse = QCA_PULSE_ON;
+	(void)kb_tx_bytes(&pulse, 1);
+	kb_sleep(100);
+
+	/* operate: flow control on, 115200 (or sweetbtbaud) */
+	kb_uart_setup(1);
+	kb_baud(oper ? oper : 115200);
+	kb_sleep(50);
+	kb_rx_poll();
+	printf("SWEET KBT: after the power-on pulse: %u stray RX bytes\n", kb.rxn);
+	kb.rxn = 0;
+
+	uint8_t evt[48];
+	int err = kb_hci_cmd(0x0c03, NULL, 0, evt, 1000);       /* HCI Reset, as a first sign of life */
+	printf("SWEET KBT: HCI Reset before firmware: %d%s\n", err, err ? "" : " (event received)");
+
+	uint8_t ver = EDL_VER_REQ;
+	err = kb_hci_cmd(EDL_OPCODE, &ver, 1, evt, 2000);
+	if (err) {
+		printf("SWEET KBT: no answer to the EDL version request (%d); SR %#x RXFS %#x\n",
+		    err, rd(bt_uart, UART_SR), rd(bt_uart, UART_RXFS));
+		return;
+	}
+	printf("SWEET KBT: EDL version event %02x len %u: %02x %02x %02x %02x %02x %02x %02x %02x\n",
+	    evt[0], evt[1], evt[2], evt[3], evt[4], evt[5], evt[6], evt[7], evt[8], evt[9]);
+
+	/* rampatch then NVM, from the phone's bluetooth partition */
+	const char *part = "bluetooth_a";
+	if (kb_download(part, "CRBTFW21TLV", "rampatch", true) == ENOENT) {
+		part = "bluetooth";
+		if (kb_download(part, "CRBTFW21TLV", "rampatch", true) != 0) {
+			return;
+		}
+	}
+	kb_sleep(100);
+	(void)kb_download(part, "CRNV21  BIN", "NVM", false);
+	kb_sleep(100);
+
+	err = kb_hci_cmd(0x0c03, NULL, 0, evt, 2000);   /* HCI Reset */
+	printf("SWEET KBT: HCI Reset: %d (event %02x status %02x)\n", err, evt[0], err ? 0 : evt[5]);
+	if (err) {
+		return;
+	}
+
+	/* hand the controller to iOS and keep draining RX */
+	kb.xport = true;
+	kb.raw_budget = 0;
+	bt_hci_register(&kbt_ops, 0, 64);
+	printf("SWEET KBT: controller up, H4 handed to com.apple.uart.bluetooth\n");
+	unsigned idle = 0;
+	for (;;) {
+		unsigned before = kb.pn + kb.rxn;
+		kb_rx_poll();
+		kb_ibs_service();
+		bt_hci_rx_service();
+		idle = (kb.pn + kb.rxn != before) ? 0 : idle + 1;
+		kb_sleep(idle > 16 ? 4 : 1);
+	}
+}
+
+void
+kirin_bt_init(void)
+{
+	int on = 0;
+	thread_t t;
+	if (!PE_parse_boot_argn("sweetbt", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	if (kernel_thread_start(kirin_bt_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
+#endif /* SWEET_KIRIN */
