+/*
+ * kirin, boot-arg sweetmodem=1: bring up the SDM630 modem (MSS, the Hexagon Q6 that runs
+ * the cellular and Wi-Fi firmware), stage A. Unlike the ADSP (a simple TrustZone PAS), the
+ * modem self-authenticates through its MBA (Modem Boot Authenticator), as Linux's
+ * pil-q6v5-mss / pil-msa / pil-q6v5 for DT /soc/qcom,mss@4080000 (qcom,pil-q6v55-mss,
+ * qdsp6v62-1-5):
+ *
+ *   GCC clocks    MSS cfg_ahb, q6_bimc_axi, snoc_axi, mnoc_bimc_axi, boot_rom (0x100000)
+ *   reset         MSS_RESTART (GCC 0x179000): assert (1), then deassert (0)
+ *   MBA           mba.bin loaded into the MBA region (0x94800000); its address written to
+ *                 RMB_MBA_IMAGE (rmb_base 0x4180000 + 0x00)
+ *   Q6 out of     the QDSP6SS register dance (reg_base 0x4080000): XO clock, BHS head switch,
+ *   reset         LDO bypass, memory clamps and power, core out of reset, core clock
+ *   handshake     poll RMB_PBL_STATUS == 1 (the PBL validated the MBA), then RMB_MBA_STATUS
+ *
+ * Stage A stops once the MBA runs (PBL success). Loading modem.mdt and its segments through
+ * the RMB protocol, SMP2P, rmtfs, QMI are the later stages (research/modem-notes.md). No RPM
+ * rail votes yet: the bootloader left vdd_cx/vdd_mx on; if the PBL never validates, add them.
+ */
+#if defined(SWEET_KIRIN)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <arm/caches_internal.h>
+#include <arm/memory_types.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, uint32_t flags);
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t sz);
+extern vm_map_address_t phystokv(uint64_t pa);
+void sweet_modem_init(void);
+
+#define GCC_PA          0x00100000ull
+#define QDSP6SS_PA      0x04080000ull
+#define RMB_PA          0x04180000ull
+#define MSS_RESTART     0x00179000ull         /* GCC MSS_RESTART, a 4 KB page of its own */
+#define MBA_PA          0x94800000ull
+#define MBA_SZ          0x00200000u
+#define MODEM_PA        0x8ac00000ull
+#define MODEM_SZ        0x07e00000u
+
+/* GCC clock branch enable registers (offsets in the GCC block), and their enable bits */
+#define GCC_MSS_CFG_AHB         0x8a000
+#define GCC_MSS_Q6_BIMC_AXI     0x8a040
+#define GCC_MSS_SNOC_AXI        0x8a03c
+#define GCC_MSS_MNOC_BIMC_AXI   0x8a004
+#define GCC_BOOT_ROM_AHB        0x52004        /* bit 10, votable (halt reg 0x38004) */
+/*
+ * The two clocks the DT lists that were missing (gcc-sdm660.c): bus_clk is
+ * GCC_BIMC_MSS_Q6_AXI (0x4401c, not the MSS-side 0x8a040), and gpll0_mss_clk is
+ * GPLL0_OUT_MSSCC (0x5200c bit 2), the gate that feeds GPLL0 to the modem's own
+ * clock controller. Without it the Q6 core has no clock source, so the PBL never
+ * runs while every power handshake (BHS) still acks: the stage A symptom.
+ */
+#define GCC_BIMC_MSS_Q6_AXI     0x4401c
+#define GCC_GPLL0_OUT_MSSCC     0x5200c        /* bit 2, halt check is a fixed delay */
+
+/* QDSP6SS registers (offsets in reg_base) */
+#define QDSP6SS_RESET           0x014
+#define QDSP6SS_GFMUX_CTL       0x020
+#define QDSP6SS_PWR_CTL         0x030
+#define QDSP6SS_XO_CBCR         0x038
+#define QDSP6V6SS_MEM_PWR_CTL   0x034         /* v62 memory power (not the v56 0x0b0) */
+#define QDSP6V62SS_BHS_STATUS   0x0c4
+#define QDSP6SS_STRAP_ACC       0x110
+
+#define Q6SS_STOP_CORE          (1u << 0)
+#define Q6SS_CORE_ARES          (1u << 1)
+#define Q6SS_BUS_ARES_ENA       (1u << 2)
+#define Q6SS_CLK_ENA            (1u << 1)
+#define Q6SS_L2DATA_STBY_N      (1u << 18)
+#define Q6SS_SLP_RET_N          (1u << 19)
+#define Q6SS_CLAMP_IO           (1u << 20)
+#define Q6v55_CLAMP_WL          (1u << 21)
+#define Q6v55_CLAMP_QMC_MEM     (1u << 22)
+#define Q6v55_BHS_ON            (1u << 24)
+#define Q6v55_LDO_BYP           (1u << 25)
+#define Q6v55_BHS_EN_REST_ACK   (1u << 0)
+
+/* RMB protocol (offsets in rmb_base) */
+#define RMB_MBA_IMAGE           0x00
+#define RMB_PBL_STATUS          0x04
+#define RMB_MBA_COMMAND         0x08
+#define RMB_MBA_STATUS          0x0c
+#define RMB_PMI_META_DATA       0x10
+#define RMB_PMI_CODE_START      0x14
+#define RMB_PMI_CODE_LENGTH     0x18
+#define STATUS_PBL_SUCCESS      0x1
+#define CMD_META_DATA_READY     0x1
+#define CMD_LOAD_READY          0x2
+#define STATUS_META_DATA_AUTH_SUCCESS   0x3
+#define STATUS_AUTH_COMPLETE            0x4
+
+static volatile uint32_t *gcc, *q6, *rmb, *restart;
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+
+struct elf_phdr32 {
+	uint32_t type, offset, vaddr, paddr, filesz, memsz, flags, align;
+};
+
+/* wait for RMB_MBA_STATUS to reach want (or go negative = error) */
+static int
+rmb_wait(uint32_t want, const char *what)
+{
+	for (int i = 0; i < 5000; i++) {
+		int32_t st = (int32_t)rmb[RMB_MBA_STATUS / 4];
+		if (st < 0) {
+			printf("SWEET MODEM: %s: MBA error %d\n", what, st);
+			return -1;
+		}
+		if ((uint32_t)st == want) {
+			return 0;
+		}
+		delay(1000);
+	}
+	printf("SWEET MODEM: %s: timeout (MBA_STATUS %#x)\n", what, rmb[RMB_MBA_STATUS / 4]);
+	return -1;
+}
+
+/*
+ * Memory ownership. The modem runs under its own VMID (15, VMID_MSS_MSA, the DT's
+ * qcom,mem-protect-id): the hypervisor's stage-2 tables only let it touch memory
+ * assigned to that VMID. Linux (peripheral-loader.c pil_assign_mem_to_*, secure_buffer.c
+ * hyp_assign_phys) hands the MBA buffer, the metadata buffer and the firmware region
+ * over from HLOS (VMID 3) before each RMB step, and takes them back after. Without the
+ * first hand-over the PBL cannot fetch the MBA and reports an error instead of success
+ * (RMB_PBL_STATUS 0xef110000 on kirin, 10/11, with every clock and rail in place).
+ *
+ * SCM svc 0xc (MP) cmd 0x16 (MEM_PROT_ASSIGN), seven arguments: a list of {addr, size},
+ * a list of source VMIDs, a list of {vmid, perm, ctx, ctx_size} destinations, a spare.
+ * Arguments past the third travel in a buffer whose physical address goes in x5
+ * (scm.c allocate_extra_arg_buffer, SCM_ARMV8_64: seven u64). The arginfo is
+ * SCM_ARGS(7, RO, VAL, RO, VAL, RO, VAL, VAL) = 0x1117.
+ */
+#define VMID_HLOS       3u
+#define VMID_MSS_MSA    15u
+#define HYP_PERM_R      4u
+#define HYP_PERM_W      2u
+#define HYP_PERM_X      1u
+
+enum hyp_move {
+	HYP_TO_MSS,     /* HLOS gives it to the modem (RW) */
+	HYP_TO_HLOS,    /* the modem gives it back (RWX) */
+	HYP_SHARE,      /* HLOS keeps it (RW) and the modem gets it too (RW): while we write the segments */
+	HYP_RECLAIM,    /* shared, then the modem alone (RW): before the final authentication */
+};
+
+struct hyp_mem_info {
+	uint64_t addr, size;
+};
+struct hyp_dest_info {
+	uint32_t vm, perm;
+	uint64_t ctx;
+	uint32_t ctx_size, pad;
+};
+
+static int64_t
+modem_scm(uint32_t svc, uint32_t cmd, uint32_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t d, uint64_t *r1)
+{
+	uint64_t fn = (1ull << 30) | (2ull << 24) | ((uint64_t)svc << 8) | cmd;
+	for (int busy = 0;; busy++) {
+		uint64_t a0 = fn, a6 = 0;
+		register uint64_t x0 __asm__("x0"), x1 __asm__("x1"), x2 __asm__("x2"), x3 __asm__("x3");
+		register uint64_t x4 __asm__("x4"), x5 __asm__("x5"), x6 __asm__("x6"), x7 __asm__("x7");
+		do {
+			x0 = a0; x1 = arginfo; x2 = a; x3 = b; x4 = c; x5 = d; x6 = a6; x7 = 0;
+			__asm__ volatile("smc #0"
+			    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+			    :
+			    : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+			a0 = 1;
+			a6 = x6;
+		} while (x0 == 1);
+		if ((int64_t)x0 != -12 || busy >= 20) {
+			if (r1) {
+				*r1 = x1;
+			}
+			return (int64_t)x0;
+		}
+		delay(30000);
+	}
+}
+
+static vm_offset_t hyp_args_va;
+static uint64_t hyp_args_pa;
+
+static int
+hyp_assign(uint64_t pa, uint64_t size, enum hyp_move move, const char *what)
+{
+	if (hyp_args_va == 0) {
+		if (kmem_alloc_contig(kernel_map, &hyp_args_va, PAGE_SIZE, PAGE_MASK, 0, 0,
+		    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			printf("SWEET MODEM: no page for the hyp_assign arguments\n");
+			return -1;
+		}
+		hyp_args_pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)hyp_args_va));
+	}
+	uint8_t *p = (uint8_t *)hyp_args_va;
+	bzero(p, PAGE_SIZE);
+	struct hyp_mem_info *mi = (struct hyp_mem_info *)(p + 0x00);
+	uint32_t *src = (uint32_t *)(p + 0x40);
+	struct hyp_dest_info *dst = (struct hyp_dest_info *)(p + 0x80);
+	uint64_t *extra = (uint64_t *)(p + 0x100);
+	unsigned nsrc = 1, ndst = 1;
+
+	mi->addr = pa;
+	mi->size = size;
+	switch (move) {
+	case HYP_TO_MSS:
+		src[0] = VMID_HLOS;
+		dst[0].vm = VMID_MSS_MSA;
+		dst[0].perm = HYP_PERM_R | HYP_PERM_W;
+		break;
+	case HYP_TO_HLOS:
+		src[0] = VMID_MSS_MSA;
+		dst[0].vm = VMID_HLOS;
+		dst[0].perm = HYP_PERM_R | HYP_PERM_W | HYP_PERM_X;
+		break;
+	case HYP_SHARE:
+		src[0] = VMID_HLOS;
+		dst[0].vm = VMID_HLOS;
+		dst[0].perm = HYP_PERM_R | HYP_PERM_W;
+		dst[1].vm = VMID_MSS_MSA;
+		dst[1].perm = HYP_PERM_R | HYP_PERM_W;
+		ndst = 2;
+		break;
+	case HYP_RECLAIM:
+		src[0] = VMID_HLOS;
+		src[1] = VMID_MSS_MSA;
+		nsrc = 2;
+		dst[0].vm = VMID_MSS_MSA;
+		dst[0].perm = HYP_PERM_R | HYP_PERM_W;
+		break;
+	}
+	/* arguments 3 to 9: source list size, destination list address and size, spare */
+	extra[0] = nsrc * sizeof(uint32_t);
+	extra[1] = hyp_args_pa + 0x80;
+	extra[2] = ndst * sizeof(struct hyp_dest_info);
+	flush_dcache64((addr64_t)hyp_args_pa, PAGE_SIZE, TRUE);
+
+	uint64_t r1 = 0;
+	int64_t r = modem_scm(0xc, 0x16, 0x1117, hyp_args_pa, sizeof(*mi), hyp_args_pa + 0x40,
+	    hyp_args_pa + 0x100, &r1);
+	printf("SWEET MODEM: hyp_assign %s (%#llx + %#llx, move %d): %lld/%#llx\n",
+	    what, pa, size, (int)move, r, r1);
+	return (r == 0 && r1 == 0) ? 0 : -1;
+}
+
+/* for sweet_mglink.c: a buffer the modem must read and write too (rmtfs) */
+int sweet_modem_share_with_mss(uint64_t pa, uint64_t size);
+int
+sweet_modem_share_with_mss(uint64_t pa, uint64_t size)
+{
+	return hyp_assign(pa, size, HYP_SHARE, "shared buffer");
+}
+
+/*
+ * A tiny read-only FAT16 reader over the eMMC "modem_a" partition: the modem firmware
+ * (image/modem.mdt and image/modem.bNN) is there, and it is too big (57 MB) to carry in the
+ * boot payload (it overflowed the payload region and reset the phone before any log). The
+ * files are read from the partition at boot instead, with sweet_emmc_read_partition.
+ */
+extern int sweet_emmc_read_partition(const char *want, uint64_t off, uint32_t count, void *out, uint64_t *total);
+#define MODEM_PART      "modem_a"
+
+/*
+ * The reader serves other FAT firmware partitions too (Bluetooth:
+ * sweet_fat_read_file_in below), one caller at a time under fat_lock;
+ * fat_part is the partition the static state belongs to.
+ */
+static const char *fat_part = MODEM_PART;
+static LCK_GRP_DECLARE(sweet_fat_grp, "sweet_fat");
+static LCK_MTX_DECLARE(sweet_fat_lock, &sweet_fat_grp);
+
+#define FAT_SECMAX      4096u           /* largest FAT logical sector we handle (modem_a uses 4096) */
+
+static uint32_t fat_bps;                /* bytes per FAT logical sector (512 or 4096 here) */
+static uint32_t fat_r;                  /* 512-byte eMMC sectors per FAT sector (bps / 512) */
+static uint32_t fat_spc;                /* FAT sectors per cluster */
+static uint32_t fat_clbytes;            /* bytes per cluster (spc * bps) */
+static uint32_t fat_fat_sec, fat_root_sec, fat_root_fs, fat_data_sec, fat_root_ents;
+static uint8_t fat_sb[FAT_SECMAX];      /* scratch for one FAT sector (BPB, directory) */
+static uint8_t fat_cache[FAT_SECMAX];   /* the last-read FAT-table sector, cached while walking a chain */
+static uint32_t fat_cache_sec;
+static int fat_cache_valid;
+static uint8_t fat_bounce[64 * 1024];   /* one cluster (mount rejects a FAT whose cluster is larger) */
+
+static uint16_t
+u16le(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | (p[1] << 8));
+}
+
+/*
+ * modem_a is a FAT with 4096-byte logical sectors, while sweet_emmc_read_partition works in
+ * 512-byte eMMC sectors (and re-parses the GPT and copies through a 1 MB bounce on every call,
+ * capped at 2048 sectors). fat_rd takes a count in FAT sectors and converts: the readers below
+ * coalesce contiguous clusters into reads of up to 1 MB and cache the FAT-table sector while
+ * following a chain, to move the 57 MB image in as few calls as possible.
+ */
+static int
+fat_rd(uint32_t fs, uint32_t n, void *out)
+{
+	uint64_t total = 0;
+	return sweet_emmc_read_partition(fat_part, (uint64_t)fs * fat_r, n * fat_r, out, &total);
+}
+
+static int
+fat_mount(void)
+{
+	uint64_t total = 0;
+	fat_cache_valid = 0;
+	/* the BPB is in the first 512 bytes; read one raw eMMC sector for it */
+	if (sweet_emmc_read_partition(fat_part, 0, 1, fat_sb, &total) != 0) {
+		printf("SWEET MODEM: cannot read %s sector 0\n", fat_part);
+		return -1;
+	}
+	fat_bps = u16le(fat_sb + 0x0b);
+	fat_spc = fat_sb[0x0d];
+	uint32_t rsvd = u16le(fat_sb + 0x0e);
+	uint32_t nfat = fat_sb[0x10];
+	fat_root_ents = u16le(fat_sb + 0x11);
+	uint32_t spf = u16le(fat_sb + 0x16);
+	if (fat_bps < 512 || fat_bps > FAT_SECMAX || (fat_bps & (fat_bps - 1)) != 0 ||
+	    fat_spc == 0 || (uint32_t)fat_spc * fat_bps > sizeof(fat_bounce)) {
+		printf("SWEET MODEM: unsupported FAT (bps %u spc %u)\n", fat_bps, fat_spc);
+		return -1;
+	}
+	fat_r = fat_bps / 512;
+	fat_clbytes = fat_spc * fat_bps;
+	fat_fat_sec = rsvd;
+	fat_root_sec = rsvd + nfat * spf;
+	fat_root_fs = (fat_root_ents * 32 + fat_bps - 1) / fat_bps;
+	fat_data_sec = fat_root_sec + fat_root_fs;
+	return 0;
+}
+
+static uint32_t
+fat_next(uint32_t cl)
+{
+	uint32_t off = cl * 2;
+	uint32_t sec = fat_fat_sec + off / fat_bps;
+	if (!fat_cache_valid || sec != fat_cache_sec) {
+		if (fat_rd(sec, 1, fat_cache) != 0) {
+			return 0xffff;
+		}
+		fat_cache_sec = sec;
+		fat_cache_valid = 1;
+	}
+	return u16le(fat_cache + (off % fat_bps));
+}
+
+/* find an 8.3 name (11 bytes, space padded) in a directory; the root when dir_cluster == 0 */
+static int
+fat_find(uint32_t dir_cluster, const char name[11], uint32_t *first_cl, uint32_t *fsize, int *is_dir)
+{
+	uint32_t cl = dir_cluster;
+	for (;;) {
+		uint32_t base, nsec;
+		if (dir_cluster == 0) {         /* FAT16 root: contiguous */
+			base = fat_root_sec;
+			nsec = fat_root_fs;
+		} else {
+			base = fat_data_sec + (cl - 2) * fat_spc;
+			nsec = fat_spc;
+		}
+		for (uint32_t s = 0; s < nsec; s++) {
+			if (fat_rd(base + s, 1, fat_sb) != 0) {
+				return -1;
+			}
+			for (uint32_t e = 0; e < fat_bps; e += 32) {
+				const uint8_t *d = fat_sb + e;
+				if (d[0] == 0x00) {
+					return -1;      /* end of directory */
+				}
+				if (d[0] == 0xe5 || (d[0x0b] & 0x0f) == 0x0f) {
+					continue;       /* deleted or long-name entry */
+				}
+				if (memcmp(d, name, 11) == 0) {
+					*first_cl = u16le(d + 0x1a);
+					*fsize = *(const uint32_t *)(d + 0x1c);
+					*is_dir = (d[0x0b] & 0x10) != 0;
+					return 0;
+				}
+			}
+		}
+		if (dir_cluster == 0) {
+			return -1;
+		}
+		cl = fat_next(cl);
+		if (cl < 2 || cl >= 0xfff8) {
+			return -1;
+		}
+	}
+}
+
+/* read a file (by its 8.3 name in dir_cluster, root if 0) into dest, up to maxlen; size, or -1 */
+static int64_t
+fat_read_file(uint32_t dir_cluster, const char name[11], uint8_t *dest, uint32_t maxlen)
+{
+	uint32_t cl, fsize;
+	int is_dir;
+	if (fat_find(dir_cluster, name, &cl, &fsize, &is_dir) != 0 || is_dir) {
+		return -1;
+	}
+	if (fsize > maxlen) {
+		printf("SWEET MODEM: %.11s is %u bytes, over the %u-byte buffer\n", name, fsize, maxlen);
+		return -1;
+	}
+	uint32_t maxrun = 2048 / (fat_spc * fat_r);     /* clusters per read, within the 1 MB bounce */
+	if (maxrun == 0) {
+		maxrun = 1;
+	}
+	uint32_t got = 0;
+	while (cl >= 2 && cl < 0xfff8 && got < fsize) {
+		uint32_t remain = fsize - got;
+		if (remain < fat_clbytes) {
+			/* the final, partial cluster: read it whole, copy only what the file holds */
+			if (fat_rd(fat_data_sec + (cl - 2) * fat_spc, fat_spc, fat_bounce) != 0) {
+				return -1;
+			}
+			memcpy(dest + got, fat_bounce, remain);
+			got += remain;
+			break;
+		}
+		/* gather a run of physically contiguous full clusters, up to the bounce size */
+		uint32_t start = cl, run = 1;
+		while (run < maxrun && (uint64_t)(run + 1) * fat_clbytes <= remain) {
+			uint32_t nx = fat_next(cl);
+			if (nx != cl + 1) {
+				break;
+			}
+			cl = nx;
+			run++;
+		}
+		uint32_t nx = fat_next(cl);
+		if (fat_rd(fat_data_sec + (start - 2) * fat_spc, run * fat_spc, dest + got) != 0) {
+			return -1;
+		}
+		got += run * fat_clbytes;
+		cl = nx;
+	}
+	return got;
+}
+
+/*
+ * Stage B: load modem.mdt and its segments through the RMB, as pil_msa_auth_modem_mdt and
+ * pil_msa_mba_verify_blob. The files come from the modem_a partition (above). The MBA
+ * authenticates the metadata, then each PT_LOAD segment as it is written to its physical
+ * address in the modem region.
+ */
+static uint8_t modem_mdt[64 * 1024];    /* the .mdt: ELF header, phdrs, hash segment and cert chain */
+
+static int modem_load_locked(void);
+static int
+modem_load(void)
+{
+	lck_mtx_lock(&sweet_fat_lock);
+	fat_part = MODEM_PART;
+	int r = modem_load_locked();
+	lck_mtx_unlock(&sweet_fat_lock);
+	return r;
+}
+
+static int
+modem_load_locked(void)
+{
+	if (fat_mount() != 0) {
+		return -1;
+	}
+	uint32_t image_cl = 0, dummy;   /* the root by default; Qualcomm usually puts them under image/ */
+	int is_dir;
+	if (fat_find(0, "IMAGE      ", &image_cl, &dummy, &is_dir) == 0 && is_dir) {
+		printf("SWEET MODEM: reading the firmware from %s:/image\n", MODEM_PART);
+	} else {
+		image_cl = 0;
+		printf("SWEET MODEM: no image/, reading the firmware from %s root\n", MODEM_PART);
+	}
+	int64_t mdt_len = fat_read_file(image_cl, "MODEM   MDT", modem_mdt, sizeof(modem_mdt));
+	if (mdt_len < 0x34) {
+		printf("SWEET MODEM: modem.mdt not read (%lld)\n", mdt_len);
+		return -1;
+	}
+	const uint8_t *mdt = modem_mdt;
+	uint32_t phoff = *(const uint32_t *)(mdt + 0x1c);
+	uint16_t phnum = *(const uint16_t *)(mdt + 0x2c);
+	if (phnum > 64 || phoff + 32ull * phnum > (uint64_t)mdt_len) {
+		printf("SWEET MODEM: bad modem.mdt (%u phdrs)\n", phnum);
+		return -1;
+	}
+
+	/* metadata (the .mdt) in a physically contiguous, cache-flushed buffer */
+	vm_offset_t meta_va = 0;
+	vm_size_t meta_sz = round_page((uint32_t)mdt_len);
+	if (kmem_alloc_contig(kernel_map, &meta_va, meta_sz, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return -1;
+	}
+	memcpy((void *)meta_va, mdt, (size_t)mdt_len);
+	uint64_t meta_pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)meta_va));
+	flush_dcache64((addr64_t)meta_pa, (unsigned)meta_sz, TRUE);
+	/* the MBA reads the metadata itself: hand the buffer over for the duration of the check */
+	if (hyp_assign(meta_pa, meta_sz, HYP_TO_MSS, "metadata") != 0) {
+		return -1;
+	}
+
+	rmb[RMB_PMI_CODE_LENGTH / 4] = 0;
+	rmb[RMB_PMI_META_DATA / 4] = (uint32_t)meta_pa;
+	rmb[RMB_MBA_COMMAND / 4] = CMD_META_DATA_READY;
+	__builtin_arm_dsb(0xf);
+	int meta_ok = rmb_wait(STATUS_META_DATA_AUTH_SUCCESS, "metadata auth");
+	(void)hyp_assign(meta_pa, meta_sz, HYP_TO_HLOS, "metadata back");
+	if (meta_ok != 0) {
+		return -1;
+	}
+	printf("SWEET MODEM: metadata authenticated\n");
+
+	/*
+	 * 126 MB of VA: ml_io_map_wcomb carves permanent space out of the small io
+	 * submap and panics for want of room (kmem_alloc failed with 3, 11/11); the
+	 * unmappable variant allocates from kernel_map and ml_io_unmap frees it.
+	 */
+	uint8_t *region = (uint8_t *)ml_io_map_unmappable(MODEM_PA, MODEM_SZ, VM_WIMG_WCOMB);
+	if (!region) {
+		printf("SWEET MODEM: the modem region cannot be mapped\n");
+		return -1;
+	}
+	/* the firmware region: ours and the modem's while the segments are written (pil_boot) */
+	if (hyp_assign(MODEM_PA, MODEM_SZ, HYP_SHARE, "modem region shared") != 0) {
+		return -1;
+	}
+	uint32_t total_len = 0, loaded = 0;
+	for (uint32_t i = 0; i < phnum; i++) {
+		const struct elf_phdr32 *ph = (const struct elf_phdr32 *)(mdt + phoff + 32 * i);
+		if (ph->type != 1 || ((ph->flags >> 24) & 7) == 2 || ph->memsz == 0) {
+			continue;       /* only PT_LOAD that is not the hash segment */
+		}
+		if (ph->paddr < MODEM_PA || ph->paddr + (uint64_t)ph->memsz > MODEM_PA + MODEM_SZ) {
+			printf("SWEET MODEM: segment %u (%#x + %#x) outside the region\n", i, ph->paddr, ph->memsz);
+			return -1;
+		}
+		uint8_t *dst = region + (ph->paddr - MODEM_PA);
+		bzero(dst, ph->memsz);
+		if (ph->filesz > 0) {
+			char nm[11];
+			memcpy(nm, "MODEM   B  ", 11);
+			nm[8] = 'B';
+			nm[9] = '0' + (i / 10);
+			nm[10] = '0' + (i % 10);
+			if (fat_read_file(image_cl, nm, dst, ph->memsz) < 0) {
+				printf("SWEET MODEM: segment %u (modem.b%02u) not read\n", i, i);
+				return -1;
+			}
+		}
+		__builtin_arm_dsb(0xf);
+		if (total_len == 0) {
+			rmb[RMB_PMI_CODE_START / 4] = ph->paddr;
+			rmb[RMB_MBA_COMMAND / 4] = CMD_LOAD_READY;
+			__builtin_arm_dsb(0xf);
+		}
+		total_len += ph->memsz;
+		rmb[RMB_PMI_CODE_LENGTH / 4] = total_len;
+		__builtin_arm_dsb(0xf);
+		if ((int32_t)rmb[RMB_MBA_STATUS / 4] < 0) {
+			printf("SWEET MODEM: segment %u refused (MBA_STATUS %#x)\n", i, rmb[RMB_MBA_STATUS / 4]);
+			return -1;
+		}
+		loaded++;
+	}
+	printf("SWEET MODEM: %u segments loaded (%u bytes), waiting for auth complete\n", loaded, total_len);
+	ml_io_unmap((vm_offset_t)region, MODEM_SZ);
+	/* the modem alone owns its firmware from here on (pil_reclaim_mem); we never touch region again */
+	if (hyp_assign(MODEM_PA, MODEM_SZ, HYP_RECLAIM, "modem region to the modem") != 0) {
+		return -1;
+	}
+	if (rmb_wait(STATUS_AUTH_COMPLETE, "modem auth") != 0) {
+		return -1;
+	}
+	printf("SWEET MODEM: THE MODEM IMAGE IS AUTHENTICATED AND RUNNING\n");
+	return 0;
+}
+
+
+/*
+ * Read one 8.3-named file from a FAT firmware partition (image/ first, then
+ * the root), for other drivers: Bluetooth reads crbtfw21.tlv/crnv21.bin from
+ * the bluetooth partition this way. Returns the byte count, or -1.
+ */
+int64_t sweet_fat_read_file_in(const char *part, const char name83[11], uint8_t *dest, uint32_t maxlen);
+int64_t
+sweet_fat_read_file_in(const char *part, const char name83[11], uint8_t *dest, uint32_t maxlen)
+{
+	lck_mtx_lock(&sweet_fat_lock);
+	fat_part = part;
+	int64_t r = -1;
+	if (fat_mount() == 0) {
+		uint32_t image_cl = 0, dummy;
+		int is_dir;
+		uint32_t dir = 0;
+		if (fat_find(0, "IMAGE      ", &image_cl, &dummy, &is_dir) == 0 && is_dir) {
+			dir = image_cl;
+		}
+		r = fat_read_file(dir, name83, dest, maxlen);
+		if (r < 0 && dir != 0) {
+			r = fat_read_file(0, name83, dest, maxlen);
+		}
+	}
+	fat_part = MODEM_PART;
+	lck_mtx_unlock(&sweet_fat_lock);
+	return r;
+}
+
+static void
+clk_on(uint32_t off, uint32_t bit)
+{
+	gcc[off / 4] |= bit;
+	__builtin_arm_dsb(0xf);
+	for (int i = 0; i < 1000; i++) {
+		if (!(gcc[off / 4] & (1u << 31))) {       /* CLK_OFF clear = running */
+			return;
+		}
+		delay(1);
+	}
+	printf("SWEET MODEM: GCC clock %#x stays off (%#x)\n", off, gcc[off / 4]);
+}
+
+/* the QDSP6SS v62_1_5 reset: head switch, LDO, memory, core out of reset */
+static int
+q6_bring_up(void)
+{
+	int i;
+	/* assert resets, stop core */
+	q6[QDSP6SS_RESET / 4] |= Q6SS_CORE_ARES | Q6SS_BUS_ARES_ENA | Q6SS_STOP_CORE;
+	__builtin_arm_dsb(0xf);
+	/* BHS needs the XO clock */
+	q6[QDSP6SS_XO_CBCR / 4] |= 1u;
+	__builtin_arm_dsb(0xf);
+	for (i = 0; i < 200 && (q6[QDSP6SS_XO_CBCR / 4] & (1u << 31)); i++) {
+		delay(1);
+	}
+	/* head switch on, wait for the BHS acknowledge */
+	q6[QDSP6SS_PWR_CTL / 4] |= Q6v55_BHS_ON;
+	__builtin_arm_dsb(0xf);
+	delay(1);
+	for (i = 200; i > 0; i--) {
+		if (q6[QDSP6V62SS_BHS_STATUS / 4] & Q6v55_BHS_EN_REST_ACK) {
+			break;
+		}
+		delay(1);
+	}
+	if (i == 0) {
+		printf("SWEET MODEM: BHS acknowledge never came (PWR_CTL %#x BHS_STATUS %#x)\n",
+		    q6[QDSP6SS_PWR_CTL / 4], q6[QDSP6V62SS_BHS_STATUS / 4]);
+		return -1;
+	}
+	/* LDO bypass */
+	q6[QDSP6SS_PWR_CTL / 4] |= Q6v55_LDO_BYP;
+	/* deassert the compiler memory clamp */
+	q6[QDSP6SS_PWR_CTL / 4] &= ~Q6v55_CLAMP_QMC_MEM;
+	/* deassert memory peripheral sleep and L2 standby */
+	q6[QDSP6SS_PWR_CTL / 4] |= Q6SS_L2DATA_STBY_N | Q6SS_SLP_RET_N;
+	__builtin_arm_dsb(0xf);
+	/* turn on L1/L2/ETB/JU memories one bit at a time (v62_1_5: QDSP6V6SS_MEM_PWR_CTL, 29..0) */
+	uint32_t m = q6[QDSP6V6SS_MEM_PWR_CTL / 4];
+	for (i = 29; i >= 0; i--) {
+		m |= (1u << i);
+		q6[QDSP6V6SS_MEM_PWR_CTL / 4] = m;
+		delay(1);
+	}
+	/* remove word-line and IO clamps */
+	q6[QDSP6SS_PWR_CTL / 4] &= ~Q6v55_CLAMP_WL;
+	q6[QDSP6SS_PWR_CTL / 4] &= ~Q6SS_CLAMP_IO;
+	__builtin_arm_dsb(0xf);
+	/* core out of reset, core clock on */
+	q6[QDSP6SS_RESET / 4] &= ~(Q6SS_CORE_ARES | Q6SS_STOP_CORE);
+	__builtin_arm_dsb(0xf);
+	q6[QDSP6SS_GFMUX_CTL / 4] |= Q6SS_CLK_ENA;
+	__builtin_arm_dsb(0xf);
+	return 0;
+}
+
+/*
+ * The bring-up threads used to start while the secondary CPUs were still being
+ * brought up, and twice (11/11) cpu 4 (mpidr 0, the first core of the other
+ * cluster) took a synchronous exception at start-up with the modem's first SCM
+ * call (hyp_assign) in flight on cpu 0. Wait until every CPU is up: it also
+ * puts the modem log after the USB console comes up.
+ */
+void sweet_wait_for_cpus(const char *who);
+void
+sweet_wait_for_cpus(const char *who)
+{
+	extern int processor_avail_count;
+	extern int ml_get_max_cpu_number(void);
+	int want = ml_get_max_cpu_number() + 1;
+	for (int i = 0; i < 3000 && processor_avail_count < want; i++) {
+		delay(10000);
+	}
+	printf("SWEET %s: starting with %d of %d CPUs up\n", who, processor_avail_count, want);
+}
+
+static void
+modem_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	DTEntry mm;
+	uint64_t const *v;
+	unsigned int size;
+	sweet_wait_for_cpus("MODEM");
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &mm) != kSuccess ||
+	    SecureDTGetProperty(mm, "MBA-FW", (void const **)&v, &size) != kSuccess || size != 16) {
+		printf("SWEET MODEM: no MBA-FW in the payload\n");
+		return;
+	}
+	const uint8_t *mba = (const uint8_t *)phystokv(v[0]);
+	uint64_t mba_len = v[1];
+	if (mba_len == 0 || mba_len > MBA_SZ) {
+		printf("SWEET MODEM: MBA is %llu bytes, out of range\n", mba_len);
+		return;
+	}
+
+	gcc = (volatile uint32_t *)ml_io_map(GCC_PA, 0x100000);
+	q6 = (volatile uint32_t *)ml_io_map(QDSP6SS_PA, 0x1000);
+	rmb = (volatile uint32_t *)ml_io_map(RMB_PA, 0x1000);
+	restart = (volatile uint32_t *)ml_io_map(MSS_RESTART & ~0xfffull, 0x1000);
+	uint8_t *mba_region = (uint8_t *)ml_io_map_wcomb(MBA_PA, MBA_SZ);
+	if (!gcc || !q6 || !rmb || !restart || !mba_region) {
+		printf("SWEET MODEM: a register region could not be mapped\n");
+		return;
+	}
+
+	/* the MBA into its region */
+	memcpy(mba_region, mba, (size_t)mba_len);
+	__builtin_arm_dsb(0xf);
+	printf("SWEET MODEM: MBA (%llu bytes) at %#llx\n", mba_len, MBA_PA);
+	/* the MBA buffer (1 MB, as pil_mss_reset_load_mba) becomes the modem's before the PBL fetches it */
+	if (hyp_assign(MBA_PA, 0x100000, HYP_TO_MSS, "MBA buffer") != 0) {
+		return;
+	}
+
+	/*
+	 * Power up the MSS rails, as pil_mss_power_up does: the modem's DT asks for
+	 * vdd_cx and vdd_mx at level 384 (NOM). They are RPM corner resources, so
+	 * vote them through the RPM before the Q6 leaves reset, or the PBL cannot run.
+	 */
+	extern int sweet_rpm_vote_cx_mx(uint32_t cx_level, uint32_t mx_level);
+	(void)sweet_rpm_vote_cx_mx(384, 384);
+
+	/* GCC MSS clocks */
+	clk_on(GCC_MSS_CFG_AHB, 1u << 0);
+	clk_on(GCC_MSS_Q6_BIMC_AXI, 1u << 0);
+	clk_on(GCC_BIMC_MSS_Q6_AXI, 1u << 0);
+	clk_on(GCC_MSS_SNOC_AXI, 1u << 0);
+	clk_on(GCC_MSS_MNOC_BIMC_AXI, 1u << 0);
+	clk_on(GCC_BOOT_ROM_AHB, 1u << 10);
+	/* GPLL0 to the MSS clock controller: fixed-delay halt check, no bit to poll */
+	gcc[GCC_GPLL0_OUT_MSSCC / 4] |= 1u << 2;
+	__builtin_arm_dsb(0xf);
+	delay(10);
+
+	/* MSS reset: assert, then deassert */
+	restart[(MSS_RESTART & 0xfff) / 4] = 1;
+	__builtin_arm_dsb(0xf);
+	delay(200);
+	restart[(MSS_RESTART & 0xfff) / 4] = 0;
+	__builtin_arm_dsb(0xf);
+	delay(200);
+
+	/* our SMP2P item must exist before the modem's smp2p looks for it */
+	extern void sweet_mglink_prepare(void);
+	sweet_mglink_prepare();
+
+	/* the PBL reads the MBA address from RMB before the core leaves reset */
+	rmb[RMB_MBA_IMAGE / 4] = (uint32_t)MBA_PA;
+	/* no debug policy image: zero the PMI registers, as pil_mss_reset does */
+	rmb[RMB_PMI_CODE_START / 4] = 0;
+	rmb[RMB_PMI_CODE_LENGTH / 4] = 0;
+	__builtin_arm_dsb(0xf);
+
+	if (q6_bring_up() != 0) {
+		return;
+	}
+	printf("SWEET MODEM: Q6 out of reset, waiting for the PBL to validate the MBA\n");
+
+	/* the PBL validates the MBA and sets PBL_STATUS; then the MBA runs */
+	int ok = 0;
+	for (int i = 0; i < 2000; i++) {
+		uint32_t pbl = rmb[RMB_PBL_STATUS / 4];
+		if (pbl != 0) {
+			printf("SWEET MODEM: PBL status %#x after %d ms%s\n", pbl, i,
+			    pbl == STATUS_PBL_SUCCESS ? ": MBA validated, PBL success" : ": PBL error");
+			ok = pbl == STATUS_PBL_SUCCESS;
+			break;
+		}
+		delay(1000);
+	}
+	if (!ok) {
+		/*
+		 * Once the Q6 has run the PBL and it errored, the whole QDSP6SS and the
+		 * MSS halt NoC external-abort on any read (ESR 0x96000210 data abort at
+		 * QDSP6SS_RESET +0x14, seen 10/11). Only the RMB (message RAM) stays
+		 * readable: the poll loop above read RMB_PBL_STATUS from it without a
+		 * fault. Read nothing else on the failure path.
+		 */
+		printf("SWEET MODEM: the PBL did not validate the MBA (PBL %#x MBA_STATUS %#x PMI_START %#x PMI_LEN %#x)\n",
+		    rmb[RMB_PBL_STATUS / 4], rmb[RMB_MBA_STATUS / 4],
+		    rmb[RMB_PMI_CODE_START / 4], rmb[RMB_PMI_CODE_LENGTH / 4]);
+		return;
+	}
+	/* the MBA is now running; it reports through RMB_MBA_STATUS */
+	for (int i = 0; i < 1000; i++) {
+		uint32_t st = rmb[RMB_MBA_STATUS / 4];
+		if (st != 0) {
+			printf("SWEET MODEM: MBA status %#x after %d ms (the MBA is running)\n", st, i);
+			break;
+		}
+		delay(1000);
+	}
+	printf("SWEET MODEM: MBA up (PBL %#x MBA %#x), loading the modem image\n",
+	    rmb[RMB_PBL_STATUS / 4], rmb[RMB_MBA_STATUS / 4]);
+
+	/* stage B: load and authenticate modem.mdt + segments through the RMB */
+	if (modem_load() != 0) {
+		return;
+	}
+
+	/* stage C and up: SMP2P ready, GLINK/QRTR, rmtfs, the baseband bridge */
+	extern void sweet_mglink_start(void);
+	sweet_mglink_start();
+}
+
+void
+sweet_modem_init(void)
+{
+	int on = 0;
+	thread_t t;
+	if (!PE_parse_boot_argn("sweetmodem", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	if (kernel_thread_start(modem_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
+#endif /* SWEET_KIRIN */
