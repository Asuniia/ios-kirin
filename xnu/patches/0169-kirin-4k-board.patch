+/*
+ * kirin: talking to the modem (MSS) once sweet_modem.c has booted it, the way
+ * sweet_glink.c talks to the ADSP. Everything here is for the modem edge
+ * (remote pid 1), from the live Android DT:
+ *
+ *   SMP2P     /soc/qcom,smp2p-modem: SMEM global items 435 (ours, written
+ *             BEFORE the modem leaves reset) and 428 (the modem's), kick =
+ *             APCS IPC bit 14. In-entry "slave-kernel" bits: 0 err-fatal,
+ *             1 err-ready, 2 proxy-unvote, 3 stop-ack. Out-entry
+ *             "master-kernel" (bit 0 is qcom,force-stop).
+ *   GLINK     /soc/qcom,glink/modem: SMEM transport in the APPS/MODEM
+ *             partition (hosts 0/1), items 478/479/480, kick = APCS bit 15.
+ *             Channel IPCRTR = QRTR, the modem's QMI services.
+ *   rmtfs     the modem's EFS: QMI service 14 served by US (the apps side),
+ *             reading and writing the eMMC partitions modemst1/modemst2/
+ *             fsg/fsc through sweet_ufs.c. Without it the modem goes
+ *             err-fatal about 40 s after boot (seen on ios-flame).
+ *   baseband  the AppleBaseband bridge for CommCenter/ABM
+ *             (iokit/Kernel/arm/SweetBaseband.inc, boot-arg sweetbb=1):
+ *             fed from this edge's QRTR, its requests sent from here.
+ *
+ * sweet_modem.c calls sweet_mglink_prepare() before the Q6 leaves reset
+ * (the SMP2P out item must exist first) and sweet_mglink_start() once the
+ * modem image is authenticated.
+ */
+#if defined(SWEET_KIRIN)
