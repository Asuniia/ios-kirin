+#include <pexpert/device_tree.h>
+extern vm_map_address_t phystokv(uint64_t pa);
+/*
+ * Files carried in the boot payload (mkpayload --blob FILE:/path=local),
+ * written to the root volume before launchd starts: user-space pieces such
+ * as /usr/lib/sweetgl.dylib update with a `fastboot boot`, without
+ * rewriting the whole iOS image. Each /chosen/memory-map property named
+ * FILE:<absolute path> is {pa, length}; the file is created or truncated
+ * (mode 0755) and written. Property names hold 31 characters, so an entry
+ * named FILEP:<anything> carries its path in the data instead: the first
+ * line ("/path\n"), then the contents. Failures are logged and skipped.
+ */
+static void
+sweet_file_drop(void)
+{
+	DTEntry mm;
+	OpaqueDTPropertyIterator it;
+	char const *name;
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &mm) != kSuccess ||
+	    SecureDTInitPropertyIterator(mm, &it) != kSuccess) {
+		return;
+	}
+	vfs_context_t ctx = vfs_context_kernel();
+	while (SecureDTIterateProperties(&it, &name) == kSuccess) {
+		uint64_t const *v;
+		unsigned int size;
+		bool inpath = strncmp(name, "FILEP:", 6) == 0;
+		if ((strncmp(name, "FILE:/", 6) != 0 && !inpath) ||
+		    SecureDTGetProperty(mm, name, (void const **)&v, &size) != kSuccess || size != 16) {
+			continue;
+		}
+		const char *data = (const char *)phystokv(v[0]);
+		uint64_t len = v[1];
+		char pbuf[256];
+		const char *path = name + 5;
+		if (inpath) {
+			uint64_t n = 0;
+			while (n < len && n < sizeof(pbuf) - 1 && data[n] != '\n') {
+				pbuf[n] = data[n];
+				n++;
+			}
+			if (n == len || data[n] != '\n' || pbuf[0] != '/') {
+				printf("SWEET FILE: %s has no path line, skipped\n", name);
+				continue;
+			}
+			pbuf[n] = '\0';
+			path = pbuf;
+			data += n + 1;
+			len -= n + 1;
+		}
+		if (inpath) {
+			/* parent directories of a FILEP: path (a plug-in bundle, ...): created as needed */
+			extern int sweet_mkdir(const char *path);
+			char dir[256];
+			strlcpy(dir, path, sizeof(dir));
+			for (char *c = dir + 1; *c; c++) {
+				if (*c == '/') {
+					*c = '\0';
+					int me = sweet_mkdir(dir);
+					if (me != 0 && me != EEXIST) {
+						printf("SWEET FILE: mkdir %s: error %d\n", dir, me);
+					}
+					*c = '/';
+				}
+			}
+		}
+		vnode_t vp = NULLVP;
+		int err = vnode_open(path, O_CREAT | O_TRUNC | FWRITE, 0755, 0, &vp, ctx);
+		if (err == 0) {
+			err = vn_rdwr(UIO_WRITE, vp, (caddr_t)data, (int)len, 0, UIO_SYSSPACE,
+			    IO_NOAUTH | IO_SYNC, vfs_context_ucred(ctx), NULL, vfs_context_proc(ctx));
+			int cerr = vnode_close(vp, FWRITE, ctx);
+			err = err ? err : cerr;
+		}
+		printf("SWEET FILE: %s (%llu bytes) %s (error %d)\n", path, len, err ? "NOT written" : "written", err);
+	}
+}
