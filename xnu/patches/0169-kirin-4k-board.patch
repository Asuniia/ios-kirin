+/*
+ * PM660 haptics (SID 1, base 0xc000; Linux leds-qpnp-haptics.c, DT
+ * qcom,haptics@c000): ERM motor, direct mode, VMAX 3000 mV, ILIM 800 mA,
+ * play rate 6667 us. Configured on first use; a pulse is EN_CTL 0x46 bit 7
+ * and PLAY 0x70 bit 7 on, then both off. Thread context only.
+ */
+#define HAP_PPID        0x1c0u
+
+static bool
+hap_setup(void)
+{
+	static int state;	/* 0 not tried, 1 ok, -1 failed */
+	if (state == 0) {
+		uint8_t cfg1 = 0, sel = 0, vmax = 0;
+		bool ok = sweet_pmic_read(HAP_PPID, 0x4c, &cfg1) &&
+		    sweet_pmic_write(HAP_PPID, 0x4c, (uint8_t)(cfg1 | 1u)) &&           /* ERM */
+		    sweet_pmic_read(HAP_PPID, 0x4e, &sel) &&
+		    sweet_pmic_write(HAP_PPID, 0x4e, (uint8_t)(sel & ~0x30u)) &&        /* direct */
+		    sweet_pmic_read(HAP_PPID, 0x51, &vmax) &&
+		    sweet_pmic_write(HAP_PPID, 0x51, (uint8_t)((vmax & ~0x7eu) | (26u << 1))) &&
+		    sweet_pmic_write(HAP_PPID, 0x52, 0x01) &&                           /* 800 mA */
+		    sweet_pmic_write(HAP_PPID, 0x54, 1333u & 0xff) &&                   /* 6667 us / 5 */
+		    sweet_pmic_write(HAP_PPID, 0x55, 1333u >> 8);
+		state = ok ? 1 : -1;
+		printf("SWEET VIB: haptics setup %s (cfg1 %#x sel %#x vmax %#x)\n",
+		    ok ? "ok" : "FAILED", cfg1, sel, vmax);
+	}
+	return state == 1;
+}
+
+static void
+keys_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&keys_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static LCK_GRP_DECLARE(hap_grp, "sweet_vib");
+static LCK_MTX_DECLARE(hap_lock, &hap_grp);
+
+/* Motor on or off and back (bsd/dev/sweet_audio.c, iOS's haptics). Thread context only. */
+bool
+sweet_haptic_set(bool on)
+{
+	lck_mtx_lock(&hap_lock);
+	bool ok = hap_setup();
+	if (ok && on) {
+		ok = sweet_pmic_write(HAP_PPID, 0x46, 0x80) && sweet_pmic_write(HAP_PPID, 0x70, 0x80);
+	} else if (ok) {
+		ok = sweet_pmic_write(HAP_PPID, 0x70, 0x00) && sweet_pmic_write(HAP_PPID, 0x46, 0x00);
+	}
+	lck_mtx_unlock(&hap_lock);
+	return ok;
+}
+
+void
+sweet_vibrate(unsigned ms)
+{
+	lck_mtx_lock(&hap_lock);
+	if (hap_setup()) {
+		bool ok = sweet_pmic_write(HAP_PPID, 0x46, 0x80) && sweet_pmic_write(HAP_PPID, 0x70, 0x80);
+		keys_sleep_ms(ms);
+		(void)sweet_pmic_write(HAP_PPID, 0x70, 0x00);
+		(void)sweet_pmic_write(HAP_PPID, 0x46, 0x00);
+		if (!ok) {
+			printf("SWEET VIB: play FAILED\n");
+		}
+	}
+	lck_mtx_unlock(&hap_lock);
+}
