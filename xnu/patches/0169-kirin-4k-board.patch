+/*
+ * IOKit side of the USB Ethernet (bsd/dev/sweet_usb.c), so that iOS's
+ * configd sees it as a network interface and runs DHCP on it. Without
+ * IONetworkingFamily (not part of XNU), only what configd reads is here
+ * (configd SCNetworkInterface.c, InterfaceNamer ifnamer.c):
+ *   IONetworkStack       configd's InterfaceNamer waits for it and opens it
+ *                        (IOServiceOpen type 0) before it handles any
+ *                        interface; its naming commands are accepted and
+ *                        ignored (the interface is self-named)
+ *   AppleUSBCDCECMData   the controller: IOMACAddress, IOSelfNamed; configd
+ *                        classifies Ethernet interfaces by their controller's
+ *                        class, this one is a USB Ethernet (CDC-ECM)
+ *   IOEthernetInterface  (an IONetworkInterface) the interface: BSD Name,
+ *                        IOInterfaceType 6 (IFT_ETHER), IOInterfaceNamePrefix,
+ *                        IOInterfaceUnit, IOBuiltin, IOPrimaryInterface
+ * The controller hangs off IOResources (configd wants a bus node above it).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSBoolean.h>
+
+class IONetworkStackUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IONetworkStackUserClient);
+public:
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IONetworkStackUserClient, IOUserClient);
+
+IOReturn
+IONetworkStackUserClient::setProperties(OSObject *properties)
+{
+	static int logged;
+	if (logged++ < 8) {
+		OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+		IOLog("SWEET NET: IONetworkStack command (%u keys) ignored\n", d ? d->getCount() : 0);
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IONetworkStackUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+class IONetworkStack : public IOService {
+	OSDeclareDefaultStructors(IONetworkStack);
+public:
+	IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type,
+	    IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IONetworkStack, IOService);
+
+IOReturn
+IONetworkStack::newUserClient(task_t owningTask, void *securityID, UInt32 type,
+    IOUserClient **handler)
+{
+	IONetworkStackUserClient *uc = OSTypeAlloc(IONetworkStackUserClient);
+	if (uc == NULL || !uc->initWithTask(owningTask, securityID, type) ||
+	    !uc->attach(this) || !uc->start(this)) {
+		if (uc != NULL) {
+			uc->detach(this);
+			uc->release();
+		}
+		return kIOReturnNoMemory;
+	}
+	*handler = uc;
+	return kIOReturnSuccess;
+}
+
+class AppleUSBCDCECMData : public IOService {
+	OSDeclareDefaultStructors(AppleUSBCDCECMData);
+};
+
+OSDefineMetaClassAndStructors(AppleUSBCDCECMData, IOService);
+
+class IONetworkInterface : public IOService {
+	OSDeclareDefaultStructors(IONetworkInterface);
+};
+
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+
+class IOEthernetInterface : public IONetworkInterface {
+	OSDeclareDefaultStructors(IOEthernetInterface);
+};
+
+OSDefineMetaClassAndStructors(IOEthernetInterface, IONetworkInterface);
+
+static void
+sweet_net_set_number(IOService *s, const char *key, uint32_t v)
+{
+	OSNumber *n = OSNumber::withNumber(v, 32);
+	if (n != NULL) {
+		s->setProperty(key, n);
+		n->release();
+	}
+}
+
+/* Called by sweet_usb.c once the BSD interface prefix<unit> is attached. */
+extern "C" void
+sweet_net_publish(const char *prefix, unsigned unit, const uint8_t *mac)
+{
+	IOService *resources = IOService::getResourceService();
+	if (resources == NULL) {
+		IOLog("SWEET NET: no IOResources\n");
+		return;
+	}
+	IONetworkStack *stack = OSTypeAlloc(IONetworkStack);
+	if (stack != NULL && stack->init() && stack->attach(resources)) {
+		stack->registerService();
+	}
+	OSSafeReleaseNULL(stack);
+
+	AppleUSBCDCECMData *ctl = OSTypeAlloc(AppleUSBCDCECMData);
+	IOEthernetInterface *nif = OSTypeAlloc(IOEthernetInterface);
+	if (ctl == NULL || nif == NULL || !ctl->init() || !nif->init()) {
+		OSSafeReleaseNULL(ctl);
+		OSSafeReleaseNULL(nif);
+		IOLog("SWEET NET: allocation failed\n");
+		return;
+	}
+	char bsd[16];
+	snprintf(bsd, sizeof(bsd), "%s%u", prefix, unit);
+	OSData *m = OSData::withBytes(mac, 6);
+	if (m != NULL) {
+		ctl->setProperty("IOMACAddress", m);
+		m->release();
+	}
+	ctl->setProperty("IOSelfNamed", kOSBooleanTrue);
+	ctl->setName("sweet-usb-ecm");
+
+	nif->setProperty("BSD Name", bsd);
+	nif->setProperty("IOInterfaceNamePrefix", prefix);
+	sweet_net_set_number(nif, "IOInterfaceUnit", unit);
+	sweet_net_set_number(nif, "IOInterfaceType", 6);      /* IFT_ETHER */
+	sweet_net_set_number(nif, "IOMaxTransferUnit", 1500);
+	nif->setProperty("IOBuiltin", kOSBooleanFalse);
+	nif->setProperty("IOPrimaryInterface", kOSBooleanFalse);
+	nif->setProperty("IOLocation", "USB");
+	nif->setName(bsd);
+
+	if (ctl->attach(resources) && nif->attach(ctl)) {
+		ctl->registerService();
+		nif->registerService();
+		IOLog("SWEET NET: %s published (USB Ethernet, %02x:%02x:%02x:%02x:%02x:%02x)\n",
+		    bsd, mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+	} else {
+		IOLog("SWEET NET: attach failed\n");
+	}
+	ctl->release();
+	nif->release();
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
