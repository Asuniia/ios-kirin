+/*
+ * A tiny read-only FAT16 reader over the eMMC "modem_a" partition: the modem firmware
+ * (image/modem.mdt and image/modem.bNN) is there, and it is too big (57 MB) to carry in the
+ * boot payload (it overflowed the payload region and reset the phone before any log). The
+ * files are read from the partition at boot instead, with sweet_emmc_read_partition.
+ */
+extern int sweet_emmc_read_partition(const char *want, uint64_t off, uint32_t count, void *out, uint64_t *total);
+#define MODEM_PART      "modem_a"
+
+#define FAT_SECMAX      4096u           /* largest FAT logical sector we handle (modem_a uses 4096) */
+
+static uint32_t fat_bps;                /* bytes per FAT logical sector (512 or 4096 here) */
+static uint32_t fat_r;                  /* 512-byte eMMC sectors per FAT sector (bps / 512) */
+static uint32_t fat_spc;                /* FAT sectors per cluster */
+static uint32_t fat_clbytes;            /* bytes per cluster (spc * bps) */
+static uint32_t fat_fat_sec, fat_root_sec, fat_root_fs, fat_data_sec, fat_root_ents;
+static uint8_t fat_sb[FAT_SECMAX];      /* scratch for one FAT sector (BPB, directory) */
+static uint8_t fat_cache[FAT_SECMAX];   /* the last-read FAT-table sector, cached while walking a chain */
+static uint32_t fat_cache_sec;
+static int fat_cache_valid;
+static uint8_t fat_bounce[64 * 1024];   /* one cluster (mount rejects a FAT whose cluster is larger) */
+
+static uint16_t
+u16le(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | (p[1] << 8));
+}
+
+/*
+ * modem_a is a FAT with 4096-byte logical sectors, while sweet_emmc_read_partition works in
+ * 512-byte eMMC sectors (and re-parses the GPT and copies through a 1 MB bounce on every call,
+ * capped at 2048 sectors). fat_rd takes a count in FAT sectors and converts: the readers below
+ * coalesce contiguous clusters into reads of up to 1 MB and cache the FAT-table sector while
+ * following a chain, to move the 57 MB image in as few calls as possible.
+ */
+static int
+fat_rd(uint32_t fs, uint32_t n, void *out)
+{
+	uint64_t total = 0;
+	return sweet_emmc_read_partition(MODEM_PART, (uint64_t)fs * fat_r, n * fat_r, out, &total);
+}
+
+static int
+fat_mount(void)
+{
+	uint64_t total = 0;
+	fat_cache_valid = 0;
+	/* the BPB is in the first 512 bytes; read one raw eMMC sector for it */
+	if (sweet_emmc_read_partition(MODEM_PART, 0, 1, fat_sb, &total) != 0) {
+		printf("SWEET MODEM: cannot read %s sector 0\n", MODEM_PART);
+		return -1;
+	}
+	fat_bps = u16le(fat_sb + 0x0b);
+	fat_spc = fat_sb[0x0d];
+	uint32_t rsvd = u16le(fat_sb + 0x0e);
+	uint32_t nfat = fat_sb[0x10];
+	fat_root_ents = u16le(fat_sb + 0x11);
+	uint32_t spf = u16le(fat_sb + 0x16);
+	if (fat_bps < 512 || fat_bps > FAT_SECMAX || (fat_bps & (fat_bps - 1)) != 0 ||
+	    fat_spc == 0 || (uint32_t)fat_spc * fat_bps > sizeof(fat_bounce)) {
+		printf("SWEET MODEM: unsupported FAT (bps %u spc %u)\n", fat_bps, fat_spc);
+		return -1;
+	}
+	fat_r = fat_bps / 512;
+	fat_clbytes = fat_spc * fat_bps;
+	fat_fat_sec = rsvd;
+	fat_root_sec = rsvd + nfat * spf;
+	fat_root_fs = (fat_root_ents * 32 + fat_bps - 1) / fat_bps;
+	fat_data_sec = fat_root_sec + fat_root_fs;
+	return 0;
+}
+
+static uint32_t
+fat_next(uint32_t cl)
+{
+	uint32_t off = cl * 2;
+	uint32_t sec = fat_fat_sec + off / fat_bps;
+	if (!fat_cache_valid || sec != fat_cache_sec) {
+		if (fat_rd(sec, 1, fat_cache) != 0) {
+			return 0xffff;
+		}
+		fat_cache_sec = sec;
+		fat_cache_valid = 1;
+	}
+	return u16le(fat_cache + (off % fat_bps));
+}
+
+/* find an 8.3 name (11 bytes, space padded) in a directory; the root when dir_cluster == 0 */
+static int
+fat_find(uint32_t dir_cluster, const char name[11], uint32_t *first_cl, uint32_t *fsize, int *is_dir)
+{
+	uint32_t cl = dir_cluster;
+	for (;;) {
+		uint32_t base, nsec;
+		if (dir_cluster == 0) {         /* FAT16 root: contiguous */
+			base = fat_root_sec;
+			nsec = fat_root_fs;
+		} else {
+			base = fat_data_sec + (cl - 2) * fat_spc;
+			nsec = fat_spc;
+		}
+		for (uint32_t s = 0; s < nsec; s++) {
+			if (fat_rd(base + s, 1, fat_sb) != 0) {
+				return -1;
+			}
+			for (uint32_t e = 0; e < fat_bps; e += 32) {
+				const uint8_t *d = fat_sb + e;
+				if (d[0] == 0x00) {
+					return -1;      /* end of directory */
+				}
+				if (d[0] == 0xe5 || (d[0x0b] & 0x0f) == 0x0f) {
+					continue;       /* deleted or long-name entry */
+				}
+				if (memcmp(d, name, 11) == 0) {
+					*first_cl = u16le(d + 0x1a);
+					*fsize = *(const uint32_t *)(d + 0x1c);
+					*is_dir = (d[0x0b] & 0x10) != 0;
+					return 0;
+				}
+			}
+		}
+		if (dir_cluster == 0) {
+			return -1;
+		}
+		cl = fat_next(cl);
+		if (cl < 2 || cl >= 0xfff8) {
+			return -1;
+		}
+	}
+}
+
+/* read a file (by its 8.3 name in dir_cluster, root if 0) into dest, up to maxlen; size, or -1 */
+static int64_t
+fat_read_file(uint32_t dir_cluster, const char name[11], uint8_t *dest, uint32_t maxlen)
+{
+	uint32_t cl, fsize;
+	int is_dir;
+	if (fat_find(dir_cluster, name, &cl, &fsize, &is_dir) != 0 || is_dir) {
+		return -1;
+	}
+	if (fsize > maxlen) {
+		printf("SWEET MODEM: %.11s is %u bytes, over the %u-byte buffer\n", name, fsize, maxlen);
+		return -1;
+	}
+	uint32_t maxrun = 2048 / (fat_spc * fat_r);     /* clusters per read, within the 1 MB bounce */
+	if (maxrun == 0) {
+		maxrun = 1;
+	}
+	uint32_t got = 0;
+	while (cl >= 2 && cl < 0xfff8 && got < fsize) {
+		uint32_t remain = fsize - got;
+		if (remain < fat_clbytes) {
+			/* the final, partial cluster: read it whole, copy only what the file holds */
+			if (fat_rd(fat_data_sec + (cl - 2) * fat_spc, fat_spc, fat_bounce) != 0) {
+				return -1;
+			}
+			memcpy(dest + got, fat_bounce, remain);
+			got += remain;
+			break;
+		}
+		/* gather a run of physically contiguous full clusters, up to the bounce size */
+		uint32_t start = cl, run = 1;
+		while (run < maxrun && (uint64_t)(run + 1) * fat_clbytes <= remain) {
+			uint32_t nx = fat_next(cl);
+			if (nx != cl + 1) {
+				break;
+			}
+			cl = nx;
+			run++;
+		}
+		uint32_t nx = fat_next(cl);
+		if (fat_rd(fat_data_sec + (start - 2) * fat_spc, run * fat_spc, dest + got) != 0) {
+			return -1;
+		}
+		got += run * fat_clbytes;
+		cl = nx;
+	}
+	return got;
+}
+
+/*
+ * Stage B: load modem.mdt and its segments through the RMB, as pil_msa_auth_modem_mdt and
+ * pil_msa_mba_verify_blob. The files come from the modem_a partition (above). The MBA
+ * authenticates the metadata, then each PT_LOAD segment as it is written to its physical
+ * address in the modem region.
+ */
+static uint8_t modem_mdt[64 * 1024];    /* the .mdt: ELF header, phdrs, hash segment and cert chain */
+
+static int
+modem_load(void)
+{
+	if (fat_mount() != 0) {
+		return -1;
+	}
+	uint32_t image_cl = 0, dummy;   /* the root by default; Qualcomm usually puts them under image/ */
+	int is_dir;
+	if (fat_find(0, "IMAGE      ", &image_cl, &dummy, &is_dir) == 0 && is_dir) {
+		printf("SWEET MODEM: reading the firmware from %s:/image\n", MODEM_PART);
+	} else {
+		image_cl = 0;
+		printf("SWEET MODEM: no image/, reading the firmware from %s root\n", MODEM_PART);
+	}
+	int64_t mdt_len = fat_read_file(image_cl, "MODEM   MDT", modem_mdt, sizeof(modem_mdt));
+	if (mdt_len < 0x34) {
+		printf("SWEET MODEM: modem.mdt not read (%lld)\n", mdt_len);
+		return -1;
+	}
+	const uint8_t *mdt = modem_mdt;
+	uint32_t phoff = *(const uint32_t *)(mdt + 0x1c);
+	uint16_t phnum = *(const uint16_t *)(mdt + 0x2c);
+	if (phnum > 64 || phoff + 32ull * phnum > (uint64_t)mdt_len) {
+		printf("SWEET MODEM: bad modem.mdt (%u phdrs)\n", phnum);
+		return -1;
+	}
+
+	/* metadata (the .mdt) in a physically contiguous, cache-flushed buffer */
+	vm_offset_t meta_va = 0;
+	vm_size_t meta_sz = round_page((uint32_t)mdt_len);
+	if (kmem_alloc_contig(kernel_map, &meta_va, meta_sz, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return -1;
+	}
+	memcpy((void *)meta_va, mdt, (size_t)mdt_len);
+	uint64_t meta_pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)meta_va));
+	flush_dcache64((addr64_t)meta_pa, (unsigned)meta_sz, TRUE);
+
+	rmb[RMB_PMI_CODE_LENGTH / 4] = 0;
+	rmb[RMB_PMI_META_DATA / 4] = (uint32_t)meta_pa;
+	rmb[RMB_MBA_COMMAND / 4] = CMD_META_DATA_READY;
+	__builtin_arm_dsb(0xf);
+	if (rmb_wait(STATUS_META_DATA_AUTH_SUCCESS, "metadata auth") != 0) {
+		return -1;
+	}
+	printf("SWEET MODEM: metadata authenticated\n");
+
+	uint8_t *region = (uint8_t *)ml_io_map_wcomb(MODEM_PA, MODEM_SZ);
+	if (!region) {
+		printf("SWEET MODEM: the modem region cannot be mapped\n");
+		return -1;
+	}
+	uint32_t total_len = 0, loaded = 0;
+	for (uint32_t i = 0; i < phnum; i++) {
+		const struct elf_phdr32 *ph = (const struct elf_phdr32 *)(mdt + phoff + 32 * i);
+		if (ph->type != 1 || ((ph->flags >> 24) & 7) == 2 || ph->memsz == 0) {
+			continue;       /* only PT_LOAD that is not the hash segment */
+		}
+		if (ph->paddr < MODEM_PA || ph->paddr + (uint64_t)ph->memsz > MODEM_PA + MODEM_SZ) {
+			printf("SWEET MODEM: segment %u (%#x + %#x) outside the region\n", i, ph->paddr, ph->memsz);
+			return -1;
+		}
+		uint8_t *dst = region + (ph->paddr - MODEM_PA);
+		bzero(dst, ph->memsz);
+		if (ph->filesz > 0) {
+			char nm[11];
+			memcpy(nm, "MODEM   B  ", 11);
+			nm[8] = 'B';
+			nm[9] = '0' + (i / 10);
+			nm[10] = '0' + (i % 10);
+			if (fat_read_file(image_cl, nm, dst, ph->memsz) < 0) {
+				printf("SWEET MODEM: segment %u (modem.b%02u) not read\n", i, i);
+				return -1;
+			}
+		}
+		__builtin_arm_dsb(0xf);
+		if (total_len == 0) {
+			rmb[RMB_PMI_CODE_START / 4] = ph->paddr;
+			rmb[RMB_MBA_COMMAND / 4] = CMD_LOAD_READY;
+			__builtin_arm_dsb(0xf);
+		}
+		total_len += ph->memsz;
+		rmb[RMB_PMI_CODE_LENGTH / 4] = total_len;
+		__builtin_arm_dsb(0xf);
+		if ((int32_t)rmb[RMB_MBA_STATUS / 4] < 0) {
+			printf("SWEET MODEM: segment %u refused (MBA_STATUS %#x)\n", i, rmb[RMB_MBA_STATUS / 4]);
+			return -1;
+		}
+		loaded++;
+	}
+	printf("SWEET MODEM: %u segments loaded (%u bytes), waiting for auth complete\n", loaded, total_len);
+	if (rmb_wait(STATUS_AUTH_COMPLETE, "modem auth") != 0) {
+		return -1;
+	}
+	printf("SWEET MODEM: THE MODEM IMAGE IS AUTHENTICATED AND RUNNING\n");
+	return 0;
+}
+
+
+static void
+clk_on(uint32_t off, uint32_t bit)
+{
+	gcc[off / 4] |= bit;
+	__builtin_arm_dsb(0xf);
+	for (int i = 0; i < 1000; i++) {
+		if (!(gcc[off / 4] & (1u << 31))) {       /* CLK_OFF clear = running */
+			return;
+		}
+		delay(1);
+	}
+	printf("SWEET MODEM: GCC clock %#x stays off (%#x)\n", off, gcc[off / 4]);
+}
+
+/* the QDSP6SS v62_1_5 reset: head switch, LDO, memory, core out of reset */
+static int
+q6_bring_up(void)
+{
+	int i;
+	/* assert resets, stop core */
+	q6[QDSP6SS_RESET / 4] |= Q6SS_CORE_ARES | Q6SS_BUS_ARES_ENA | Q6SS_STOP_CORE;
+	__builtin_arm_dsb(0xf);
+	/* BHS needs the XO clock */
+	q6[QDSP6SS_XO_CBCR / 4] |= 1u;
+	__builtin_arm_dsb(0xf);
+	for (i = 0; i < 200 && (q6[QDSP6SS_XO_CBCR / 4] & (1u << 31)); i++) {
+		delay(1);
+	}
+	/* head switch on, wait for the BHS acknowledge */
+	q6[QDSP6SS_PWR_CTL / 4] |= Q6v55_BHS_ON;
+	__builtin_arm_dsb(0xf);
+	delay(1);
+	for (i = 200; i > 0; i--) {
+		if (q6[QDSP6V62SS_BHS_STATUS / 4] & Q6v55_BHS_EN_REST_ACK) {
+			break;
+		}
+		delay(1);
+	}
+	if (i == 0) {
+		printf("SWEET MODEM: BHS acknowledge never came (PWR_CTL %#x BHS_STATUS %#x)\n",
+		    q6[QDSP6SS_PWR_CTL / 4], q6[QDSP6V62SS_BHS_STATUS / 4]);
+		return -1;
+	}
+	/* LDO bypass */
+	q6[QDSP6SS_PWR_CTL / 4] |= Q6v55_LDO_BYP;
+	/* deassert the compiler memory clamp */
+	q6[QDSP6SS_PWR_CTL / 4] &= ~Q6v55_CLAMP_QMC_MEM;
+	/* deassert memory peripheral sleep and L2 standby */
+	q6[QDSP6SS_PWR_CTL / 4] |= Q6SS_L2DATA_STBY_N | Q6SS_SLP_RET_N;
+	__builtin_arm_dsb(0xf);
+	/* turn on L1/L2/ETB/JU memories one bit at a time (v62_1_5: QDSP6V6SS_MEM_PWR_CTL, 29..0) */
+	uint32_t m = q6[QDSP6V6SS_MEM_PWR_CTL / 4];
+	for (i = 29; i >= 0; i--) {
+		m |= (1u << i);
+		q6[QDSP6V6SS_MEM_PWR_CTL / 4] = m;
+		delay(1);
+	}
+	/* remove word-line and IO clamps */
+	q6[QDSP6SS_PWR_CTL / 4] &= ~Q6v55_CLAMP_WL;
+	q6[QDSP6SS_PWR_CTL / 4] &= ~Q6SS_CLAMP_IO;
+	__builtin_arm_dsb(0xf);
+	/* core out of reset, core clock on */
+	q6[QDSP6SS_RESET / 4] &= ~(Q6SS_CORE_ARES | Q6SS_STOP_CORE);
+	__builtin_arm_dsb(0xf);
+	q6[QDSP6SS_GFMUX_CTL / 4] |= Q6SS_CLK_ENA;
+	__builtin_arm_dsb(0xf);
+	return 0;
+}
+
+static void
+modem_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	DTEntry mm;
+	uint64_t const *v;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &mm) != kSuccess ||
+	    SecureDTGetProperty(mm, "MBA-FW", (void const **)&v, &size) != kSuccess || size != 16) {
+		printf("SWEET MODEM: no MBA-FW in the payload\n");
+		return;
+	}
+	const uint8_t *mba = (const uint8_t *)phystokv(v[0]);
+	uint64_t mba_len = v[1];
+	if (mba_len == 0 || mba_len > MBA_SZ) {
+		printf("SWEET MODEM: MBA is %llu bytes, out of range\n", mba_len);
+		return;
+	}
+
+	gcc = (volatile uint32_t *)ml_io_map(GCC_PA, 0x100000);
+	q6 = (volatile uint32_t *)ml_io_map(QDSP6SS_PA, 0x1000);
+	rmb = (volatile uint32_t *)ml_io_map(RMB_PA, 0x1000);
+	restart = (volatile uint32_t *)ml_io_map(MSS_RESTART & ~0xfffull, 0x1000);
+	uint8_t *mba_region = (uint8_t *)ml_io_map_wcomb(MBA_PA, MBA_SZ);
+	if (!gcc || !q6 || !rmb || !restart || !mba_region) {
+		printf("SWEET MODEM: a register region could not be mapped\n");
+		return;
+	}
+
+	/* the MBA into its region */
+	memcpy(mba_region, mba, (size_t)mba_len);
+	__builtin_arm_dsb(0xf);
+	printf("SWEET MODEM: MBA (%llu bytes) at %#llx\n", mba_len, MBA_PA);
+
+	/*
+	 * Power up the MSS rails, as pil_mss_power_up does: the modem's DT asks for
+	 * vdd_cx and vdd_mx at level 384 (NOM). They are RPM corner resources, so
+	 * vote them through the RPM before the Q6 leaves reset, or the PBL cannot run.
+	 */
+	extern int sweet_rpm_vote_cx_mx(uint32_t cx_level, uint32_t mx_level);
+	(void)sweet_rpm_vote_cx_mx(384, 384);
+
+	/* GCC MSS clocks */
+	clk_on(GCC_MSS_CFG_AHB, 1u << 0);
+	clk_on(GCC_MSS_Q6_BIMC_AXI, 1u << 0);
+	clk_on(GCC_MSS_SNOC_AXI, 1u << 0);
+	clk_on(GCC_MSS_MNOC_BIMC_AXI, 1u << 0);
+	clk_on(GCC_BOOT_ROM_AHB, 1u << 10);
+
+	/* MSS reset: assert, then deassert */
+	restart[(MSS_RESTART & 0xfff) / 4] = 1;
+	__builtin_arm_dsb(0xf);
+	delay(200);
+	restart[(MSS_RESTART & 0xfff) / 4] = 0;
+	__builtin_arm_dsb(0xf);
+	delay(200);
+
+	/* the PBL reads the MBA address from RMB before the core leaves reset */
+	rmb[RMB_MBA_IMAGE / 4] = (uint32_t)MBA_PA;
+	__builtin_arm_dsb(0xf);
+
+	if (q6_bring_up() != 0) {
+		return;
+	}
+	printf("SWEET MODEM: Q6 out of reset, waiting for the PBL to validate the MBA\n");
+
+	/* the PBL validates the MBA and sets PBL_STATUS; then the MBA runs */
+	int ok = 0;
+	for (int i = 0; i < 2000; i++) {
+		uint32_t pbl = rmb[RMB_PBL_STATUS / 4];
+		if (pbl != 0) {
+			printf("SWEET MODEM: PBL status %#x after %d ms%s\n", pbl, i,
+			    pbl == STATUS_PBL_SUCCESS ? ": MBA validated, PBL success" : ": PBL error");
+			ok = pbl == STATUS_PBL_SUCCESS;
+			break;
+		}
+		delay(1000);
+	}
+	if (!ok) {
+		printf("SWEET MODEM: PBL never validated the MBA (PBL %#x MBA_STATUS %#x RESET %#x PWR_CTL %#x)\n",
+		    rmb[RMB_PBL_STATUS / 4], rmb[RMB_MBA_STATUS / 4], q6[QDSP6SS_RESET / 4], q6[QDSP6SS_PWR_CTL / 4]);
+		return;
+	}
+	/* the MBA is now running; it reports through RMB_MBA_STATUS */
+	for (int i = 0; i < 1000; i++) {
+		uint32_t st = rmb[RMB_MBA_STATUS / 4];
+		if (st != 0) {
+			printf("SWEET MODEM: MBA status %#x after %d ms (the MBA is running)\n", st, i);
+			break;
+		}
+		delay(1000);
+	}
+	printf("SWEET MODEM: MBA up (PBL %#x MBA %#x), loading the modem image\n",
+	    rmb[RMB_PBL_STATUS / 4], rmb[RMB_MBA_STATUS / 4]);
+
+	/* stage B: load and authenticate modem.mdt + segments through the RMB */
+	(void)modem_load();
+}
+
+void
+sweet_modem_init(void)
+{
+	int on = 0;
+	thread_t t;
+	if (!PE_parse_boot_argn("sweetmodem", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	if (kernel_thread_start(modem_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
+#endif /* SWEET_KIRIN */
diff --git a/bsd/dev/sweet_perf.c b/bsd/dev/sweet_perf.c
index a0a9ae1..63d27e4 100644
--- a/bsd/dev/sweet_perf.c
+++ b/bsd/dev/sweet_perf.c
@@ -563,6 +563,281 @@ fastboot_thread(void *arg, wait_result_t result)
 	printf("SWEET FASTBOOT: still running after PS_HOLD\n");
 }
 
+#if defined(SWEET_KIRIN)
+/*
+ * SDM630 CPU clocks, read only (step 1 before any clock change): the two
+ * cluster PLLs (DT qcom,clk-cpu-osm-sdm630: pwrcl_pll 0x17916000, perfcl_pll
+ * 0x17816000, L value at +0x04, mode at +0x00, user ctl at +0x0c, rate =
+ * L x 19.2 MHz), the cluster muxes (apcs cmd/cfg rcgr 0x17911050/54,
+ * 0x17811050/54), the OSM block (0x179c0000) and each CPU's measured clock.
+ */
+static unsigned kirin_rail_mv[3];      /* PM660 S1-S3 (CPU rails) as read by the probe, 0 if unknown */
+
+/*
+ * Little cluster (pwrcl, CPUs 4-7) off GPLL0: the bootloader leaves its
+ * mux on GPLL0 (cfg 0x401, GPLL_SEL: 600 MHz) with the cluster PLL
+ * running unused at L 32. The PLL is set up for L (Linux
+ * clk_osm_setup_cluster_pll: MODE 0, L, MODE 2, lock wait, MODE 6, MODE 7)
+ * and the mux moved to its early output (cfg 0x501, PLL_EARLY_SEL, as the
+ * big cluster's), with CMD_RCGR update. Only at 1094.4 MHz (L 57), the
+ * pwrcl corner 4 of the DT OSM table whose CPR ceiling is 790 mV, and only
+ * if the three CPU rails read at least 800 mV: no voltage is changed.
+ * Boot-arg sweetpwrcl=0 leaves the cluster on GPLL0.
+ */
+static void
+kirin_pwrcl_raise(void)
+{
+	int on = 1;
+	(void)PE_parse_boot_argn("sweetpwrcl", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	for (unsigned n = 0; n < 3; n++) {
+		if (kirin_rail_mv[n] < 800) {
+			printf("SWEET CLK: pwrcl stays on GPLL0 (rail s%u %u mV)\n", n + 1, kirin_rail_mv[n]);
+			return;
+		}
+	}
+	vm_offset_t pll = ml_io_map(0x17916000u, 0x1000), rcg = ml_io_map(0x17911000u, 0x1000);
+	if (pll == 0 || rcg == 0) {
+		return;
+	}
+	uint32_t cfg = clk_rd(rcg, 0x54);
+	if ((cfg & 0x700) != 0x400) {
+		printf("SWEET CLK: pwrcl mux cfg %#x is not GPLL0, left alone\n", cfg);
+		return;
+	}
+	const uint32_t l = 57;  /* 57 x 19.2 = 1094.4 MHz */
+	clk_wr(pll, 0x00, 0x0);
+	clk_wr(pll, 0x04, l);
+	clk_wr(pll, 0x00, 0x2);
+	delay(50);
+	clk_wr(pll, 0x00, 0x6);
+	delay(75);
+	clk_wr(pll, 0x00, 0x7);
+	bool locked = false;
+	for (int i = 0; i < 100 && !locked; i++) {
+		locked = (clk_rd(pll, 0x2c) & (1u << 16)) != 0;   /* PLL_STATUS lock detect */
+		if (!locked) {
+			delay(10);
+		}
+	}
+	if (!locked) {
+		printf("SWEET CLK: pwrcl PLL did not lock at L %u (mode %#x status %#x), stays on GPLL0\n", l,
+		    clk_rd(pll, 0x00), clk_rd(pll, 0x2c));
+		return;
+	}
+	clk_wr(rcg, 0x54, (cfg & ~0x7ffu) | 0x501);
+	clk_wr(rcg, 0x50, clk_rd(rcg, 0x50) | 1u);
+	bool upd = false;
+	for (int i = 0; i < 100 && !upd; i++) {
+		upd = (clk_rd(rcg, 0x50) & 1u) == 0;
+		if (!upd) {
+			delay(10);
+		}
+	}
+	printf("SWEET CLK: pwrcl -> PLL L %u (%u MHz): mode %#x cfg %#x cmd %#x%s\n", l, l * 192 / 10,
+	    clk_rd(pll, 0x00), clk_rd(rcg, 0x54), clk_rd(rcg, 0x50), upd ? "" : " (update stuck)");
+}
+
+/*
+ * OSM pstate (SDM630 clk-cpu-osm, DT qcom,clk-cpu-630@179c0000). The big
+ * cluster (perfcl, CPU 0-3) is driven by the OSM at base + 1 * OSM_CORE_TABLE_SIZE
+ * (0x2000), the little one (pwrcl) at +0. ENABLE_REG 0x1004, the requested
+ * performance state at DCVS_PERF_STATE_DESIRED_REG 0x1F10. The OSM's LUT, loaded
+ * by the bootloader from the device DT (qcom,{pwrcl,perfcl}-speedbin0-v0),
+ * carries the fused open-loop voltage of every corner, so raising the pstate
+ * applies the matching voltage in hardware: no manual CPRh/SAW, no guessed mV.
+ * Read only, unless sweetpstate_perf / sweetpstate_pwr name a pstate and the
+ * cluster's OSM reports enabled.
+ */
+static const uint32_t pwrcl_mhz[8] = {300, 614, 883, 1094, 1382, 1536, 1728, 1843};
+static const uint32_t perfcl_mhz[10] = {300, 787, 1113, 1344, 1516, 1670, 1881, 2016, 2150, 2380};
+
+static void
+kirin_osm_tune(void)
+{
+	vm_offset_t osm = ml_io_map(0x179c0000u, 0x4000);
+	if (osm == 0) {
+		return;
+	}
+	vm_offset_t efuse = ml_io_map(0x784000u, 0x1000);
+	if (efuse != 0) {
+		printf("SWEET OSM: perfcl speed-bin fuse %#x %#x\n", clk_rd(efuse, 0x130), clk_rd(efuse, 0x134));
+	}
+	static const struct {
+		const char *name;
+		uint32_t base;
+		const uint32_t *mhz;
+		unsigned n;
+		unsigned safe;          /* pstate matching the current PLL freq (handover target) */
+		const char *arg;
+	} cl[] = {
+		{"pwrcl", 0x0000u, pwrcl_mhz, 8, 3, "sweetpstate_pwr"},    /* 1094 MHz */
+		{"perfcl", 0x2000u, perfcl_mhz, 10, 5, "sweetpstate_perf"}, /* 1670 MHz */
+	};
+	/*
+	 * sweetosmon=1 enables the OSM (if the bootloader left it off) at the
+	 * target pstate, so the hardware drives frequency and the CPRh voltage from
+	 * its LUT. Without a sweetpstate, it goes to the corner that matches the
+	 * current PLL frequency first, to validate the handover safely.
+	 */
+	int osmon = 0;
+	(void)PE_parse_boot_argn("sweetosmon", &osmon, sizeof(osmon));
+	for (unsigned i = 0; i < 2; i++) {
+		uint32_t en = clk_rd(osm, cl[i].base + 0x1004u);
+		uint32_t cur = clk_rd(osm, cl[i].base + 0x1f10u);
+		printf("SWEET OSM: %s enable %#x, pstate %u (%u MHz); %u pstates, max %u MHz\n",
+		    cl[i].name, en, cur, cur < cl[i].n ? cl[i].mhz[cur] : 0, cl[i].n, cl[i].mhz[cl[i].n - 1]);
+		int want = -1;
+		(void)PE_parse_boot_argn(cl[i].arg, &want, sizeof(want));
+		if (want < 0 && osmon && i == 1) {
+			want = (int)cl[i].safe;         /* perfcl only; pwrcl stays on its manual PLL */
+		}
+		if (want < 0) {
+			continue;
+		}
+		if (want >= (int)cl[i].n) {
+			want = (int)cl[i].n - 1;
+		}
+		if (en & 1u) {
+			/* OSM already driving: just move the desired pstate */
+			clk_wr(osm, cl[i].base + 0x1f10u, (uint32_t)want);
+			delay(2000);
+			printf("SWEET OSM: %s -> pstate %u (%u MHz), reads %u\n", cl[i].name, want,
+			    cl[i].mhz[want], clk_rd(osm, cl[i].base + 0x1f10u));
+		} else if (osmon) {
+			/* set the pstate, then hand the cluster over to the OSM */
+			clk_wr(osm, cl[i].base + 0x1f10u, (uint32_t)want);
+			clk_wr(osm, cl[i].base + 0x1004u, 1u);
+			delay(5000);
+			printf("SWEET OSM: %s enabled at pstate %u (%u MHz): enable %#x desired %u\n",
+			    cl[i].name, want, cl[i].mhz[want], clk_rd(osm, cl[i].base + 0x1004u),
+			    clk_rd(osm, cl[i].base + 0x1f10u));
+		} else {
+			printf("SWEET OSM: %s OSM off, pstate left alone (sweetosmon=1 to enable)\n", cl[i].name);
+		}
+	}
+}
+
+static void
+kirin_clk_probe(void)
+{
+	static const struct { const char *name; uint32_t pll, rcg; } cl[] = {
+		{"pwrcl (cpu4-7, 0x0xx)", 0x17916000u, 0x17911000u},
+		{"perfcl (cpu0-3, 0x1xx)", 0x17816000u, 0x17811000u},
+	};
+	for (unsigned i = 0; i < 2; i++) {
+		vm_offset_t pll = ml_io_map(cl[i].pll, 0x1000), rcg = ml_io_map(cl[i].rcg, 0x1000);
+		if (pll == 0 || rcg == 0) {
+			continue;
+		}
+		uint32_t mode = clk_rd(pll, 0x00), l = clk_rd(pll, 0x04), user = clk_rd(pll, 0x0c);
+		printf("SWEET CLK: %s PLL mode %#x status %#x L %u (%u MHz) user %#x rcg cmd %#x cfg %#x\n",
+		    cl[i].name, mode, clk_rd(pll, 0x2c), l & 0xffu, (l & 0xffu) * 192u / 10u, user,
+		    clk_rd(rcg, 0x50), clk_rd(rcg, 0x54));
+	}
+	/*
+	 * PM660 (SID 1) SMPS S1-S6 at 0x1400 + 0x300 n, read only: type/subtype
+	 * 0x04/0x05, VOLTAGE_CTRL1/2 0x40/0x41 (PMIC4 FTS426: mV, LSB/MSB),
+	 * mode 0x45, enable 0x46. The CPU rails are driven by the CPRh
+	 * controllers through their SAWs; this shows what they set.
+	 */
+	for (unsigned n = 0; n < 6; n++) {
+		uint16_t ppid = (uint16_t)(0x100 | (0x14 + 3 * n));
+		uint8_t t = 0, st = 0, lo = 0, hi = 0, mode = 0, en = 0;
+		bool ok = sweet_pmic_read(ppid, 0x04, &t) && sweet_pmic_read(ppid, 0x05, &st) &&
+		    sweet_pmic_read(ppid, 0x40, &lo) && sweet_pmic_read(ppid, 0x41, &hi) &&
+		    sweet_pmic_read(ppid, 0x45, &mode) && sweet_pmic_read(ppid, 0x46, &en);
+		if (n < 3) {
+			kirin_rail_mv[n] = ok && (en & 0x80) ? ((unsigned)hi << 8 | lo) : 0;
+		}
+		printf("SWEET CLK: pm660 s%u type %#x/%#x vctl %#x %#x (%u mV) mode %#x en %#x%s\n", n + 1,
+		    t, st, lo, hi, (unsigned)hi << 8 | lo, mode, en, ok ? "" : " (read failed)");
+	}
+	/*
+	 * Display controller (MDP 3.3, DT qcom,mdss_mdp@c900000), read only:
+	 * which source pipe scans out the boot splash (VIG0 +0x5000, DMA0-2
+	 * +0x25000/+0x27000/+0x29000: SRC_SIZE 0x00, SRC_XY 0x08, OUT_SIZE
+	 * 0x0c, SRC0_ADDR 0x14, SRC_YSTRIDE0 0x24, SRC_FORMAT 0x30), the CTLs
+	 * (+0x2000 + 0x200 n: LAYER(LM0) 0x00, TOP 0x14, FLUSH 0x18) and the
+	 * interfaces (+0x6b000 / +0x6b800: TIMING_ENGINE_EN 0x00, frame and
+	 * line counts 0xac / 0xb0).
+	 */
+	static const struct { const char *name; uint32_t off; } pipes[] = {
+		{"vig0", 0x5000}, {"dma0", 0x25000}, {"dma1", 0x27000}, {"dma2", 0x29000},
+	};
+	for (unsigned i = 0; i < sizeof(pipes) / sizeof(pipes[0]); i++) {
+		vm_offset_t pp = ml_io_map(0x0c900000u + pipes[i].off, 0x1000);
+		if (pp != 0) {
+			printf("SWEET MDP: %s size %#x xy %#x out %#x addr %#x stride %#x fmt %#x\n", pipes[i].name,
+			    clk_rd(pp, 0x00), clk_rd(pp, 0x08), clk_rd(pp, 0x0c), clk_rd(pp, 0x14),
+			    clk_rd(pp, 0x24), clk_rd(pp, 0x30));
+		}
+	}
+	vm_offset_t ctl = ml_io_map(0x0c902000u, 0x1000), intf = ml_io_map(0x0c96b000u, 0x1000);
+	for (unsigned n = 0; ctl != 0 && n < 5; n++) {
+		printf("SWEET MDP: ctl%u layer %#x top %#x flush %#x\n", n, clk_rd(ctl, 0x200 * n),
+		    clk_rd(ctl, 0x200 * n + 0x14), clk_rd(ctl, 0x200 * n + 0x18));
+	}
+	for (unsigned n = 0; intf != 0 && n < 2; n++) {
+		printf("SWEET MDP: intf%u en %#x frames %#x line %#x\n", n, clk_rd(intf, 0x800 * n),
+		    clk_rd(intf, 0x800 * n + 0xac), clk_rd(intf, 0x800 * n + 0xb0));
+	}
+	vm_offset_t osm = ml_io_map(0x179c0000u, 0x4000);
+	if (osm != 0) {
+		printf("SWEET CLK: osm +0 %#x +4 %#x +1000 %#x +1004 %#x +1100 %#x +3000 %#x\n",
+		    clk_rd(osm, 0x0), clk_rd(osm, 0x4), clk_rd(osm, 0x1000), clk_rd(osm, 0x1004),
+		    clk_rd(osm, 0x1100), clk_rd(osm, 0x3000));
+	}
+	kirin_pwrcl_raise();
+	kirin_osm_tune();
+	for (int c = 0; c < (int)ml_get_cpu_count(); c++) {
+		struct processor *p = cpu_to_processor(c);
+		if (p == NULL) {
+			continue;
+		}
+		thread_bind(p);
+		thread_block(THREAD_CONTINUE_NULL);
+		printf("SWEET CLK: cpu%d %llu MHz\n", c, perf_mhz());
+	}
+	thread_bind(PROCESSOR_NULL);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+kirin_perf_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	perf_wait(5);
+	kirin_clk_probe();
+	/*
+	 * Every 10 s: CoreAnimation swaps and panel presents per second, the
+	 * average present() time, and per-process CPU use (SWEET TOP). The
+	 * MSM8996 clock readings of perf_thread are left out.
+	 */
+	top_gen = 1;
+	perf_top(0);
+	uint64_t swaps = 0, presents = 0, pabs = 0, t = mach_absolute_time();
+	for (;;) {
+		perf_wait(10);
+		uint64_t now = mach_absolute_time(), ms = perf_ns(now - t) / NSEC_PER_MSEC;
+		uint64_t ds = sweet_fb_stat_swaps - swaps, dp = sweet_fb_stat_presents - presents;
+		uint64_t dabs = sweet_fb_stat_present_abs - pabs;
+		printf("SWEET PERF: swaps %llu.%llu/s  presents %llu.%llu/s  present avg %llu us\n",
+		    ms ? ds * 1000 / ms : 0, ms ? ds * 10000 / ms % 10 : 0,
+		    ms ? dp * 1000 / ms : 0, ms ? dp * 10000 / ms % 10 : 0,
+		    dp ? perf_ns(dabs) / 1000 / dp : 0);
+		perf_top(perf_ns(now - t));
+		swaps = sweet_fb_stat_swaps;
+		presents = sweet_fb_stat_presents;
+		pabs = sweet_fb_stat_present_abs;
+		t = now;
+	}
+}
+#endif
+
 void
 sweet_perf_init(void)
 {
@@ -577,6 +852,15 @@ sweet_perf_init(void)
 	int enabled = 1;
 	thread_t thread;
 	(void)PE_parse_boot_argn("sweetperf", &enabled, sizeof(enabled));
+#if defined(SWEET_KIRIN)
+	/* The Pixel clock code below must never run here (other addresses). */
+	int clk = 1;
+	(void)PE_parse_boot_argn("sweetclkprobe", &clk, sizeof(clk));
+	if (clk && kernel_thread_start(kirin_perf_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	return;
+#endif
 	if (!enabled) {
 		return;
 	}
diff --git a/bsd/dev/sweet_q6audio.c b/bsd/dev/sweet_q6audio.c
new file mode 100644
index 0000000..f49bd0b
--- /dev/null
+++ b/bsd/dev/sweet_q6audio.c
@@ -0,0 +1,1384 @@
+/*
+ * kirin: playback through the ADSP (APR services AFE, ADM, ASM over
+ * bsd/dev/sweet_glink.c), as Linux's q6afe/q6adm/q6asm and sdm660-internal
+ * do it for the earpiece and headphone port, INT0_MI2S_RX (0x102e):
+ *
+ *   SMMU     the ADSP reads our buffers through the LPASS Q6 SMMU
+ *            (0x5100000, stream 1: DT msm-audio-ion iommus = <&lpass_q6_smmu 1>);
+ *            its power vote (GCC 0x17d034) and clock (0x17d014) on; no stream
+ *            group matches stream 1 after boot (the DSP's first read then froze
+ *            the whole SoC) and bypass is refused, so a free group points it at
+ *            a free context bank whose tables map each address to itself: the
+ *            address given to the DSP is the physical one, with the stream id in
+ *            its upper 32 bits (as msm_audio_ion's smmu_sid_bits). Not taken:
+ *            no playback at all
+ *   AFE      clocks INT_MCLK_0 (codec core, 9.6 MHz) and INT0_MI2S_IBIT
+ *            (1.536 MHz), I2S config 48 kHz 16-bit stereo on SD0, port start
+ *   ADM      COPP on the port, NULL topology; the matrix maps ASM session 1
+ *            to it
+ *   ASM      the buffers mapped (8 x 4 KB), stream 1 of session 1 opened for
+ *            PCM (no post-processing), media format; RUN only when iOS plays
+ *            and PAUSE 0.5 s after its last frames, a write per buffer while
+ *            running, each refilled when the DSP says it is done with it
+ *
+ * What iOS plays (/dev/sweet-audio, stereo 16-bit 48 kHz, bsd/dev/sweet_audio.c)
+ * goes to a 64 KB ring; silence when it runs dry. The codec (digital part in
+ * the LPASS, analog part in the PM660L) is not set up here yet: the DSP
+ * plays into a port nothing listens to, which says whether this half works.
+ */
+#if defined(SWEET_KIRIN)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <arm/caches_internal.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern bool sweet_glink_up(void);
+extern int sweet_glink_apr_send(const void *pkt, uint32_t len);
+extern void (*sweet_glink_apr_client)(const uint8_t *pkt, uint32_t len);
+void sweet_q6audio_init(void);
+void sweet_q6audio_play(const uint8_t *pcm, uint32_t len);
+extern bool sweet_glink_smem_string(uint16_t item, char *out, uint32_t len);
+extern bool sweet_pmic_read(uint16_t ppid, uint8_t addr, uint8_t *out);
+
+/*
+ * The earpiece's codec, analog half: the PM660L's peripherals 0xf0 (digital) and 0xf1
+ * (analog) on SPMI SID 3 (DT anlg-cdc@f000 under pm660l@3). Linux's msm-analog-cdc picks
+ * its whole sequence by version: REVISION1, PERPH_SUBTYPE and the analog REVISION4
+ * (CAJON 2.0 on a TOMBAK 1.0 PMIC with analog major 2 is the DRAX codec). Read only, to
+ * write the earpiece path for the codec this phone has.
+ */
+#define CDC_DIG_PPID    0x3f0
+#define CDC_ANA_PPID    0x3f1
+
+extern bool sweet_pmic_write(uint16_t ppid, uint8_t addr, uint8_t val);
+
+/*
+ * The earpiece path, Linux's "handset" route of sdm660-internal (mixer_paths: RX1 MIX1
+ * INP1 = RX1, RDAC2 MUX = RX1, EAR_S = Switch, EAR PA Boost = ENABLE) on the DRAX codec,
+ * in the order DAPM powers its widgets (msm-digital-cdc, msm-analog-cdc):
+ *   PDM pins     LPI TLMM 0x15070000: gpio 18, 19, 21, 23, 25 func1 8 mA output-high,
+ *                gpio 20 func1 8 mA (DT cdc_pdm_gpios_active, cdc_pdm_2_gpios_active)
+ *   digital      the LPASS codec at 0x152c0000 (DT msm-dig-codec): RX I2S 48 kHz 16-bit,
+ *                RX1 interpolator at 48 kHz fed by I2S RX1, PDM and MCLK clocks (9.6 MHz)
+ *   analog       PM660L: bring-up reset, CAJON 2.0/DRAX defaults, clock block, RX1 clock,
+ *                RX bias, EAR charge pump in bypass (BOOST_SWITCH with EAR PA Boost),
+ *                RDAC2 = RX1, both DACs, EAR PA, then RX1 unmuted
+ */
+#define LPASS_DIG_CDC_PA        0x152c0000ull
+#define LPI_TLMM_PA             0x15070000ull
+
+static volatile uint32_t *dig_cdc;
+
+static void
+cdc_upd(uint16_t ppid, uint8_t reg, uint8_t mask, uint8_t val)
+{
+	uint8_t v = 0;
+	(void)sweet_pmic_read(ppid, reg, &v);
+	(void)sweet_pmic_write(ppid, reg, (uint8_t)((v & ~mask) | (val & mask)));
+}
+
+static void
+cdc_w(uint16_t ppid, uint8_t reg, uint8_t val)
+{
+	(void)sweet_pmic_write(ppid, reg, val);
+}
+
+static void
+dig_upd(uint32_t reg, uint32_t mask, uint32_t val)
+{
+	dig_cdc[reg / 4] = (dig_cdc[reg / 4] & ~mask) | (val & mask);
+}
+
+static void
+cdc_pdm_pins(void)
+{
+	volatile uint32_t *lpi = (volatile uint32_t *)ml_io_map(LPI_TLMM_PA + 0x8000, 0x1000);
+	static const struct { uint32_t off; bool out; } pin[] = {
+		{ 0x000, true }, { 0x010, true }, { 0x020, false }, { 0x030, true }, { 0x050, true }, { 0x070, true },
+	};
+	if (lpi == NULL) {
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(pin) / sizeof(pin[0]); i++) {
+		volatile uint32_t *r = lpi + pin[i].off / 4;
+		uint32_t v = r[0] & ~(0x3cu | 0x1c0u | 0x200u);
+		v |= (1u << 2) | (3u << 6) | (pin[i].out ? 1u << 9 : 0);     /* func1, 8 mA, value high */
+		r[0] = v;
+		r[1] = pin[i].out ? 1u << 1 : 0;                        /* output enable */
+	}
+	__builtin_arm_dsb(0xf);
+}
+
+static void
+cdc_earpiece_on(void)
+{
+	dig_cdc = (volatile uint32_t *)ml_io_map(LPASS_DIG_CDC_PA, 0x1000);
+	if (dig_cdc == NULL) {
+		printf("SWEET CDC: the digital codec cannot be mapped\n");
+		return;
+	}
+	cdc_pdm_pins();
+
+	/* analog bring-up (msm_anlg_cdc_bringup), OCP init, CAJON 2.0/DRAX defaults */
+	cdc_w(CDC_DIG_PPID, 0xd0, 0xa5);
+	cdc_w(CDC_DIG_PPID, 0xdb, 0x01);
+	cdc_w(CDC_ANA_PPID, 0xd0, 0xa5);
+	cdc_w(CDC_ANA_PPID, 0xdb, 0x01);
+	cdc_w(CDC_DIG_PPID, 0xd0, 0xa5);
+	cdc_w(CDC_DIG_PPID, 0xdb, 0x00);
+	cdc_w(CDC_ANA_PPID, 0xd0, 0xa5);
+	cdc_w(CDC_ANA_PPID, 0xdb, 0x00);
+	cdc_upd(CDC_ANA_PPID, 0x91, 0xff, 0x12);        /* RX_COM_OCP_CTL */
+	cdc_upd(CDC_ANA_PPID, 0x92, 0xff, 0xff);        /* RX_COM_OCP_COUNT */
+	static const struct { uint16_t ppid; uint8_t reg, val; } defaults[] = {
+		{ CDC_DIG_PPID, 0xd0, 0xa5 }, { CDC_DIG_PPID, 0xda, 0x0f },     /* PERPH_RESET_CTL3 */
+		{ CDC_ANA_PPID, 0xd0, 0xa5 }, { CDC_ANA_PPID, 0xda, 0x0f },
+		{ CDC_ANA_PPID, 0x65, 0x4c },   /* TX_1_2_OPAMP_BIAS */
+		{ CDC_ANA_PPID, 0xc0, 0xa2 },   /* CURRENT_LIMIT */
+		{ CDC_ANA_PPID, 0x83, 0xa8 },   /* NCP_FBCTRL */
+		{ CDC_ANA_PPID, 0x85, 0xa4 },   /* NCP_VCTRL */
+		{ CDC_ANA_PPID, 0xb3, 0x41 },   /* SPKR_ANA_BIAS_SET */
+		{ CDC_ANA_PPID, 0xb2, 0x69 },   /* SPKR_DRV_CTL */
+		{ CDC_ANA_PPID, 0xb7, 0x01 },   /* SPKR_DRV_DBG */
+		{ CDC_ANA_PPID, 0xb4, 0xe1 },   /* SPKR_OCP_CTL */
+		{ CDC_ANA_PPID, 0xb0, 0x03 },   /* SPKR_DAC_CTL */
+		{ CDC_ANA_PPID, 0xa1, 0x10 },   /* RX_EAR_STATUS */
+		{ CDC_ANA_PPID, 0xc2, 0x18 },   /* BYPASS_MODE */
+		{ CDC_ANA_PPID, 0x94, 0xfa },   /* RX_HPH_BIAS_PA */
+		{ CDC_DIG_PPID, 0x46, 0x80 },   /* CDC_RST_CTL */
+	};
+	for (unsigned i = 0; i < sizeof(defaults) / sizeof(defaults[0]); i++) {
+		cdc_w(defaults[i].ppid, defaults[i].reg, defaults[i].val);
+	}
+
+	/* digital codec: RX I2S 48 kHz 16-bit and its clock, RX1 interpolator fed by I2S RX1 */
+	dig_upd(0x0c, 0x0f, 0x03);              /* CLK_RX_I2S_CTL: 48 kHz */
+	dig_upd(0x0c, 0x20, 0x20);              /* 16-bit */
+	dig_upd(0x0c, 0x10, 0x10);              /* RX_I2S_CLK */
+	dig_upd(0x50, 0xf0, 0x60);              /* RX1_B5_CTL: interpolator at 48 kHz */
+	dig_upd(0x180, 0x07, 0x03);             /* CONN_RX1_B1_CTL: RX1 MIX1 INP1 = RX1 */
+
+	/* analog clock block, with the digital codec's CLK_ON (PDM, 9.6 MHz MCLK) inside */
+	cdc_upd(CDC_ANA_PPID, 0x46, 0x30, 0x30);        /* MASTER_BIAS_CTL */
+	dig_upd(0x28, 0x03, 0x03);                      /* CLK_PDM_CTL */
+	dig_upd(0xa4, 0x01, 0x01);                      /* TOP_CTL: 9.6 MHz MCLK */
+	dig_upd(0x24, 0x01, 0x01);                      /* CLK_MCLK_CTL */
+	cdc_upd(CDC_DIG_PPID, 0x46, 0x80, 0x80);        /* CDC_RST_CTL */
+	cdc_upd(CDC_DIG_PPID, 0x48, 0x0c, 0x0c);        /* CDC_TOP_CLK_CTL */
+	cdc_upd(CDC_DIG_PPID, 0x4a, 0x01, 0x01);        /* RX1 CLK (CDC_DIG_CLK_CTL) */
+	dig_upd(0x20, 0x01, 0x01);                      /* RX1 MIX2: CLK_RX_B1_CTL */
+
+	/* RX bias */
+	cdc_upd(CDC_ANA_PPID, 0x93, 0x80, 0x80);        /* RX_COM_BIAS_DAC */
+	cdc_upd(CDC_ANA_PPID, 0x93, 0x01, 0x01);
+	/* EAR charge pump: EAR PA Boost with BOOST_SWITCH is bypass (CAJON 2.0 and later) */
+	cdc_upd(CDC_DIG_PPID, 0x4a, 0x80, 0x80);
+	cdc_upd(CDC_DIG_PPID, 0x4a, 0x20, 0x20);
+	cdc_upd(CDC_ANA_PPID, 0xc2, 0x20, 0x20);        /* BYPASS_MODE */
+	cdc_upd(CDC_ANA_PPID, 0x80, 0x10, 0x10);        /* NCP_EN: EAR CP */
+	delay(1100);
+	/* RDAC2 MUX = RX1 */
+	cdc_upd(CDC_DIG_PPID, 0x52, 0x03, 0x02);        /* CDC_CONN_HPHR_DAC_CTL */
+	/* HPHL DAC (DRAX: later than CAJON) */
+	cdc_upd(CDC_ANA_PPID, 0x97, 0x08, 0x08);        /* RX_HPH_CNP_EN */
+	cdc_upd(CDC_ANA_PPID, 0x97, 0x08, 0x00);
+	cdc_upd(CDC_ANA_PPID, 0x9b, 0x02, 0x02);        /* RX_HPH_L_PA_DAC_CTL */
+	cdc_upd(CDC_DIG_PPID, 0x4a, 0x01, 0x01);
+	cdc_upd(CDC_DIG_PPID, 0x49, 0x02, 0x02);        /* CDC_ANA_CLK_CTL */
+	cdc_upd(CDC_ANA_PPID, 0x9b, 0x08, 0x08);        /* the DAC itself */
+	cdc_upd(CDC_ANA_PPID, 0x9b, 0x02, 0x00);
+	/* HPHR DAC */
+	cdc_upd(CDC_ANA_PPID, 0x9d, 0x02, 0x02);        /* RX_HPH_R_PA_DAC_CTL */
+	cdc_upd(CDC_DIG_PPID, 0x4a, 0x02, 0x02);
+	cdc_upd(CDC_DIG_PPID, 0x49, 0x01, 0x01);
+	cdc_upd(CDC_ANA_PPID, 0x9d, 0x08, 0x08);
+	cdc_upd(CDC_ANA_PPID, 0x9d, 0x02, 0x00);
+	/* EAR PA (DIANGU and later) */
+	cdc_upd(CDC_ANA_PPID, 0x9e, 0x80, 0x80);        /* RX_EAR_CTL: EAR selected */
+	cdc_upd(CDC_ANA_PPID, 0x93, 0x08, 0x00);
+	cdc_upd(CDC_ANA_PPID, 0x9a, 0x04, 0x04);        /* RX_HPH_L_TEST */
+	cdc_upd(CDC_ANA_PPID, 0x9c, 0x04, 0x04);        /* RX_HPH_R_TEST */
+	cdc_upd(CDC_ANA_PPID, 0x9e, 0x40, 0x40);        /* the PA on */
+	delay(7100);
+	dig_upd(0x5c, 0xff, 0x00);                      /* RX1 digital gain: 0 dB */
+	dig_upd(0x54, 0x01, 0x00);                      /* RX1_B6_CTL: unmuted */
+	__builtin_arm_dsb(0xf);
+	uint8_t ear = 0, ncp = 0;
+	(void)sweet_pmic_read(CDC_ANA_PPID, 0x9e, &ear);
+	(void)sweet_pmic_read(CDC_ANA_PPID, 0x80, &ncp);
+	printf("SWEET CDC: earpiece on (EAR_CTL %#x NCP_EN %#x; digital RX_I2S %#x RX1_B6 %#x MCLK %#x)\n", ear, ncp,
+	    dig_cdc[0x0c / 4], dig_cdc[0x54 / 4], dig_cdc[0x24 / 4]);
+}
+
+/*
+ * Microphone (TX) path: ADC1 on INT3, as msm_anlg_cdc (analog TX1 front-end,
+ * micbias, PM660L SPMI 0xf1) and msm_dig_cdc (decimator and TX I2S, the LPASS
+ * digital codec MMIO 0x152c0000). First pass -- the exact TX sequence is
+ * finicky, as the earpiece was; iterate against what the DSP reads back.
+ */
+static void
+cdc_mic_on(void)
+{
+	/* micbias1 for the internal (bottom) microphone */
+	cdc_upd(CDC_ANA_PPID, 0x42, 0x02, 0x02);        /* MICB_1_CTL: enable */
+	cdc_w(CDC_ANA_PPID, 0x40, 0x80);                /* MICB_1_EN */
+	delay(10000);
+	/* TX1 analog front-end (ADC1) */
+	cdc_w(CDC_ANA_PPID, 0x65, 0x6b);                /* TX_1_2_OPAMP_BIAS (POR) */
+	cdc_w(CDC_ANA_PPID, 0x66, 0x51);                /* TX_1_2_TXFE_CLKDIV (POR) */
+	cdc_w(CDC_ANA_PPID, 0x62, 0xbf);                /* TX_1_2_TEST_CTL_1 (POR) */
+	cdc_w(CDC_ANA_PPID, 0x63, 0x8c);                /* TX_1_2_TEST_CTL_2 (POR) */
+	cdc_upd(CDC_ANA_PPID, 0x60, 0x03, 0x03);        /* TX_1_EN: ADC1 on */
+	delay(12000);
+	/* digital decimator and TX I2S (LPASS dig codec, MMIO) */
+	cdc_upd(CDC_DIG_PPID, 0x50, 0x03, 0x00);        /* CONN_TX1_CTL: ADC1 -> TX1 */
+	dig_upd(0x10, 0x0f, 0x03);                      /* CLK_TX_I2S_CTL: 48 kHz */
+	dig_upd(0x10, 0x10, 0x10);                      /* CLK_TX_I2S_CTL: enable */
+	dig_upd(0x28c, 0x0f, 0x01);                     /* TX1_MUX_CTL: decimator input = ADC1 */
+	dig_upd(0x288, 0xff, 0x00);                     /* TX1_VOL_CTL_CFG */
+	dig_upd(0x284, 0xff, 0x00);                     /* TX1_VOL_CTL_GAIN: 0 dB */
+	__builtin_arm_dsb(0xf);
+	printf("SWEET CDC: mic on (micbias, TX1 ADC1, TX I2S)\n");
+}
+
+static void
+cdc_probe(void)
+{
+	static const uint8_t dig[] = { 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x46, 0x48, 0x49, 0x4a };
+	static const uint8_t ana[] = { 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x46, 0x80, 0x9e, 0xc3 };
+	char line[200];
+	int n = 0;
+	uint8_t v;
+	n += snprintf(line + n, sizeof(line) - n, "SWEET CDC: digital");
+	for (unsigned i = 0; i < sizeof(dig); i++) {
+		n += sweet_pmic_read(CDC_DIG_PPID, dig[i], &v) ? snprintf(line + n, sizeof(line) - n, " %02x=%02x", dig[i], v) :
+		    snprintf(line + n, sizeof(line) - n, " %02x=?", dig[i]);
+	}
+	printf("%s\n", line);
+	n = snprintf(line, sizeof(line), "SWEET CDC: analog ");
+	for (unsigned i = 0; i < sizeof(ana); i++) {
+		n += sweet_pmic_read(CDC_ANA_PPID, ana[i], &v) ? snprintf(line + n, sizeof(line) - n, " %02x=%02x", ana[i], v) :
+		    snprintf(line + n, sizeof(line) - n, " %02x=?", ana[i]);
+	}
+	printf("%s\n", line);
+}
+
+/*
+ * The speaker's codec, read only: the LPASS SoundWire codec (msm-sdw-codec, 0x152c1000),
+ * which drives the WSA881x amplifiers over SoundWire for the main speaker (port INT4). It
+ * only answers once its clocks run (INT_MCLK_1 9.6 MHz = 0x306, SWR NPL 153.6 MHz = 0x307,
+ * from the ADSP). Registers are a byte each at sdw_base + offset. This reads a few top
+ * registers to see whether the codec is reachable, before the full bring-up.
+ */
+struct apr_hdr {
+	uint16_t hdr_field, pkt_size;
+	uint8_t src_svc, src_domain;
+	uint16_t src_port;
+	uint8_t dest_svc, dest_domain;
+	uint16_t dest_port;
+	uint32_t token, opcode;
+} __attribute__((packed));
+
+#define SVC_CORE        3
+#define SVC_AFE         4
+#define SVC_ASM         7
+#define SVC_ADM         8
+#define BASIC_RSP       0x000110E8
+
+static int afe_clock(const char *what, uint32_t id, uint32_t hz, uint32_t enable, uint32_t token);
+static int q6_cmd(const char *what, void *pkt, uint32_t len, uint8_t svc, uint16_t port, uint32_t token, uint32_t rsp);
+#define PORT_INT4_RX    0x1036
+#define SDW_CDC_PA      0x152c1000ull
+
+/*
+ * A clock set against a port (AFE_PORT_CMD_SET_PARAM_V2, as afe_set_lpass_clock_v2): the
+ * SoundWire codec's register bus is gated this way, tied to INT4, not by the service-level
+ * clock set afe_clock uses.
+ */
+static int
+afe_port_clock(const char *what, uint16_t port, uint32_t clk_id, uint32_t hz)
+{
+	struct {
+		struct apr_hdr h;
+		uint16_t port, payload_size;
+		uint32_t mem[3];
+		uint32_t module, param;
+		uint16_t psize, reserved;
+		uint32_t ver, clk_id, freq;
+		uint16_t attri, root;
+		uint32_t enable;
+	} __attribute__((packed)) c;
+	bzero(&c, sizeof(c));
+	c.h.opcode = 0x000100EF;                /* AFE_PORT_CMD_SET_PARAM_V2 */
+	c.port = port;
+	c.payload_size = 12 + 20;
+	c.module = 0x0001028F;                  /* AFE_MODULE_CLOCK_SET */
+	c.param = 0x00010290;                   /* AFE_PARAM_ID_CLOCK_SET */
+	c.psize = 20;
+	c.ver = 1;
+	c.clk_id = clk_id;
+	c.freq = hz;
+	c.attri = 1;                            /* COUPLE_NO */
+	c.enable = 1;
+	return q6_cmd(what, &c, sizeof(c), 4 /* SVC_AFE */, 0, 0, 0);
+}
+
+/* the LPASS SoundWire codec (0x152c1000), byte registers at a 4-byte stride */
+static volatile uint32_t *sdw_cdc;
+
+/* one SoundWire-master register through the codec's AHB bridge (4 bytes, LSB first) */
+static void
+swrm_write(uint32_t addr, uint32_t val)
+{
+	for (int i = 0; i < 4; i++) {
+		sdw_cdc[(0xa4 + 4 * i) / 4] = (val >> (8 * i)) & 0xff;      /* WR_DATA_0..3 */
+	}
+	for (int i = 0; i < 4; i++) {
+		sdw_cdc[(0xb4 + 4 * i) / 4] = (addr >> (8 * i)) & 0xff;     /* WR_ADDR_0..3 triggers it */
+	}
+	__builtin_arm_dsb(0xf);
+	delay(100);
+}
+
+static uint32_t
+swrm_read(uint32_t addr)
+{
+	for (int i = 0; i < 4; i++) {
+		sdw_cdc[(0xc4 + 4 * i) / 4] = (addr >> (8 * i)) & 0xff;     /* RD_ADDR_0..3 */
+	}
+	__builtin_arm_dsb(0xf);
+	delay(100);
+	uint32_t v = 0;
+	for (int i = 0; i < 4; i++) {
+		v |= (sdw_cdc[(0xd4 + 4 * i) / 4] & 0xff) << (8 * i);       /* RD_DATA_0..3 */
+	}
+	return v;
+}
+
+static void
+sdw_probe(void)
+{
+	/*
+	 * The SoundWire codec's register bus is clocked only once the ADSP's INT4_MI2S_RX
+	 * port runs (Linux enables INT_MCLK_1 against AFE_PORT_ID_INT4_MI2S_RX). So, as for
+	 * INT0: the codec MCLK (INT_MCLK_1 0x306), the INT4 bit clock (0x113), the SoundWire
+	 * NPL clock (0x307), then an I2S config and a device start on port 0x1036 (mono).
+	 */
+	/* the ADSP refuses the port-level clock set (error 0x2); the service level works */
+	if (afe_clock("INT_MCLK_1 (9.6 MHz)", 0x306, 9600000, 1, 90) ||
+	    afe_clock("INT4_MI2S bit clock (1.536 MHz)", 0x113, 1536000, 1, 90) ||
+	    afe_clock("SoundWire NPL clock (153.6 MHz)", 0x307, 153600000, 1, 90)) {
+		printf("SWEET SDW: clocks refused, codec not brought up\n");
+		return;
+	}
+	/* which is alive: the earpiece digital codec (0x152c0000, known good) vs the sdw (0x152c1000) */
+	{
+		volatile uint32_t *dig = (volatile uint32_t *)ml_io_map(0x152c0000ull, 0x1000);
+		volatile uint32_t *sw = (volatile uint32_t *)ml_io_map(SDW_CDC_PA, 0x1000);
+		printf("SWEET SDW: compare: dig(0x152c0000) CLK_RX_I2S=%02x TOP_CTL=%02x ; sdw(0x152c1000) 0x104=%02x 0x204=%02x\n",
+		    dig ? (uint8_t)dig[0x0c / 4] : 0xff, dig ? (uint8_t)dig[0xa4 / 4] : 0xff,
+		    sw ? (uint8_t)sw[0x104 / 4] : 0xff, sw ? (uint8_t)sw[0x204 / 4] : 0xff);
+	}
+	{
+		struct {
+			struct apr_hdr h;
+			uint16_t port, payload_size;
+			uint32_t mem[3];
+			uint32_t module, param;
+			uint16_t psize, reserved;
+			uint32_t ver;
+			uint16_t bit_width, channel_mode, mono_stereo, ws_src;
+			uint32_t rate;
+			uint16_t data_format, reserved2;
+		} __attribute__((packed)) c;
+		bzero(&c, sizeof(c));
+		c.h.opcode = 0x000100EF;        /* AFE_PORT_CMD_SET_PARAM_V2 */
+		c.port = PORT_INT4_RX;
+		c.payload_size = 12 + 20;
+		c.module = 0x0001020C;          /* AFE_MODULE_AUDIO_DEV_INTERFACE */
+		c.param = 0x0001020D;           /* AFE_PARAM_ID_I2S_CONFIG */
+		c.psize = 20;
+		c.ver = 1;
+		c.bit_width = 16;
+		c.channel_mode = 1;             /* SD0 */
+		c.mono_stereo = 0;              /* mono (the WSA speaker) */
+		c.ws_src = 1;                   /* internal: we are the master */
+		c.rate = 48000;
+		if (q6_cmd("INT4_MI2S_RX I2S config", &c, sizeof(c), SVC_AFE, 0, 0, 0)) {
+			return;
+		}
+	}
+	{
+		struct { struct apr_hdr h; uint16_t port, reserved; } __attribute__((packed)) c;
+		bzero(&c, sizeof(c));
+		c.h.opcode = 0x000100E5;        /* AFE_PORT_CMD_DEVICE_START */
+		c.port = PORT_INT4_RX;
+		if (q6_cmd("INT4_MI2S_RX start", &c, sizeof(c), SVC_AFE, 0, 0, 0)) {
+			return;
+		}
+	}
+	sdw_cdc = (volatile uint32_t *)ml_io_map(SDW_CDC_PA, 0x1000);
+	if (sdw_cdc == NULL) {
+		printf("SWEET SDW: codec cannot be mapped\n");
+		return;
+	}
+	/*
+	 * Codec clock block (msm_sdw_mclk_enable): FS_CNT (0x108), MCLK_CONTROL (0x104),
+	 * FREQ_MCLK (0x228) for 9.6 MHz; then SWR_CONTROL (0x10c) clocks the SoundWire master.
+	 * Each register is a byte at a 4-byte stride (regmap reg_stride 4), so sdw_cdc[off/4].
+	 */
+	sdw_cdc[0x108 / 4] = 0x01;
+	sdw_cdc[0x104 / 4] = 0x01;
+	sdw_cdc[0x228 / 4] = 0x01;
+	sdw_cdc[0x10c / 4] = 0x01;
+	__builtin_arm_dsb(0xf);
+	delay(1000);
+	printf("SWEET SDW: codec MCLK=%02x FS_CNT=%02x SWR=%02x TOP_CFG0=%02x FREQ=%02x\n",
+	    (uint8_t)sdw_cdc[0x104 / 4], (uint8_t)sdw_cdc[0x108 / 4], (uint8_t)sdw_cdc[0x10c / 4],
+	    (uint8_t)sdw_cdc[0x204 / 4], (uint8_t)sdw_cdc[0x228 / 4]);
+
+	/*
+	 * The SoundWire master is reached through the codec's AHB bridge: its registers are
+	 * not in the codec's own map. To write one, put the 32-bit value in WR_DATA_0..3
+	 * (0xa4 + 4*i) then the address in WR_ADDR_0..3 (0xb4 + 4*i); to read, put the address
+	 * in RD_ADDR_0..3 (0xc4) and read RD_DATA_0..3 (0xd4). As Linux's msm_sdw_swrm_read/write.
+	 */
+	uint32_t hw = swrm_read(0x0);                   /* SWRM_COMP_HW_VERSION */
+	printf("SWEET SDW: SoundWire master HW version %#x\n", hw);
+
+	/* init as swr-wcd-ctrl's swrm_reg_writes */
+	swrm_write(0x1044, 0x02);                       /* MCP_BUS_CTRL: clock start */
+	swrm_write(0x500, 0x01);                        /* ENUMERATOR_CFG: auto-enumerate */
+	swrm_write(0x204, 0x1FFFD);                     /* INTERRUPT_MASK */
+	uint32_t mcp = swrm_read(0x1048);
+	swrm_write(0x1048, (mcp & ~0x1f0000u) | (0x1fu << 16)); /* MCP_CFG: max no-ping cmds */
+	swrm_write(0x314, 0x01);                        /* CMD_FIFO_CFG: 1 retry */
+	swrm_write(0x4, 0x02);                          /* COMP_CFG: IRQ pulse */
+	swrm_write(0x4, 0x03);                          /* COMP_CFG: enable */
+	swrm_write(0x208, 0x08);                        /* INTERRUPT_CLEAR */
+	__builtin_arm_dsb(0xf);
+	delay(5000);                                    /* let the WSA amps enumerate */
+
+	uint32_t slv = swrm_read(0x1090);               /* MCP_SLV_STATUS: 2 bits per device */
+	printf("SWEET SDW: slave status %#x (01 = a device attached, per slot)%s\n", slv,
+	    slv ? "" : ": no WSA enumerated");
+}
+
+/* our SMMU context bank, for its fault registers */
+static volatile uint32_t *q_cbr;
+
+/* why the DSP stopped: the context bank's fault state, and the LPASS's own reason (SMEM 423) */
+static void
+q6_diagnose(const char *when)
+{
+	char why[160] = "";
+	if (q_cbr) {
+		printf("SWEET Q6: %s: SMMU context FSR %#x FAR %#x%08x FSYNR0 %#x\n", when, q_cbr[0x58 / 4],
+		    q_cbr[0x64 / 4], q_cbr[0x60 / 4], q_cbr[0x68 / 4]);
+	}
+	if (sweet_glink_smem_string(423, why, sizeof(why)) && why[0]) {
+		printf("SWEET Q6: %s: the LPASS says \"%s\"\n", when, why);
+	} else {
+		printf("SWEET Q6: %s: no LPASS reason in SMEM 423\n", when);
+	}
+}
+
+#define SMMU_PA         0x05100000ull
+#define SMMU_SZ         0x40000u
+#define GCC_LPASS_GDSC  0x0017d034ull
+#define GCC_LPASS_SMMU  0x0017d014ull
+#define AUDIO_SID       1u
+
+#define PORT_INT0_RX    0x102E
+#define SESSION         1
+#define ASM_PORT        ((SESSION << 8) | 1)
+
+#define NBUF            8
+#define BUFSZ           4096u
+#define INFLIGHT        4
+#define RING            65536u
+
+static struct {
+	/* the one command waited for */
+	volatile uint32_t want, got, status, pl[4];
+	/* buffers the DSP gave back, by index */
+	volatile uint32_t done_mask;
+	volatile uint32_t write_errs;
+	uint8_t ring[RING];
+	volatile uint32_t rhead, rtail;
+	bool playing;
+	volatile uint64_t last_write;
+	int sleep_chan;
+} q;
+
+static LCK_GRP_DECLARE(sweet_q6_grp, "sweet_q6audio");
+static LCK_SPIN_DECLARE(sweet_q6_ring_lock, &sweet_q6_grp);
+
+/* ---- microphone capture (INT3_MI2S_TX, ADSP read) ---- */
+#define PORT_INT3_TX    0x1035
+#define CSESSION        2
+#define CASM_PORT       ((CSESSION << 8) | 1)
+#define NBUF_CAP        8
+#define MICRING         65536u
+
+static struct {
+	volatile uint32_t capturing;            /* /dev/sweet-mic is open */
+	volatile uint32_t read_done;            /* bitmask of buffers the DSP filled */
+	volatile uint32_t read_len[NBUF_CAP];   /* bytes filled, per buffer */
+	uint8_t ring[MICRING];                  /* captured mono 16-bit, waiting for iOS */
+	volatile uint32_t rhead, rtail;
+	bool ready;                             /* the capture session is set up */
+	uint32_t handle;
+	uint8_t *cbuf;
+	uint64_t cpa;
+} mc;
+static LCK_SPIN_DECLARE(mic_ring_lock, &sweet_q6_grp);
+
+void sweet_q6audio_capture_start(void);
+void sweet_q6audio_capture_stop(void);
+uint32_t sweet_q6audio_capture_read(uint8_t *out, uint32_t len);
+
+void
+sweet_q6audio_capture_start(void)
+{
+	mc.capturing = 1;
+}
+
+void
+sweet_q6audio_capture_stop(void)
+{
+	mc.capturing = 0;
+}
+
+uint32_t
+sweet_q6audio_capture_read(uint8_t *out, uint32_t len)
+{
+	lck_spin_lock(&mic_ring_lock);
+	uint32_t avail = (mc.rhead - mc.rtail) & (MICRING - 1);
+	len = MIN(len, avail);
+	for (uint32_t i = 0; i < len; i++) {
+		out[i] = mc.ring[(mc.rtail + i) & (MICRING - 1)];
+	}
+	mc.rtail = (mc.rtail + len) & (MICRING - 1);
+	lck_spin_unlock(&mic_ring_lock);
+	return len;
+}
+
+/* the DSP filled a capture buffer: keep its mono samples for iOS to read */
+static void
+mic_ring_put(const uint8_t *pcm, uint32_t len)
+{
+	lck_spin_lock(&mic_ring_lock);
+	uint32_t room = (mc.rtail - mc.rhead - 1) & (MICRING - 1);
+	len = MIN(len, room);
+	for (uint32_t i = 0; i < len; i++) {
+		mc.ring[(mc.rhead + i) & (MICRING - 1)] = pcm[i];
+	}
+	mc.rhead = (mc.rhead + len) & (MICRING - 1);
+	lck_spin_unlock(&mic_ring_lock);
+}
+
+static void
+q_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&q.sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* the glink thread: only note what came, the sends happen in our thread */
+static void
+q6_rx(const uint8_t *pkt, uint32_t len)
+{
+	const struct apr_hdr *h = (const struct apr_hdr *)pkt;
+	const uint32_t *pl = (const uint32_t *)(pkt + ((h->hdr_field >> 4) & 0xf) * 4);
+	uint32_t n = (len - ((h->hdr_field >> 4) & 0xf) * 4) / 4;
+	if (h->opcode == 0x00010D99) {          /* ASM_DATA_EVENT_WRITE_DONE_V2 */
+		if (n >= 4 && pl[3] != 0) {
+			q.write_errs++;
+		}
+		if (h->token < NBUF) {
+			__c11_atomic_fetch_or((_Atomic uint32_t *)&q.done_mask, 1u << h->token, __ATOMIC_RELEASE);
+		}
+		return;
+	}
+	if (h->opcode == 0x00010D9A) {          /* ASM_DATA_EVENT_READ_DONE_V2 */
+		if (h->token < NBUF_CAP) {
+			mc.read_len[h->token] = n >= 5 ? pl[4] : BUFSZ;      /* enc_framesotal_size */
+			__c11_atomic_fetch_or((_Atomic uint32_t *)&mc.read_done, 1u << h->token, __ATOMIC_RELEASE);
+		}
+		return;
+	}
+	if (q.want && (h->opcode == q.want || (h->opcode == BASIC_RSP && n >= 2 && pl[0] == q.want))) {
+		for (uint32_t i = 0; i < 4 && i < n; i++) {
+			q.pl[i] = pl[i];
+		}
+		q.status = h->opcode == BASIC_RSP ? pl[1] : 0;
+		__c11_atomic_store((_Atomic uint32_t *)&q.got, h->opcode, __ATOMIC_RELEASE);
+		return;
+	}
+	printf("SWEET Q6: svc %u opcode %#x token %u%s%#x %#x\n", h->src_svc, h->opcode, h->token,
+	    n >= 2 ? ": " : "", n >= 1 ? pl[0] : 0, n >= 2 ? pl[1] : 0);
+}
+
+/* send, then wait for the basic response to cmd or for rsp (when not 0) */
+static int
+q6_cmd(const char *what, void *pkt, uint32_t len, uint8_t svc, uint16_t port, uint32_t token, uint32_t rsp)
+{
+	struct apr_hdr *h = (struct apr_hdr *)pkt;
+	h->hdr_field = (2 << 8) | (5 << 4);     /* SEQ_CMD, 20-byte header */
+	h->pkt_size = (uint16_t)len;
+	h->src_svc = svc;
+	h->src_domain = 5;
+	h->src_port = port;
+	h->dest_svc = svc;
+	h->dest_domain = 4;
+	h->dest_port = port;
+	h->token = token;
+	q.got = 0;
+	q.status = 0;
+	q.want = rsp ? rsp : h->opcode;
+	int err = sweet_glink_apr_send(pkt, len);
+	for (int i = 0; !err && i < 1000 && !q.got; i++) {
+		q_sleep_ms(1);
+	}
+	q.want = 0;
+	if (err || !q.got) {
+		printf("SWEET Q6: %s: %s\n", what, err ? "not sent" : "no answer in 1 s");
+		return err ? err : ETIMEDOUT;
+	}
+	if (q.status) {
+		printf("SWEET Q6: %s: refused, ADSP error %#x\n", what, q.status);
+		return EIO;
+	}
+	printf("SWEET Q6: %s ok\n", what);
+	return 0;
+}
+
+/* AFE_SVC_CMD_SET_PARAM (v1 header) with one clock */
+static int
+afe_clock(const char *what, uint32_t id, uint32_t hz, uint32_t enable, uint32_t token)
+{
+	struct {
+		struct apr_hdr h;
+		uint32_t payload_size;
+		uint32_t mem[3];
+		uint32_t module, param;
+		uint16_t psize, reserved;
+		uint32_t ver, clk_id, freq;
+		uint16_t attri, root;
+		uint32_t enable;
+	} __attribute__((packed)) c;
+	bzero(&c, sizeof(c));
+	c.h.opcode = 0x000100f3;                /* AFE_SVC_CMD_SET_PARAM */
+	c.payload_size = 12 + 20;
+	c.module = 0x0001028F;                  /* AFE_MODULE_CLOCK_SET */
+	c.param = 0x00010290;                   /* AFE_PARAM_ID_CLOCK_SET */
+	c.psize = 20;
+	c.ver = 1;
+	c.clk_id = id;
+	c.freq = hz;
+	c.attri = 1;                            /* COUPLE_NO */
+	c.enable = enable;
+	/* token = the port index, as Linux's afe_set_lpass_clk_cfg: it routes the clock to the port */
+	return q6_cmd(what, &c, sizeof(c), SVC_AFE, 0, token, 0);
+}
+
+static uint64_t
+smmu_setup(void)
+{
+	volatile uint32_t *gdsc = (volatile uint32_t *)ml_io_map(GCC_LPASS_GDSC & ~0xfffull, 0x1000);
+	volatile uint32_t *clk = (volatile uint32_t *)ml_io_map(GCC_LPASS_SMMU & ~0xfffull, 0x1000);
+	if (!gdsc || !clk) {
+		return 0;
+	}
+	volatile uint32_t *gd = gdsc + (GCC_LPASS_GDSC & 0xfff) / 4;
+	volatile uint32_t *ck = clk + (GCC_LPASS_SMMU & 0xfff) / 4;
+	uint32_t gd0 = *gd, ck0 = *ck;
+	*gd = gd0 & ~1u;                        /* SW_COLLAPSE off */
+	*ck = ck0 | 1u;
+	__builtin_arm_dsb(0xf);
+	q_sleep_ms(2);
+	printf("SWEET Q6: SMMU power vote %#x -> %#x, clock %#x -> %#x\n", gd0, *gd, ck0, *ck);
+
+	volatile uint32_t *s = (volatile uint32_t *)ml_io_map(SMMU_PA, SMMU_SZ);
+	if (!s) {
+		return 0;
+	}
+	uint32_t idr0 = s[0x20 / 4], idr1 = s[0x24 / 4], nsmr = idr0 & 0xff;
+	uint32_t pg = (idr1 >> 31) ? 0x10000 : 0x1000;
+	printf("SWEET Q6: SMMU sCR0 %#x IDR0 %#x IDR1 %#x (%u stream groups)\n", s[0], idr0, idr1, nsmr);
+	bool found = false;
+	for (uint32_t i = 0; i < nsmr && i < 128; i++) {
+		uint32_t smr = s[(0x800 + 4 * i) / 4], s2cr = s[(0xc00 + 4 * i) / 4];
+		uint32_t id = smr & 0x7fff, mask = (smr >> 16) & 0x7fff;
+		if (!(smr & (1u << 31)) || ((AUDIO_SID ^ id) & ~mask & 0x7fff)) {
+			continue;
+		}
+		found = true;
+		uint32_t type = (s2cr >> 16) & 3, cb = s2cr & 0xff;
+		volatile uint32_t *cbr = s + (SMMU_SZ / 2 + cb * pg) / 4;
+		printf("SWEET Q6: SMMU group %u: id %#x mask %#x, S2CR %#x (%s, context %u: SCTLR %#x TTBR0 %#x%08x)\n",
+		    i, id, mask, s2cr, type == 0 ? "translation" : type == 1 ? "bypass" : "fault", cb,
+		    type == 0 ? cbr[0] : 0, type == 0 ? cbr[0x24 / 4] : 0, type == 0 ? cbr[0x20 / 4] : 0);
+		if (type != 1) {
+			s[(0xc00 + 4 * i) / 4] = (s2cr & ~(3u << 16)) | (1u << 16);
+			__builtin_arm_dsb(0xf);
+			printf("SWEET Q6: SMMU group %u set to bypass: S2CR now %#x\n", i, s[(0xc00 + 4 * i) / 4]);
+		}
+	}
+	if (found) {
+		return 1;
+	}
+	/*
+	 * No group matches stream 1: the DSP's first read of our buffers froze the whole SoC.
+	 * Bypass is refused (S2CR stays "fault": the hypervisor's rule), so as Linux's arm-smmu:
+	 * a free context bank, stage 1 only, AArch64 tables with T0SZ 32 (4 GB of IOVA, starting
+	 * at level 1) whose four 1 GB blocks map each address to itself; then a free group points
+	 * stream 1 at it.
+	 */
+	uint32_t ncb = idr1 & 0xff, used = 0;
+	for (uint32_t i = 0; i < nsmr && i < 128; i++) {
+		uint32_t s2cr = s[(0xc00 + 4 * i) / 4];
+		if ((s[(0x800 + 4 * i) / 4] & (1u << 31)) && ((s2cr >> 16) & 3) == 0) {
+			used |= 1u << (s2cr & 0x1f);
+		}
+	}
+	int cb = -1;
+	for (int c = (int)MIN(ncb, 32u) - 1; c >= 0; c--) {
+		if (!(used & (1u << c))) {
+			cb = c;
+			break;
+		}
+	}
+	int grp = -1;
+	for (uint32_t i = 0; i < nsmr && i < 128; i++) {
+		if (!(s[(0x800 + 4 * i) / 4] & (1u << 31))) {
+			grp = (int)i;
+			break;
+		}
+	}
+	if (cb < 0 || grp < 0) {
+		printf("SWEET Q6: no free SMMU context (%d) or group (%d): no playback\n", cb, grp);
+		return 0;
+	}
+	vm_offset_t ptva = 0;
+	if (kmem_alloc_contig(kernel_map, &ptva, PAGE_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return 0;
+	}
+	uint64_t pt = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)ptva));
+	for (uint64_t i = 0; i < 4; i++) {
+		/*
+		 * block, AttrIndx 0 (normal write-back), inner shareable, access flag, nG, and
+		 * AP_UNPRIV as Linux's io-pgtable-arm sets on every mapping: the DSP's reads are
+		 * not privileged, and without it the decoder took a permission fault on the
+		 * first buffer ("EX:AUDIO_660.adsp.:2:ADec9").
+		 */
+		((uint64_t *)ptva)[i] = (i << 30) | (1ull << 11) | (1ull << 10) | (3ull << 8) | (1ull << 6) | 1ull;
+	}
+	flush_dcache64((addr64_t)pt, PAGE_SIZE, TRUE);
+	flush_dcache64((addr64_t)ptva, PAGE_SIZE, FALSE);
+	__builtin_arm_dsb(0xf);
+
+	volatile uint32_t *gr1 = s + pg / 4;
+	volatile uint32_t *cbr = s + (SMMU_SZ / 2 + (uint32_t)cb * pg) / 4;
+	cbr[0] = 0;                                     /* SCTLR: off while it is set up */
+	gr1[cb] = (1u << 16) | (3u << 8) | (0xfu << 12); /* CBAR: S1 trans S2 bypass, NSH, WB */
+	gr1[(0x800 / 4) + cb] = 1;                      /* CBA2R: AArch64 */
+	/*
+	 * TTBCR2 (0x10): the upper 32 bits of the 64-bit LPAE TCR. PASize from IDR2.OAS, and
+	 * SEP_UPSTREAM (0x7 << 15) as arm-smmu.c adds for an AArch64 stage-1 context. It was
+	 * missing (only PASize), so the walker had no address-size separator and faulted.
+	 */
+	cbr[0x10 / 4] = ((s[0x28 / 4] >> 4) & 0x7) | (0x7u << 15);
+	cbr[0x20 / 4] = (uint32_t)pt;                   /* TTBR0, ASID 0 */
+	cbr[0x24 / 4] = (uint32_t)(pt >> 32);
+	cbr[0x28 / 4] = 0;                              /* TTBR1 */
+	cbr[0x2c / 4] = 0;
+	/*
+	 * TCR (TTBCR, the low 32 bits): T0SZ 25 (ias 39 as DT qcom,use-3-lvl-tables caps it,
+	 * so the walk starts at level 1 over the 512-entry table below), TG0 4K, EPD1, and
+	 * cacheable inner-shareable walks (SH_IS, IRGN/ORGN WBWA) with the table flushed.
+	 * The AArch32 EAE bit (31) is gone: the context is AArch64 (CBA2R.VA64).
+	 */
+	cbr[0x30 / 4] = 25u | (1u << 8) | (1u << 10) | (3u << 12) | (1u << 23);
+	cbr[0x38 / 4] = 0xff;                           /* MAIR0: attr 0 normal write-back */
+	cbr[0x3c / 4] = 0;
+	cbr[0x58 / 4] = 0xffffffffu;                    /* FSR: clear */
+	__builtin_arm_dsb(0xf);
+	cbr[0x618 / 4] = 0;                             /* TLBIALL */
+	cbr[0x7f0 / 4] = 0;                             /* TLBSYNC */
+	for (int i = 0; i < 1000 && (cbr[0x7f4 / 4] & 1); i++) {
+		delay(1);
+	}
+	/* SCTLR: M, TRE, AFE, CFRE, CFIE (faults report, they do not stall) */
+	cbr[0] = 1u | (1u << 1) | (1u << 2) | (1u << 5) | (1u << 6);
+	__builtin_arm_dsb(0xf);
+	uint32_t s2cr = s[(0xc00 + 4 * grp) / 4];
+	s[(0xc00 + 4 * grp) / 4] = (s2cr & ~(3u << 16) & ~0xffu) | (uint32_t)cb;
+	__builtin_arm_dsb(0xf);
+	s[(0x800 + 4 * grp) / 4] = (1u << 31) | AUDIO_SID;
+	__builtin_arm_dsb(0xf);
+	q_cbr = cbr;
+	uint32_t smr = s[(0x800 + 4 * grp) / 4], s2 = s[(0xc00 + 4 * grp) / 4];
+	bool ok = smr == ((1u << 31) | AUDIO_SID) && ((s2 >> 16) & 3) == 0 && (s2 & 0xff) == (uint32_t)cb &&
+	    (cbr[0] & 1) && cbr[0x20 / 4] == (uint32_t)pt;
+	printf("SWEET Q6: SMMU context %d (identity, tables at %#llx: SCTLR %#x TCR %#x TTBR0 %#x CBAR %#x CBA2R %#x, "
+	    "IDR2 %#x) and group %d (SMR %#x S2CR %#x) for stream %u: %s\n", cb, pt, cbr[0], cbr[0x30 / 4], cbr[0x20 / 4],
+	    gr1[cb], gr1[(0x800 / 4) + cb], s[0x28 / 4], grp, smr, s2, AUDIO_SID, ok ? "taken" : "NOT taken, no playback");
+	if (!ok) {
+		s[(0x800 + 4 * grp) / 4] = 0;          /* give the group back */
+	}
+	return ok ? 1 : 0;
+}
+
+static void
+ring_take(uint8_t *out, uint32_t n)
+{
+	lck_spin_lock(&sweet_q6_ring_lock);
+	uint32_t have = (q.rhead - q.rtail) & (RING - 1), k = MIN(have, n) & ~3u;
+	for (uint32_t i = 0; i < k; i++) {
+		out[i] = q.ring[(q.rtail + i) & (RING - 1)];
+	}
+	q.rtail = (q.rtail + k) & (RING - 1);
+	lck_spin_unlock(&sweet_q6_ring_lock);
+	bzero(out + k, n - k);
+}
+
+void
+sweet_q6audio_play(const uint8_t *pcm, uint32_t len)
+{
+	if (!q.playing) {
+		return;
+	}
+	lck_spin_lock(&sweet_q6_ring_lock);
+	uint32_t room = (q.rtail - q.rhead - 4) & (RING - 1);
+	len = MIN(len, room) & ~3u;            /* full: the rest is dropped */
+	for (uint32_t i = 0; i < len; i++) {
+		q.ring[(q.rhead + i) & (RING - 1)] = pcm[i];
+	}
+	q.rhead = (q.rhead + len) & (RING - 1);
+	lck_spin_unlock(&sweet_q6_ring_lock);
+	q.last_write = mach_absolute_time();
+}
+
+/*
+ * Capture (microphone) setup: the mirror of the playback path on INT3_MI2S_TX.
+ * Runs once in q6_thread after playback is set up; a failure here leaves
+ * playback working. The capture session (CSESSION) reads mono 16-bit 48 kHz
+ * from the DSP into mc.cbuf, which capture_pump() drains into the mic ring.
+ */
+static uint16_t cap_copp;
+
+static bool
+capture_setup(void)
+{
+	vm_offset_t cva = 0;
+	if (kmem_alloc_contig(kernel_map, &cva, NBUF_CAP * BUFSZ, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET Q6: no memory for the capture buffers\n");
+		return false;
+	}
+	mc.cbuf = (uint8_t *)cva;
+	mc.cpa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)cva));
+
+	if (afe_clock("INT3_MI2S bit clock (1.536 MHz)", 0x112, 1536000, 1, 0)) {
+		return false;
+	}
+	{
+		struct {
+			struct apr_hdr h;
+			uint16_t port, payload_size;
+			uint32_t mem[3];
+			uint32_t module, param;
+			uint16_t psize, reserved;
+			uint32_t ver;
+			uint16_t bit_width, channel_mode, mono_stereo, ws_src;
+			uint32_t rate;
+			uint16_t data_format, reserved2;
+		} __attribute__((packed)) c;
+		bzero(&c, sizeof(c));
+		c.h.opcode = 0x000100EF;        /* AFE_PORT_CMD_SET_PARAM_V2 */
+		c.port = PORT_INT3_TX;
+		c.payload_size = 12 + 20;
+		c.module = 0x0001020C;
+		c.param = 0x0001020D;
+		c.psize = 20;
+		c.ver = 1;
+		c.bit_width = 16;
+		c.channel_mode = 1;
+		c.mono_stereo = 0;              /* mono */
+		c.ws_src = 1;
+		c.rate = 48000;
+		if (q6_cmd("INT3_MI2S_TX I2S config", &c, sizeof(c), SVC_AFE, 0, 0, 0)) {
+			return false;
+		}
+	}
+	{
+		struct { struct apr_hdr h; uint16_t port, reserved; } __attribute__((packed)) c;
+		bzero(&c, sizeof(c));
+		c.h.opcode = 0x000100E5;        /* AFE_PORT_CMD_DEVICE_START */
+		c.port = PORT_INT3_TX;
+		if (q6_cmd("INT3_MI2S_TX start", &c, sizeof(c), SVC_AFE, 0, 0, 0)) {
+			return false;
+		}
+	}
+	cdc_mic_on();
+	{
+		struct {
+			struct apr_hdr h;
+			uint16_t flags, mode, ep1, ep2;
+			uint32_t topology;
+			uint16_t channels, bit_width;
+			uint32_t rate;
+			uint8_t map[8];
+		} __attribute__((packed)) c;
+		bzero(&c, sizeof(c));
+		c.h.opcode = 0x00010326;        /* ADM_CMD_DEVICE_OPEN_V5 */
+		c.mode = 2;                     /* live record (TX) COPP */
+		c.ep1 = PORT_INT3_TX;
+		c.ep2 = 0xffff;
+		c.topology = 0x00010312;        /* NULL_COPP_TOPOLOGY */
+		c.channels = 1;
+		c.bit_width = 16;
+		c.rate = 48000;
+		c.map[0] = 1;
+		if (q6_cmd("ADM TX COPP open", &c, sizeof(c), SVC_ADM, PORT_INT3_TX, 0, 0x00010329)) {
+			return false;
+		}
+		if (q.pl[0] != 0) {
+			printf("SWEET Q6: ADM TX COPP open: ADSP error %#x\n", q.pl[0]);
+			return false;
+		}
+		cap_copp = (uint16_t)q.pl[1];
+		printf("SWEET Q6: TX COPP %u on INT3_MI2S_TX\n", cap_copp);
+	}
+	{
+		struct {
+			struct apr_hdr h;
+			uint16_t pool, nregions;
+			uint32_t property;
+			uint32_t lsw, msw, size;
+		} __attribute__((packed)) c;
+		bzero(&c, sizeof(c));
+		c.h.opcode = 0x00010D92;        /* ASM_CMD_SHARED_MEM_MAP_REGIONS */
+		c.pool = 3;
+		c.nregions = 1;
+		c.lsw = (uint32_t)mc.cpa;
+		c.msw = (uint32_t)(mc.cpa >> 32) | AUDIO_SID;
+		c.size = NBUF_CAP * BUFSZ;
+		if (q6_cmd("ASM capture buffer map", &c, sizeof(c), SVC_ASM, 0, 0, 0x00010D93)) {
+			return false;
+		}
+		mc.handle = q.pl[0];
+	}
+	{
+		struct {
+			struct apr_hdr h;
+			uint32_t mode_flags, src_endpoint, preproc, enc_fmt;
+			uint16_t bits, reserved;
+		} __attribute__((packed)) c;
+		bzero(&c, sizeof(c));
+		c.h.opcode = 0x00010DB4;        /* ASM_STREAM_CMD_OPEN_READ_V3 */
+		c.src_endpoint = 0;             /* device matrix */
+		c.preproc = 0x00010C68;         /* NONE */
+		c.enc_fmt = 0x00010DA5;         /* MULTI_CHANNEL_PCM_V2 */
+		c.bits = 16;
+		if (q6_cmd("ASM capture open", &c, sizeof(c), SVC_ASM, CASM_PORT, 0, 0)) {
+			return false;
+		}
+	}
+	{
+		struct {
+			struct apr_hdr h;
+			uint32_t matrix, nsessions;
+			uint16_t session, ncopps;
+			uint16_t copp, pad;
+		} __attribute__((packed)) c;
+		bzero(&c, sizeof(c));
+		c.h.opcode = 0x00010325;        /* ADM_CMD_MATRIX_MAP_ROUTINGS_V5 */
+		c.matrix = 1;                   /* audio TX */
+		c.nsessions = 1;
+		c.session = CSESSION;
+		c.ncopps = 1;
+		c.copp = cap_copp;
+		if (q6_cmd("ADM route capture session", &c, sizeof(c), SVC_ADM, 0, 0, 0)) {
+			return false;
+		}
+	}
+	/*
+	 * No MEDIA_FMT_UPDATE here: that is a playback (write) command. A read
+	 * session takes its PCM format from OPEN_READ (enc_cfg_id) and the COPP
+	 * (1 channel, 16-bit, 48 kHz).
+	 */
+	mc.ready = true;
+	printf("SWEET Q6: capture ready (waiting for /dev/sweet-mic)\n");
+	return true;
+}
+
+/* submit one empty buffer for the DSP to fill */
+static void
+capture_read_submit(uint32_t i, uint32_t seq)
+{
+	struct { struct apr_hdr h; uint32_t lsw, msw, handle, size, seq; } __attribute__((packed)) r;
+	bzero(&r, sizeof(r));
+	r.h.hdr_field = (2 << 8) | (5 << 4);
+	r.h.pkt_size = sizeof(r);
+	r.h.src_svc = r.h.dest_svc = SVC_ASM;
+	r.h.src_domain = 5;
+	r.h.dest_domain = 4;
+	r.h.src_port = r.h.dest_port = CASM_PORT;
+	r.h.token = i;
+	r.h.opcode = 0x00010DAC;                /* ASM_DATA_CMD_READ_V2 */
+	r.lsw = (uint32_t)(mc.cpa + i * BUFSZ);
+	r.msw = (uint32_t)((mc.cpa + i * BUFSZ) >> 32) | AUDIO_SID;
+	r.handle = mc.handle;
+	r.size = BUFSZ;
+	r.seq = seq;
+	(void)sweet_glink_apr_send(&r, sizeof(r));
+}
+
+/* RUN/PAUSE the capture with /dev/sweet-mic, and drain filled buffers */
+static void
+capture_pump(void)
+{
+	static bool crun;
+	static uint32_t cseq;
+	if (!mc.ready) {
+		return;
+	}
+	if (mc.capturing && !crun) {
+		struct { struct apr_hdr h; uint32_t flags, lsw, msw; } __attribute__((packed)) c;
+		bzero(&c, sizeof(c));
+		c.h.opcode = 0x00010DAA;        /* ASM_SESSION_CMD_RUN_V2 */
+		if (q6_cmd("mic: ASM run", &c, sizeof(c), SVC_ASM, CASM_PORT, 0, 0)) {
+			return;
+		}
+		crun = true;
+		mc.read_done = 0;
+		for (uint32_t i = 0; i < NBUF_CAP; i++) {
+			capture_read_submit(i, cseq++);
+		}
+		printf("SWEET Q6: mic capture running\n");
+		return;
+	}
+	if (!mc.capturing && crun) {
+		struct apr_hdr c;
+		bzero(&c, sizeof(c));
+		c.opcode = 0x00010BD3;          /* ASM_SESSION_CMD_PAUSE */
+		(void)q6_cmd("mic: ASM pause", &c, sizeof(c), SVC_ASM, CASM_PORT, 0, 0);
+		crun = false;
+		return;
+	}
+	if (!crun) {
+		return;
+	}
+	uint32_t done = __c11_atomic_exchange((_Atomic uint32_t *)&mc.read_done, 0, __ATOMIC_ACQUIRE);
+	for (uint32_t i = 0; i < NBUF_CAP; i++) {
+		if (!(done & (1u << i))) {
+			continue;
+		}
+		uint32_t got = MIN(mc.read_len[i], BUFSZ);
+		mic_ring_put(mc.cbuf + i * BUFSZ, got);
+		capture_read_submit(i, cseq++);
+	}
+}
+
+static void
+q6_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (int i = 0; !sweet_glink_up(); i++) {
+		if (i > 60000) {
+			return;
+		}
+		q_sleep_ms(1);
+	}
+	sweet_glink_apr_client = q6_rx;
+	if (!smmu_setup()) {
+		printf("SWEET Q6: the DSP could not read our buffers: playback not started\n");
+		return;
+	}
+
+	vm_offset_t va = 0;
+	if (kmem_alloc_contig(kernel_map, &va, NBUF * BUFSZ, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET Q6: no %u KB for the buffers\n", NBUF * BUFSZ / 1024);
+		return;
+	}
+	uint64_t pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)va));
+	uint8_t *buf = (uint8_t *)va;
+
+	if (afe_clock("codec core clock (INT_MCLK_0 9.6 MHz)", 0x305, 9600000, 1, 0) ||
+	    afe_clock("INT0_MI2S bit clock (1.536 MHz)", 0x10F, 1536000, 1, 0)) {
+		return;
+	}
+	cdc_probe();
+	{
+		struct {
+			struct apr_hdr h;
+			uint16_t port, payload_size;
+			uint32_t mem[3];
+			uint32_t module, param;
+			uint16_t psize, reserved;
+			uint32_t ver;
+			uint16_t bit_width, channel_mode, mono_stereo, ws_src;
+			uint32_t rate;
+			uint16_t data_format, reserved2;
+		} __attribute__((packed)) c;
+		bzero(&c, sizeof(c));
+		c.h.opcode = 0x000100EF;        /* AFE_PORT_CMD_SET_PARAM_V2 */
+		c.port = PORT_INT0_RX;
+		c.payload_size = 12 + 20;
+		c.module = 0x0001020C;          /* AFE_MODULE_AUDIO_DEV_INTERFACE */
+		c.param = 0x0001020D;           /* AFE_PARAM_ID_I2S_CONFIG */
+		c.psize = 20;
+		c.ver = 1;
+		c.bit_width = 16;
+		c.channel_mode = 1;             /* SD0 */
+		c.mono_stereo = 1;              /* stereo */
+		c.ws_src = 1;                   /* internal: we are the master */
+		c.rate = 48000;
+		if (q6_cmd("INT0_MI2S_RX I2S config", &c, sizeof(c), SVC_AFE, 0, 0, 0)) {
+			return;
+		}
+	}
+	{
+		struct { struct apr_hdr h; uint16_t port, reserved; } __attribute__((packed)) c;
+		bzero(&c, sizeof(c));
+		c.h.opcode = 0x000100E5;        /* AFE_PORT_CMD_DEVICE_START */
+		c.port = PORT_INT0_RX;
+		if (q6_cmd("INT0_MI2S_RX start", &c, sizeof(c), SVC_AFE, 0, 0, 0)) {
+			return;
+		}
+	}
+	cdc_earpiece_on();
+	sdw_probe();
+	uint16_t copp;
+	{
+		struct {
+			struct apr_hdr h;
+			uint16_t flags, mode, ep1, ep2;
+			uint32_t topology;
+			uint16_t channels, bit_width;
+			uint32_t rate;
+			uint8_t map[8];
+		} __attribute__((packed)) c;
+		bzero(&c, sizeof(c));
+		c.h.opcode = 0x00010326;        /* ADM_CMD_DEVICE_OPEN_V5 */
+		c.mode = 1;                     /* RX path COPP */
+		c.ep1 = PORT_INT0_RX;
+		c.ep2 = 0xffff;
+		c.topology = 0x00010312;        /* NULL_COPP_TOPOLOGY */
+		c.channels = 2;
+		c.bit_width = 16;
+		c.rate = 48000;
+		c.map[0] = 1;                   /* FL */
+		c.map[1] = 2;                   /* FR */
+		if (q6_cmd("ADM COPP open", &c, sizeof(c), SVC_ADM, PORT_INT0_RX, 0, 0x00010329)) {
+			return;
+		}
+		if (q.pl[0] != 0) {
+			printf("SWEET Q6: ADM COPP open: ADSP error %#x\n", q.pl[0]);
+			return;
+		}
+		copp = (uint16_t)q.pl[1];
+		printf("SWEET Q6: COPP %u on INT0_MI2S_RX\n", copp);
+	}
+	uint32_t handle;
+	{
+		struct {
+			struct apr_hdr h;
+			uint16_t pool, nregions;
+			uint32_t property;
+			uint32_t lsw, msw, size;
+		} __attribute__((packed)) c;
+		bzero(&c, sizeof(c));
+		c.h.opcode = 0x00010D92;        /* ASM_CMD_SHARED_MEM_MAP_REGIONS */
+		c.pool = 3;                     /* SHMEM8_4K */
+		c.nregions = 1;
+		c.lsw = (uint32_t)pa;
+		c.msw = (uint32_t)(pa >> 32) | AUDIO_SID;
+		c.size = NBUF * BUFSZ;
+		if (q6_cmd("ASM buffer map", &c, sizeof(c), SVC_ASM, 0, 0, 0x00010D93)) {
+			return;
+		}
+		handle = q.pl[0];
+	}
+	{
+		struct {
+			struct apr_hdr h;
+			uint32_t mode_flags;
+			uint16_t sink, bits;
+			uint32_t postproc, dec_fmt;
+		} __attribute__((packed)) c;
+		bzero(&c, sizeof(c));
+		c.h.opcode = 0x00010DB3;        /* ASM_STREAM_CMD_OPEN_WRITE_V3 */
+		c.sink = 0;                     /* the matrix */
+		c.bits = 16;
+		c.postproc = 0x00010C68;        /* NULL_POPP_TOPOLOGY */
+		c.dec_fmt = 0x00010DA5;         /* MULTI_CHANNEL_PCM_V2 */
+		if (q6_cmd("ASM stream open", &c, sizeof(c), SVC_ASM, ASM_PORT, 0, 0)) {
+			return;
+		}
+	}
+	{
+		struct {
+			struct apr_hdr h;
+			uint32_t matrix, nsessions;
+			uint16_t session, ncopps;
+			uint16_t copp, pad;
+		} __attribute__((packed)) c;
+		bzero(&c, sizeof(c));
+		c.h.opcode = 0x00010325;        /* ADM_CMD_MATRIX_MAP_ROUTINGS_V5 */
+		c.matrix = 0;                   /* audio RX */
+		c.nsessions = 1;
+		c.session = SESSION;
+		c.ncopps = 1;
+		c.copp = copp;
+		if (q6_cmd("ADM route session 1", &c, sizeof(c), SVC_ADM, 0, 0, 0)) {
+			return;
+		}
+	}
+	{
+		struct {
+			struct apr_hdr h;
+			uint32_t fmt_blk_size;
+			uint16_t channels, bits;
+			uint32_t rate;
+			uint16_t is_signed, reserved;
+			uint8_t map[8];
+		} __attribute__((packed)) c;
+		bzero(&c, sizeof(c));
+		c.h.opcode = 0x00010D98;        /* ASM_DATA_CMD_MEDIA_FMT_UPDATE_V2 */
+		c.fmt_blk_size = 20;
+		c.channels = 2;
+		c.bits = 16;
+		c.rate = 48000;
+		c.is_signed = 1;
+		c.map[0] = 1;
+		c.map[1] = 2;
+		if (q6_cmd("ASM media format", &c, sizeof(c), SVC_ASM, ASM_PORT, 0, 0)) {
+			return;
+		}
+	}
+	/*
+	 * Ready, not running: the DSP reads our buffers only while iOS plays. The first frames
+	 * start the session (RUN), 0.5 s without any pause it (PAUSE); RUN again resumes.
+	 */
+	q.playing = true;
+	q.done_mask = 0;
+	printf("SWEET Q6: ready, waiting for iOS to play\n");
+	(void)capture_setup();          /* the microphone; a failure leaves playback working */
+	uint32_t inflight = 0, next = 0, seq = 0;
+	uint64_t writes = 0, dones = 0, run_writes = 0, run_dones = 0, run_start = 0;
+	bool running = false, diagnosed = false;
+	for (;;) {
+		uint32_t done = __c11_atomic_exchange((_Atomic uint32_t *)&q.done_mask, 0, __ATOMIC_ACQUIRE);
+		uint32_t back = (uint32_t)__builtin_popcount(done);
+		dones += back;
+		inflight -= MIN(inflight, back);
+
+		uint64_t now = mach_absolute_time(), idle_ns = ~0ull;
+		if (q.last_write) {
+			absolutetime_to_nanoseconds(now - q.last_write, &idle_ns);
+		}
+		bool active = idle_ns < 500000000ull;
+		if (active && !running) {
+			struct { struct apr_hdr h; uint32_t flags, lsw, msw; } __attribute__((packed)) c;
+			bzero(&c, sizeof(c));
+			c.h.opcode = 0x00010DAA;        /* ASM_SESSION_CMD_RUN_V2 */
+			if (q6_cmd("iOS plays: ASM run", &c, sizeof(c), SVC_ASM, ASM_PORT, 0, 0)) {
+				if (!diagnosed) {
+					diagnosed = true;
+					q6_diagnose("ASM run unanswered");
+				}
+				q.last_write = 0;
+				q_sleep_ms(1000);
+				continue;
+			}
+			running = true;
+			run_start = now;
+			run_writes = writes;
+			run_dones = dones;
+		} else if (!active && running) {
+			struct apr_hdr c;
+			bzero(&c, sizeof(c));
+			c.opcode = 0x00010BD3;          /* ASM_SESSION_CMD_PAUSE */
+			(void)q6_cmd("iOS stopped: ASM pause", &c, sizeof(c), SVC_ASM, ASM_PORT, 0, 0);
+			running = false;
+			uint64_t ns;
+			absolutetime_to_nanoseconds(now - run_start, &ns);
+			/* 1024 frames (21.3 ms) per buffer */
+			printf("SWEET Q6: %llu ms played: %llu buffers sent, %llu given back by the DSP (%u with an error)%s\n",
+			    ns / 1000000ull, writes - run_writes, dones - run_dones, q.write_errs,
+			    dones - run_dones >= (ns / 1000000ull) / 30 && dones > run_dones ? ": THE DSP PLAYS" : "");
+		}
+		if (running && !diagnosed && writes > run_writes && dones == run_dones) {
+			uint64_t ns;
+			absolutetime_to_nanoseconds(now - run_start, &ns);
+			if (ns > 300000000ull) {
+				diagnosed = true;
+				q6_diagnose("no buffer back after 300 ms");
+				q6_diagnose("and again");     /* the log may drop a line */
+			}
+		}
+		while (running && inflight < INFLIGHT) {
+			uint32_t i = next;
+			next = (next + 1) % NBUF;
+			ring_take(buf + i * BUFSZ, BUFSZ);
+			flush_dcache64((addr64_t)(pa + i * BUFSZ), BUFSZ, TRUE);
+			struct {
+				struct apr_hdr h;
+				uint32_t lsw, msw, handle, size, seq, ts_lsw, ts_msw, flags;
+			} __attribute__((packed)) w;
+			bzero(&w, sizeof(w));
+			w.h.hdr_field = (2 << 8) | (5 << 4);
+			w.h.pkt_size = sizeof(w);
+			w.h.src_svc = w.h.dest_svc = SVC_ASM;
+			w.h.src_domain = 5;
+			w.h.dest_domain = 4;
+			w.h.src_port = w.h.dest_port = ASM_PORT;
+			w.h.token = i;
+			w.h.opcode = 0x00010DAB;        /* ASM_DATA_CMD_WRITE_V2 */
+			w.lsw = (uint32_t)(pa + i * BUFSZ);
+			w.msw = (uint32_t)((pa + i * BUFSZ) >> 32) | AUDIO_SID;
+			w.handle = handle;
+			w.size = BUFSZ;
+			w.seq = seq++;
+			if (writes < 2) {
+				printf("SWEET Q6: write %llu (buffer %u at %#llx)\n", writes, i, pa + i * BUFSZ);
+			}
+			int err = sweet_glink_apr_send(&w, sizeof(w));
+			if (writes < 2) {
+				printf("SWEET Q6: write %llu sent (%d)\n", writes, err);
+			}
+			if (err != 0) {
+				break;
+			}
+			inflight++;
+			writes++;
+		}
+		capture_pump();
+		q_sleep_ms(running || mc.capturing ? 2 : 20);
+	}
+}
+
+void
+sweet_q6audio_init(void)
+{
+	thread_t t;
+	if (kernel_thread_start(q6_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
+#endif /* SWEET_KIRIN */
diff --git a/bsd/dev/sweet_rpm_kirin.c b/bsd/dev/sweet_rpm_kirin.c
new file mode 100644
index 0000000..95e1dd4
--- /dev/null
+++ b/bsd/dev/sweet_rpm_kirin.c
@@ -0,0 +1,382 @@
+/*
+ * kirin (SDM630): RPM requests over GLINK, polled. The modem's PBL needs
+ * vdd_cx and vdd_mx at the NOM corner (level 384) before the Q6 leaves reset
+ * (pil_mss_power_up); iOS never brings the RPM link up, so the modem bring-up
+ * (sweet_modem.c) asks for those corners through here first.
+ *
+ * This is the same intentless GLINK-RPM edge as the Pixel 1 code in
+ * sweet_rpm.c (mainline qcom_glink_rpm / rpm-smd), only the addresses differ:
+ *   transport  RPM message RAM 0x778000 (28 KiB), TOC "grt0" in its last 256
+ *              bytes naming the ap2r (tx) and r2ap (rx) FIFOs: tail, head,
+ *              data. Doorbell: APCS IPC 0x17911000 + 8 = 1 (mbox index 0).
+ *   protocol   VERSION -> VERSION_ACK, OPEN "rpm_requests" both ways + OPEN_ACK,
+ *              TX_DATA {cmd, lcid, iid 0, chunk, left} + payload, 8-byte aligned.
+ *              Intentless: no INTENT/RX_DONE. 32-bit accesses to the msg RAM.
+ *   requests   "req" header {msg_id, set, resource_type, resource_id, len} +
+ *              KVPs {key, 4, value}; the answer carries "msg#" and, on
+ *              failure, "err" + text. A level rail ("rwcx"/"rwmx") takes one
+ *              KVP {key "vlvl", 4, level}.
+ *
+ * Reusable: sweet_rpm_vote_level(resource, id, set, level) votes any RPM level
+ * resource, so the Wi-Fi rails go the same way.
+ */
+#if defined(SWEET_KIRIN)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <kern/locks.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int sweet_rpm_setup(void);
+int sweet_rpm_vote_level(uint32_t resource, uint32_t resource_id, uint32_t set, uint32_t level);
+int sweet_rpm_vote_cx_mx(uint32_t cx_level, uint32_t mx_level);
+
+static LCK_GRP_DECLARE(sweet_rpm_grp, "sweet_rpm_kirin");
+static LCK_MTX_DECLARE(sweet_rpm_lock, &sweet_rpm_grp);
+
+#define RPM_MSGRAM_PA   0x00778000u
+#define RPM_MSGRAM_SIZE 0x7000u
+#define RPM_IPC_PA      0x17911000u     /* APCS global, +8 IPC, bit 0 = RPM */
+#define RPM_IPC_OFF     0x8u
+#define RPM_TOC_MAGIC   0x67727430u     /* grt0 */
+#define RPM_FIFO_AP2R   0x61703272u
+#define RPM_FIFO_R2AP   0x72326170u
+#define RPM_LCID        1u
+
+#define CMD_VERSION       0u
+#define CMD_VERSION_ACK   1u
+#define CMD_OPEN          2u
+#define CMD_CLOSE         3u
+#define CMD_OPEN_ACK      4u
+#define CMD_TX_DATA       9u
+#define CMD_CLOSE_ACK     11u
+#define CMD_TX_DATA_CONT  12u
+#define CMD_READ_NOTIF    13u
+
+struct rpm_fifo {
+	volatile uint32_t *tail, *head, *data;
+	uint32_t len;
+};
+
+static struct {
+	struct rpm_fifo tx, rx;
+	vm_offset_t ipc;
+	bool mapped, up, remote_open, open_acked;
+	uint32_t rcid, msg_id;
+	uint32_t resp[64];              /* last complete TX_DATA payload */
+	uint32_t resp_len;
+	bool resp_ready;
+} rpm;
+
+static uint32_t
+fifo_avail_rx(void)
+{
+	uint32_t head = *rpm.rx.head, tail = *rpm.rx.tail;
+	return head >= tail ? head - tail : rpm.rx.len - tail + head;
+}
+
+static void
+fifo_peek(uint32_t off, uint32_t *buf, uint32_t n)
+{
+	uint32_t pos = (*rpm.rx.tail + off) % rpm.rx.len;
+	for (uint32_t i = 0; i < n / 4; i++) {
+		buf[i] = rpm.rx.data[pos / 4];
+		pos = (pos + 4) % rpm.rx.len;
+	}
+}
+
+static void
+fifo_advance(uint32_t n)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+	*rpm.rx.tail = (*rpm.rx.tail + n) % rpm.rx.len;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+rpm_kick(void)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(rpm.ipc + RPM_IPC_OFF) = 1u;
+}
+
+/* n is a multiple of 4; the message is padded to 8 bytes. */
+static bool
+rpm_send(const uint32_t *w, uint32_t n)
+{
+	uint32_t total = (n + 7u) & ~7u;
+	for (unsigned tries = 0;; tries++) {
+		uint32_t head = *rpm.tx.head, tail = *rpm.tx.tail;
+		uint32_t avail = tail <= head ? rpm.tx.len - head + tail : tail - head;
+		if (avail > total) {
+			break;
+		}
+		if (tries == 100) {
+			printf("SWEET RPM: tx fifo full (head %u tail %u)\n", head, tail);
+			return false;
+		}
+		delay(1000);
+	}
+	uint32_t pos = *rpm.tx.head;
+	for (uint32_t i = 0; i < total / 4; i++) {
+		rpm.tx.data[pos / 4] = i < n / 4 ? w[i] : 0u;
+		pos = (pos + 4) % rpm.tx.len;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	*rpm.tx.head = pos;
+	rpm_kick();
+	return true;
+}
+
+static bool
+rpm_send_cmd(uint32_t cmd, uint32_t param1, uint32_t param2)
+{
+	uint32_t w[2] = {cmd | (param1 << 16), param2};
+	return rpm_send(w, sizeof(w));
+}
+
+static bool
+rpm_send_open(void)
+{
+	static const char name[] = "rpm_requests";
+	uint32_t w[2 + 4] = {CMD_OPEN | (RPM_LCID << 16), sizeof(name)};
+	memcpy(&w[2], name, sizeof(name));
+	return rpm_send(w, 8u + ((sizeof(name) + 3u) & ~3u));
+}
+
+/* Handle one incoming message; false when nothing (complete) is there. */
+static bool
+rpm_rx_one(void)
+{
+	uint32_t avail = fifo_avail_rx(), h[4];
+	if (avail < 8) {
+		return false;
+	}
+	fifo_peek(0, h, 8);
+	uint32_t cmd = h[0] & 0xffffu, p1 = h[0] >> 16, p2 = h[1];
+	switch (cmd) {
+	case CMD_VERSION:
+		fifo_advance(8);
+		(void)rpm_send_cmd(CMD_VERSION_ACK, 1, 0);
+		break;
+	case CMD_VERSION_ACK:
+		fifo_advance(8);
+		if (p1 != 1) {
+			printf("SWEET RPM: version ack %u features %#x\n", p1, p2);
+		} else if (p2 != 0) {
+			(void)rpm_send_cmd(CMD_VERSION, 1, 0);
+		} else if (!rpm.up) {
+			rpm.up = true;
+			(void)rpm_send_open();
+		}
+		break;
+	case CMD_OPEN: {
+		uint32_t len = 8u + ((p2 + 7u) & ~7u), name[8] = {0};
+		if (avail < len) {
+			return false;
+		}
+		fifo_peek(8, name, MIN(p2 + 3u, 31u) & ~3u);
+		fifo_advance(len);
+		if (strncmp((const char *)name, "rpm_requests", 13) == 0) {
+			rpm.rcid = p1;
+			rpm.remote_open = true;
+			(void)rpm_send_cmd(CMD_OPEN_ACK, p1, 0);
+		} else {
+			printf("SWEET RPM: ignoring remote open of '%.24s'\n", (const char *)name);
+		}
+		break;
+	}
+	case CMD_OPEN_ACK:
+		fifo_advance(8);
+		if (p1 == RPM_LCID) {
+			rpm.open_acked = true;
+		}
+		break;
+	case CMD_CLOSE:
+		fifo_advance(8);
+		(void)rpm_send_cmd(CMD_CLOSE_ACK, p1, 0);
+		if (p1 == rpm.rcid) {
+			rpm.remote_open = false;
+		}
+		break;
+	case CMD_TX_DATA:
+	case CMD_TX_DATA_CONT: {
+		if (avail < 16) {
+			return false;
+		}
+		fifo_peek(0, h, 16);
+		uint32_t chunk = h[2], left = h[3];
+		if (avail < 16 + chunk) {
+			return false;
+		}
+		if (cmd == CMD_TX_DATA) {
+			rpm.resp_len = 0;
+		}
+		uint32_t take = MIN(chunk, (uint32_t)sizeof(rpm.resp) - rpm.resp_len) & ~3u;
+		fifo_peek(16, (uint32_t *)((uint8_t *)rpm.resp + rpm.resp_len), take);
+		rpm.resp_len += take;
+		fifo_advance((16u + chunk + 7u) & ~7u);
+		if (left == 0) {
+			rpm.resp_ready = true;
+		}
+		break;
+	}
+	case CMD_READ_NOTIF:
+		fifo_advance(8);
+		rpm_kick();
+		break;
+	default:
+		/* intent/rx-done/signals: not used on this intentless edge */
+		printf("SWEET RPM: rx cmd %u p1 %u p2 %#x dropped\n", cmd, p1, p2);
+		fifo_advance(8);
+		break;
+	}
+	return true;
+}
+
+/* Poll up to ms for cond. */
+#define RPM_POLL(ms, cond) ({                                   \
+	unsigned _i;                                            \
+	for (_i = 0; _i < (ms) && !(cond); _i++) {              \
+	        while (rpm_rx_one()) {                          \
+	        }                                               \
+	        if (!(cond)) {                                  \
+	                delay(1000);                            \
+	        }                                               \
+	}                                                       \
+	(cond);                                                 \
+})
+
+static bool
+rpm_open(void)
+{
+	if (rpm.up && rpm.remote_open && rpm.open_acked) {
+		return true;
+	}
+	if (!rpm.mapped) {
+		vm_offset_t ram = ml_io_map(RPM_MSGRAM_PA, RPM_MSGRAM_SIZE);
+		rpm.ipc = ml_io_map(RPM_IPC_PA, 0x1000);
+		if (!ram || !rpm.ipc) {
+			printf("SWEET RPM: MMIO mapping failed\n");
+			return false;
+		}
+		volatile uint32_t *toc = (volatile uint32_t *)(ram + RPM_MSGRAM_SIZE - 256);
+		uint32_t count = toc[1];
+		if (toc[0] != RPM_TOC_MAGIC || count > 20) {
+			printf("SWEET RPM: bad TOC magic %#x count %u\n", toc[0], count);
+			return false;
+		}
+		for (uint32_t i = 0; i < count; i++) {
+			uint32_t id = toc[2 + 3 * i], off = toc[3 + 3 * i], size = toc[4 + 3 * i];
+			struct rpm_fifo *f = id == RPM_FIFO_AP2R ? &rpm.tx : id == RPM_FIFO_R2AP ? &rpm.rx : NULL;
+			if (f == NULL || off + size > RPM_MSGRAM_SIZE || (size & 3u)) {
+				continue;
+			}
+			f->tail = (volatile uint32_t *)(ram + off);
+			f->head = f->tail + 1;
+			f->data = f->tail + 2;
+			f->len = size;
+		}
+		if (!rpm.tx.data || !rpm.rx.data) {
+			printf("SWEET RPM: TOC has no ap2r/r2ap fifo\n");
+			return false;
+		}
+		printf("SWEET RPM: tx len %u head %u tail %u, rx len %u head %u tail %u\n",
+		    rpm.tx.len, *rpm.tx.head, *rpm.tx.tail, rpm.rx.len, *rpm.rx.head, *rpm.rx.tail);
+		rpm.mapped = true;
+	}
+	/* As Linux: our write index and read index start over, then negotiate. */
+	rpm.up = rpm.remote_open = rpm.open_acked = false;
+	*rpm.tx.head = 0;
+	*rpm.rx.tail = 0;
+	(void)rpm_send_cmd(CMD_VERSION, 1, 0);
+	bool ok = RPM_POLL(1000u, rpm.up && rpm.remote_open && rpm.open_acked);
+	printf("SWEET RPM: link %s (version %d, remote open %d rcid %u, open ack %d)\n",
+	    ok ? "up" : "FAILED", rpm.up, rpm.remote_open, rpm.rcid, rpm.open_acked);
+	return ok;
+}
+
+/*
+ * One request in set `set` (0 active, 1 sleep): type, id and nkvp {key, 4,
+ * value} records. Lock held. True if the RPM acked it ("msg#" = our id)
+ * without "err".
+ */
+static bool
+rpm_request(const char *what, uint32_t set, uint32_t type, uint32_t id, const uint32_t *kv, unsigned nkvp)
+{
+	if (!rpm_open()) {
+		return false;
+	}
+	if (nkvp > 4) {
+		return false;
+	}
+	uint32_t msg = ++rpm.msg_id;
+	uint32_t w[11 + 3 * 4] = {
+		CMD_TX_DATA | (RPM_LCID << 16), 0, 0, 0,        /* chunk set below */
+		0x00716572u, 20u + 12u * nkvp,                  /* "req", length */
+		msg, set, type, id, 12u * nkvp,
+	};
+	for (unsigned k = 0; k < nkvp; k++) {
+		w[11 + 3 * k] = kv[2 * k];
+		w[12 + 3 * k] = 4u;
+		w[13 + 3 * k] = kv[2 * k + 1];
+	}
+	uint32_t bytes = (11u + 3u * nkvp) * 4u;
+	w[2] = bytes - 16u;
+	rpm.resp_ready = false;
+	if (!rpm_send(w, bytes)) {
+		return false;
+	}
+	if (!RPM_POLL(1000u, rpm.resp_ready)) {
+		printf("SWEET RPM: %s: no answer\n", what);
+		return false;
+	}
+	/* "req", length, then {type, length, data} records */
+	bool acked = false, err = false;
+	uint32_t words = MIN(rpm.resp_len / 4, 2u + rpm.resp[1] / 4), i = 2;
+	while (i + 2 <= words) {
+		uint32_t rtype = rpm.resp[i], len = rpm.resp[i + 1];
+		if (rtype == 0x2367736du && rpm.resp[i + 2] == msg) {           /* "msg#" */
+			acked = true;
+		} else if (rtype == 0x00727265u) {                             /* "err" */
+			char text[32] = {0};
+			memcpy(text, &rpm.resp[i + 2], MIN(len, (uint32_t)sizeof(text) - 1));
+			printf("SWEET RPM: %s: error '%s'\n", what, text);
+			err = true;
+		}
+		i += 2 + (len + 3) / 4;
+	}
+	return acked && !err;
+}
+
+int
+sweet_rpm_setup(void)
+{
+	lck_mtx_lock(&sweet_rpm_lock);
+	bool ok = rpm_open();
+	lck_mtx_unlock(&sweet_rpm_lock);
+	return ok ? 0 : -1;
+}
+
+/* Vote a level/corner rail (key "vlvl") at `level` in set `set` (0 active). */
+int
+sweet_rpm_vote_level(uint32_t resource, uint32_t resource_id, uint32_t set, uint32_t level)
+{
+	uint32_t kv[2] = {0x6c766c76u, level};          /* "vlvl", level */
+	lck_mtx_lock(&sweet_rpm_lock);
+	bool ok = rpm_request("level", set, resource, resource_id, kv, 1);
+	lck_mtx_unlock(&sweet_rpm_lock);
+	printf("SWEET RPM: resource %08x id %u set %u level %u: %s\n", resource, resource_id, set, level,
+	    ok ? "ok" : "FAILED");
+	return ok ? 0 : -1;
+}
+
+int
+sweet_rpm_vote_cx_mx(uint32_t cx_level, uint32_t mx_level)
+{
+	int a = sweet_rpm_vote_level(0x78637772u /* "rwcx" */, 0, 0, cx_level);
+	int b = sweet_rpm_vote_level(0x786d7772u /* "rwmx" */, 0, 0, mx_level);
+	return a ? a : b;
+}
