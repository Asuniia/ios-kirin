+#if defined(SWEET_KIRIN)
+/* Register reg of the current Novatek page, n bytes, in FIFO-sized reads. */
+static int
+nvt_read(uint8_t reg, uint8_t *buf, unsigned n)
+{
+	for (unsigned done = 0; done < n;) {
+		unsigned chunk = MIN(n - done, st.rx_max);
+		uint8_t r = (uint8_t)(reg + done);
+		int err = qup_msg(false, &r, 1);
+		if (!err) {
+			err = qup_msg(true, buf + done, chunk);
+		}
+		if (err) {
+			return err;
+		}
+		done += chunk;
+	}
+	return 0;
+}
+
+static int
+nvt_poll(void)
+{
+	uint8_t p[NVT_POINT_LEN];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	int err = nvt_read(0, p, sizeof(p));
+	if (err) {
+		return err;
+	}
+	uint32_t mask = 0;
+	for (unsigned i = 0; i < TOUCH_MAX; i++) {
+		const uint8_t *e = p + 6 * i;
+		unsigned id = e[0] >> 3, status = e[0] & 7u;
+		if (id == 0 || id > TOUCH_MAX || (status != 1 && status != 2)) {
+			continue;
+		}
+		mask |= 1u << (id - 1);
+		x[id - 1] = e[1] << 4 | e[3] >> 4;
+		y[id - 1] = e[2] << 4 | (e[3] & 0xf);
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
+
+static void
+touch_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	st.vote = ml_io_map(TOUCH_GCC_VOTE_PA, 0x1000);
+	st.gccqup = ml_io_map(TOUCH_GCC_QUP_PA, 0x1000);
+	st.qup = ml_io_map(TOUCH_QUP_PA, 0x1000);
+	st.gpio[0] = ml_io_map(TOUCH_TLMM_PA + 0x1000u * TOUCH_SDA, 0x1000);
+	st.gpio[1] = ml_io_map(TOUCH_TLMM_PA + 0x1000u * TOUCH_SCL, 0x1000);
+	if (!st.vote || !st.gccqup || !st.qup || !st.gpio[0] || !st.gpio[1]) {
+		printf("SWEET TOUCH: MMIO mapping failed\n");
+		goto out;
+	}
+	if (!touch_clocks()) {
+		goto out;
+	}
+	touch_gpio(0, 3, 0, 2, false, false);   /* blsp_i2c1, no pull, 2 mA (DT i2c_1_active) */
+	touch_gpio(1, 3, 0, 2, false, false);
+	if (!qup_init()) {
+		goto out;
+	}
+	uint8_t page[3] = {0xff, (NVT_EVENT_BUF >> 16) & 0xff, (NVT_EVENT_BUF >> 8) & 0xff};
+	int err = qup_msg(false, page, sizeof(page));
+	if (err) {
+		printf("SWEET TOUCH: Novatek page select failed err=%d status=%#x\n", err, st.last_status);
+		goto out;
+	}
+	printf("SWEET TOUCH: Novatek NT36672A running, polled every 10 ms\n");
+	unsigned errors = 0;
+	for (;;) {
+		err = nvt_poll();
+		if (err) {
+			if ((errors++ % 100u) == 0) {
+				printf("SWEET TOUCH: read err=%d status=%#x flags=%#x\n",
+				    err, st.last_status, st.last_err);
+			}
+			if (errors == 10) {
+				touch_report(0, st.x, st.y);   /* release after persistent bad reads */
+			}
+			if (!qup_init() || qup_msg(false, page, sizeof(page))) {
+				touch_wait(100);
+			}
+		} else {
+			errors = 0;
+		}
+		touch_wait(10);
+	}
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+#else /* !SWEET_KIRIN */
 static void
 touch_thread(void *arg, wait_result_t result)
 {
@@ -531,6 +655,7 @@ out:
 	(void)thread_terminate(current_thread());
 	thread_block(THREAD_CONTINUE_NULL);
 }
+#endif /* SWEET_KIRIN */
 
