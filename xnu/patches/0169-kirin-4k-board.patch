+/* wait for RMB_MBA_STATUS to reach want (or go negative = error) */
+static int
+rmb_wait(uint32_t want, const char *what)
+{
+	for (int i = 0; i < 5000; i++) {
+		int32_t st = (int32_t)rmb[RMB_MBA_STATUS / 4];
+		if (st < 0) {
+			printf("SWEET MODEM: %s: MBA error %d\n", what, st);
+			return -1;
+		}
+		if ((uint32_t)st == want) {
+			return 0;
+		}
+		delay(1000);
+	}
+	printf("SWEET MODEM: %s: timeout (MBA_STATUS %#x)\n", what, rmb[RMB_MBA_STATUS / 4]);
+	return -1;
