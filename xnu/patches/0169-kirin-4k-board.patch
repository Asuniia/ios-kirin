+      memcpy(fLogs, args->asyncReference, sizeof(io_user_reference_t) *
+             (args->asyncReferenceCount < kOSAsyncRef64Count ? args->asyncReferenceCount : kOSAsyncRef64Count));
+      fLogsPending = true;
+      return kIOReturnSuccess;
+    default:
+      return kIOReturnUnsupported;
+    }
+  }
