+static void
+sweet_rtc_init(void)
+{
+	uint8_t ctl = 0, b[4] = {0}, c[4] = {0};
+	bool ok = sweet_pmic_read(0x060, 0x46, &ctl);
+	for (int tries = 0; ok && tries < 3; tries++) {
+		for (int i = 0; ok && i < 4; i++) {
+			ok = sweet_pmic_read(0x060, (uint8_t)(0x48 + i), &b[i]);
+		}
+		for (int i = 0; ok && i < 4; i++) {
+			ok = sweet_pmic_read(0x060, (uint8_t)(0x48 + i), &c[i]);
+		}
+		if (ok && memcmp(b, c, 4) == 0) {
+			break;
+		}
+	}
+	uint32_t secs = (uint32_t)c[0] | (uint32_t)c[1] << 8 | (uint32_t)c[2] << 16 | (uint32_t)c[3] << 24;
