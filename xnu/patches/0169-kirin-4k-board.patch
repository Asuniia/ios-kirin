+#define NLOCAL  24
+#define NREMOTE 32
+struct mchan {
+	const char *name;
+	uint16_t lcid, rcid;
+	bool open_sent, open_acked, remote_open, intents_sent;
+	struct { uint32_t id, size; uint8_t *buf; uint32_t off; } local[NLOCAL];
+	uint32_t nlocal;
+	struct { uint32_t id, size; bool used; } remote[NREMOTE];
+	void (*handler)(const uint8_t *, uint32_t);
+	uint32_t isize[NLOCAL];
+};
+
+static struct {
+	volatile uint8_t *smem, *mutex, *apcs;
+	volatile uint8_t *part;
+	uint32_t part_size, part_cacheline;
+	volatile uint32_t *desc;
+	volatile uint8_t *txf, *rxf;
+	uint32_t txlen, rxlen;
+	volatile struct smp2p_item *s2out;
+	bool version_done, prepared, started;
+	uint32_t next_liid;
+	struct mchan ch[1];
+	int sleep_chan;
+} mg;
+
+static LCK_GRP_DECLARE(mg_grp, "sweet_mglink");
+static LCK_MTX_DECLARE(mg_tx_lock, &mg_grp);
+
+static void
+mg_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&mg.sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* ---- SMEM (the APPS/MODEM partition, and global items for SMP2P) ---- */
+
+static bool
+mg_hwlock(void)
+{
+	for (int i = 0; i < 1000; i++) {
+		*(volatile uint32_t *)mg.mutex = 1;     /* QCOM_MUTEX_APPS_PROC_ID */
+		__builtin_arm_dsb(0xf);
+		if (*(volatile uint32_t *)mg.mutex == 1) {
+			return true;
+		}
+		delay(10);
+	}
+	return false;
+}
+
+static void
+mg_hwunlock(void)
+{
+	__builtin_arm_dsb(0xf);
+	*(volatile uint32_t *)mg.mutex = 0;
+	__builtin_arm_dsb(0xf);
+}
+
+static bool
+mg_find_partition(void)
+{
+	volatile uint8_t *pt = mg.smem + SMEM_SZ - 4096;
+	if (memcmp((const void *)pt, "$TOC", 4) != 0) {
+		printf("SWEET MGLINK: no SMEM partition table\n");
+		return false;
+	}
+	uint32_t n = *(volatile uint32_t *)(pt + 8);
+	for (uint32_t i = 0; i < n && i < 32; i++) {
+		volatile struct ptable_entry *e = (volatile struct ptable_entry *)(pt + 32 + i * sizeof(struct ptable_entry));
+		if (((e->host0 == 0 && e->host1 == MODEM_PID) || (e->host0 == MODEM_PID && e->host1 == 0)) &&
+		    e->offset && e->size && e->offset + (uint64_t)e->size <= SMEM_SZ) {
+			mg.part = mg.smem + e->offset;
+			mg.part_size = e->size;
+			mg.part_cacheline = (e->cacheline && !(e->cacheline & (e->cacheline - 1))) ? e->cacheline : 32;
+			if (memcmp((const void *)mg.part, "$PRT", 4) != 0) {
+				printf("SWEET MGLINK: APPS/MODEM partition without its magic\n");
+				return false;
+			}
+			printf("SWEET MGLINK: SMEM partition APPS/MODEM at +%#x, %u KB, cacheline %u\n",
+			    e->offset, e->size >> 10, mg.part_cacheline);
+			return true;
+		}
+	}
+	printf("SWEET MGLINK: no APPS/MODEM partition among %u\n", n);
+	return false;
+}
+
+static volatile uint8_t *
+mg_get(uint16_t item, uint32_t *size)
+{
+	volatile struct part_header *ph = (volatile struct part_header *)mg.part;
+	if (mg.part == NULL) {
+		return NULL;
+	}
+	uint32_t end = ph->offset_free_uncached;
+	uint32_t off = sizeof(struct part_header);
+	if (end > mg.part_size) {
+		return NULL;
+	}
+	while (off + sizeof(struct private_entry) <= end) {
+		volatile struct private_entry *e = (volatile struct private_entry *)(mg.part + off);
+		if (e->canary != 0xa5a5) {
+			printf("SWEET MGLINK: SMEM bad canary at +%#x\n", off);
+			return NULL;
+		}
+		uint32_t next = off + sizeof(struct private_entry) + e->padding_hdr + e->size;
+		if (e->item == item) {
+			if (size) {
+				*size = e->size - e->padding_data;
+			}
+			return mg.part + off + sizeof(struct private_entry) + e->padding_hdr;
+		}
+		if (next <= off) {
+			return NULL;
+		}
+		off = next;
+	}
+
+	/*
+	 * Not among the items allocated from the front. The modem allocates its own
+	 * (its GLINK fifo 480, its SMP2P item 428) from the far end of the partition:
+	 * Linux's "cached" list (qcom_smem_get_private), entry headers aligned to the
+	 * partition's cacheline, each header sitting right after its data, walked
+	 * downwards from the end to offset_free_cached. Seen 11/11: the modem had
+	 * consumed our GLINK commands and written 80 bytes we never found.
+	 */
+	uint32_t cl = mg.part_cacheline;
+	uint32_t ehdr = ((uint32_t)sizeof(struct private_entry) + cl - 1) & ~(cl - 1);
+	uint32_t low = ph->offset_free_cached;
+	if (low > mg.part_size || low < sizeof(struct part_header) || mg.part_size < ehdr) {
+		return NULL;
+	}
+	static unsigned cached_complaints;
+	uint32_t eoff = mg.part_size - ehdr;
+	while (eoff > low) {
+		volatile struct private_entry *e = (volatile struct private_entry *)(mg.part + eoff);
+		if (e->canary != 0xa5a5) {
+			if (cached_complaints++ < 3) {
+				printf("SWEET MGLINK: SMEM bad canary in the cached list at +%#x\n", eoff);
+			}
+			return NULL;
+		}
+		if (e->item == item) {
+			if (e->size > eoff) {
+				return NULL;
+			}
+			if (size) {
+				*size = e->size - e->padding_data;
+			}
+			return mg.part + eoff - e->size;
+		}
+		uint32_t step = e->size + ehdr;
+		if (step == 0 || step > eoff) {
+			return NULL;
+		}
+		eoff -= step;
+	}
+	return NULL;
+}
+
+/* one-shot inventory: the partition's two lists and the global table (items 400 to 520) */
+static void
+mg_dump_items(void)
+{
+	volatile struct part_header *ph = (volatile struct part_header *)mg.part;
+	char line[200];
+	unsigned o;
+	if (mg.part == NULL) {
+		return;
+	}
+	o = (unsigned)snprintf(line, sizeof(line), "SWEET MGLINK: partition items, front:");
+	uint32_t off = sizeof(struct part_header), end = ph->offset_free_uncached;
+	while (end <= mg.part_size && off + sizeof(struct private_entry) <= end) {
+		volatile struct private_entry *e = (volatile struct private_entry *)(mg.part + off);
+		if (e->canary != 0xa5a5) {
+			break;
+		}
+		o += (unsigned)snprintf(line + o, sizeof(line) - o, " %u(%u)", e->item, e->size);
+		if (o > 150) {
+			printf("%s\n", line);
+			o = (unsigned)snprintf(line, sizeof(line), "SWEET MGLINK:   ");
+		}
+		uint32_t next = off + (uint32_t)sizeof(struct private_entry) + e->padding_hdr + e->size;
+		if (next <= off) {
+			break;
+		}
+		off = next;
+	}
+	printf("%s\n", line);
+
+	o = (unsigned)snprintf(line, sizeof(line), "SWEET MGLINK: partition items, back (free_cached %#x):", ph->offset_free_cached);
+	uint32_t cl = mg.part_cacheline;
+	uint32_t ehdr = ((uint32_t)sizeof(struct private_entry) + cl - 1) & ~(cl - 1);
+	uint32_t low = ph->offset_free_cached;
+	if (low <= mg.part_size && mg.part_size >= ehdr) {
+		uint32_t eoff = mg.part_size - ehdr;
+		while (eoff > low) {
+			volatile struct private_entry *e = (volatile struct private_entry *)(mg.part + eoff);
+			if (e->canary != 0xa5a5) {
+				o += (unsigned)snprintf(line + o, sizeof(line) - o, " [bad canary at +%#x]", eoff);
+				break;
+			}
+			o += (unsigned)snprintf(line + o, sizeof(line) - o, " %u(%u)", e->item, e->size);
+			if (o > 150) {
+				printf("%s\n", line);
+				o = (unsigned)snprintf(line, sizeof(line), "SWEET MGLINK:   ");
+			}
+			uint32_t step = e->size + ehdr;
+			if (step == 0 || step > eoff) {
+				break;
+			}
+			eoff -= step;
+		}
+	}
+	printf("%s\n", line);
+
+	o = (unsigned)snprintf(line, sizeof(line), "SWEET MGLINK: global items 400-520:");
+	for (uint32_t item = 400; item <= 520; item++) {
+		volatile uint32_t *toc = (volatile uint32_t *)(mg.smem + 0xd0 + 16 * item);
+		if (toc[0] == 1 && toc[2]) {
+			o += (unsigned)snprintf(line + o, sizeof(line) - o, " %u(%u)", item, toc[2]);
+			if (o > 150) {
+				printf("%s\n", line);
+				o = (unsigned)snprintf(line, sizeof(line), "SWEET MGLINK:   ");
+			}
+		}
+	}
+	printf("%s\n", line);
+}
+
+static volatile uint8_t *
+mg_alloc(uint16_t item, uint32_t size, uint32_t *got)
+{
+	volatile uint8_t *p = mg_get(item, got);
+	if (p) {
+		return p;
+	}
+	if (!mg_hwlock()) {
+		printf("SWEET MGLINK: TCSR mutex 3 stays taken\n");
+		return NULL;
+	}
+	volatile struct part_header *ph = (volatile struct part_header *)mg.part;
+	uint32_t off = ph->offset_free_uncached;
+	uint32_t asz = (uint32_t)sizeof(struct private_entry) + ((size + 7) & ~7u);
+	if (off + asz > ph->offset_free_cached) {
+		mg_hwunlock();
+		printf("SWEET MGLINK: SMEM partition full for item %u\n", item);
+		return NULL;
+	}
+	volatile struct private_entry *e = (volatile struct private_entry *)(mg.part + off);
+	e->canary = 0xa5a5;
+	e->item = item;
+	e->size = (size + 7) & ~7u;
+	e->padding_data = (uint16_t)(e->size - size);
+	e->padding_hdr = 0;
+	e->reserved = 0;
+	__builtin_arm_dsb(0xf);
+	ph->offset_free_uncached = off + asz;
+	mg_hwunlock();
+	return mg_get(item, got);
+}
+
+/* ---- SMP2P ---- */
+
+static void
+smp2p_kick(void)
+{
+	__builtin_arm_dsb(0xf);
+	*(volatile uint32_t *)(mg.apcs + APCS_IPC_OFF) = SMP2P_IPC_BIT;
+}
+
+/*
+ * Our outbound item, with the one entry "master-kernel" (bit 0 is
+ * qcom,force-stop), written before the modem's PBL runs so its own smp2p
+ * finds it at init.
+ */
+void
+sweet_mglink_prepare(void)
+{
+	if (mg.prepared) {
+		return;
+	}
+	if (!mg.smem) {
+		mg.smem = (volatile uint8_t *)ml_io_map_wcomb(SMEM_PA, SMEM_SZ);
+		mg.mutex = (volatile uint8_t *)ml_io_map(TCSR_MUTEX_PA, 0x1000);
+		mg.apcs = (volatile uint8_t *)ml_io_map(APCS_IPC_PA, 0x1000);
+	}
+	if (!mg.smem || !mg.mutex || !mg.apcs || !mg_find_partition()) {
+		return;
+	}
+	uint32_t got = 0;
+	volatile struct smp2p_item *it = (volatile struct smp2p_item *)mg_alloc(ITEM_SMP2P_OUT, sizeof(struct smp2p_item), &got);
+	if (!it || got < sizeof(struct smp2p_item)) {
+		printf("SWEET MGLINK: SMP2P out item not allocated\n");
+		return;
+	}
+	bzero((void *)(uintptr_t)it, sizeof(*it));
+	it->version = 1;
+	it->local_pid = 0;
+	it->remote_pid = MODEM_PID;
+	it->total_entries = SMP2P_ENTRIES;
+	it->valid_entries = 0;
+	__builtin_arm_dsb(0xf);
+	it->magic = SMP2P_MAGIC;
+	__builtin_arm_dsb(0xf);
+	memcpy((void *)(uintptr_t)it->entries[0].name, "master-kernel", 14);
+	it->entries[0].value = 0;
+	__builtin_arm_dsb(0xf);
+	it->valid_entries = 1;
+	mg.s2out = it;
+	smp2p_kick();
+	mg.prepared = true;
+	printf("SWEET MGLINK: SMP2P out item %u ready (master-kernel)\n", ITEM_SMP2P_OUT);
+}
+
+/* the modem's "slave-kernel" bits; ~0 while its item is not there yet */
+static uint32_t
+smp2p_modem_state(void)
+{
+	uint32_t got = 0;
+	volatile struct smp2p_item *it = (volatile struct smp2p_item *)mg_get(ITEM_SMP2P_IN, &got);
+	if (!it || got < 16 || it->magic != SMP2P_MAGIC) {
+		return ~0u;
+	}
+	uint16_t n = it->valid_entries;
+	for (uint16_t i = 0; i < n && i < SMP2P_ENTRIES; i++) {
+		if (strncmp((const char *)(uintptr_t)it->entries[i].name, "slave-kernel", 16) == 0) {
+			return it->entries[i].value;
+		}
+	}
+	return ~0u;
+}
+
+/* ---- GLINK fifos (the modem edge) ---- */
+
+static uint32_t
+mg_rx_avail(void)
+{
+	if (!mg.rxf) {
+		uint32_t len = 0;
+		volatile uint8_t *f = mg_get(ITEM_RX_FIFO, &len);
+		if (!f) {
+			return 0;
+		}
+		mg.rxf = f;
+		mg.rxlen = len;
+		printf("SWEET MGLINK: the modem's fifo is there (%u bytes)\n", len);
+	}
+	uint32_t head = mg.desc[3], tail = mg.desc[2];
+	uint32_t n = head >= tail ? head - tail : mg.rxlen - tail + head;
+	return n > mg.rxlen ? 0 : n;
+}
+
+static void
+mg_rx_peek(void *out, uint32_t off, uint32_t n)
+{
+	uint32_t t = mg.desc[2] + off;
+	if (t >= mg.rxlen) {
+		t -= mg.rxlen;
+	}
+	uint32_t a = MIN(n, mg.rxlen - t);
+	for (uint32_t i = 0; i < a; i++) {
+		((uint8_t *)out)[i] = mg.rxf[t + i];
+	}
+	for (uint32_t i = 0; i < n - a; i++) {
+		((uint8_t *)out)[a + i] = mg.rxf[i];
+	}
+}
+
+static void
+mg_rx_advance(uint32_t n)
+{
+	uint32_t t = mg.desc[2] + ((n + 7) & ~7u);
+	if (t >= mg.rxlen) {
+		t %= mg.rxlen;
+	}
+	__builtin_arm_dmb(0xf);
+	mg.desc[2] = t;
+}
+
+static uint32_t
+mg_tx_avail(void)
+{
+	uint32_t head = mg.desc[1], tail = mg.desc[0];
+	uint32_t a = tail <= head ? mg.txlen - head + tail : tail - head;
+	return a < 16 ? 0 : a - 16;
+}
+
+static uint32_t
+mg_tx_write_one(uint32_t head, const void *d, uint32_t n)
+{
+	uint32_t a = MIN(n, mg.txlen - head);
+	for (uint32_t i = 0; i < a; i++) {
+		mg.txf[head + i] = ((const uint8_t *)d)[i];
+	}
+	for (uint32_t i = 0; i < n - a; i++) {
+		mg.txf[i] = ((const uint8_t *)d)[a + i];
+	}
+	head += n;
+	return head >= mg.txlen ? head - mg.txlen : head;
+}
+
+static void
+mg_kick(void)
+{
+	__builtin_arm_dsb(0xf);
+	*(volatile uint32_t *)(mg.apcs + APCS_IPC_OFF) = GLINK_IPC_BIT;
+}
+
+static int
+mg_tx(const void *hdr, uint32_t hlen, const void *data, uint32_t dlen)
+{
+	uint32_t tlen = (hlen + dlen + 7) & ~7u;
+	if (tlen >= mg.txlen) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&mg_tx_lock);
+	for (int i = 0; mg_tx_avail() < tlen; i++) {
+		if (i > 2000) {
+			lck_mtx_unlock(&mg_tx_lock);
+			printf("SWEET MGLINK: tx fifo stays full\n");
+			return EBUSY;
+		}
+		mg_kick();
+		mg_sleep_ms(1);
+	}
+	uint32_t head = mg.desc[1];
+	head = mg_tx_write_one(head, hdr, hlen);
+	if (dlen) {
+		head = mg_tx_write_one(head, data, dlen);
+	}
+	head = (head + 7) & ~7u;
+	if (head >= mg.txlen) {
+		head -= mg.txlen;
+	}
+	__builtin_arm_dsb(0xf);
+	mg.desc[1] = head;
+	mg_kick();
+	lck_mtx_unlock(&mg_tx_lock);
+	return 0;
+}
+
+static int
+mg_cmd(uint16_t cmd, uint16_t p1, uint32_t p2)
+{
+	struct { uint16_t cmd, p1; uint32_t p2; } m = { cmd, p1, p2 };
+	return mg_tx(&m, sizeof(m), NULL, 0);
+}
+
+/* ---- the IPCRTR channel ---- */
+
+static void
+mch_open(struct mchan *c)
+{
+	struct { uint16_t cmd, lcid; uint32_t namelen; char name[32]; } req;
+	bzero(&req, sizeof(req));
+	uint32_t nl = (uint32_t)strlen(c->name) + 1;
+	req.cmd = CMD_OPEN;
+	req.lcid = c->lcid;
+	req.namelen = nl;
+	strlcpy(req.name, c->name, sizeof(req.name));
+	c->open_sent = true;
+	(void)mg_tx(&req, (8 + nl + 7) & ~7u, NULL, 0);
+}
+
+static void
+mch_advertise(struct mchan *c, uint32_t i)
+{
+	struct { uint16_t cmd, lcid; uint32_t count, size, liid; } m;
+	c->local[i].id = ++mg.next_liid;
+	c->local[i].off = 0;
+	m.cmd = CMD_INTENT;
+	m.lcid = c->lcid;
+	m.count = 1;
+	m.size = c->local[i].size;
+	m.liid = c->local[i].id;
+	(void)mg_tx(&m, sizeof(m), NULL, 0);
+}
+
+static void
+mch_ready(struct mchan *c)
+{
+	if (!c->open_acked || !c->remote_open || c->intents_sent) {
+		return;
+	}
+	c->intents_sent = true;
+	for (uint32_t i = 0; i < c->nlocal; i++) {
+		c->local[i].size = c->isize[i];
+		if (!c->local[i].buf) {
+			c->local[i].buf = kalloc_data(c->local[i].size, Z_WAITOK | Z_ZERO);
+		}
+		mch_advertise(c, i);
+	}
+	printf("SWEET MGLINK: channel %s open (local %u, remote %u)\n", c->name, c->lcid, c->rcid);
+}
+
+static int
+mch_send(struct mchan *c, const void *d, uint32_t len)
+{
+	if (!c->intents_sent) {
+		return ENOTCONN;
+	}
+	for (int tries = 0; tries < 500; tries++) {
+		lck_mtx_lock(&mg_tx_lock);
+		int best = -1;
+		for (int i = 0; i < NREMOTE; i++) {
+			if (c->remote[i].size >= len && !c->remote[i].used &&
+			    (best < 0 || c->remote[i].size < c->remote[best].size)) {
+				best = i;
+			}
+		}
+		if (best >= 0) {
+			c->remote[best].used = true;
+		}
+		lck_mtx_unlock(&mg_tx_lock);
+		if (best >= 0) {
+			struct { uint16_t cmd, lcid; uint32_t iid, chunk, left; } h;
+			h.cmd = CMD_TX_DATA;
+			h.lcid = c->lcid;
+			h.iid = c->remote[best].id;
+			h.chunk = len;
+			h.left = 0;
+			return mg_tx(&h, sizeof(h), d, len);
+		}
+		if (tries == 0) {
+			(void)mg_cmd(CMD_RX_INTENT_REQ, c->lcid, len);
+		}
+		mg_sleep_ms(2);
+	}
+	printf("SWEET MGLINK: %s: no modem buffer for %u bytes\n", c->name, len);
+	return EBUSY;
+}
+
+static bool
+mg_rx_one(void)
+{
+	uint32_t avail = mg_rx_avail();
+	struct { uint16_t cmd, p1; uint32_t p2; } m;
+	if (avail < 8) {
+		return false;
+	}
+	mg_rx_peek(&m, 0, 8);
+	struct mchan *c = &mg.ch[0];
+	switch (m.cmd) {
+	case CMD_VERSION:
+		mg_rx_advance(8);
+		printf("SWEET MGLINK: the modem speaks GLINK version %u, features %#x\n", m.p1, m.p2);
+		/* qcom_glink_receive_version: ack with the features we both have (ours: INTENT_REUSE) */
+		(void)mg_cmd(CMD_VERSION_ACK, 1, m.p2 & 1u);
+		mg.version_done = true;
+		break;
+	case CMD_VERSION_ACK:
+		mg_rx_advance(8);
+		mg.version_done = true;
+		break;
+	case CMD_OPEN: {
+		uint32_t nl = m.p2 & 0xffff;
+		char name[33] = { 0 };
+		if (avail < 8 + nl) {
+			return false;
+		}
+		mg_rx_peek(name, 8, MIN(nl, 32u));
+		mg_rx_advance(8 + nl);
+		if (strcmp(c->name, name) == 0) {
+			c->rcid = m.p1;
+			c->remote_open = true;
+			(void)mg_cmd(CMD_OPEN_ACK, c->rcid, 0);
+			if (!c->open_sent) {
+				mch_open(c);
+			}
+			mch_ready(c);
+		} else {
+			printf("SWEET MGLINK: the modem opens %s (not handled)\n", name);
+			(void)mg_cmd(CMD_OPEN_ACK, m.p1, 0);
+		}
+		break;
+	}
+	case CMD_OPEN_ACK:
+		mg_rx_advance(8);
+		if (m.p1 == c->lcid) {
+			c->open_acked = true;
+			mch_ready(c);
+		}
+		break;
+	case CMD_CLOSE:
+		mg_rx_advance(8);
+		(void)mg_cmd(CMD_CLOSE_ACK, m.p1, 0);
+		if (c->remote_open && c->rcid == m.p1) {
+			printf("SWEET MGLINK: the modem closes %s\n", c->name);
+			c->remote_open = false;
+		}
+		break;
+	case CMD_CLOSE_ACK:
+		mg_rx_advance(8);
+		break;
+	case CMD_INTENT: {
+		uint32_t n = m.p2, len = 8 + 8 * n;
+		if (avail < len) {
+			return false;
+		}
+		static unsigned intent_logs;
+		if (intent_logs++ < 6) {
+			uint32_t first[2] = { 0, 0 };
+			if (n) {
+				mg_rx_peek(first, 8, 8);
+			}
+			printf("SWEET MGLINK: the modem offers %u buffer(s) on its channel %u (first %u bytes, id %u)%s\n",
+			    n, m.p1, first[0], first[1], (c->remote_open && c->rcid == m.p1) ? "" : ": not ours, ignored");
+		}
+		for (uint32_t k = 0; k < n; k++) {
+			uint32_t pair[2];
+			mg_rx_peek(pair, 8 + 8 * k, 8);
+			if (!c->remote_open || c->rcid != m.p1) {
+				continue;
+			}
+			lck_mtx_lock(&mg_tx_lock);
+			for (int i = 0; i < NREMOTE; i++) {
+				if (c->remote[i].size == 0) {
+					c->remote[i].size = pair[0];
+					c->remote[i].id = pair[1];
+					c->remote[i].used = false;
+					break;
+				}
+			}
+			lck_mtx_unlock(&mg_tx_lock);
+		}
+		mg_rx_advance(len);
+		break;
+	}
+	case CMD_RX_DONE:
+	case CMD_RX_DONE_W_REUSE:
+		mg_rx_advance(8);
+		{
+			static unsigned done_logs;
+			if (done_logs++ < 4) {
+				printf("SWEET MGLINK: the modem consumed our packet in its buffer %u (channel %u)\n", m.p2, m.p1);
+			}
+		}
+		if (c->remote_open && c->rcid == m.p1) {
+			lck_mtx_lock(&mg_tx_lock);
+			for (int i = 0; i < NREMOTE; i++) {
+				if (c->remote[i].size && c->remote[i].id == m.p2) {
+					if (m.cmd == CMD_RX_DONE) {
+						c->remote[i].size = 0;
+					}
+					c->remote[i].used = false;
+				}
+			}
+			lck_mtx_unlock(&mg_tx_lock);
+		}
+		break;
+	case CMD_RX_INTENT_REQ:
+		mg_rx_advance(8);
+		printf("SWEET MGLINK: the modem asks for a %u-byte buffer on channel %u\n", m.p2, m.p1);
+		if (c->remote_open && c->rcid == m.p1) {
+			if (c->nlocal >= NLOCAL) {
+				(void)mg_cmd(CMD_RX_INTENT_REQ_ACK, c->lcid, 0);
+				break;
+			}
+			uint32_t s = c->nlocal++;
+			c->local[s].size = MAX(m.p2, 512u);
+			c->local[s].buf = kalloc_data(c->local[s].size, Z_WAITOK | Z_ZERO);
+			(void)mg_cmd(CMD_RX_INTENT_REQ_ACK, c->lcid, 1);
+			mch_advertise(c, s);
+		}
+		break;
+	case CMD_TX_DATA:
+	case CMD_TX_DATA_CONT: {
+		struct { uint16_t cmd, p1; uint32_t liid, chunk, left; } h;
+		if (avail < 16) {
+			return false;
+		}
+		mg_rx_peek(&h, 0, 16);
+		if (avail < 16 + h.chunk) {
+			return false;
+		}
+		int li = -1;
+		if (c->remote_open && c->rcid == h.p1) {
+			for (uint32_t i = 0; i < c->nlocal; i++) {
+				if (c->local[i].id == h.liid) {
+					li = (int)i;
+				}
+			}
+		}
+		if (li < 0 || c->local[li].size - c->local[li].off < h.chunk) {
+			printf("SWEET MGLINK: data for unknown buffer %u on channel %u, dropped\n", h.liid, h.p1);
+			mg_rx_advance(16 + h.chunk);
+			break;
+		}
+		mg_rx_peek(c->local[li].buf + c->local[li].off, 16, h.chunk);
+		c->local[li].off += h.chunk;
+		mg_rx_advance(16 + h.chunk);
+		if (h.left == 0) {
+			if (c->handler) {
+				c->handler(c->local[li].buf, c->local[li].off);
+			}
+			(void)mg_cmd(CMD_RX_DONE, c->lcid, c->local[li].id);
+			mch_advertise(c, (uint32_t)li);
+		}
+		break;
+	}
+	case CMD_READ_NOTIF:
+		mg_rx_advance(8);
+		mg_kick();
+		break;
+	case CMD_RX_INTENT_REQ_ACK:
+	case CMD_SIGNALS:
+		mg_rx_advance(8);
+		break;
+	default:
+		printf("SWEET MGLINK: unknown command %u (%u, %#x), fifo reset\n", m.cmd, m.p1, m.p2);
+		mg.desc[2] = mg.desc[3];
+		break;
+	}
+	return true;
+}
+
+/* ---- QRTR ---- */
+
+struct qrtr_hdr_v1 {
+	uint32_t version, type, src_node, src_port, confirm_rx, size, dst_node, dst_port;
+};
+#define QRTR_TYPE_DATA          1
+#define QRTR_TYPE_HELLO         2
+#define QRTR_TYPE_NEW_SERVER    4
+#define QRTR_TYPE_DEL_SERVER    5
+#define QRTR_TYPE_DEL_CLIENT    6
+#define QRTR_TYPE_RESUME_TX     7
+#define QRTR_PORT_CTRL          0xfffffffeu
+#define QRTR_NODE_BCAST         0xffffffffu
+#define QRTR_LOCAL_NODE         1u
+
+#define RMTFS_SERVICE   14
+#define RMTFS_PORT      0x10u
+#define BB_PORT_BASE    0x4100u         /* CBQ_PORT_BASE in coachz_bb_qmux.h */
+
+static uint32_t qrtr_modem_node = ~0u;
+static bool bb_configured;
+
+static int
+qrtr_send_data(uint32_t src_port, uint32_t dst_node, uint32_t dst_port, const void *d, uint32_t len)
+{
+	if (len > 60000) {
+		return EMSGSIZE;
+	}
+	uint32_t total = (uint32_t)sizeof(struct qrtr_hdr_v1) + len;
+	uint8_t *pkt = kalloc_data(total, Z_WAITOK);
+	if (!pkt) {
+		return ENOMEM;
+	}
+	struct qrtr_hdr_v1 *h = (struct qrtr_hdr_v1 *)pkt;
+	bzero(h, sizeof(*h));
+	h->version = 1;
+	h->type = QRTR_TYPE_DATA;
+	h->src_node = QRTR_LOCAL_NODE;
+	h->src_port = src_port;
+	h->size = len;
+	h->dst_node = dst_node;
+	h->dst_port = dst_port;
+	memcpy(pkt + sizeof(*h), d, len);
+	int err = mch_send(&mg.ch[0], pkt, total);
+	kfree_data(pkt, total);
+	return err;
+}
+
+static int
+qrtr_ctrl(uint32_t type, uint32_t dst_node, uint32_t dst_port, const uint32_t *args, uint32_t nargs)
+{
+	struct { struct qrtr_hdr_v1 h; uint32_t cmd, a[4]; } p;
+	bzero(&p, sizeof(p));
+	p.h.version = 1;
+	p.h.type = type;
+	p.h.src_node = QRTR_LOCAL_NODE;
+	p.h.src_port = QRTR_PORT_CTRL;
+	/*
+	 * A control packet is always the full struct qrtr_ctrl_pkt (20 bytes: cmd and
+	 * four words, zero when unused), whatever the command; Linux's name service
+	 * and the modem's router drop shorter ones. The 4-byte hello of 11/11 got the
+	 * modem's hello back (sent unsolicited at channel open) but no service list.
+	 */
+	p.h.size = 20;
+	p.h.dst_node = dst_node;
+	p.h.dst_port = dst_port;
+	p.cmd = type;
+	for (uint32_t i = 0; i < nargs && i < 4; i++) {
+		p.a[i] = args[i];
+	}
+	return mch_send(&mg.ch[0], &p, sizeof(p.h) + p.h.size);
+}
+
+static void rmtfs_announce(void);
+static void rmtfs_handle(const struct qrtr_hdr_v1 *h, const uint8_t *d, uint32_t n);
+
+/* the bridge's QRTR side: runs on this file's thread via coachz_baseband_poll */
+static void
+mg_bb_send(uint32_t local_port, uint32_t node, uint32_t port, const void *data, uint32_t len)
+{
+	(void)qrtr_send_data(local_port, node, port, data, len);
+}
+
+static void
+mg_bb_del_client(uint32_t local_port)
+{
+	uint32_t a[2] = { QRTR_LOCAL_NODE, local_port };
+	if (qrtr_modem_node != ~0u) {
+		qrtr_ctrl(QRTR_TYPE_DEL_CLIENT, qrtr_modem_node, QRTR_PORT_CTRL, a, 2);
+	}
+}
+
+static void
+qrtr_rx(const uint8_t *pkt, uint32_t len)
+{
+	const struct qrtr_hdr_v1 *h = (const struct qrtr_hdr_v1 *)pkt;
+	if (len < sizeof(*h) || h->version != 1) {
+		printf("SWEET MQRTR: %u bytes, version %u: not a v1 packet\n", len, len >= 4 ? h->version : 0);
+		return;
+	}
+	const uint32_t *c = (const uint32_t *)(pkt + sizeof(*h));
+	static unsigned traced;
+	if (traced++ < 20) {
+		printf("SWEET MQRTR: rx type %u from %u:%#x to %u:%#x, %u bytes\n",
+		    h->type, h->src_node, h->src_port, h->dst_node, h->dst_port, h->size);
+	}
+	switch (h->type) {
+	case QRTR_TYPE_HELLO:
+		qrtr_modem_node = h->src_node;
+		printf("SWEET MQRTR: hello from the modem (node %u)\n", h->src_node);
+		qrtr_ctrl(QRTR_TYPE_HELLO, h->src_node, QRTR_PORT_CTRL, NULL, 0);
+		rmtfs_announce();
+		if (!bb_configured && coachz_baseband_enabled()) {
+			bb_configured = true;
+			coachz_baseband_configure(mg_bb_send, mg_bb_del_client);
+		}
+		break;
+	case QRTR_TYPE_NEW_SERVER:
+		if (h->size >= 20) {
+			printf("SWEET MQRTR: modem service %u (%#x) version %u instance %u at %u:%u\n",
+			    c[1], c[1], c[2] & 0xff, c[2] >> 8, c[3], c[4]);
+			if (bb_configured) {
+				coachz_baseband_new_server(c[1], c[2], c[3], c[4]);
+			}
+		}
+		break;
+	case QRTR_TYPE_DEL_SERVER:
+		if (h->size >= 20) {
+			printf("SWEET MQRTR: modem service %u gone\n", c[1]);
+			if (bb_configured) {
+				coachz_baseband_del_server(c[1], c[3], c[4]);
+			}
+		}
+		break;
+	case QRTR_TYPE_DATA:
+		if (h->confirm_rx) {
+			struct { struct qrtr_hdr_v1 h; uint32_t cmd, node, port; } r;
+			bzero(&r, sizeof(r));
+			r.h.version = 1;
+			r.h.type = QRTR_TYPE_RESUME_TX;
+			r.h.src_node = QRTR_LOCAL_NODE;
+			r.h.src_port = h->dst_port;
+			r.h.size = 12;
+			r.h.dst_node = h->src_node;
+			r.h.dst_port = h->src_port;
+			r.cmd = QRTR_TYPE_RESUME_TX;
+			r.node = QRTR_LOCAL_NODE;
+			r.port = h->dst_port;
+			(void)mch_send(&mg.ch[0], &r, sizeof(r));
+		}
+		if (h->dst_port == RMTFS_PORT) {
+			rmtfs_handle(h, pkt + sizeof(*h), h->size);
+		} else if (h->dst_port >= BB_PORT_BASE && bb_configured) {
+			(void)coachz_baseband_qrtr(h->dst_port, h->src_node, h->src_port, pkt + sizeof(*h), h->size);
+		} else {
+			printf("SWEET MQRTR: data %u bytes from %u:%u to port %u (no taker)\n",
+			    h->size, h->src_node, h->src_port, h->dst_port);
+		}
+		break;
+	case QRTR_TYPE_RESUME_TX:
+	case 9: /* PING */
+		break;
+	default:
+		printf("SWEET MQRTR: control %u from %u:%u\n", h->type, h->src_node, h->src_port);
+		break;
+	}
+}
+
+/* ---- QMI (Linux qmi_encdec wire format: 7-byte header + TLVs) ---- */
+
+struct qmi_msg {
+	uint8_t type;
+	uint16_t txn, id;
+	const uint8_t *tlv;
+	uint16_t len;
+};
+
+struct qmi_buf {
+	uint8_t b[512];
+	uint32_t n;
+};
+
+static int
+qmi_parse(const uint8_t *d, uint32_t n, struct qmi_msg *m)
+{
+	if (n < 7) {
+		return -1;
+	}
+	m->type = d[0];
+	m->txn = (uint16_t)(d[1] | d[2] << 8);
+	m->id = (uint16_t)(d[3] | d[4] << 8);
+	uint16_t l = (uint16_t)(d[5] | d[6] << 8);
+	if (7u + l > n) {
+		return -1;
+	}
+	m->tlv = d + 7;
+	m->len = l;
+	return 0;
+}
+
+static const uint8_t *
+qmi_get(const struct qmi_msg *m, uint8_t t, uint16_t *len)
+{
+	uint32_t off = 0;
+	while (off + 3 <= m->len) {
+		uint8_t tt = m->tlv[off];
+		uint16_t tl = (uint16_t)(m->tlv[off + 1] | m->tlv[off + 2] << 8);
+		if (off + 3 + tl > m->len) {
+			return NULL;
+		}
+		if (tt == t) {
+			*len = tl;
+			return m->tlv + off + 3;
+		}
+		off += 3u + tl;
+	}
+	return NULL;
+}
+
+static int
+qmi_get_u32(const struct qmi_msg *m, uint8_t t, uint32_t *v)
+{
+	uint16_t l;
+	const uint8_t *p = qmi_get(m, t, &l);
+	if (!p || l < 4) {
+		return -1;
+	}
+	memcpy(v, p, 4);
+	return 0;
+}
+
+static int
+qmi_get_u8(const struct qmi_msg *m, uint8_t t, uint8_t *v)
+{
+	uint16_t l;
+	const uint8_t *p = qmi_get(m, t, &l);
+	if (!p || l < 1) {
+		return -1;
+	}
+	*v = p[0];
+	return 0;
+}
+
+static void
+qmi_start(struct qmi_buf *q, uint8_t type, uint16_t txn, uint16_t id)
+{
+	q->b[0] = type;
+	q->b[1] = (uint8_t)txn;
+	q->b[2] = (uint8_t)(txn >> 8);
+	q->b[3] = (uint8_t)id;
+	q->b[4] = (uint8_t)(id >> 8);
+	q->b[5] = q->b[6] = 0;
+	q->n = 7;
+}
+
+static void
+qmi_tlv(struct qmi_buf *q, uint8_t t, const void *v, uint16_t len)
+{
+	if (q->n + 3u + len > sizeof(q->b)) {
+		return;
+	}
+	q->b[q->n] = t;
+	q->b[q->n + 1] = (uint8_t)len;
+	q->b[q->n + 2] = (uint8_t)(len >> 8);
+	memcpy(q->b + q->n + 3, v, len);
+	q->n += 3u + len;
+}
+
+static void
+qmi_tlv_u8(struct qmi_buf *q, uint8_t t, uint8_t v)
+{
+	qmi_tlv(q, t, &v, 1);
+}
+
+static void
+qmi_tlv_u32(struct qmi_buf *q, uint8_t t, uint32_t v)
+{
+	qmi_tlv(q, t, &v, 4);
+}
+
+static void
+qmi_tlv_u64(struct qmi_buf *q, uint8_t t, uint64_t v)
+{
+	qmi_tlv(q, t, &v, 8);
+}
+
+static void
+qmi_tlv_result(struct qmi_buf *q, uint16_t result, uint16_t error)
+{
+	uint16_t v[2] = { result, error };
+	qmi_tlv(q, 2, v, 4);
+}
+
+static uint32_t
+qmi_finish(struct qmi_buf *q)
+{
+	uint16_t l = (uint16_t)(q->n - 7);
+	q->b[5] = (uint8_t)l;
+	q->b[6] = (uint8_t)(l >> 8);
+	return q->n;
+}
+
+/* ---- rmtfs: the modem's EFS, from the eMMC (QMI service 14) ----
+ *
+ * Protocol as github.com/andersson/rmtfs and ios-flame's userland server.
+ * The iovec entries move whole 512-byte sectors between the shared buffer
+ * and the partition. fsg is the factory image: never written.
+ */
+enum { RMTFS_OPEN = 1, RMTFS_CLOSE, RMTFS_RW_IOVEC, RMTFS_ALLOC_BUFF, RMTFS_GET_DEV_ERROR, RMTFS_FORCE_SYNC_IND };
+
+static const struct { const char *path, *part; bool writable; } rmtfs_parts[] = {
+	{ "/boot/modem_fs1", "modemst1", true },
+	{ "/boot/modem_fs2", "modemst2", true },
+	{ "/boot/modem_fsg", "fsg", false },
+	{ "/boot/modem_fsc", "fsc", true },
+};
+#define NPARTS (sizeof(rmtfs_parts) / sizeof(rmtfs_parts[0]))
+
+#define RMTFS_BUF_SIZE  0x200000u
+static uint64_t rmtfs_buf_pa;
+static uint8_t *rmtfs_buf_va;
+static uint8_t rmtfs_tmp[64 * 1024];
+static bool rmtfs_announced;
+
+static void
+rmtfs_announce(void)
+{
+	if (!rmtfs_announced) {
+		vm_offset_t va = 0;
+		/* a guard page on both sides, as the downstream sharedmem does */
+		if (kmem_alloc_contig(kernel_map, &va, RMTFS_BUF_SIZE + 0x2000, PAGE_MASK, 0, 0,
+		    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			printf("SWEET RMTFS: no 2 MB buffer\n");
+			return;
+		}
+		rmtfs_buf_va = (uint8_t *)(va + 0x1000);
+		rmtfs_buf_pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)(va + 0x1000)));
+		rmtfs_announced = true;
+		/* the modem reads and writes this buffer itself: HLOS and MSS both RW (msm_sharedmem's hyp_assign) */
+		extern int sweet_modem_share_with_mss(uint64_t pa, uint64_t size);
+		int shared = sweet_modem_share_with_mss(rmtfs_buf_pa, RMTFS_BUF_SIZE);
+		printf("SWEET RMTFS: buffer at %#llx (shared with the modem: %d), serving %u:%#x\n",
+		    rmtfs_buf_pa, shared, QRTR_LOCAL_NODE, RMTFS_PORT);
+	}
+	uint32_t a[4] = { RMTFS_SERVICE, 1 /* version, instance 0 */, QRTR_LOCAL_NODE, RMTFS_PORT };
+	qrtr_ctrl(QRTR_TYPE_NEW_SERVER, QRTR_NODE_BCAST, QRTR_PORT_CTRL, a, 4);
+}
+
+static int
+rmtfs_iovec(uint32_t caller, uint8_t dir, const uint8_t *v, uint16_t len)
+{
+	if (caller < 1 || caller > NPARTS) {
+		return -1;
+	}
+	const char *part = rmtfs_parts[caller - 1].part;
+	if (dir && !rmtfs_parts[caller - 1].writable) {
+		printf("SWEET RMTFS: refusing a write to %s\n", part);
+		return -1;
+	}
+	/* u8 count first (Linux encdec: the array is prefixed by its length) */
+	unsigned hdr = (len % 12 == 1) ? 1 : (len % 12 == 2) ? 2 : 4;
+	unsigned n = (len - hdr) / 12;
+	for (unsigned i = 0; i < n; i++) {
+		uint32_t e[3];
+		memcpy(e, v + hdr + 12 * i, 12);
+		uint64_t sector = e[0], bytes = (uint64_t)e[2] * 512;
+		uint64_t pa = e[1] >= (uint32_t)rmtfs_buf_pa ? (rmtfs_buf_pa & ~0xffffffffull) + e[1] : rmtfs_buf_pa + e[1];
+		if (pa < rmtfs_buf_pa || pa + bytes > rmtfs_buf_pa + RMTFS_BUF_SIZE) {
+			printf("SWEET RMTFS: iovec outside the buffer (%#x %#x %#x)\n", e[0], e[1], e[2]);
+			return -1;
+		}
+		uint8_t *bufp = rmtfs_buf_va + (pa - rmtfs_buf_pa);
+		uint64_t done = 0;
+		while (done < bytes) {
+			uint32_t chunk = (uint32_t)MIN(bytes - done, (uint64_t)sizeof(rmtfs_tmp));
+			uint64_t total = 0;
+			int err;
+			if (dir == 0) {
+				err = sweet_emmc_read_partition(part, sector + done / 512, chunk / 512, rmtfs_tmp, &total);
+				if (err) {
+					printf("SWEET RMTFS: read %s +%llu x%u: %d\n", part, sector + done / 512, chunk / 512, err);
+					return -1;
+				}
+				memcpy(bufp + done, rmtfs_tmp, chunk);
+			} else {
+				memcpy(rmtfs_tmp, bufp + done, chunk);
+				err = sweet_emmc_write_partition(part, sector + done / 512, chunk / 512, rmtfs_tmp);
+				if (err) {
+					printf("SWEET RMTFS: write %s +%llu x%u: %d\n", part, sector + done / 512, chunk / 512, err);
+					return -1;
+				}
+			}
+			done += chunk;
+		}
+		printf("SWEET RMTFS: %s %s sectors %u+%u\n", dir ? "write" : "read", part, e[0], e[2]);
+	}
+	return 0;
+}
+
+static void
+rmtfs_handle(const struct qrtr_hdr_v1 *h, const uint8_t *d, uint32_t n)
+{
+	struct qmi_msg m;
+	static struct qmi_buf q;        /* only the mglink thread runs this */
+	uint32_t caller = 0;
+	if (qmi_parse(d, n, &m) || m.type != 0 /* request */) {
+		return;
+	}
+	qmi_start(&q, 2 /* response */, m.txn, m.id);
+	(void)qmi_get_u32(&m, 1, &caller);
+	switch (m.id) {
+	case RMTFS_OPEN: {
+		uint16_t l = 0;
+		const uint8_t *p = qmi_get(&m, 1, &l);
+		char path[64] = { 0 };
+		if (p) {
+			memcpy(path, p, l < 63 ? l : 63);
+		}
+		unsigned i;
+		for (i = 0; i < NPARTS; i++) {
+			if (strcmp(path, rmtfs_parts[i].path) == 0) {
+				break;
+			}
+		}
+		printf("SWEET RMTFS: open \"%s\": %d\n", path, i < NPARTS ? (int)i + 1 : -1);
+		if (i < NPARTS) {
+			qmi_tlv_result(&q, 0, 0);
+			qmi_tlv_u32(&q, 0x10, i + 1);
+		} else {
+			qmi_tlv_result(&q, 1, 3);
+		}
+		break;
+	}
+	case RMTFS_CLOSE:
+		qmi_tlv_result(&q, 0, 0);
+		break;
+	case RMTFS_ALLOC_BUFF: {
+		uint32_t size = 0;
+		(void)qmi_get_u32(&m, 2, &size);
+		printf("SWEET RMTFS: alloc %u bytes for %u: %#llx\n", size, caller, rmtfs_buf_pa);
+		if (size <= RMTFS_BUF_SIZE && rmtfs_buf_pa) {
+			qmi_tlv_result(&q, 0, 0);
+			qmi_tlv_u64(&q, 0x10, rmtfs_buf_pa);
+		} else {
+			qmi_tlv_result(&q, 1, 3);
+		}
+		break;
+	}
+	case RMTFS_RW_IOVEC: {
+		uint8_t dir = 0;
+		uint16_t l = 0;
+		(void)qmi_get_u8(&m, 2, &dir);
+		const uint8_t *v = qmi_get(&m, 3, &l);
+		int r = v ? rmtfs_iovec(caller, dir, v, l) : -1;
+		qmi_tlv_result(&q, r ? 1 : 0, r ? 3 : 0);
+		break;
+	}
+	case RMTFS_GET_DEV_ERROR:
+		qmi_tlv_result(&q, 0, 0);
+		qmi_tlv_u8(&q, 0x10, 0);
+		break;
+	default:
+		printf("SWEET RMTFS: message %u (%u TLV bytes) not supported\n", m.id, m.len);
+		qmi_tlv_result(&q, 1, 0x47);    /* QMI_ERR_NOT_SUPPORTED */
+		break;
+	}
+	(void)qrtr_send_data(RMTFS_PORT, h->src_node, h->src_port, q.b, qmi_finish(&q));
+}
+
+/* ---- bring-up ---- */
+
+static void
+mglink_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	/* the modem first: err-ready before GLINK says anything */
+	uint32_t last = ~0u;
+	for (int i = 0; i < 3000; i++) {
+		uint32_t st = smp2p_modem_state();
+		if (st != last) {
+			last = st;
+			if (st != ~0u) {
+				printf("SWEET MGLINK: modem SMP2P state %#x%s%s%s%s\n", st,
+				    (st & 1) ? " ERR-FATAL" : "", (st & 2) ? " err-ready" : "",
+				    (st & 4) ? " proxy-unvote" : "", (st & 8) ? " stop-ack" : "");
+			}
+			if (st != ~0u && (st & 1)) {
+				char why[200];
+				if (sweet_glink_smem_string(421, why, sizeof(why)) && why[0]) {
+					printf("SWEET MGLINK: modem crash reason: %s\n", why);
+				}
+				return;
+			}
+			if (st != ~0u && (st & 2)) {
+				break;
+			}
+		}
+		mg_sleep_ms(10);
+	}
+	if (last == ~0u || !(last & 2)) {
+		printf("SWEET MGLINK: no err-ready from the modem after 30 s (state %#x)\n", last);
+		/* what the modem did create, and whether it died: the SMEM inventory and item 421 */
+		mg_dump_items();
+		char why[200];
+		if (sweet_glink_smem_string(421, why, sizeof(why)) && why[0]) {
+			printf("SWEET MGLINK: modem crash reason (SMEM 421): %s\n", why);
+		}
+		/* keep going: GLINK may still come up */
+	}
+
+	uint32_t dsz = 0;
+	mg.desc = (volatile uint32_t *)mg_alloc(ITEM_DESC, 32, &dsz);
+	mg.txf = mg_alloc(ITEM_TX_FIFO, TX_FIFO_SZ, &mg.txlen);
+	if (!mg.desc || dsz != 32 || !mg.txf) {
+		printf("SWEET MGLINK: descriptor (%u bytes) or tx fifo missing\n", dsz);
+		return;
+	}
+	mg.desc[2] = 0;
+	mg.desc[1] = 0;
+
+	/* IPCRTR intents from the DT: 5 x 2 KB, 3 x 8 KB, 2 x 17 KB */
+	mg.ch[0].name = "IPCRTR";
+	mg.ch[0].lcid = 1;
+	mg.ch[0].handler = qrtr_rx;
+	mg.ch[0].nlocal = 10;
+	for (int i = 0; i < 10; i++) {
+		mg.ch[0].isize[i] = i < 5 ? 0x800 : i < 8 ? 0x2000 : 0x4400;
+	}
+
+	struct { uint16_t cmd, p1; uint32_t p2; } ver = { CMD_VERSION, 1, 1 /* INTENT_REUSE */ };
+	(void)mg_tx(&ver, 8, NULL, 0);
+	printf("SWEET MGLINK: descriptor and %u-byte tx fifo in SMEM, waiting for the modem\n", mg.txlen);
+
+	uint64_t start = mach_absolute_time(), last_ver = start, now;
+	uint64_t ns = 0, last_report = 0;
+	bool opened = false, hello = false;
+	uint32_t idle = 0, fatal_checks = 0;
+	for (;;) {
+		bool any = false;
+		while (mg_rx_one()) {
+			any = true;
+		}
+		now = mach_absolute_time();
+		absolutetime_to_nanoseconds(now - start, &ns);
+		if (!mg.version_done) {
+			uint64_t d;
+			absolutetime_to_nanoseconds(now - last_ver, &d);
+			if (d > 2000000000ull) {
+				(void)mg_tx(&ver, 8, NULL, 0);
+				last_ver = now;
+				if (ns > 30000000000ull && ns < 32100000000ull) {
+					printf("SWEET MGLINK: no GLINK answer from the modem after 30 s (tx %u/%u rx %u/%u)\n",
+					    mg.desc[0], mg.desc[1], mg.desc[2], mg.desc[3]);
+				}
+			}
+		} else if (!opened) {
+			opened = true;
+			mch_open(&mg.ch[0]);
+		}
+		if (mg.ch[0].intents_sent && !hello) {
+			hello = true;
+			int e = qrtr_ctrl(QRTR_TYPE_HELLO, QRTR_NODE_BCAST, QRTR_PORT_CTRL, NULL, 0);
+			printf("SWEET MQRTR: hello sent to the modem (%d)\n", e);
+		}
+		if (bb_configured) {
+			coachz_baseband_poll();
+		}
+		if (ns - last_report > 10000000000ull) {
+			last_report = ns;
+			if (bb_configured) {
+				coachz_baseband_report((unsigned)(ns / 1000000000ull));
+			}
+			/* watch for a late crash too */
+			uint32_t st = smp2p_modem_state();
+			if (st != ~0u && (st & 1) && fatal_checks++ == 0) {
+				char why[200];
+				printf("SWEET MGLINK: the modem went ERR-FATAL (state %#x)\n", st);
+				if (sweet_glink_smem_string(421, why, sizeof(why)) && why[0]) {
+					printf("SWEET MGLINK: modem crash reason: %s\n", why);
+				}
+			}
+		}
+		idle = any ? 0 : idle + 1;
+		mg_sleep_ms(idle > 8 ? 4 : 1);
+	}
+}
+
+void
+sweet_mglink_start(void)
+{
+	thread_t t;
+	if (!mg.prepared || mg.started) {
+		return;
+	}
+	mg.started = true;
+	if (kernel_thread_start(mglink_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
+#endif /* SWEET_KIRIN */
