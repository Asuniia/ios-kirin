+void sweet_hfs_growfs_init(void);
+
+static void
+sweet_hfs_growfs_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	int chan;
+	uint64_t deadline;
+	clock_interval_to_deadline(60, NSEC_PER_SEC, &deadline);
+	(void)assert_wait_deadline(&chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+
+	vnode_t root = vfs_rootvnode();
+	if (root == NULLVP) {
+		printf("SWEET GROWFS: no root vnode\n");
+		return;
+	}
+	mount_t mp = vnode_mount(root);
+	if (strcmp(vfs_statfs(mp)->f_fstypename, "hfs") != 0 || vfs_isrdonly(mp)) {
+		printf("SWEET GROWFS: the root is %s%s: nothing done\n", vfs_statfs(mp)->f_fstypename,
+		    vfs_isrdonly(mp) ? ", read-only" : "");
+		vnode_put(root);
+		return;
+	}
+	struct hfsmount *hfsmp = VFSTOHFS(mp);
+	vfs_context_t ctx = vfs_context_kernel();
+	u_int32_t ss = 0;
+	u_int64_t sc = 0;
+	if (VNOP_IOCTL(hfsmp->hfs_devvp, DKIOCGETBLOCKSIZE, (caddr_t)&ss, 0, ctx) ||
+	    VNOP_IOCTL(hfsmp->hfs_devvp, DKIOCGETBLOCKCOUNT, (caddr_t)&sc, 0, ctx) || ss == 0) {
+		printf("SWEET GROWFS: the device does not say its size\n");
+		vnode_put(root);
+		return;
+	}
+	u_int64_t dev = (u_int64_t)ss * sc;
+	u_int64_t cur = (u_int64_t)hfsmp->totalBlocks * hfsmp->blockSize;
+	u_int64_t want = dev - dev % hfsmp->blockSize;
+	printf("SWEET GROWFS: volume %llu MB, partition %llu MB (blocks of %u bytes)\n",
+	    cur >> 20, dev >> 20, hfsmp->blockSize);
+	if (want <= cur + (64ull << 20)) {
+		printf("SWEET GROWFS: the volume already fills the partition\n");
+		vnode_put(root);
+		return;
+	}
+	int err = hfs_extendfs(hfsmp, want, ctx);
+	printf("SWEET GROWFS: grown to %llu MB: %s (%d)\n",
+	    ((u_int64_t)hfsmp->totalBlocks * hfsmp->blockSize) >> 20, err ? "FAILED" : "ok", err);
