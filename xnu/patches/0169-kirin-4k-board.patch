+  {
+    return bb_open<AppleBasebandUserClient>(this, t, s, type, p, out);
+  }
+  IOReturn newUserClient(task_t t, void *s, UInt32 type, IOUserClient **out) override { return newUserClient(t, s, type, nullptr, out); }
+};
