+#define FB_SCALE        2
+#define FB_CELL         (8 * FB_SCALE)
+#define FB_COLS         (SWEET_EARLY_FB_WIDTH / FB_CELL)
+#define FB_ROWS         ((0x200000 / SWEET_EARLY_FB_STRIDE) / FB_CELL)
+#define FB_FG           0xffffffffu     /* white */
+#define FB_BG           0x00000000u
+
+static unsigned int fb_col, fb_row;
+
+static void
+fb_fill_cell(unsigned int row, unsigned int col, const uint8_t *glyph)
+{
+	for (unsigned int y = 0; y < FB_CELL; y++) {
+		volatile uint32_t *px = (volatile uint32_t *)(early_base +
+		    (row * FB_CELL + y) * SWEET_EARLY_FB_STRIDE) + col * FB_CELL;
+		uint8_t bits = glyph ? glyph[y / FB_SCALE] : 0;
+		for (unsigned int x = 0; x < FB_CELL; x++) {
+			px[x] = (bits >> (x / FB_SCALE)) & 1 ? FB_FG : FB_BG;
+		}
+	}
+}
+
+static void
+fb_new_row(void)
+{
+	fb_col = 0;
+	fb_row = (fb_row + 1) % FB_ROWS;
