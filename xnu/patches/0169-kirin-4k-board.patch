+		}
+		delay(1);
+	}
+	sd_wr(SD_INT_STAT, 0xffffffff);
+	sd_wr(SD_ARG, arg);
+	sd_wr(SD_XFER_CMD, (idx << 24) | (flags << 16) | xfer);
+	uint32_t st;
+	int error = emmc_wait(INT_CMD_DONE, 100 * NSEC_PER_MSEC, &st);
+	if (error) {
+		printf("SWEET EMMC: CMD%u arg 0x%x failed: int 0x%x\n", idx, arg, st);
+		emmc_reset_lines(inhibit);
+		return error;
+	}
+	sd_wr(SD_INT_STAT, INT_CMD_DONE);
+	*r1 = sd_rd(SD_RESP0);
+	if ((flags & 0x3) && (*r1 & R1_ERRORS)) {
+		printf("SWEET EMMC: CMD%u arg 0x%x: card status 0x%x\n", idx, arg, *r1);
