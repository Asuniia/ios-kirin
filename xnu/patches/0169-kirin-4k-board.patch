+	/* EXT_CSD: volatile cache on (CACHE_CTRL, byte 33), user area size (SEC_COUNT, 212). */
+	int error = emmc_xfer(8, 0, 1, false);
+	if (error) {
+		return error;
+	}
+	const uint8_t *ext = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	uint32_t sectors;
+	memcpy(&sectors, ext + 212, 4);
+	su.emmc_cache = ext[33] & 1;
+	printf("SWEET EMMC: RCA %u, %u MiB, cache %s\n", su.rca, sectors >> 11,
+	    su.emmc_cache ? "on" : "off");
+	return 0;
+}
