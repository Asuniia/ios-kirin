+/*
+ * count blocks of 512 bytes between the card and the bounce buffer with
+ * command idx (17/18 read, 24/25 write, 8 EXT_CSD). Auto CMD12 ends
+ * multi-block transfers.
+ */
+static int
+emmc_xfer(uint32_t idx, uint32_t arg, uint32_t count, bool write)
+{
+	uint32_t len = count * UFS_BLOCK;
+	assert(count && len <= BOUNCE_SIZE);
+	uint32_t *desc = (uint32_t *)(su.dma + DMA_ADMA);
+	uint64_t pa = su.dma_pa + DMA_BOUNCE;
+	uint32_t n = 0;
+	for (uint32_t done = 0; done < len; done += ADMA_CHUNK, n++) {
+		uint32_t chunk = MIN(ADMA_CHUNK, len - done);
+		desc[3 * n] = chunk << 16 | 0x21;       /* length, ACT=tran | VALID */
+		desc[3 * n + 1] = (uint32_t)(pa + done);
+		desc[3 * n + 2] = (uint32_t)((pa + done) >> 32);
+	}
+	desc[3 * (n - 1)] |= 0x2;                       /* END */
+	dma_sync(DMA_ADMA, n * 12);
+	dma_sync(DMA_BOUNCE, len);
+	__builtin_arm_dsb(0xf);
+
+	uint64_t desc_pa = su.dma_pa + DMA_ADMA;
+	sd_wr(SD_ADMA_ADDR, (uint32_t)desc_pa);
+	sd_wr(SD_ADMA_ADDR_HI, (uint32_t)(desc_pa >> 32));
+	sd_wr(SD_BLKSZ_CNT, (count << 16) | UFS_BLOCK);
+	uint32_t xfer = XFER_DMA | (write ? 0 : XFER_READ);
+	if (count > 1) {
+		xfer |= XFER_BLKCNT | XFER_MULTI | XFER_ACMD12;
+	}
+	uint32_t r1, st;
+	int error = emmc_cmd(idx, arg, CMD_DATA | CMD_INDEX | CMD_CRC | CMD_RESP48, xfer, &r1);
+	if (!error) {
+		error = emmc_wait(INT_XFER_DONE, CMD_TIMEOUT_NS, &st);
+		if (error) {
+			printf("SWEET EMMC: CMD%u arg 0x%x x%u: int 0x%x adma 0x%x\n",
+			    idx, arg, count, st, sd_rd(SD_ADMA_ERR));
+			emmc_reset_lines(3);
+		} else {
+			sd_wr(SD_INT_STAT, INT_XFER_DONE);
+		}
+	}
+	__builtin_arm_dsb(0xf);
+	if (!write) {
+		dma_sync(DMA_BOUNCE, len);
+	}
+	if (write && !error) {
+		error = emmc_wait_tran();
+	}
+	return error;
+}
+
+/* Read count device blocks at lba into the bounce buffer. */
+static int
+ufs_read_blocks(uint64_t lba, uint32_t count)
+{
+	if (lba > UINT32_MAX || count == 0 || count > BOUNCE_SIZE / UFS_BLOCK) {
+		return EINVAL;
+	}
+	return emmc_xfer(count > 1 ? 18 : 17, (uint32_t)lba, count, false);
+}
+
+/*
+ * Write count device blocks from the bounce buffer to lba. The range must
+ * lie inside the partition: this is the only place data goes out.
+ */
+static int
+ufs_write_blocks(uint64_t lba, uint32_t count)
+{
+	if (!su.writable || !su.nblocks || count == 0 || count > BOUNCE_SIZE / UFS_BLOCK ||
+	    lba < su.first_block || lba - su.first_block >= su.nblocks ||
+	    count > su.nblocks - (lba - su.first_block) || lba + count - 1 > UINT32_MAX) {
+		printf("SWEET EMMC: refusing write of %u blocks at 0x%llx\n", count, lba);
+		return EPERM;
+	}
+	return emmc_xfer(count > 1 ? 25 : 24, (uint32_t)lba, count, true);
+}
+
+/* CMD6 SWITCH FLUSH_CACHE (EXT_CSD 32) when the card's volatile cache is on. */
+static int
+ufs_sync_cache(void)
+{
+	if (!su.emmc_cache) {
+		return 0;
+	}
+	uint32_t r1, st;
+	int error = emmc_cmd(6, (3u << 24) | (32u << 16) | (1u << 8),
+	    CMD_INDEX | CMD_CRC | CMD_RESP48_BUSY, 0, &r1);
+	if (!error) {
+		error = emmc_wait(INT_XFER_DONE, CMD_TIMEOUT_NS, &st);  /* end of busy */
+		if (error) {
+			printf("SWEET EMMC: cache flush: int 0x%x\n", st);
+			emmc_reset_lines(3);
+		} else {
+			sd_wr(SD_INT_STAT, INT_XFER_DONE);
+		}
+	}
+	return error ? error : emmc_wait_tran();
+}
