+/*
+ * Zero-copy present: VIG0 (MDP 3.3 SSPP: SRC_SIZE 0x00, SRC_IMG_SIZE 0x04,
+ * SRC_XY 0x08, OUT_SIZE 0x0c, OUT_XY 0x10, SRC0_ADDR 0x14, SRC_YSTRIDE0
+ * 0x24) scans the region (sx,sy,w,h) of a physically contiguous swap
+ * surface out at panel (dx,dy); the layer mixer fills the rest (the 42-row
+ * letterbox) with its border colour. CTL0 FLUSH latches it at the next
+ * frame; present() then waits for the latch, so CoreAnimation never draws
+ * into the surface being scanned and swaps follow the panel's refresh.
+ */
+bool
+AppleCLCD::kirinScanoutStart(void)
+{
+	int on = 1;
+	PE_parse_boot_argn("sweetfb_scanout", &on, sizeof(on));
+	vm_offset_t vig = on ? ml_io_map(0x0c905000u, 0x1000) : 0, ctl = on ? ml_io_map(0x0c902000u, 0x1000) : 0;
+	if (vig == 0 || ctl == 0) {
+		return false;
+	}
+	fVig = (volatile uint32_t *)vig;
+	fCtl = (volatile uint32_t *)ctl;
+	fFrontPa = fPhys;
+	IOLog("SWEET FB: zero-copy scan-out on (VIG0 src %#x out %#x addr %#x stride %#x)\n",
+	    fVig[0], fVig[0x0c / 4], fVig[0x14 / 4], fVig[0x24 / 4]);
+	return true;
+}
+
+void
+AppleCLCD::kirinScanout(uint64_t pa, uint32_t stride, int32_t sx, int32_t sy, int32_t dx, int32_t dy,
+    int32_t w, int32_t h, uint32_t srcw, uint32_t srch)
+{
+	fVig[0x00 / 4] = (uint32_t)h << 16 | (uint32_t)w;
+	fVig[0x04 / 4] = srch << 16 | srcw;
+	fVig[0x08 / 4] = (uint32_t)sy << 16 | (uint32_t)sx;
+	fVig[0x0c / 4] = (uint32_t)h << 16 | (uint32_t)w;
+	fVig[0x10 / 4] = (uint32_t)dy << 16 | (uint32_t)dx;
+	fVig[0x14 / 4] = (uint32_t)pa;
+	fVig[0x24 / 4] = stride;
+	__builtin_arm_dsb(0xf);
+	fCtl[0x18 / 4] = 0x20001u;
+	__builtin_arm_dsb(0xf);
+	fFrontPa = pa;
+}
+
+/*
+ * The flip of the previous present has to latch before its old front buffer
+ * is drawn into. Up to a frame (16.7 ms): sleep 1 ms between checks instead
+ * of spinning (the spin was ~8.6 ms of a CPU per present).
+ */
+void
+AppleCLCD::kirinWaitFlip(void)
+{
+	for (int i = 0; i < 25 && (fCtl[0x18 / 4] & 0x20001u); i++) {
+		IOSleep(1);
+	}
+}
+
+void
+AppleCLCD::kirinFlip(uint64_t pa, uint32_t stride)
+{
+	if (pa == fFrontPa) {
+		return;
+	}
+	fVig[0x14 / 4] = (uint32_t)pa;
+	fVig[0x24 / 4] = stride;
+	__builtin_arm_dsb(0xf);
+	fCtl[0x18 / 4] = 0x20001u;
+	__builtin_arm_dsb(0xf);
+	fFrontPa = pa;
+}
