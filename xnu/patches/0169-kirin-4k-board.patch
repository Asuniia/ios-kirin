+/* PM660L GPIO 7 as input with pull-up, as Linux's gpio-keys pinctrl. */
+static void
+keys_voldn_setup(void)
+{
+	uint8_t mode = 0, pull = 0, en = 0, rt = 0;
+	bool ok = sweet_pmic_read(KEYS_VOLDN_PPID, 0x40, &mode) &&
+	    sweet_pmic_read(KEYS_VOLDN_PPID, 0x42, &pull) &&
+	    sweet_pmic_read(KEYS_VOLDN_PPID, 0x46, &en) &&
+	    sweet_pmic_read(KEYS_VOLDN_PPID, 0x10, &rt);
+	printf("SWEET KEYS: volume down gpio mode=%#x pull=%#x en=%#x rt=%#x (%s)\n",
+	    mode, pull, en, rt, ok ? "read" : "READ FAILED");
+	/* MODE_CTL bits 6:4 = 0 (digital input), PULL 0 (30 uA up), EN bit 7 */
+	if (ok && (((mode >> 4) & 7u) != 0 || (pull & 7u) != 0 || !(en & 0x80u))) {
+		bool w = sweet_pmic_write(KEYS_VOLDN_PPID, 0x40, 0x00) &&
+		    sweet_pmic_write(KEYS_VOLDN_PPID, 0x42, 0x00) &&
+		    sweet_pmic_write(KEYS_VOLDN_PPID, 0x46, 0x80);
+		printf("SWEET KEYS: volume down gpio set to input pull-up (%s)\n", w ? "ok" : "FAILED");
+	}
+}
