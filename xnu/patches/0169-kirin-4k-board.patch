+	    gicr_read32(0x10d00), gicr_read32(0x10c04), gicr_read32(GICR_IPRIORITYR0 + 16), before, after);
+	printf("SWEET GIC enable: GICD TYPER %#x IIDR %#x PIDR2 %#x\n",
+	    gicd_read32(0x4), gicd_read32(0x8), gicd_read32(0xffe8));
