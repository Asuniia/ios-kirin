diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index a8809d1..ea4c75a 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -64,6 +64,11 @@ MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
 # Pixel 1 Kryo is ARMv8.0: no LSE atomics (ID_AA64ISAR0 Atomic=0), no PAN.
 # -mcpu, not -march: with -arch arm64 Apple clang keeps its Apple CPU features (LSE).
 MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -mcpu=kryo
+# SWEET_BOARD=kirin (Xperia 10, SDM630): Cortex-A53 without a 16K granule,
+# 4K pages (pexpert/arm64/SWEET.h)
+ifeq ($(SWEET_BOARD),kirin)
+MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET -DSWEET_KIRIN=1     -mcpu=cortex-a53
+endif
 
 
 #
@@ -339,6 +344,14 @@ ARM64_PLKSEG_ADDR  =0xfffffe0004004000
 ARM64_LINK_ADDR    =0xfffffe0007004000
 endif
 
+# 4K pages give TTBR1 39 bits: no room for ARM_LARGE_MEMORY's -2TB kernel
+# base, so kirin keeps the iOS kernel layout.
+ifeq ($(SWEET_BOARD),kirin)
+LARGE_MEMORY_DEFINE=-UARM_LARGE_MEMORY
+ARM64_PLKSEG_ADDR  =0xfffffff004004000
+ARM64_LINK_ADDR    =0xfffffff007004000
+endif
+
 
 CFLAGS_ARM64	= -Darm64 -DARM64 -D__ARM64__ -DLP64 -DPAGE_SIZE_FIXED -DVM_KERNEL_LINK_ADDRESS=$(ARM64_LINK_ADDR) \
 			$(LARGE_MEMORY_DEFINE) -momit-leaf-frame-pointer -fno-strict-aliasing -D__API__=v4 -mkernel
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 7ed7d29..ed61fdd 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1832,7 +1832,17 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
  * for a Device alias of the early log block (sweet_early.c) that survives
  * bootstrap TTBR0 teardown.
  */
+#if defined(SWEET_KIRIN)
+/*
+ * kirin has no ARM_LARGE_MEMORY, so VM_MIN_KERNEL_ADDRESS is not the low
+ * globals and its L1 entry has no table. Use the next 2MB block after the
+ * low globals: same L2 table (set up just before), inside the 8MB low
+ * globals range pmap reserves with 4K pages.
+ */
+#define SWEET_EARLY_FB_VA (LOW_GLOBAL_BASE_ADDRESS + ARM_TT_L2_SIZE)
+#else
 #define SWEET_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
+#endif
 
 static void
 sweet_early_map_final(void)
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 5ea69e3..27677d0 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -513,7 +513,20 @@ LEXT(start_first_cpu)
 	mov		x20, x0
 	mov		x21, #0
 
-#if defined(SWEET)
+#if defined(SWEET_KIRIN)
+	/*
+	 * Stage 0, MMU off: paint the top 8 rows of the splash buffer white
+	 * (sweet_early.c draws its text over them later).
+	 */
+	MOV64	x0, SWEET_EARLY_LOG_BLOCK
+	MOV64	x1, (SWEET_EARLY_LOG_BLOCK + 8 * SWEET_EARLY_FB_STRIDE)
+	mov		x2, #-1
+Lsweet_s0_paint:
+	str		x2, [x0], #8
+	cmp		x0, x1
+	b.lo	Lsweet_s0_paint
+	dsb		sy
+#elif defined(SWEET)
 	/*
 	 * Stage 0, MMU off: append a line to the pstore console record the
 	 * shim started (layout in sweet_early.c), no stack or page tables.
@@ -695,12 +708,24 @@ Lkernelcache_base_found:
 	 * reads of the carve-outs that share the block.
 	 */
 	MOV64	x10, SWEET_EARLY_LOG_BLOCK
+#if defined(SWEET_KIRIN)
+	/*
+	 * kirin uses 4K pages: one L1 entry covers 1GB and the block is 2MB.
+	 * The first V=P L2 page covers the 1GB holding the kernel base (x23),
+	 * so only use it when the splash block is in that same 1GB.
+	 */
+	lsr		x12, x10, #(ARM_TT_L1_SHIFT)
+	lsr		x13, x23, #(ARM_TT_L1_SHIFT)
+	cmp		x12, x13
+	b.ne	Lsweet_log_block_done
+#endif
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	add		x13, x25, #(2 * PGBYTES)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+Lsweet_log_block_done:
 #endif
 
 	/* Ensure TTEs are visible */
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index a784618..6d4ec61 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -16,17 +16,75 @@
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
+static volatile uint8_t *early_base = (volatile uint8_t *)(uintptr_t)SWEET_EARLY_LOG_BLOCK;
+
+/* Initialized data must remain writable until disable, including panics. */
+static unsigned int early_disabled, early_panicking;
+
+#if defined(SWEET_KIRIN)
+/*
+ * kirin: no pstore that survives our resets, but the splash buffer is still
+ * on screen. Text in the mapped 2MB block, 8x8 glyphs scaled 2x: 67 columns,
+ * 30 rows, wrapping to the top and clearing the next row as it goes.
+ */
+#include <arm64/sweet_font8x8.h>
+
+#define FB_SCALE        2
+#define FB_CELL         (8 * FB_SCALE)
+#define FB_COLS         (SWEET_EARLY_FB_WIDTH / FB_CELL)
+#define FB_ROWS         ((0x200000 / SWEET_EARLY_FB_STRIDE) / FB_CELL)
+#define FB_FG           0xffffffffu     /* white */
+#define FB_BG           0x00000000u
+
+static unsigned int fb_col, fb_row;
+
+static void
+fb_fill_cell(unsigned int row, unsigned int col, const uint8_t *glyph)
+{
+	for (unsigned int y = 0; y < FB_CELL; y++) {
+		volatile uint32_t *px = (volatile uint32_t *)(early_base +
+		    (row * FB_CELL + y) * SWEET_EARLY_FB_STRIDE) + col * FB_CELL;
+		uint8_t bits = glyph ? glyph[y / FB_SCALE] : 0;
+		for (unsigned int x = 0; x < FB_CELL; x++) {
+			px[x] = (bits >> (x / FB_SCALE)) & 1 ? FB_FG : FB_BG;
+		}
+	}
+}
+
+static void
+fb_new_row(void)
+{
+	fb_col = 0;
+	fb_row = (fb_row + 1) % FB_ROWS;
+	for (unsigned int col = 0; col < FB_COLS; col++) {
+		fb_fill_cell(fb_row, col, NULL);
+	}
+}
+
+static void
+sweet_log_raw(char c)
+{
+	if (c == '\n') {
+		fb_new_row();
+		return;
+	}
+	if (fb_col == FB_COLS) {
+		fb_new_row();
+	}
+	unsigned char uc = (unsigned char)c;
+	if (uc < SWEET_FONT_FIRST || uc > SWEET_FONT_LAST) {
+		uc = '?';
+	}
+	fb_fill_cell(fb_row, fb_col++, sweet_font8x8[uc - SWEET_FONT_FIRST]);
+}
+#else /* !SWEET_KIRIN */
 /* persistent_ram_buffer: "DBGC", start, size, then the text (no ECC) */
 #define PRZ_OFF         (SWEET_EARLY_LOG_PRZ - SWEET_EARLY_LOG_BLOCK)
 #define PRZ_SIG         0x43474244u
 #define PRZ_DATA_MAX    (0x80000u - 12u)
 
-static volatile uint8_t *early_base = (volatile uint8_t *)(uintptr_t)SWEET_EARLY_LOG_BLOCK;
 #define PRZ_W(off) (*(volatile uint32_t *)(early_base + PRZ_OFF + (off)))
 
-/* Initialized data must remain writable until disable, including panics. */
-static unsigned int early_disabled, early_panicking;
-
 /*
  * Ring like Linux persistent_ram: start = next write position, size grows
  * to the buffer size; Android unrolls it as data[start..size) + data[0..start).
@@ -51,6 +109,7 @@ sweet_log_raw(char c)
 	PRZ_W(4) = start;
 	PRZ_W(8) = size;
 }
+#endif /* SWEET_KIRIN */
 
 static unsigned int log_line_start = 1;
 
@@ -61,6 +120,11 @@ static unsigned int log_line_start = 1;
 void
 sweet_log_putc(char c)
 {
+#if defined(SWEET_KIRIN)
+	if (early_disabled) {           /* the framebuffer console owns the screen */
+		return;
+	}
+#endif
 	if (log_line_start && c != '\n') {
 		uint64_t t;
 		__asm__ volatile ("isb");
