+
+struct ptable_entry {
+	uint32_t offset, size, flags;
+	uint16_t host0, host1;
+	uint32_t cacheline, reserved[7];
+} __attribute__((packed));
+
+struct part_header {
+	uint8_t magic[4];
+	uint16_t host0, host1;
+	uint32_t size, offset_free_uncached, offset_free_cached, reserved[3];
+} __attribute__((packed));
+
+struct private_entry {
+	uint16_t canary, item;
+	uint32_t size;
+	uint16_t padding_data, padding_hdr;
+	uint32_t reserved;
+} __attribute__((packed));
+
+/* Linux qcom_smp2p wire format */
+#define SMP2P_MAGIC     0x504d5324u
+#define SMP2P_ENTRIES   16
+struct smp2p_entry_w {
+	uint8_t name[16];
+	uint32_t value;
+} __attribute__((packed));
+struct smp2p_item {
+	uint32_t magic;
+	uint8_t version;
+	uint8_t features[3];
+	uint16_t local_pid, remote_pid;
+	uint16_t total_entries, valid_entries;
+	uint32_t flags;
+	struct smp2p_entry_w entries[SMP2P_ENTRIES];
+} __attribute__((packed));
