+	if (fReal && !valid && logged < 10) {
+		logged++;
+		IOLog("SWEET BATTERY: PMIC read failed at step %d\n", step);
+	}
+	if (!valid) {
+		publish(100, 4200, 0, true, true, false, true, false, false);
+		return;
+	}
+	bool vok = reg16(0x41a0, 0x41a6, &vraw);
+	bool iok = reg16(0x41a2, 0x41a8, &iraw);
