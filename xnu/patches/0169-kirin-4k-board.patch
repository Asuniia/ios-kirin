+	unsigned st = chgr & 7u;
+	bool full = external && st == 5;
+	bool charging = external && st <= 4;
+	uint8_t regs[6] = {soc, usb, chgr, 0, 0, 0};
+	if (memcmp(regs, fLastRegs, sizeof(regs)) != 0) {
+		IOLog("SWEET BATTERY: soc 0x%02x = %u%% %u mV %d mA %d.%d C usb rt 0x%02x chgr sts 0x%02x -> external %d charging %d full %d\n",
+		    soc, percent, mv, ma, fTemperature / 100, (fTemperature < 0 ? -fTemperature : fTemperature) / 10 % 10,
+		    usb, chgr, external, charging, full);
+		memcpy(fLastRegs, regs, sizeof(regs));
+	}
+	publish(percent, mv, ma, external, external, charging, full, true, iok);
