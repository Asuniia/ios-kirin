+/* MPM PS_HOLD (DT restart@10ac000, Linux msm-poweroff deassert_ps_hold). */
+#define KIRIN_PSHOLD_PA         0x010ac000u
+static volatile uint32_t *kirin_pshold;
+
+/*
+ * Power off and restart as Linux does on SDM630: the PMICs' PS_HOLD reset
+ * type (shutdown or hard reset), then PS_HOLD low; PSCI SYSTEM_OFF/RESET if
+ * the SoC is still running 100 ms later. Panic restarts are left alone so
+ * the panic stays on screen.
+ */
+int
+SweetPlatformExpert::haltRestart(unsigned int type)
+{
+	if (type != kPEHaltCPU && type != kPERestartCPU) {
+		return IODTPlatformExpert::haltRestart(type);
+	}
+	bool off = type == kPEHaltCPU;
+	bool cfg = false;
+	if (ml_get_interrupts_enabled() && get_preemption_level() == 0) {
+		cfg = sweet_pmic_pshold_config(off);
+	}
+	kprintf("SWEET: %s (PMIC reset type %s)\n", off ? "power off" : "restart", cfg ? "set" : "NOT set");
+	(void)ml_set_interrupts_enabled(FALSE);
+	if (kirin_pshold != NULL) {
+		*kirin_pshold = 0;
+		__builtin_arm_dsb(0xf);
+	}
+	delay(100000);
+	register uint64_t x0 __asm__("x0") = off ? 0x84000008ull : 0x84000009ull;
+	__asm__ volatile ("smc #0" : "+r"(x0) :: "x1", "x2", "x3", "memory");
+	for (;;) {
+		__builtin_arm_wfi();
+	}
+}
+#endif
+
