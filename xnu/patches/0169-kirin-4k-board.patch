+static void
+keys_thread(void *arg, wait_result_t result)
+{
+	static const int code[3] = {KEY_POWER, KEY_VOLUP, KEY_VOLDN};
+	int state[3] = {0, 0, 0};
+	int seen[3] = {0, 0, 0};	/* debounce: a change must hold for 2 reads (40 ms) */
+	unsigned errors = 0;
+	(void)arg;
+	(void)result;
+	sweet_rtc_init();
+	keys_voldn_setup();
+	for (;;) {
+		uint8_t pon = 0, gpio = 1;
+		bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
+		bool gok = sweet_pmic_read(KEYS_VOLDN_PPID, 0x10, &gpio);
+		int now[3] = {!!(pon & 1u), !!(pon & 2u), !(gpio & 1u)};
+		bool valid[3] = {pok, pok, gok};
+		if ((!pok || !gok) && (errors++ % 250u) == 0) {
+			printf("SWEET KEYS: read error pon=%d gpio=%d arb-status=%#x\n", pok, gok, keys_last_status);
+		}
+		for (int k = 0; k < 3; ++k) {
+			if (!valid[k]) {
+				continue;
+			}
+			if (now[k] != state[k] && now[k] == seen[k]) {
+				state[k] = now[k];
+				printf("SWEET KEYS: key=%d down=%d\n", code[k], state[k]);
+				sweet_hid_key(code[k], state[k]);
+			}
+			seen[k] = now[k];
+		}
+		keys_wait();
+	}
+}
