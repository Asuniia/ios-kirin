+void sweet_gic_dump(const char *when);
+void
+sweet_gic_dump(const char *when)
+{
+	vm_offset_t gicr_pe_base = find_gicr_pe_base();
+	printf("SWEET GIC %s: CTLR %#x WAKER %#x GRP0 %#x EN0 %#x PEND0 %#x ACT0 %#x\n", when,
