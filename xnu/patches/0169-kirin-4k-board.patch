+ * eMMC transport (SDM630 SDHC1, qcom,sdhci-msm-v5, standard SDHCI 3.0
+ * registers). xboot leaves the host clocked (8-bit HS200) and the card
+ * selected in transfer state, as ABL leaves the Pixel's UFS link up; the
+ * shim's read-only probe (shim/emmc.c) checked that on the phone. PIO reads
+ * repeat words on this host, so every transfer is ADMA2 (64-bit, 12-byte
+ * descriptors) from the bounce buffer, polled, one command at a time.
+ * 32-bit register accesses only.
+ */
+#define SD_BLKSZ_CNT    0x04
+#define SD_ARG          0x08
+#define SD_XFER_CMD     0x0c                    /* transfer mode | command << 16 */
+#define SD_RESP0        0x10
+#define SD_PRESENT      0x24
+#define SD_CLK_CTL      0x2c                    /* clock, timeout, software reset << 24 */
+#define SD_INT_STAT     0x30
+#define SD_INT_EN       0x34
+#define SD_SIG_EN       0x38
+#define SD_CAPS         0x40
+#define SD_ADMA_ERR     0x54
+#define SD_ADMA_ADDR    0x58
+#define SD_ADMA_ADDR_HI 0x5c
+
+#define INT_CMD_DONE    (1u << 0)
+#define INT_XFER_DONE   (1u << 1)
+#define INT_ERR         (1u << 15)
+#define CMD_RESP48      0x02
+#define CMD_RESP48_BUSY 0x03
+#define CMD_CRC         0x08
+#define CMD_INDEX       0x10
+#define CMD_DATA        0x20
+#define XFER_DMA        (1u << 0)
+#define XFER_BLKCNT     (1u << 1)
+#define XFER_ACMD12     (1u << 2)
+#define XFER_READ       (1u << 4)
+#define XFER_MULTI      (1u << 5)
+#define CAPS_64BIT      (1u << 28)
+
+#define R1_STATE(r)     (((r) >> 9) & 0xf)
+#define R1_TRAN         4
+#define R1_READY        (1u << 8)
+#define R1_ERRORS       0xfdf80080u             /* error bits 31-19 and SWITCH_ERROR */
+
+#define DMA_ADMA        0x0000                  /* descriptor table, 8 byte aligned */
+#define ADMA_CHUNK      (32u << 10)             /* bytes per descriptor (16-bit length) */
+#define ADMA_DESCS      (BOUNCE_SIZE / ADMA_CHUNK)
+
+static inline uint32_t
+sd_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(su.regs + off);
+}
+
+static inline void
+sd_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(su.regs + off) = v;
+}
+
+static uint64_t
+sd_deadline(uint64_t ns)
+{
+	uint64_t t;
+	nanoseconds_to_absolutetime(ns, &t);
+	return mach_absolute_time() + t;
+}
+
+/* After an error the CMD (1) / DAT (2) circuits stay stuck until reset. */
+static void
+emmc_reset_lines(uint32_t mask)
+{
+	sd_wr(SD_CLK_CTL, sd_rd(SD_CLK_CTL) | (mask << 25));
+	uint64_t deadline = sd_deadline(10 * NSEC_PER_MSEC);
+	while ((sd_rd(SD_CLK_CTL) >> 25) & mask) {
+		if (mach_absolute_time() > deadline) {
+			printf("SWEET EMMC: line reset 0x%x stuck\n", mask);
+			return;
+		}
+		delay(1);
+	}
+}
+
+/* Wait for any of bits (or an error) in INT_STAT. */
+static int
+emmc_wait(uint32_t bits, uint64_t ns, uint32_t *st)
+{
+	uint64_t deadline = sd_deadline(ns);
+	for (;;) {
+		uint32_t s = sd_rd(SD_INT_STAT);
+		if (s & (bits | INT_ERR)) {
+			*st = s;
+			return (s & INT_ERR) ? EIO : 0;
+		}
+		if (mach_absolute_time() > deadline) {
+			*st = 0;
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+}
+
+/* One command; data (if any) is set up by the caller. *r1 gets RESP0. */
+static int
+emmc_cmd(uint32_t idx, uint32_t arg, uint32_t flags, uint32_t xfer, uint32_t *r1)
+{
+	uint32_t inhibit = (flags & CMD_DATA) || (flags & 0x3) == CMD_RESP48_BUSY ? 3 : 1;
+	uint64_t deadline = sd_deadline(CMD_TIMEOUT_NS);
+	while (sd_rd(SD_PRESENT) & inhibit) {
+		if (mach_absolute_time() > deadline) {
+			printf("SWEET EMMC: CMD%u: host busy, present 0x%x\n", idx, sd_rd(SD_PRESENT));
+			return EBUSY;
+		}
+		delay(1);
+	}
+	sd_wr(SD_INT_STAT, 0xffffffff);
+	sd_wr(SD_ARG, arg);
+	sd_wr(SD_XFER_CMD, (idx << 24) | (flags << 16) | xfer);
+	uint32_t st;
+	int error = emmc_wait(INT_CMD_DONE, 100 * NSEC_PER_MSEC, &st);
+	if (error) {
+		printf("SWEET EMMC: CMD%u arg 0x%x failed: int 0x%x\n", idx, arg, st);
+		emmc_reset_lines(inhibit);
+		return error;
+	}
+	sd_wr(SD_INT_STAT, INT_CMD_DONE);
+	*r1 = sd_rd(SD_RESP0);
+	if ((flags & 0x3) && (*r1 & R1_ERRORS)) {
+		printf("SWEET EMMC: CMD%u arg 0x%x: card status 0x%x\n", idx, arg, *r1);
+		return EIO;
+	}
+	return 0;
+}
+
+/* CMD13 until the card is back in transfer state (writes keep it programming). */
+static int
+emmc_wait_tran(void)
+{
+	uint64_t deadline = sd_deadline(CMD_TIMEOUT_NS);
+	for (;;) {
+		uint32_t r1;
+		int error = emmc_cmd(13, su.rca << 16, CMD_INDEX | CMD_CRC | CMD_RESP48, 0, &r1);
+		if (error) {
+			return error;
+		}
+		if (R1_STATE(r1) == R1_TRAN && (r1 & R1_READY)) {
+			return 0;
+		}
+		if (mach_absolute_time() > deadline) {
+			printf("SWEET EMMC: card stuck, status 0x%x\n", r1);
+			return ETIMEDOUT;
+		}
+		delay(10);
+	}
