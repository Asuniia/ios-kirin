+/* Source pixel (x, y) of the RGBA8 test pattern, byte c. */
+static uint8_t
+pat(uint32_t x, uint32_t y, uint32_t c)
+{
+	return (uint8_t)(c == 0 ? x * 4 + 1 : c == 1 ? y * 4 + 2 : c == 2 ? (x + y) * 2 + 3 : 0x80);
+}
+
+/* Step 3: three 2D blits (see the header). */
+static void
+blit_test(vm_offset_t gpu, vm_offset_t smmu, vm_offset_t scratch_va, uint64_t scratch)
+{
+	vm_offset_t sva, d1va, d2va, d3va;
+	uint64_t src = gpu_page(&sva), d1 = gpu_page(&d1va), d2 = gpu_page(&d2va), d3 = gpu_page(&d3va);
+	if (src == 0 || d1 == 0 || d2 == 0 || d3 == 0) {
+		printf("SWEET GPU: no blit pages\n");
+		return;
+	}
+	uint8_t *s = (uint8_t *)sva, *o1 = (uint8_t *)d1va, *o2 = (uint8_t *)d2va, *o3 = (uint8_t *)d3va;
+	for (uint32_t y = 0; y < 64; y++) {
+		for (uint32_t x = 0; x < 64; x++) {
+			for (uint32_t c = 0; c < 4; c++) {
+				s[y * 256 + x * 4 + c] = pat(x, y, c);
+			}
+		}
+	}
+	flush_dcache64((addr64_t)src, PAGE_SIZE, TRUE);
+	flush_dcache64((addr64_t)d1, PAGE_SIZE, TRUE);
+	flush_dcache64((addr64_t)d2, PAGE_SIZE, TRUE);
+	flush_dcache64((addr64_t)d3, PAGE_SIZE, TRUE);
+	uint64_t fence = scratch + 16;
+	volatile uint32_t *fv = (volatile uint32_t *)(scratch_va + 16);
+	printf("SWEET GPU: blit pages src %llx dst %llx %llx %llx\n", src, d1, d2, d3);
+
+	static const char *const name[3] = {"copy RGBA8 64x64", "RGBA8 -> RGB888 64x64", "scale RGBA8 32x32 -> RGB888 46x46"};
+	for (uint32_t t = 0; t < 3; t++) {
+		gpu_wait(2);
+		if (t == 0) {
+			emit_blit(BLIT_OP_COPY, RB5_R8G8B8A8_UNORM, src, 256, 64, 64,
+			    RB5_R8G8B8A8_UNORM, d1, 256, 64, 64, fence, 0x100 + t);
+		} else if (t == 1) {
+			emit_blit(BLIT_OP_COPY, RB5_R8G8B8A8_UNORM, src, 256, 64, 64,
+			    RB5_R8G8B8_UNORM, d2, 192, 64, 64, fence, 0x100 + t);
+		} else {
+			emit_blit(BLIT_OP_SCALE, RB5_R8G8B8A8_UNORM, src, 256, 32, 32,
+			    RB5_R8G8B8_UNORM, d3, 192, 46, 46, fence, 0x100 + t);
+		}
+		bool read = kick(gpu);
+		delay(5000);
+		flush_dcache64((addr64_t)scratch, 64, TRUE);
+		flush_dcache64((addr64_t)d1, PAGE_SIZE, TRUE);
+		flush_dcache64((addr64_t)d2, PAGE_SIZE, TRUE);
+		flush_dcache64((addr64_t)d3, PAGE_SIZE, TRUE);
+		uint32_t bad = 0, nonzero = 0, first = ~0u;
+		for (uint32_t y = 0; y < 64; y++) {
+			for (uint32_t x = 0; x < 64; x++) {
+				for (uint32_t c = 0; c < 4; c++) {
+					uint32_t got, want;
+					if (t == 0) {
+						got = o1[y * 256 + x * 4 + c];
+						want = pat(x, y, c);
+					} else if (t == 1 && c < 3) {
+						got = o2[y * 192 + x * 3 + c];
+						want = pat(x, y, c);
+					} else if (t == 2 && c < 3 && x < 46 && y < 46) {
+						/* nearest; the GPU may sample at pixel centres, so only count */
+						got = o3[y * 192 + x * 3 + c];
+						want = pat(x * 32 / 46, y * 32 / 46, c);
+					} else {
+						continue;
+					}
+					nonzero += got != 0;
+					if (got != want) {
+						if (bad++ == 0) {
+							first = (y << 16) | (x << 4) | c;
+						}
+					}
+				}
+			}
+		}
+		uint8_t *o = t == 0 ? o1 : t == 1 ? o2 : o3;
+		cp_state(gpu, read ? "blit read:" : "blit NOT read (200 ms):");
+		smmu_faults(smmu, "after blit:");
+		printf("SWEET GPU: blit %s: fence %x (want %x), %u nonzero, %u mismatches (first y %u x %u c %u); "
+		    "dst[0..7] %02x %02x %02x %02x %02x %02x %02x %02x -> %s\n",
+		    name[t], *fv, 0x100 + t, nonzero, bad, first >> 16, (first >> 4) & 0xfff, first & 0xf,
+		    o[0], o[1], o[2], o[3], o[4], o[5], o[6], o[7],
+		    bad == 0 ? "GPU 2D BLIT WORKS" : nonzero ? "partly written" : "nothing written");
+		if (!read) {
+			return;
+		}
+	}
+}
