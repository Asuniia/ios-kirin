+static uint64_t
+usecs(uint64_t abs)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(abs, &ns);
+	return ns / 1000;
+}
+
+/* CPU blend as fast as plain C gets: blend.asm's two-channels-per-op form. */
+static void
+blend_cpu(const uint32_t *src, uint32_t *dst, uint32_t n)
+{
+	for (uint32_t i = 0; i < n; i++) {
+		uint32_t s = src[i], d = dst[i], ia = 255 - (s >> 24);
+		uint32_t rb = (d & 0x00ff00ffu) * ia, ag = ((d >> 8) & 0x00ff00ffu) * ia;
+		rb = ((rb + 0x00800080u + ((rb >> 8) & 0x00ff00ffu)) >> 8) & 0x00ff00ffu;
+		ag = ((ag + 0x00800080u + ((ag >> 8) & 0x00ff00ffu)) >> 8) & 0x00ff00ffu;
+		dst[i] = s + (rb | (ag << 8));
+	}
+}
