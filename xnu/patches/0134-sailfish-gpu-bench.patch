+/*
+ * Full-frame benchmark: 1024x1024 pixels (4 MB per buffer, about one
+ * 750x1334 iOS frame). Three rounds; GPU at the step-1 clock (200 MHz).
+ */
+static void
+bench_test(vm_offset_t gpu, vm_offset_t smmu, vm_offset_t scratch_va, uint64_t scratch)
+{
+	const uint32_t n = 1024 * 1024, bytes = n * 4, groups = n / 64;
+	vm_offset_t sva, dva, cva;
+	uint64_t src = gpu_alloc(&sva, bytes), dst = gpu_alloc(&dva, bytes), cpu = gpu_alloc(&cva, bytes);
+	uint64_t kb = kernel_page(&k_blend);
+	if (src == 0 || dst == 0 || cpu == 0 || kb == 0) {
+		printf("SWEET GPU: bench: no 4 MB buffers\n");
+		return;
+	}
+	uint32_t *s = (uint32_t *)sva, *d = (uint32_t *)dva, *c = (uint32_t *)cva;
+	volatile uint32_t *fv = (volatile uint32_t *)(scratch_va + 48);
+	for (uint32_t r = 0; r < 3; r++) {
+		for (uint32_t i = 0; i < n; i++) {
+			uint32_t al = (i * 37 + r) & 0xff, ch = al ? (i * 11) % (al + 1) : 0;
+			s[i] = (al << 24) | (ch << 16) | ((ch / 2) << 8) | (ch / 3);
+			d[i] = c[i] = 0xff000000u | ((i * 7) & 0xff) << 16 | ((i * 13) & 0xff) << 8 | (i & 0xff);
+		}
+		uint64_t t0 = mach_absolute_time();
+		flush_dcache64((addr64_t)src, bytes, TRUE);
+		flush_dcache64((addr64_t)dst, bytes, TRUE);
+		uint64_t t1 = mach_absolute_time();
+		uint64_t bufs[2] = {src, dst};
+		uint32_t sizes[2] = {bytes, bytes};
+		bool read = compute_run(gpu, &k_blend, kb, bufs, sizes, groups, scratch + 48, 0x500 + r);
+		uint64_t t2 = mach_absolute_time();
+		bool done = false;
+		for (unsigned us = 0; us < 500000 && !(done = (*fv == 0x500 + r)); us += 10) {
+			delay(10);
+			flush_dcache64((addr64_t)scratch + 48, 4, TRUE);
+		}
+		uint64_t t3 = mach_absolute_time();
+		flush_dcache64((addr64_t)dst, bytes, TRUE);
+		uint64_t t4 = mach_absolute_time();
+		blend_cpu(s, c, n);
+		uint64_t t5 = mach_absolute_time();
+		uint32_t bad = 0, first = ~0u;
+		for (uint32_t i = 0; i < n; i++) {
+			if (d[i] != c[i] && bad++ == 0) {
+				first = i;
+			}
+		}
+		printf("SWEET GPU: bench %u: %u px; cache clean+inval 8 MB %llu us; GPU submit %llu us, "
+		    "submit->fence %llu us (%s); inval 4 MB %llu us; CPU blend %llu us; GPU vs CPU %u wrong (first %u)\n",
+		    r, n, usecs(t1 - t0), usecs(t2 - t1), usecs(t3 - t1), done ? "done" : read ? "NO FENCE" : "NOT READ",
+		    usecs(t4 - t3), usecs(t5 - t4), bad, first);
+		smmu_faults(smmu, "after bench:");
+		if (!done) {
+			cp_state(gpu, "bench stuck:");
+			return;
+		}
+		gpu_wait(1);
+	}
 }
 
