+/* Pixel 1: keep the panel aside, give the rest of the driver a 750x1334 BGRA surface. */
+bool
+AppleCLCD::startScaled(void)
+{
+	fPanelW = fWidth;
+	fPanelH = fHeight;
+	fPanelStride = fRowBytes;
+	fPanel = ml_io_map_wcomb((vm_offset_t)fPhys, (vm_size_t)fRowBytes * fHeight);
+	fShadow = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+	    kIODirectionInOut | kIOMemoryPhysicallyContiguous,
+	    round_page(SWEET_FB_P1_W * 4 * SWEET_FB_P1_H), 0xFFFFFFFFFULL & ~(uint64_t)PAGE_MASK);
+	fRow = (uint8_t *)IOMallocData(SWEET_FB_P1_W * 4);
+	fOut = (uint8_t *)IOMallocData(fPanelW * 3);
+	fXmap = (uint32_t *)IOMallocData(fPanelW * sizeof(uint32_t));
+	if (fPanel == 0 || fShadow == NULL || fRow == NULL || fOut == NULL || fXmap == NULL) {
+		return false;
+	}
+	bzero(fShadow->getBytesNoCopy(), fShadow->getLength());
+	fPhys = fShadow->getPhysicalAddress();
+	fWidth = SWEET_FB_P1_W;
+	fHeight = SWEET_FB_P1_H;
+	fRowBytes = SWEET_FB_P1_W * 4;
+	fScaled = true;
+	return true;
+}
+
+/*
+ * Logical rect (dx,dy,w,h) of a BGRA source at (sx,sy) -> every panel pixel
+ * whose logical (nearest) pixel is inside it. Source rows are read once into
+ * fRow (the surface mapping is write-combined: slow to read piecemeal).
+ */
+void
+AppleCLCD::blitScaled(uintptr_t src, uint32_t bpr, int32_t sx, int32_t sy,
+    int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	uint32_t lw = fWidth, lh = fHeight;
+	uint32_t x0 = ((uint32_t)dx * fPanelW + lw - 1) / lw;
+	uint32_t x1 = ((uint32_t)(dx + w) * fPanelW + lw - 1) / lw;
+	uint32_t y0 = ((uint32_t)dy * fPanelH + lh - 1) / lh;
+	uint32_t y1 = ((uint32_t)(dy + h) * fPanelH + lh - 1) / lh;
+	x1 = MIN(x1, fPanelW);
+	y1 = MIN(y1, fPanelH);
+	if (x0 >= x1 || y0 >= y1) {
+		return;
+	}
+	uint32_t n = x1 - x0;
+	for (uint32_t i = 0; i < n; i++) {
+		fXmap[i] = ((x0 + i) * lw / fPanelW - (uint32_t)dx) * 4;
+	}
+	int32_t last = -1;
+	for (uint32_t y = y0; y < y1; y++) {
+		int32_t ly = (int32_t)(y * lh / fPanelH) - dy;
+		if (ly != last) {
+			memcpy(fRow, (const void *)(src + (uint64_t)(sy + ly) * bpr + (uint64_t)sx * 4), (size_t)w * 4);
+			for (uint32_t i = 0; i < n; i++) {
+				const uint8_t *p = fRow + fXmap[i];
+				fOut[3 * i] = p[0];
+				fOut[3 * i + 1] = p[1];
+				fOut[3 * i + 2] = p[2];
+			}
+			last = ly;
+		}
+		memcpy((void *)(fPanel + (uint64_t)y * fPanelStride + (uint64_t)x0 * 3), fOut, (size_t)n * 3);
+	}
+}
