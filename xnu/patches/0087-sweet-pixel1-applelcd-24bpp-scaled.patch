+/*
+ * Command-mode panel (Pixel 1): send the frame. A kickoff while the previous
+ * transfer (~16 ms) still runs leaves a torn mix of frames in the panel's
+ * memory, so console kickoffs are spaced >= 20 ms apart (the last lines show
+ * with the next one); force is for whole frames (AppleCLCD, 10 Hz).
+ */
+void
+sweet_fbcon_kick(bool force)
+{
+	static uint64_t last;
+
+	if (fbcon_kickoff == NULL) {
+		return;
 	}
+	uint64_t now = mach_absolute_time();
+	if (!force && now - last < gPEClockFrequencyInfo.timebase_frequency_hz / 50) {
+		return;
+	}
+	last = now;
+	__builtin_arm_dsb(DSB_SY);
+	*fbcon_kickoff = 1;
 }
 
