+/* RGBA8 test image pixel (premultiplied: every channel <= alpha). */
+static uint32_t
+src_px(uint32_t x, uint32_t y)
+{
+	uint32_t al = (x * 9 + y * 5 + 40) & 0xff, c = al ? (x * 7 + y * 3) % (al + 1) : 0;
+	return (al << 24) | (c << 16) | ((c / 2) << 8) | (c / 3);
+}
