+/*
+ * sample.asm checks. A: identity placement of a 64x64 image at (16, 16) in a
+ * 128x128 dst, opacity 1 (expect blend_ref, +-1 for float rounding).
+ * B: 2x upscale over the whole dst, opacity 0.5: bilinear weights are
+ * quarters, so out = (sum16 * 255 + d * (8160 - sum16_a)) / 8160 exactly in
+ * integers (sum16 = 16x the bilinear sum; 8160 = 255 * 32); expect +-2.
+ */
+static void
+sample_test(vm_offset_t gpu, vm_offset_t smmu, vm_offset_t scratch_va, uint64_t scratch)
+{
+	const uint32_t W = 128, H = 128, SW = 64, SH = 64;
+	vm_offset_t sva, dva;
+	uint64_t src = gpu_page(&sva), dst = gpu_alloc(&dva, W * H * 4), ks = kernel_page(&k_sample);
+	if (src == 0 || dst == 0 || ks == 0) {
+		printf("SWEET GPU: sample: no pages\n");
+		return;
+	}
+	uint32_t *s = (uint32_t *)sva, *d = (uint32_t *)dva;
+	volatile uint32_t *fv = (volatile uint32_t *)(scratch_va + 56);
+	for (uint32_t y = 0; y < SH; y++) {
+		for (uint32_t x = 0; x < SW; x++) {
+			s[y * SW + x] = src_px(x, y);
+		}
+	}
+	for (uint32_t t = 0; t < 2; t++) {
+		for (uint32_t i = 0; i < W * H; i++) {
+			d[i] = 0xff000000u | ((i * 7) & 0xff) << 16 | ((i * 13) & 0xff) << 8 | (i & 0xff);
+		}
+		uint32_t orig_d0 = d[0];
+		flush_dcache64((addr64_t)src, PAGE_SIZE, TRUE);
+		flush_dcache64((addr64_t)dst, W * H * 4, TRUE);
+		/* floats as bits: 1.0 3f800000, 0.5 3f000000, 255.0 437f0000, -16.0 c1800000 */
+		uint32_t x0 = t == 0 ? 16 : 0, y0 = x0, w = t == 0 ? SW : W, h = t == 0 ? SH : H;
+		uint32_t consts[16] = {
+			t == 0 ? 0x3f800000u : 0x3f000000u, 0, 0, t == 0 ? 0x3f800000u : 0x3f000000u,
+			t == 0 ? 0xc1800000u : 0, t == 0 ? 0xc1800000u : 0, t == 0 ? 0x3f800000u : 0x3f000000u, 0x3f800000u,
+			0x437f0000u, 0x3f000000u, w - 1, W,
+			x0, y0, 0, 0,
+		};
+		uint32_t tex[24], samp[8];
+		tex_rgba8(tex, src, SW, SH, SW * 4);
+		tex_rgba8(tex + 12, dst, W, H, W * 4);
+		samp_unnorm(samp, true);
+		samp_unnorm(samp + 4, false);
+		struct cs_extra x = {consts, 4, tex, samp, 2, h};
+		uint64_t bufs[1] = {dst};
+		uint32_t sizes[1] = {W * H * 4};
+		wr(smmu + 0x8000, 0x58, 0xffffffffu);
+		bool read = compute_run(gpu, &k_sample, ks, bufs, sizes, (w + 63) / 64, scratch + 56, 0x600 + t, &x);
+		delay(5000);
+		flush_dcache64((addr64_t)scratch, 64, TRUE);
+		flush_dcache64((addr64_t)dst, W * H * 4, TRUE);
+		uint32_t bad = 0, first = ~0u, maxdiff = 0, want_first = 0;
+		for (uint32_t py = 0; py < H; py++) {
+			for (uint32_t px = 0; px < W; px++) {
+				uint32_t i = py * W + px;
+				uint32_t dd = 0xff000000u | ((i * 7) & 0xff) << 16 | ((i * 13) & 0xff) << 8 | (i & 0xff);
+				uint32_t want;
+				if (t == 0) {
+					bool in = px >= x0 && px < x0 + w && py >= y0 && py < y0 + h;
+					want = in ? blend_ref(src_px(px - x0, py - y0), dd) : dd;
+				} else {
+					/* texel pairs and quarter weights along each axis, clamped */
+					int ax = (px & 1) ? (int)(px / 2) : (int)(px / 2) - 1, ay = (py & 1) ? (int)(py / 2) : (int)(py / 2) - 1;
+					uint32_t wx0 = (px & 1) ? 3 : 1, wy0 = (py & 1) ? 3 : 1;
+					int xs[2] = {ax < 0 ? 0 : ax, ax + 1 > (int)SW - 1 ? (int)SW - 1 : ax + 1};
+					int ys[2] = {ay < 0 ? 0 : ay, ay + 1 > (int)SH - 1 ? (int)SH - 1 : ay + 1};
+					uint32_t wxs[2] = {wx0, 4 - wx0}, wys[2] = {wy0, 4 - wy0}, sum[4] = {0, 0, 0, 0};
+					for (int j = 0; j < 2; j++) {
+						for (int k2 = 0; k2 < 2; k2++) {
+							uint32_t p = src_px((uint32_t)xs[k2], (uint32_t)ys[j]);
+							for (int c = 0; c < 4; c++) {
+								sum[c] += wys[j] * wxs[k2] * ((p >> (8 * c)) & 0xff);
+							}
+						}
+					}
+					want = 0;
+					for (int c = 0; c < 4; c++) {
+						uint32_t dc = (dd >> (8 * c)) & 0xff;
+						uint32_t v = (sum[c] * 255 + dc * (8160 - sum[3]) + 4080) / 8160;
+						want |= (v > 255 ? 255 : v) << (8 * c);
+					}
+				}
+				uint32_t got = d[i], md = 0;
+				for (int c = 0; c < 4; c++) {
+					int df = (int)((got >> (8 * c)) & 0xff) - (int)((want >> (8 * c)) & 0xff);
+					uint32_t a = (uint32_t)(df < 0 ? -df : df);
+					md = a > md ? a : md;
+				}
+				maxdiff = md > maxdiff ? md : maxdiff;
+				if (md > (t == 0 ? 1u : 2u) && bad++ == 0) {
+					first = i;
+					want_first = want;
+				}
+			}
+		}
+		cp_state(gpu, read ? "sample read:" : "sample NOT read (200 ms):");
+		smmu_faults(smmu, "after sample:");
+		printf("SWEET GPU: sample %s: fence %x (want %x), max channel diff %u, %u bad (first [%u] = %08x want %08x, "
+		    "d[0] %08x was %08x) -> %s\n", t == 0 ? "A identity 64x64 at (16,16)" : "B 2x upscale, opacity 0.5",
+		    *fv, 0x600 + t, maxdiff, bad, first, first < W * H ? d[first] : 0, want_first, d[0], orig_d0,
+		    bad == 0 ? "GPU TEXTURED QUAD MATCHES THE CPU" : "wrong");
+		if (!read) {
+			return;
+		}
+		gpu_wait(1);
+	}
 }
 
