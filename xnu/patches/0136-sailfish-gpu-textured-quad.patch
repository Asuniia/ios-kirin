+/* A5XX_TEX_CONST for a linear RGBA8 2-D image (byte 0 = x). */
+static void
+tex_rgba8(uint32_t *t, uint64_t pa, uint32_t w, uint32_t h, uint32_t pitch)
+{
+	memset(t, 0, 12 * 4);
+	t[0] = (0u << 4) | (1u << 7) | (2u << 10) | (3u << 13) | (0x30u << 22);  /* XYZW, TFMT5_8_8_8_8_UNORM */
+	t[1] = w | (h << 15);
+	t[2] = (pitch << 7) | (1u << 29);                       /* PITCHALIGN 0, 2D */
+	t[3] = ((pitch * h) >> 12) & 0x3fff;                    /* ARRAY_PITCH */
+	t[4] = (uint32_t)pa;                                    /* 32-byte aligned */
+	t[5] = (uint32_t)(pa >> 32) | (1u << 17);               /* DEPTH 1 */
 }
 
+/* A5XX_TEX_SAMP: unnormalized coords, clamp to edge, linear or nearest. */
+static void
+samp_unnorm(uint32_t *s, bool linear)
+{
+	uint32_t f = linear ? 1 : 0;
+	s[0] = (f << 1) | (f << 3) | (1u << 5) | (1u << 8) | (1u << 11);
+	s[1] = (1u << 5) | (32u << 8);                         /* UNNORM, MAX_LOD 0.125 */
+	s[2] = 0;
+	s[3] = 0;
+}
