+/*
+ * Step 4.1: one compute dispatch (computerator a5xx_emit_grid with
+ * cs_restore_emit / cs_program_emit / cs_ibo_emit; no consts, no private
+ * memory), then the CPU checks the SSBO.
+ */
+static void
+compute_test(vm_offset_t gpu, vm_offset_t smmu, vm_offset_t scratch_va, uint64_t scratch)
+{
+	static const uint32_t local[3] = {k_fill_LOCAL_SIZE}, groups = 16;
+	uint32_t n = local[0] * groups, bytes = n * 4;
+	vm_offset_t shva, outva;
+	uint64_t sh = gpu_page(&shva), out = gpu_page(&outva);
+	if (sh == 0 || out == 0 || bytes > PAGE_SIZE) {
+		printf("SWEET GPU: no compute pages\n");
+		return;
+	}
+	memcpy((void *)shva, k_fill, sizeof(k_fill));
+	memset((void *)outva, 0xee, bytes);
+	flush_dcache64((addr64_t)sh, PAGE_SIZE, TRUE);
+	flush_dcache64((addr64_t)out, PAGE_SIZE, TRUE);
+	uint64_t fence = scratch + 32;
+	volatile uint32_t *fv = (volatile uint32_t *)(scratch_va + 32);
+	uint32_t thr = k_fill_DOUBLE_THREADSIZE ? 1 : 0;   /* FOUR_QUADS : TWO_QUADS */
+	wr(smmu + 0x8000, 0x58, 0xffffffffu);
+
+	/* cs_restore_emit */
+	emit(pkt7(CP_SET_RENDER_MODE, 5)); emit(BYPASS); emit(0); emit(0); emit(0); emit(0);
+	emit(pkt4(R_UCHE_CACHE_INVALIDATE_MIN, 5)); emit(0); emit(0); emit(0); emit(0); emit(0x12);
+	emit(pkt7(CP_WAIT_FOR_IDLE, 0));
+	emit(pkt4(R_HLSQ_UPDATE_CNTL, 1)); emit(0x000fffff);
+	emit(pkt4(R_RB_MODE_CNTL, 1)); emit(0x44);
+	emit(pkt4(R_RB_DBG_ECO_CNTL, 1)); emit(0x00100000);
+	emit(pkt4(R_PC_MODE_CNTL, 1)); emit(0x1f);
+	emit(pkt4(R_SP_MODE_CNTL, 1)); emit(0x1e);
+	emit(pkt4(R_SP_DBG_ECO_CNTL, 1)); emit(0x40000800);     /* not A540 */
+	emit(pkt4(R_TPL1_MODE_CNTL, 1)); emit(0x544);
+	emit(pkt4(R_HLSQ_TIMEOUT_THRESHOLD_0, 2)); emit(0x80); emit(0);
+	emit(pkt4(R_VPC_DBG_ECO_CNTL, 1)); emit(0x400);
+	emit(pkt4(R_HLSQ_MODE_CNTL, 1)); emit(1);
+	emit(pkt4(R_VPC_MODE_CNTL, 1)); emit(0);
+	/* cs_program_emit */
+	emit(pkt4(R_SP_SP_CNTL, 1)); emit(0);
+	emit(pkt4(R_HLSQ_CONTROL_0_REG, 1)); emit((thr << 2) | 0x880);
+	emit(pkt4(R_SP_CS_CTRL_REG0, 1));
+	emit((thr << 3) | ((uint32_t)(k_fill_MAX_HALF_REG + 1) << 4) | ((uint32_t)(k_fill_MAX_REG + 1) << 10) |
+	    ((uint32_t)k_fill_BRANCHSTACK << 24) | (1u << 2) /* BUFFER */ | 0x2);
+	emit(pkt4(R_HLSQ_CS_CONFIG, 1)); emit(1);
+	emit(pkt4(R_HLSQ_CS_CNTL, 1)); emit((k_fill_INSTRLEN << 1) | (k_fill_NUM_BUFS ? 1u : 0));
+	emit(pkt4(R_SP_CS_CONFIG, 1)); emit(1);
+	emit(pkt4(R_HLSQ_CS_CONSTLEN, 2)); emit(k_fill_CONSTLEN / 4); emit(k_fill_INSTRLEN);
+	emit(pkt4(R_TPL1_CS_TEX_COUNT, 1)); emit(0);
+	emit(pkt4(R_SP_CS_OBJ_START, 6));
+	emit((uint32_t)sh); emit((uint32_t)(sh >> 32));
+	emit(0);                                /* PVT_MEM_PARAM */
+	emit(0); emit(0);                       /* PVT_MEM_ADDR */
+	emit(0);                                /* PVT_MEM_SIZE */
+	emit(pkt4(R_HLSQ_UPDATE_CNTL, 1)); emit(0x01f00000);
+	emit(pkt4(R_HLSQ_CS_CNTL_0, 2));
+	emit(k_fill_WGID_REGID | (0xfcu << 8) | (0xfcu << 16) | ((uint32_t)k_fill_LOCALID_REGID << 24));
+	emit(1);                                /* HLSQ_CS_CNTL_1 */
+	emit(pkt7(CP_LOAD_STATE4, 3));
+	emit((2u << 16) | (SB4_CS_SHADER << 18) | ((uint32_t)k_fill_INSTRLEN << 22));     /* SS4_INDIRECT */
+	emit((uint32_t)sh);                     /* STATE_TYPE ST4_SHADER (0) in bits 1:0 */
+	emit((uint32_t)(sh >> 32));
+	/* cs_ibo_emit: SSBO 0 size (bytes, overflowing from WIDTH into HEIGHT), then address */
+	emit(pkt7(CP_LOAD_STATE4, 5));
+	emit((SB4_CS_SSBO << 18) | (1u << 22));
+	emit(1);                                /* ST4_CONSTANTS */
+	emit(0);
+	emit((bytes & 0xffffu) << 16);
+	emit(bytes >> 16);
+	emit(pkt7(CP_LOAD_STATE4, 5));
+	emit((SB4_CS_SSBO << 18) | (1u << 22));
+	emit(2);                                /* ST4_UBO */
+	emit(0);
+	emit((uint32_t)out); emit((uint32_t)(out >> 32));
+	/* grid */
+	emit(pkt4(R_HLSQ_CS_NDRANGE_0, 7));
+	emit(3u | ((local[0] - 1) << 2) | ((local[1] - 1) << 12) | ((local[2] - 1) << 22));
+	emit(local[0] * groups); emit(0);
+	emit(local[1]); emit(0);
+	emit(local[2]); emit(0);
+	emit(pkt4(R_HLSQ_CS_KERNEL_GROUP_X, 3)); emit(1); emit(1); emit(1);
+	emit(pkt7(CP_EXEC_CS, 4)); emit(0); emit(groups); emit(1); emit(1);
+	emit(pkt7(CP_WAIT_FOR_IDLE, 0));
+	emit(pkt7(CP_EVENT_WRITE, 4)); emit(CACHE_FLUSH_TS);
+	emit((uint32_t)fence); emit((uint32_t)(fence >> 32)); emit(0x400);
+	emit(pkt7(CP_WAIT_FOR_IDLE, 0));
+
+	bool read = kick(gpu);
+	delay(5000);
+	flush_dcache64((addr64_t)scratch, 64, TRUE);
+	flush_dcache64((addr64_t)out, PAGE_SIZE, TRUE);
+	const uint32_t *o = (const uint32_t *)outva;
+	uint32_t bad = 0, first = ~0u, untouched = 0;
+	for (uint32_t i = 0; i < n; i++) {
+		untouched += o[i] == 0xeeeeeeeeu;
+		if (o[i] != (i ^ 0x5a5a0000u) && bad++ == 0) {
+			first = i;
+		}
+	}
+	cp_state(gpu, read ? "compute read:" : "compute NOT read (200 ms):");
+	smmu_faults(smmu, "after compute:");
+	printf("SWEET GPU: compute %u invocations: fence %x (want 400), %u wrong (first [%u] = %08x), %u untouched; "
+	    "out[0..3] %08x %08x %08x %08x -> %s\n", n, *fv, bad, first, first < n ? o[first] : 0, untouched,
+	    o[0], o[1], o[2], o[3], bad == 0 ? "GPU SHADER WORKS" : "wrong");
+}
