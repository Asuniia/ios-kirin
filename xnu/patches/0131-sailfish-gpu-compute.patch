+/*
+ * Adreno 530 compute kernels for sweet_gpu.c, generated by tools/ir3asm
+ * (tools/build-ir3asm.sh) from tools/gpu-shaders/*.asm. Do not edit.
+ */
+/* k_fill: generated by tools/ir3asm from tools/gpu-shaders/fill.asm */
+#define k_fill_INSTRLEN 1    /* units of 16 instructions */
+#define k_fill_CONSTLEN 0    /* vec4 */
+#define k_fill_MAX_REG 3
+#define k_fill_MAX_HALF_REG -1
+#define k_fill_DOUBLE_THREADSIZE 1
+#define k_fill_BRANCHSTACK 0
+#define k_fill_LOCAL_SIZE 64, 1, 1
+#define k_fill_LOCALID_REGID 0x0
+#define k_fill_WGID_REGID 0xc0
+#define k_fill_NUM_BUFS 1
+static const uint32_t k_fill[32] = {
+	0x5a5a0000, 0x204cc00d, 0x200600c0, 0x46d00004, 0x00000000, 0x00000200, 0x00000004, 0x42100004,
+	0x00000000, 0x00000200, 0x20020004, 0x46d00008, 0x000d0004, 0x43f0000c, 0x00000000, 0x00000500,
+	0x04000619, 0xc7260008, 0x00000000, 0x03000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000,
+	0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000,
+};
