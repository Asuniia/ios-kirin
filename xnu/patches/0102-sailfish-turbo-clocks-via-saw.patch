+/*
+ * Linux msm_spm_drv_set_vdd (AVS off). Refuses unless the SAW reports
+ * `expect` (or 0: never used) first; the caller checks the PMIC afterwards.
+ * Boot 0102a: SAW ver 0x10000000 (SAW2 v3.0 layout), id 0x2018086f, PMIC_STS 0.
+ */
+static bool
+saw_set_vset(uint32_t expect, uint32_t vset)
+{
+	vm_offset_t saw = ml_io_map(SAW_PA, 0x1000);
+	if (!saw) {
+		return false;
+	}
+	uint32_t ver = clk_rd(saw, 0xfd0), major = ver >> 28;
+	bool v4 = major == 4;   /* SAW2 v4.x moved the control registers; v3.0 (major 1) and v2.3 share the old ones */
+	uint32_t id = v4 ? 0xc04 : 0x04, sts = v4 ? 0xc18 : 0x14, rst = v4 ? 0xc1c : 0x18;
+	uint32_t vctl = v4 ? 0x900 : 0x1c, avs = v4 ? 0x904 : 0x20, data3 = 0x4c;
+	printf("SWEET CLK: SAW ver=%#x id=%#x pmic_sts=%#x vctl=%#x data3=%#x avs=%#x\n",
+	    ver, clk_rd(saw, id), clk_rd(saw, sts), clk_rd(saw, vctl), clk_rd(saw, data3), clk_rd(saw, avs));
+	/* PMIC_STS is 0 until the SAW sends its first level (ABL set S11 over SPMI). */
+	uint32_t cur = clk_rd(saw, sts) & 0xffu;
+	if ((major != 1 && major != 3 && major != 4) || !(clk_rd(saw, id) & (1u << 2)) ||
+	    (clk_rd(saw, avs) & 1u) || (cur != expect && cur != 0)) {
+		printf("SWEET CLK: SAW not as expected (want PMIC level %u or 0, AVS off), no voltage change\n", expect);
+		return false;
+	}
+	clk_wr(saw, rst, 1);
+	clk_wr(saw, vctl, (clk_rd(saw, vctl) & ~0x700ffu) | vset);
+	clk_wr(saw, data3, (clk_rd(saw, data3) & ~0x700ffu) | vset);
+	unsigned us;
+	for (us = 0; us < 50 && (clk_rd(saw, sts) & 0xffu) != vset; us++) {
+		delay(1);
+	}
+	delay(200);     /* ramp: 35 mV at the FTS2.5 step rate takes well under this */
+	printf("SWEET CLK: SAW pmic_sts=%#x after %u us\n", clk_rd(saw, sts), us);
+	return (clk_rd(saw, sts) & 0xffu) == vset;
+}
+
 static void
+perf_turbo(vm_offset_t apc0, vm_offset_t apc1, vm_offset_t cbf, vm_offset_t cbfpll)
+{
+	uint8_t vset = 0;
+	if (!saw_set_vset(S11_VSET_NOM, S11_VSET_TURBO) ||
+	    !sweet_pmic_read(PMIC_S11, 0x41, &vset) || vset != S11_VSET_TURBO) {
+		printf("SWEET CLK: turbo skipped (S11 vset=%u)\n", vset);
+		return;
+	}
+	printf("SWEET CLK: S11 vset=%u (940 mV)\n", vset);
+	vm_offset_t macc = ml_io_map(MEMACC_PA, 0x1000);
+	if (macc) {
+		uint32_t a = clk_rd(macc, 0xc0);
+		clk_wr(macc, 0xc0, a & ~0x1fu);
+		printf("SWEET CLK: mem-acc %#x -> %#x\n", a, clk_rd(macc, 0xc0));
+	}
+	clk_pll_start(&clk_perf, apc1, apc1, CLK_MUX, 0, 2150);
+	clk_pll_start(&clk_cbf, cbfpll, cbf, 0x18, 3, 1593);
+	uint32_t mux = clk_rd(apc0, CLK_MUX);
+	if ((mux & 0xfu) != 0x4u) {     /* ABL: hf 0 (lf mux), lf 1 (PLL main) */
+		printf("SWEET CLK: pwr mux=%#x unexpected, pwr cluster left alone\n", mux);
+		return;
+	}
+	clk_wr(apc0, CLK_MUX, (mux & ~0xcu) | (3u << 2));       /* lf: GPLL0 aux */
+	delay(5);
+	clk_pll_start(&clk_pwr, apc0, apc0, CLK_MUX, 0, 1593);
+	clk_dump("pwrcl", apc0);
+	clk_dump("perfcl", apc1);
+	printf("SWEET CLK: cbf mux=%#x pll mode=%#x l=%u\n", clk_rd(cbf, 0x18), clk_rd(cbfpll, 0), clk_rd(cbfpll, 8));
+}
