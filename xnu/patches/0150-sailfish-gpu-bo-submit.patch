+/* Lock held: a free slot (the table grows by doubling), or NULL. */
+struct sweet_gpu_bo *
+SweetGPUUserClient::newBo(uint32_t *handle)
+{
+	for (uint32_t i = 0; i < fBoCap; i++) {
+		if (fBos[i].md == NULL) {
+			*handle = i + 1;
+			return &fBos[i];
+		}
+	}
