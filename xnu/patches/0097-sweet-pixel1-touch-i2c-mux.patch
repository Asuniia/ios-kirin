 #define TOUCH_RESET       89u
 #define TOUCH_ATTN        125u
+#define TOUCH_SWITCH      80u
 #define TOUCH_ADDR        0x20u
 #define TOUCH_MAX         10u
 
@@ -85,7 +88,7 @@
 
 static struct {
 	bool started;
