+
+/* gfx3d RCG = GPLL0 (600 MHz) / div, div in half steps (field 2*div - 1). */
+static bool
+gfx_clock(uint32_t field)
+{
+	wr(mmcc, 0x4004, (5u << 8) | field);
+	wr(mmcc, 0x4000, rd(mmcc, 0x4000) | 1u);
+	return poll(mmcc, 0x4000, 1u, 0, 10);
 }
 
