+/* Display sleep/wake (lock button): black panel, frames held back meanwhile. */
+void
+AppleCLCD::setPower(bool on)
+{
+	IOLockLock(fPresentLock);
+	if (fBlanked == !on) {
+		IOLockUnlock(fPresentLock);
+		return;
+	}
+	fBlanked = !on;
+	sweet_fbcon_blank(!on);
+	if (on && fDirty) {
+		presentPending();
+	}
+	IOLockUnlock(fPresentLock);
+	IOLog("SWEET FB: display %s\n", on ? "on" : "off");
