+
+/*
+ * Display sleep (AppleCLCD power off): layer mixer 0 drops VIG0 and sends
+ * only its border colour, black, which on the AMOLED panel is all pixels
+ * off; the panel itself stays powered (no DSI DCS display off/sleep in).
+ * Unblank puts back the LAYER(LM0) value it replaced.
+ */
+#define FBCON_LAYER_BORDER      (1u << 24)      /* BORDER_COLOR, no pipes */
+
+void
+sweet_fbcon_blank(bool blank)
+{
+	static uint32_t shown;
+
+	if (fbcon_kickoff == NULL) {
+		return;
+	}
+	if (blank) {
+		uint32_t cur = fbcon_kickoff[-7];
+		if (cur == FBCON_LAYER_BORDER) {
+			return;
+		}
+		shown = cur;
+	} else if (shown == 0) {
+		return;
+	}
+	os_atomic_store(&fbcon_layer_next, blank ? FBCON_LAYER_BORDER : shown, release);
 	sweet_fbcon_kick(true);
 }
 
