--- a/bsd/dev/sweet_perf.c
+++ b/bsd/dev/sweet_perf.c
@@ -188,8 +188,16 @@
 perf_turbo(vm_offset_t apc0, vm_offset_t apc1, vm_offset_t cbf, vm_offset_t cbfpll)
 {
 	uint8_t vset = 0;
-	if (!saw_set_vset(S11_VSET_NOM, S11_VSET_TURBO) ||
-	    !sweet_pmic_read(PMIC_S11, 0x41, &vset) || vset != S11_VSET_TURBO) {
+	bool set = saw_set_vset(S11_VSET_NOM, S11_VSET_TURBO);
+	/* The first read right after the SAW's command can fail (0103a: vset=0). */
+	for (int i = 0; set && i < 10 && vset != S11_VSET_TURBO; i++) {
+		if (i) {
+			delay(100);
+		}
+		vset = 0;
+		(void)sweet_pmic_read(PMIC_S11, 0x41, &vset);
+	}
+	if (!set || vset != S11_VSET_TURBO) {
 		printf("SWEET CLK: turbo skipped (S11 vset=%u)\n", vset);
 		return;
 	}
