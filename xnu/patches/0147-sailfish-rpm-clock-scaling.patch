 /*
- * Clock vote in the active set (clk-smd-rpm.c): type e.g. "clk2" (memory
- * clocks: id 0 bimc = DDR), key "KHz ", rate in kHz; the RPM rounds to a
- * supported rate.
+ * Clock vote in the sleep and the active set, like a Linux clk-smd-rpm
+ * clock without an _a twin: type e.g. "clk2" (memory clocks: id 0 bimc =
+ * DDR), key "KHz ", rate in kHz; the RPM rounds to a supported rate. Takes
+ * effect only once scaling is on (sweet_rpm_clk_scaling).
  */
 bool
 sweet_rpm_clk(uint32_t type, uint32_t id, uint32_t khz)
 {
 	uint32_t kv[2] = {0x007a484bu, khz};                    /* "KHz " */
 	lck_mtx_lock(&sweet_rpm_lock);
-	bool ok = rpm_request("clk", type, id, kv, 1);
+	bool ok = rpm_request("clk sleep", 1, type, id, kv, 1) && rpm_request("clk active", 0, type, id, kv, 1);
 	lck_mtx_unlock(&sweet_rpm_lock);
 	printf("SWEET RPM: clock %08x id %u %u kHz: %s\n", type, id, khz, ok ? "ok" : "FAILED");
+	return ok;
+}
+
+/*
+ * RPM clock scaling on (clk-smd-rpm.c clk_smd_rpm_enable_scaling, downstream
+ * enable_rpm_scaling): "clk0" id 2, "Enab" = 1, sleep then active set.
+ * Until then the RPM acks rate votes and ignores them (0146a: DDR stayed at
+ * 1016 MHz after an acked 1804 MHz vote). Once it is on the RPM goes by the
+ * AP's votes, so first, like Linux's clk_smd_rpm_handoff, every msm8996 RPM
+ * clock (downstream clock-gcc-8996.c / msm-clocks-hwio-8996.h) is voted on
+ * at its maximum in both sets: rate clocks "KHz " INT_MAX, branches "Enab"
+ * 1, XO buffers "swen" 1, their pin-controlled twins "pccb" 1.
+ */
+static const struct {
+	uint32_t type, id, key, value;
+} rpm_handoff[] = {
+	{0x316b6c63u, 0, 0x007a484bu, 0x7fffffffu},     /* clk1 pnoc */
+	{0x316b6c63u, 1, 0x007a484bu, 0x7fffffffu},     /* clk1 snoc */
+	{0x316b6c63u, 2, 0x007a484bu, 0x7fffffffu},     /* clk1 cnoc */
+	{0x326b6c63u, 0, 0x007a484bu, 0x7fffffffu},     /* clk2 bimc (DDR) */
+	{0x69786d6du, 0, 0x007a484bu, 0x7fffffffu},     /* mmxi mmssnoc_axi */
+	{0x00617069u, 0, 0x007a484bu, 0x7fffffffu},     /* ipa */
+	{0x00006563u, 0, 0x007a484bu, 0x7fffffffu},     /* ce1 */
+	{0x72676761u, 1, 0x62616e45u, 1},               /* aggr aggre1_noc */
+	{0x72676761u, 2, 0x62616e45u, 1},               /* aggr aggre2_noc */
+	{0x306b6c63u, 1, 0x62616e45u, 1},               /* clk0 qdss */
+	{0x616b6c63u, 1, 0x6e657773u, 1},               /* clka bb_clk1 */
+	{0x616b6c63u, 2, 0x6e657773u, 1},               /* clka bb_clk2 */
+	{0x616b6c63u, 4, 0x6e657773u, 1},               /* clka rf_clk1 */
+	{0x616b6c63u, 5, 0x6e657773u, 1},               /* clka rf_clk2 */
+	{0x616b6c63u, 8, 0x6e657773u, 1},               /* clka ln_bb_clk */
+	{0x616b6c63u, 0xb, 0x6e657773u, 1},             /* clka div_clk1 */
+	{0x616b6c63u, 0xc, 0x6e657773u, 1},             /* clka div_clk2 */
+	{0x616b6c63u, 0xd, 0x6e657773u, 1},             /* clka div_clk3 */
+	{0x616b6c63u, 1, 0x62636370u, 1},               /* clka bb_clk1_pin */
+	{0x616b6c63u, 2, 0x62636370u, 1},               /* clka bb_clk2_pin */
+	{0x616b6c63u, 4, 0x62636370u, 1},               /* clka rf_clk1_pin */
+	{0x616b6c63u, 5, 0x62636370u, 1},               /* clka rf_clk2_pin */
+};
+
+bool
+sweet_rpm_clk_scaling(void)
+{
+	uint32_t kv[2] = {0x62616e45u, 1u};                     /* "Enab" */
+	unsigned failed = 0;
+	lck_mtx_lock(&sweet_rpm_lock);
+	for (unsigned i = 0; i < sizeof(rpm_handoff) / sizeof(rpm_handoff[0]); i++) {
+		uint32_t h[2] = {rpm_handoff[i].key, rpm_handoff[i].value};
+		char what[24];
+		snprintf(what, sizeof(what), "handoff %08x %u", rpm_handoff[i].type, rpm_handoff[i].id);
+		for (uint32_t set = 0; set < 2; set++) {
+			failed += !rpm_request(what, 1 - set, rpm_handoff[i].type, rpm_handoff[i].id, h, 1);
+		}
+	}
+	bool ok = failed == 0 && rpm_request("scaling sleep", 1, 0x306b6c63u, 2, kv, 1) &&
+	    rpm_request("scaling active", 0, 0x306b6c63u, 2, kv, 1);
+	lck_mtx_unlock(&sweet_rpm_lock);
+	printf("SWEET RPM: clock handoff (%u votes failed)\n", failed);
+	printf("SWEET RPM: clock scaling on: %s\n", ok ? "ok" : "FAILED");
 	return ok;
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
