 OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+/*
+ * Panel brightness for CoreBrightness (backboardd): it takes the service
+ * with backlight-control = true that conforms to AppleARMBacklight, and sets
+ * {brightness = ceil(level * (max - min)) + min, FadePeriod = seconds as
+ * 16.16, backlight-level} with IORegistryEntrySetCFProperties, min and max
+ * from IODisplayParameters. With 0..255 brightness is the panel's DCS 0x51
+ * level (ea8064tg); the fade is stepped here every 16 ms, on its own work
+ * loop (a DCS write waits for the frame being sent). It is what fades the
+ * screen out before display sleep. Boot-arg sweetbl=0 leaves it out.
+ */
+#define SWEET_BL_MAX            255
+#define SWEET_BL_STEP_MS        16
+
+class AppleARMBacklight : public IOService {
+	OSDeclareDefaultStructors(AppleARMBacklight);
+
+	IOWorkLoop         *fWL;
+	IOTimerEventSource *fFade;
+	bool                fKnown;         /* fLevel is what the panel has */
+	uint32_t            fLevel, fFrom, fTo;
+	uint64_t            fStart, fPeriod;        /* abs time */
+	uint32_t            fLogged;
+
+	static void fadeStep(OSObject *owner, IOTimerEventSource *sender);
+	void apply(uint32_t level);
+	void publish(uint32_t level);
+
+public:
+	bool startBacklight(void);
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleARMBacklight, IOService);
+
+void
+AppleARMBacklight::publish(uint32_t level)
+{
+	OSDictionary *b = OSDictionary::withCapacity(3);
+	OSDictionary *p = OSDictionary::withCapacity(1);
+	if (b != NULL && p != NULL) {
+		OSNumber *n;
+		n = OSNumber::withNumber(0ULL, 32); b->setObject("min", n); OSSafeReleaseNULL(n);
+		n = OSNumber::withNumber(SWEET_BL_MAX, 32); b->setObject("max", n); OSSafeReleaseNULL(n);
+		n = OSNumber::withNumber(level, 32); b->setObject("value", n); OSSafeReleaseNULL(n);
+		p->setObject("brightness", b);
+		setProperty("IODisplayParameters", p);
+	}
+	OSSafeReleaseNULL(b);
+	OSSafeReleaseNULL(p);
+}
+
+bool
+AppleARMBacklight::startBacklight(void)
+{
+	fWL = IOWorkLoop::workLoop();
+	fFade = IOTimerEventSource::timerEventSource(this, &AppleARMBacklight::fadeStep);
+	if (fWL == NULL || fFade == NULL || fWL->addEventSource(fFade) != kIOReturnSuccess) {
+		return false;
+	}
+	fLevel = SWEET_BL_MAX;
+	setProperty("backlight-control", true);
+	publish(fLevel);
+	registerService();
+	return true;
+}
+
+/* fWL gate held. */
+void
+AppleARMBacklight::apply(uint32_t level)
+{
+	if (fKnown && level == fLevel) {
+		return;
+	}
+	bool ok = sweet_fbcon_dcs(0x51, (uint8_t)level);
+	if (!ok || !fKnown) {
+		IOLog("SWEET BL: panel level %u %s\n", level, ok ? "set" : "FAILED (no DSI command done)");
+	}
+	fKnown = true;
+	fLevel = level;
+}
+
+void
+AppleARMBacklight::fadeStep(OSObject *owner, IOTimerEventSource *sender)
+{
+	AppleARMBacklight *bl = (AppleARMBacklight *)owner;
+	uint64_t t = mach_absolute_time() - bl->fStart;
+	uint32_t level = bl->fTo;
+	if (t < bl->fPeriod) {
+		level = (uint32_t)((int64_t)bl->fFrom +
+		    ((int64_t)bl->fTo - (int64_t)bl->fFrom) * (int64_t)t / (int64_t)bl->fPeriod);
+	}
+	bl->apply(level);
+	if (level != bl->fTo) {
+		sender->setTimeoutMS(SWEET_BL_STEP_MS);
+	}
+}
+
+IOReturn
+AppleARMBacklight::setProperties(OSObject *properties)
+{
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+	if (d == NULL) {
+		return kIOReturnBadArgument;
+	}
+	OSNumber *b = OSDynamicCast(OSNumber, d->getObject("brightness"));
+	OSNumber *f = OSDynamicCast(OSNumber, d->getObject("FadePeriod"));
+	if (fLogged < 40) {
+		fLogged++;
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		OSNumber *l = OSDynamicCast(OSNumber, d->getObject("backlight-level"));
+		IOLog("SWEET BL: %s sets %u keys: brightness %d FadePeriod %d backlight-level %d\n", name,
+		    d->getCount(), b ? (int)b->unsigned32BitValue() : -1, f ? (int)f->unsigned32BitValue() : -1,
+		    l ? (int)l->unsigned32BitValue() : -1);
+	}
+	if (b == NULL) {
+		return kIOReturnSuccess;
+	}
+	int32_t v = (int32_t)b->unsigned32BitValue();
+	uint32_t to = v < 0 ? 0 : MIN((uint32_t)v, SWEET_BL_MAX);
+	uint64_t ms = f != NULL ? ((uint64_t)f->unsigned32BitValue() * 1000) >> 16 : 0;
+	fWL->runActionBlock(^IOReturn (void) {
+		fFade->cancelTimeout();
+		fFrom = fLevel;
+		fTo = to;
+		fStart = mach_absolute_time();
+		nanoseconds_to_absolutetime(MIN(ms, 5000ULL) * NSEC_PER_MSEC, &fPeriod);
+		fadeStep(this, fFade);
+		return kIOReturnSuccess;
+	});
+	publish(to);
+	return kIOReturnSuccess;
+}
 
