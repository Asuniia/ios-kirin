 /*
+ * DCS short write with one parameter (data type 0x15) to the panel, from the
+ * DSI controller's command FIFO (CMD_DMA_TPG, DSI 1.3+: no DMA buffer, no
+ * SMMU), as Linux mdss_dsi_cmd_dma_tpg_tx (msm-3.18). Only between frames:
+ * waits for the frame being sent like a kickoff does. The bootloader left
+ * the controller set up (command DMA, software trigger). Panel brightness =
+ * 0x51 (ea8064tg, bl_ctrl_dcs, 1..255). False if the command never finished.
+ */
+bool
+sweet_fbcon_dcs(uint8_t cmd, uint8_t param)
+{
+	volatile uint32_t *d = fbcon_dsi;
+
+	if (d == NULL) {
+		return false;
+	}
+	for (;;) {
+		if (os_atomic_cmpxchg(&fbcon_kick_lock, 0u, 1u, acquire)) {
+			if (fbcon_frame_done(mach_absolute_time())) {
+				break;
+			}
+			os_atomic_store(&fbcon_kick_lock, 0u, release);
+		}
+		delay(500);
+	}
+	d[0x15c / 4] = 3u << 16 | 1u << 2 | 1u << 1;   /* CMD_DMA_TPG: pattern 3, FIFO mode, on */
+	d[0x17c / 4] = 1u << 31 | 0x15u << 16 | (uint32_t)param << 8 | cmd;    /* last | DCS_WRITE1 */
+	d[0x17c / 4] = 0;                               /* an even number of words */
+	d[0x04c / 4] = 4;                               /* DMA_LEN */
+	__builtin_arm_dsb(DSB_SY);
+	d[0x090 / 4] = 1;                               /* TRIG_DMA */
+	__builtin_arm_dsb(DSB_SY);
+	bool done = false;
+	for (int i = 0; i < 400 && !done; i++) {        /* 20 ms */
+		done = (d[0x110 / 4] & 1u) != 0;        /* INT_CTRL: CMD_DMA_DONE */
+		if (!done) {
+			delay(50);
+		}
+	}
+	d[0x110 / 4] = d[0x110 / 4];                    /* clear the latched status bits */
+	d[0x1ec / 4] = 1;                               /* reset the TPG FIFO */
+	__builtin_arm_dsb(DSB_SY);
+	d[0x1ec / 4] = 0;
+	d[0x15c / 4] = 0;                               /* CMD_DMA_TPG off */
+	__builtin_arm_dsb(DSB_SY);
+	os_atomic_store(&fbcon_kick_lock, 0u, release);
+	return done;
+}
